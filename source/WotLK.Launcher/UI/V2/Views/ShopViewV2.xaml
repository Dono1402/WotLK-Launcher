<UserControl x:Class="WotLK.Launcher.UI.V2.Views.ShopViewV2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WotLK.Launcher.UI.V2.Views"
             xmlns:localization="clr-namespace:WotLK.Launcher.UI.V2.Localization"
             localization:LauncherLocalizationOptions.IsUserText="True"
             FontFamily="{StaticResource AtlasV2.Font.Inter}" TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" Background="Transparent" Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/AtlasV2.Shop.xaml"/></ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ShopChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
            <Style x:Key="ServiceCurrencyChoice" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleLabel}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ChoiceSurface" Background="#90030F18" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                        <Grid><ContentPresenter/>
                            <Border Width="13" Height="13" CornerRadius="7" BorderBrush="{Binding CurrencyColor}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0">
                                <Ellipse x:Name="SelectedDot" Fill="{Binding CurrencyColor}" Margin="3" Visibility="Collapsed"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{Binding CurrencyColor}"/><Setter TargetName="ChoiceSurface" Property="Background" Value="{StaticResource AtlasV2.Brush.GlassRaised}"/><Setter TargetName="SelectedDot" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="#91BBD2"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="ServiceCardButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.GlassSurface}"/><Setter Property="Foreground" Value="#F7FAFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GlassBorder}"/><Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="CardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" ClipToBounds="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="Background" Value="{StaticResource AtlasV2.Brush.GlassRaised}"/><Setter TargetName="CardBorder" Property="BorderBrush" Value="#76ACCB"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#EDCC82"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers>
            <DataTrigger Binding="{Binding IsConversionOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding IsServiceOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding IsWalletOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding IsHistoryOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers></Style></ScrollViewer.Style>
        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/></ScrollViewer.Resources>
        <Grid x:Name="ContentFrame" Margin="64,6,64,24" MaxWidth="1440">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20">
                <Grid x:Name="CatalogueHeader">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="{Binding PageHeading}" Style="{StaticResource AtlasV2.Text.Hero}" FontSize="48" Foreground="{StaticResource AtlasV2.Brush.TitleIce}"/>
                        <TextBlock x:Name="PageDescription" Text="{Binding Subtitle}" Style="{StaticResource AtlasV2.Text.Body}" FontSize="14" Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ServicesHeading}" Style="{StaticResource ShopHeading}" FontSize="20" VerticalAlignment="Center"/>
                            <Button x:Name="ShopHistoryButton" Style="{StaticResource ShopAction}" Click="History_Click" Height="34" Padding="12,0" Margin="18,0,0,0" Background="#6805111A" AutomationProperties.Name="{Binding HistoryLabel}">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource ShopIcon.Clock}" Style="{StaticResource ShopIcon}" Width="16" Height="16"/><TextBlock Text="{Binding HistoryLabel}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Border x:Name="ConversionBanner">
                            <Button x:Name="MoreConversionButton" Style="{StaticResource ShopAction}" Height="72" Width="280" Padding="12,0" Click="Credits_Click" AutomationProperties.Name="{Binding ConversionHeading}" ToolTip="{Binding ConversionHeading}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Image x:Name="ConversionCoins" Source="/WotLK.Launcher;component/Assets/Shop/Conversion_or_transparent.png" Width="92" Height="56" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding ConversionShortcutLabel}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.TitlePearl}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" ToolTip="{Binding ConversionRateDescription}" AutomationProperties.Name="{Binding ConversionRateDescription}">
                                            <TextBlock x:Name="ShortcutRateNumber" Text="{Binding ConversionRateNumber}" FontSize="12" Foreground="{StaticResource ShopGold}" VerticalAlignment="Center"/>
                                            <Image x:Name="ShortcutGoldCoin" Source="{StaticResource ShopGoldCoin}" Width="15" Height="15" Margin="4,0,5,0" AutomationProperties.Name="{Binding ConversionGoldUnitLabel}"/>
                                            <TextBlock Text="{Binding ConversionRateValue}" FontSize="12" Foreground="{StaticResource ShopGold}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ShortcutCreditsLabel" Text="{Binding CreditsLabel}" FontSize="11" Foreground="#D4C49D" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>
                    </StackPanel>
                </Grid>
                <ProgressBar Height="3" Margin="0,10,0,0" IsIndeterminate="True" Style="{StaticResource AtlasV2.Progress.Compact}" Visibility="{Binding IsLoading, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                <Border Background="#DA071925" CornerRadius="6" Padding="14" Margin="0,12,0,0" Visibility="{Binding ShowStatus, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource ShopBody}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button x:Name="RetryButton" Grid.Column="1" Content="{Binding RetryLabel}" Style="{StaticResource ShopAction}" Height="34" IsEnabled="{Binding CanRefresh}" Visibility="{Binding ShowRetry, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}" Click="Refresh_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
            <ItemsControl x:Name="ProductList" Grid.Row="1" ItemsSource="{Binding Offers}" Margin="0,0,-18,0" AutomationProperties.Name="{Binding CategoryLabel}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Button Style="{StaticResource ServiceCardButton}" Margin="0,0,18,18" Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=views:ShopViewV2}}" Click="Service_Click" AutomationProperties.Name="{Binding Name}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="188"/></Grid.RowDefinitions>
                            <Border Height="{Binding CardImageHeight, RelativeSource={RelativeSource AncestorType=views:ShopViewV2}}" CornerRadius="13,13,0,0" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill"/></Border.Background></Border>
                            <Border Grid.Row="1" Height="1" Background="{StaticResource AtlasV2.Brush.GlassHighlight}" VerticalAlignment="Top"/>
                            <Grid Grid.Row="1" Margin="16,12,16,14">
                                <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="56"/><RowDefinition Height="56"/></Grid.RowDefinitions>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="20" FontWeight="Bold" LineHeight="23" Foreground="{StaticResource AtlasV2.Brush.TitlePearl}" Margin="0,3,0,0"/>
                                <TextBlock Grid.Row="1" Text="{Binding Tagline}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="18" Foreground="#B6D4E9" FontSize="13" Margin="0,2,0,0"/>
                                <Border Grid.Row="2" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="0,1,0,0" Padding="0,7,0,0" Margin="0,3,0,0">
                                    <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="21"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Path Data="{StaticResource ShopIcon.Wallet}" Style="{StaticResource ShopIcon}" Width="14" Height="14" Stroke="#A9DCFA" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding WalletLabel}" FontSize="11.5" Foreground="#A9C7DA" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding WalletPrice}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ShopWalletAmount}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <Path Grid.Row="1" Data="{StaticResource ShopIcon.AtlasCredits}" Style="{StaticResource ShopIcon}" Width="14" Height="15" Stroke="#E3BE69" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CreditsLabel}" FontSize="11.5" Foreground="#CBBE9D" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CreditPrice}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource ShopCreditsAmount}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </ScrollViewer>
    <Grid Visibility="{Binding IsServiceOpen, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="ServiceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/></ScrollViewer.Resources>
        <Grid x:Name="ServiceFrame" Margin="60,18,60,30" MaxWidth="1500">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Button x:Name="ServiceBackButton" Style="{StaticResource ShopAction}" Content="{Binding BackToShopLabel}" Click="ServiceBack_Click" HorizontalAlignment="Left" Background="#99142432" Margin="0,0,0,26"/>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition x:Name="DetailColumn" Width="400"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding OfferName}" Style="{StaticResource ShopHeading}" FontSize="36" Margin="0,0,0,20"/>
                    <Image Source="{Binding OfferArtwork}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" MaxHeight="300" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding IncludedLabel}" Style="{StaticResource ShopHeading}" FontSize="19" Margin="0,20,0,6"/>
                    <TextBlock Text="{Binding OfferDescription}" Style="{StaticResource ShopBody}" FontSize="15" LineHeight="23"/>
                    <TextBlock Text="{Binding PreservedLabel}" Style="{StaticResource ShopHeading}" FontSize="19" Margin="0,16,0,6"/>
                    <TextBlock Text="{Binding OfferPreserved}" Style="{StaticResource ShopBody}" FontSize="15" LineHeight="23"/>
                    <TextBlock Text="{Binding ConditionsLabel}" Style="{StaticResource ShopHeading}" FontSize="19" Margin="0,16,0,6"/>
                    <TextBlock Text="{Binding OfferConditions}" Style="{StaticResource ShopBody}" FontSize="15" LineHeight="24"/>
                </StackPanel>
                <Border x:Name="DetailsPanel" Grid.Column="2" Style="{StaticResource ShopPanel}" Padding="22,17,22,15" VerticalAlignment="Top" >
                    <StackPanel>
                        <TextBlock Text="{Binding ServicePreparationLabel}" Style="{StaticResource ShopHeading}" FontSize="22"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Path Data="{StaticResource ShopIcon.Clock}" Style="{StaticResource ShopIcon}" Width="13" Height="13"/><TextBlock Text="{Binding ServiceAvailabilityLabel}" FontSize="12" Foreground="#A6C8E2" Margin="7,0,0,0"/></StackPanel>
                        <TextBlock Text="{Binding BeneficiaryLabel}" Style="{StaticResource ShopBody}" Foreground="#E9F3FF" FontSize="14" Margin="0,13,0,7"/>
                        <ComboBox x:Name="CharacterPicker" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}" ItemTemplate="{StaticResource ShopChoice}" Style="{StaticResource ShopField}" IsEnabled="{Binding HasCharacters}" AutomationProperties.Name="{Binding BeneficiaryLabel}"/>
                        <TextBlock x:Name="EligibilityTitleText" Text="{Binding EligibilityTitle}" Foreground="{Binding EligibilityColor}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock x:Name="EligibilityDescriptionText" Text="{Binding EligibilityDescription}" Style="{StaticResource ShopCaption}" FontSize="12" LineHeight="18" Margin="0,3,0,0"/>
                        <StackPanel Visibility="{Binding HasPrices, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                        <TextBlock Text="{Binding ServiceCurrencyLabel}" Style="{StaticResource ShopBody}" Foreground="#E9F3FF" FontSize="14" Margin="0,16,0,8"/>
                        <ListBox x:Name="CurrencyChoices" ItemsSource="{Binding Prices}" SelectedItem="{Binding SelectedPrice, Mode=TwoWay}" SelectionMode="Single" ItemContainerStyle="{StaticResource ServiceCurrencyChoice}"
                                 Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,-8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding ServiceCurrencyLabel}">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate><DataTemplate><StackPanel MinHeight="117">
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                    <Path Width="13" Height="14" Stroke="{Binding CurrencyColor}" StrokeThickness="1.2" Stretch="Uniform" Margin="0,0,6,0">
                                        <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{StaticResource ShopIcon.Wallet}"/><Style.Triggers><DataTrigger Binding="{Binding IsCredits}" Value="True"><Setter Property="Data" Value="{StaticResource ShopIcon.AtlasCredits}"/></DataTrigger></Style.Triggers></Style></Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding CurrencyLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding CurrencyColor}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Amount}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding CurrencyColor}" Margin="0,12,0,8" TextTrimming="CharacterEllipsis" ToolTip="{Binding Amount}"/>
                                <TextBlock Text="{Binding AvailableLabel}" Style="{StaticResource ShopCaption}" FontSize="11.5" LineHeight="16"/>
                                <TextBlock Text="{Binding BalanceStatus}" FontSize="11.5" Foreground="{Binding StatusColor}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="ServiceFundingButton" Content="{Binding ServiceFundingAction}" Style="{StaticResource ShopAction}" Foreground="{Binding SelectedCurrencyColor}" Height="40" Margin="0,10,0,0" Click="Funding_Click" IsEnabled="{Binding CanPrepareServiceFunding}" Visibility="{Binding HasServiceFundingAction, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                        <Expander x:Name="ServiceWalletHelp" Style="{StaticResource ShopWalletHelp}" Margin="0,8,0,12"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PriceLabel}" FontSize="21" FontWeight="SemiBold" Foreground="#F1DFB9" Margin="0,22,0,20">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasPrices}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </ScrollViewer>
    <Border x:Name="ServiceFooter" Grid.Row="1" Style="{StaticResource ShopPanel}" MaxWidth="1500" Margin="60,8,60,18" Padding="18,12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock Text="{Binding OfferName}" Style="{StaticResource ShopBody}" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="SummaryText" Text="{Binding SummaryCharacter}" Style="{StaticResource ShopCaption}" FontSize="12"/>
                <TextBlock Text="{Binding ServicePriceChangeText}" Style="{StaticResource ShopCaption}" FontSize="12" Foreground="#ECD096" Visibility="{Binding ShowServicePriceChange, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding TotalLabel}" Style="{StaticResource ShopCaption}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="{Binding SelectedAmount}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding SelectedCurrencyColor}"/></StackPanel>
                <TextBlock Text="{Binding SelectedCurrencyLabel}" Foreground="{Binding SelectedCurrencyColor}" FontSize="12" HorizontalAlignment="Right" Margin="0,3,0,0"/>
            </StackPanel>
            <Button x:Name="PurchaseButton" Grid.Column="2" Style="{StaticResource ShopAction}" IsEnabled="{Binding CanPurchase}" Height="44" MinWidth="190" Background="#26354C60" BorderBrush="{Binding SelectedCurrencyColor}" Foreground="{Binding SelectedCurrencyColor}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ShopIcon.Lock}" Style="{StaticResource ShopIcon}" Width="16" Height="18" Stroke="{Binding SelectedCurrencyColor}"/><TextBlock Text="{Binding PurchaseActionLabel}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
        </Grid>
    </Border>
    </Grid>
    <views:ShopConversionViewV2 x:Name="ConversionView"/>
    <views:ShopWalletViewV2 x:Name="WalletView"/>
    <views:ShopHistoryViewV2 x:Name="HistoryView"/>
    </Grid>
</UserControl>
