        <GeometryDrawing Geometry="M16,5 A11,11 0 1 1 15.99,5"><GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E5B954" Offset="0"/><GradientStop Color="#9D651C" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush><GeometryDrawing.Pen><Pen Brush="#FBE29B" Thickness="1"/></GeometryDrawing.Pen></GeometryDrawing>
