<UserControl x:Class="WotLK.Launcher.UI.V2.Views.GameViewV2"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:presentation="clr-namespace:WotLK.Launcher.UI.V2.Presentation"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="796"
             Background="Transparent"
             FontFamily="{StaticResource AtlasV2.Font.Manrope}"
             Focusable="False"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <ScrollViewer x:Name="GameScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      PanningMode="VerticalOnly">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}"
                       BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/>
            </ScrollViewer.Resources>

            <Grid x:Name="ViewportFrame"
                  Height="{Binding ViewportHeight, ElementName=GameScrollViewer}"
                  MinHeight="528">
                <Border x:Name="ContentFrame"
                        Margin="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Border x:Name="HeroCard"
                            MinHeight="520"
                            Background="#0B1016"
                            ClipToBounds="True">
                        <Grid DataContext="{Binding State, ElementName=Root}">
                            <Rectangle x:Name="HeroArtwork"
                                       Opacity="0.96"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                <Rectangle.Fill>
                                    <ImageBrush AlignmentX="Right"
                                                AlignmentY="Center"
                                                Stretch="UniformToFill">
                                        <ImageBrush.ImageSource>
                                            <BitmapImage UriSource="/WotLK.Launcher;component/Assets/Images/LichKingFrostmourneHero.jpg"
                                                         DecodePixelWidth="3840"
                                                         CacheOption="OnLoad"/>
                                        </ImageBrush.ImageSource>
                                    </ImageBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Offset="0" Color="#B8080D12"/>
                                        <GradientStop Offset="0.34" Color="#92080D12"/>
                                        <GradientStop Offset="0.64" Color="#42080D12"/>
                                        <GradientStop Offset="1" Color="#10080D12"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Offset="0" Color="#0A080D12"/>
                                        <GradientStop Offset="0.50" Color="#16080D12"/>
                                        <GradientStop Offset="0.78" Color="#B8080D12"/>
                                        <GradientStop Offset="1" Color="#F7080D12"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="HeroCopyPanel"
                                        Grid.Row="0"
                                        Padding="48,44,48,0"
                                        HorizontalAlignment="Left">
                                    <StackPanel x:Name="HeroCopyContent" MaxWidth="650">
                                        <TextBlock Text="{Binding RealmLabel}"
                                                   Style="{StaticResource AtlasV2.Text.Eyebrow}"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock x:Name="HeroTitle"
                                                   Text="{Binding Title}"
                                                   Style="{StaticResource AtlasV2.Text.Hero}"
                                                   FontSize="48"
                                                   Margin="0,0,0,7"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Style="{StaticResource AtlasV2.Text.Body}"
                                                   FontSize="18"
                                                   Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"
                                                   Margin="0,0,0,17"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="12"
                                                  Height="12"
                                                  Margin="0,0,8,0"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="{x:Type Path}">
                                                        <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Check}"/>
                                                        <Setter Property="Stroke" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
                                                        <Setter Property="Fill" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.NotInstalled}">
                                                                <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Download}"/>
                                                                <Setter Property="Stroke" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.UpdateAvailable}">
                                                                <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Refresh}"/>
                                                                <Setter Property="Stroke" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.Downloading}">
                                                                <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Download}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.Installing}">
                                                                <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Refresh}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.Verifying}">
                                                                <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Refresh}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.Error}">
                                                                <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.AlertCircle}"/>
                                                                <Setter Property="Stroke" Value="{StaticResource AtlasV2.Brush.Danger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="{Binding ClientStatus}">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}"
                                                           BasedOn="{StaticResource AtlasV2.Text.Caption}">
                                                        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SemanticTone}" Value="{x:Static presentation:GameSemanticTone.Neutral}">
                                                                <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SemanticTone}" Value="{x:Static presentation:GameSemanticTone.Accent}">
                                                                <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SemanticTone}" Value="{x:Static presentation:GameSemanticTone.Warning}">
                                                                <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SemanticTone}" Value="{x:Static presentation:GameSemanticTone.Error}">
                                                                <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Danger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid x:Name="HeroBottomBar"
                                      Grid.Row="2"
                                      Margin="48,28,48,44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0"
                                          MaxWidth="560"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Bottom">
                                        <Border Padding="16,13"
                                                Background="#D10A0F14"
                                                BorderBrush="{StaticResource AtlasV2.Brush.CyanBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Visibility="{Binding ShowsProgress, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding ProgressTitle}"
                                                               Style="{StaticResource AtlasV2.Text.Body}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                                    <TextBlock Text="{Binding ProgressPercentText}"
                                                               HorizontalAlignment="Right"
                                                               Style="{StaticResource AtlasV2.Text.Caption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                                                </Grid>
                                                <ProgressBar Margin="0,9,0,8"
                                                             Style="{StaticResource AtlasV2.Progress.Compact}"
                                                             Value="{Binding Progress}"
                                                             IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                                                <Grid>
                                                    <TextBlock Text="{Binding ProgressPrimaryDetail}"
                                                               Style="{StaticResource AtlasV2.Text.Caption}"
                                                               Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ProgressSecondaryDetail}"
                                                               Margin="18,0,0,0"
                                                               HorizontalAlignment="Right"
                                                               Style="{StaticResource AtlasV2.Text.Caption}"
                                                               Foreground="{StaticResource AtlasV2.Brush.TextMuted}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="16,13"
                                                Background="#D10A0F14"
                                                BorderBrush="{StaticResource AtlasV2.Brush.DangerBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Visibility="{Binding ShowsError, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="15"
                                                          Height="15"
                                                          Margin="0,1,8,0"
                                                          Data="{StaticResource AtlasV2.Icon.AlertCircle}"
                                                          Style="{StaticResource AtlasV2.Icon.Stroke}"
                                                          Stroke="{StaticResource AtlasV2.Brush.Danger}"/>
                                                    <TextBlock Text="{Binding ErrorTitle}"
                                                               Style="{StaticResource AtlasV2.Text.Body}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                                </StackPanel>
                                                <TextBlock Margin="23,5,0,0"
                                                           Text="{Binding ErrorSummary}"
                                                           Style="{StaticResource AtlasV2.Text.Caption}"
                                                           Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <StackPanel x:Name="HeroActionPanel"
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom">
                                        <Button x:Name="LatestPatchNoteAction"
                                                Width="52"
                                                Margin="0,0,12,0"
                                                Padding="0"
                                                Style="{StaticResource AtlasV2.Button.Secondary}"
                                                HorizontalContentAlignment="Center"
                                                IsEnabled="{Binding DashboardState.Current.CanOpenLatestPatchNote, ElementName=Root}"
                                                ToolTip="Mises à jour"
                                                AutomationProperties.Name="Mises à jour"
                                                Click="LatestPatchNoteAction_Click">
                                            <Path Width="19"
                                                  Height="19"
                                                  Data="{StaticResource AtlasV2.Icon.FileText}"
                                                  Style="{StaticResource AtlasV2.Icon.Stroke}"
                                                  Stroke="{StaticResource AtlasV2.Brush.Gold}"/>
                                        </Button>

                                        <Button x:Name="PrimaryActionButton"
                                                Width="238"
                                                Style="{StaticResource AtlasV2.Button.Primary}"
                                                IsEnabled="{Binding IsPrimaryActionEnabled}"
                                                Command="{Binding PrimaryActionCommand}"
                                                ToolTip="{Binding PrimaryActionUnavailableReason}"
                                                ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="{Binding PrimaryActionLabel}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="17"
                                                      Height="17"
                                                      Margin="0,0,9,0"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Stretch="Uniform">
                                                    <Path.Style>
                                                        <Style TargetType="{x:Type Path}">
                                                            <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Play}"/>
                                                            <Setter Property="Fill" Value="#111318"/>
                                                            <Setter Property="Stroke" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.NotInstalled}">
                                                                    <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Download}"/>
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                    <Setter Property="Stroke" Value="#111318"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.UpdateAvailable}">
                                                                    <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Refresh}"/>
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                    <Setter Property="Stroke" Value="#111318"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.Downloading}">
                                                                    <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Close}"/>
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                    <Setter Property="Stroke" Value="#111318"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.Installing}">
                                                                    <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Close}"/>
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                    <Setter Property="Stroke" Value="#111318"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.Error}">
                                                                    <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Refresh}"/>
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                    <Setter Property="Stroke" Value="#111318"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsLaunchInProgress}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Refresh}"/>
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                    <Setter Property="Stroke" Value="#111318"/>
                                                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                                 From="0"
                                                                                                 To="360"
                                                                                                 Duration="0:0:0.9"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock Text="{Binding PrimaryActionLabel}" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border x:Name="LocalNotification"
                Panel.ZIndex="20"
                MaxWidth="430"
                Margin="24"
                Padding="14,11"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{StaticResource AtlasV2.Brush.SurfaceRaised}"
                BorderThickness="1"
                CornerRadius="6"
                IsHitTestVisible="False"
                Visibility="{Binding State.ShowsNotification, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                AutomationProperties.Name="Notification locale">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.NotificationTone, ElementName=Root}" Value="{x:Static presentation:GameSemanticTone.Warning}">
                            <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State.NotificationTone, ElementName=Root}" Value="{x:Static presentation:GameSemanticTone.Error}">
                            <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Danger}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Path Width="15"
                      Height="15"
                      Margin="0,1,9,0"
                      Data="{StaticResource AtlasV2.Icon.AlertCircle}"
                      Style="{StaticResource AtlasV2.Icon.Stroke}"
                      Stroke="{Binding BorderBrush, ElementName=LocalNotification}"/>
                <TextBlock MaxWidth="370"
                           Text="{Binding State.NotificationMessage, ElementName=Root}"
                           Style="{StaticResource AtlasV2.Text.Body}"
                           Foreground="{StaticResource AtlasV2.Brush.Text}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
