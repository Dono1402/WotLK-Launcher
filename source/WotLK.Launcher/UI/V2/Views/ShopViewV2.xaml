<UserControl x:Class="WotLK.Launcher.UI.V2.Views.ShopViewV2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Focusable="False">
    <UserControl.Resources>
        <DataTemplate x:Key="ShopChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
        <Style x:Key="ShopPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.GlassSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GlassHighlight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="ShopBody" TargetType="TextBlock" BasedOn="{StaticResource AtlasV2.Text.Body}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style x:Key="ShopCaption" TargetType="TextBlock" BasedOn="{StaticResource AtlasV2.Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ShopAction" TargetType="Button" BasedOn="{StaticResource AtlasV2.Button.Secondary}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
        </Style>
        <Style x:Key="ShopProduct" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Field}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card" CornerRadius="8" Padding="22" BorderThickness="1"
                            Background="{StaticResource AtlasV2.Brush.GlassSurface}" BorderBrush="{StaticResource AtlasV2.Brush.GlassHighlight}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.CyanBorder}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Gold}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="ContentFrame" MaxWidth="1520" Margin="64,6,64,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="2" Margin="0,0,20,0" Background="{StaticResource AtlasV2.Brush.Cyan}"/>
                    <TextBlock Text="ATLAS LAUNCHER" Style="{StaticResource AtlasV2.Text.Eyebrow}" Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                </StackPanel>
                <TextBlock x:Name="PageTitle" Text="{Binding Title}" FontFamily="{StaticResource AtlasV2.Font.Inter}"
                           FontSize="48" FontWeight="ExtraBold" Foreground="{StaticResource AtlasV2.Brush.TitleIce}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource ShopBody}"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="Actualiser" Margin="18,0,0,0"
                    VerticalAlignment="Center" Style="{StaticResource ShopAction}" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click"/>
        </Grid>
        <ProgressBar Grid.Row="1" Height="3" Margin="0,12,0,0" IsIndeterminate="True"
                     Style="{StaticResource AtlasV2.Progress.Compact}"
                     Visibility="{Binding IsLoading, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
        <ScrollViewer x:Name="PageScroll" Grid.Row="2" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/>
            </ScrollViewer.Resources>
            <Grid x:Name="ShopColumns">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="CategoryColumn" Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="350"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="CategoriesPanel" Margin="0,0,22,0">
                    <TextBlock Text="CATALOGUE" Style="{StaticResource AtlasV2.Text.Eyebrow}" Margin="0,0,0,16"/>
                    <Border Padding="14" CornerRadius="6" Background="{StaticResource AtlasV2.Brush.GoldSurface}" BorderBrush="{StaticResource AtlasV2.Brush.GoldBorder}" BorderThickness="1">
                        <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource ShopBody}" Foreground="{StaticResource AtlasV2.Brush.Gold}"/>
                    </Border>
                    <TextBlock Text="{Binding Availability}" Style="{StaticResource ShopCaption}" Margin="14,18,0,0"/>
                    <Border Height="1" Background="{StaticResource AtlasV2.Brush.BorderSoft}" Margin="0,22,0,20"/>
                    <TextBlock Text="{Binding CreditsLabel}" Style="{StaticResource ShopBody}"/>
                    <TextBlock x:Name="CreditBalance" Text="{Binding CreditBalance}" FontFamily="{StaticResource AtlasV2.Font.Inter}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AtlasV2.Brush.Gold}" Margin="0,4,0,6"/>
                    <TextBlock Text="{Binding WalletDescription}" Style="{StaticResource ShopCaption}"/>
                    <Button x:Name="OpenConversionButton" Content="Convertir de l’or" Height="Auto" Padding="10,10" Margin="0,16,0,0"
                            Style="{StaticResource ShopAction}" Click="Credits_Click">
                        <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate></Button.ContentTemplate>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="CataloguePanel" Grid.Column="1" Margin="0,0,22,0">
                    <Border Style="{StaticResource ShopPanel}" Margin="0,0,0,12"
                            Visibility="{Binding ShowStatus, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                        <TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource ShopBody}"/>
                    </Border>
                    <ListBox x:Name="ProductList" ItemsSource="{Binding Offers}" SelectedItem="{Binding SelectedOffer, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource ShopProduct}"
                             AutomationProperties.Name="Produits de la boutique">
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel>
                                <Border Height="150" CornerRadius="6" Background="{StaticResource AtlasV2.Brush.CyanSurface}">
                                    <Grid>
                                        <Ellipse Width="100" Height="100" Stroke="{StaticResource AtlasV2.Brush.CyanBorder}" StrokeThickness="1"/>
                                        <Ellipse Width="124" Height="124" Stroke="{StaticResource AtlasV2.Brush.CyanBorder}" StrokeThickness="1" Opacity="0.45"/>
                                        <Path Width="48" Height="48" Data="{StaticResource AtlasV2.Icon.User}" Style="{StaticResource AtlasV2.Icon.Stroke}" Stroke="{StaticResource AtlasV2.Brush.Gold}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AtlasV2.Font.Inter}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AtlasV2.Brush.Text}" TextWrapping="Wrap" Margin="0,18,0,10"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource ShopBody}"/>
                                <Border Height="1" Background="{StaticResource AtlasV2.Brush.BorderSoft}" Margin="0,20,0,16"/>
                                <TextBlock Text="{Binding Price}" FontFamily="{StaticResource AtlasV2.Font.Inter}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.Gold}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel x:Name="DetailsPanel" Grid.Column="2">
                    <Border Style="{StaticResource ShopPanel}" Visibility="{Binding HasSelection, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="VOTRE SÉLECTION" Style="{StaticResource AtlasV2.Text.Eyebrow}" Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                            <TextBlock Text="{Binding OfferName}" FontFamily="{StaticResource AtlasV2.Font.Inter}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AtlasV2.Brush.Text}" TextWrapping="Wrap" Margin="0,12,0,14"/>
                            <TextBlock Text="Personnage bénéficiaire" Style="{StaticResource ShopBody}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="CharacterPicker" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}" ItemTemplate="{StaticResource ShopChoice}"
                                      Style="{StaticResource AtlasV2.ComboBox.Field}" IsEnabled="{Binding HasCharacters}" AutomationProperties.Name="Personnage bénéficiaire"/>
                            <TextBlock Text="{Binding CharacterHint}" Style="{StaticResource ShopCaption}" Margin="0,8,0,18"/>
                            <TextBlock Text="Moyen de paiement" Style="{StaticResource ShopBody}" Margin="0,0,0,8"/>
                            <ComboBox x:Name="CurrencyPicker" ItemsSource="{Binding Prices}" SelectedItem="{Binding SelectedPrice, Mode=TwoWay}" ItemTemplate="{StaticResource ShopChoice}"
                                      Style="{StaticResource AtlasV2.ComboBox.Field}" AutomationProperties.Name="Moyen de paiement"/>
                            <TextBlock Text="{Binding PaymentHint}" Style="{StaticResource ShopCaption}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding OfferConditions}" Style="{StaticResource ShopCaption}" Margin="0,18,0,18"/>
                            <Border Background="{StaticResource AtlasV2.Brush.CyanSurface}" CornerRadius="6" Padding="14">
                                <TextBlock x:Name="SummaryText" Text="{Binding Summary}" Style="{StaticResource ShopBody}"/>
                            </Border>
                            <Button x:Name="PurchaseButton" Content="Bientôt disponible" Style="{StaticResource AtlasV2.Button.Primary}" IsEnabled="{Binding CanPurchase}" Margin="0,18,0,10"/>
                            <TextBlock Text="{Binding PurchaseHint}" Style="{StaticResource ShopCaption}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border x:Name="CreditsPanel" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ShopPanel}" Margin="0,18,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Convertir mon or en crédit Atlas" FontFamily="{StaticResource AtlasV2.Font.Inter}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AtlasV2.Brush.Text}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CreditsInformation}" Style="{StaticResource ShopBody}" Margin="0,12,0,8"/>
                        <TextBlock Text="{Binding ConversionRate}" Style="{StaticResource ShopBody}" Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Personnage" Style="{StaticResource ShopBody}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="ConversionCharacterPicker" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}" ItemTemplate="{StaticResource ShopChoice}"
                                          Style="{StaticResource AtlasV2.ComboBox.Field}" IsEnabled="{Binding HasCharacters}" AutomationProperties.Name="Personnage dont l’or sera converti"/>
                                <TextBlock Text="Montant d’or à convertir" Style="{StaticResource ShopBody}" Margin="0,14,0,8"/>
                                <Border Style="{StaticResource AtlasV2.Field.Container}">
                                    <TextBox x:Name="ConversionAmount" Text="{Binding ConversionGold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AtlasV2.TextBox.Field}" MaxLength="12" IsEnabled="{Binding CanPreviewConversion}" AutomationProperties.Name="Montant d’or à convertir"/>
                                </Border>
                            </StackPanel>
                            <Border Grid.Column="1" Padding="18" CornerRadius="6" Background="{StaticResource AtlasV2.Brush.CyanSurface}">
                                <StackPanel>
                                    <TextBlock Text="Crédit Atlas obtenu" Style="{StaticResource ShopBody}"/>
                                    <TextBlock x:Name="ConversionCreditText" Text="{Binding ConversionCredit}" FontFamily="{StaticResource AtlasV2.Font.Inter}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AtlasV2.Brush.Gold}" Margin="0,4,0,16"/>
                                    <TextBlock Text="Or débité" Style="{StaticResource ShopCaption}"/>
                                    <TextBlock Text="{Binding ConversionDebit}" Style="{StaticResource ShopBody}" Margin="0,2,0,10"/>
                                    <TextBlock Text="Reste conservé" Style="{StaticResource ShopCaption}"/>
                                    <TextBlock Text="{Binding ConversionRemainder}" Style="{StaticResource ShopBody}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding ConversionHint}" Style="{StaticResource ShopCaption}" Margin="0,14,0,16"/>
                        <Button x:Name="ConvertButton" Content="Conversion bientôt disponible" Style="{StaticResource AtlasV2.Button.Primary}" IsEnabled="{Binding CanConvert}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
