<UserControl x:Class="WotLK.Launcher.UI.V2.Views.FriendsDrawerV2"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WotLK.Launcher.UI.V2.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="796"
             Background="Transparent"
             Visibility="Collapsed"
             IsHitTestVisible="False"
             Focusable="False"
             PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <DataTemplate x:Key="AtlasV2.Friends.Avatar">
            <Grid Width="38" Height="38">
                <Ellipse Fill="{Binding AvatarColor}"/>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding Initial}"
                           FontFamily="{StaticResource AtlasV2.Font.Manrope}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#111318"/>
                <Ellipse AutomationProperties.Name="Photo de profil Atlas">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding AvatarImage}"
                                    Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                    <Ellipse.Style>
                        <Style TargetType="{x:Type Ellipse}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Ellipse StrokeThickness="1">
                    <Ellipse.Style>
                        <Style TargetType="{x:Type Ellipse}">
                            <Setter Property="Stroke" Value="{StaticResource AtlasV2.Brush.Border}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                                    <Setter Property="Opacity" Value="0.82"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AtlasV2.Friends.ProfileAvatar">
            <Grid Width="82" Height="82">
                <Ellipse Fill="{Binding AvatarColor}"/>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding Initial}"
                           FontSize="27"
                           FontWeight="ExtraBold"
                           Foreground="#111318"/>
                <Ellipse>
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                    <Ellipse.Style>
                        <Style TargetType="{x:Type Ellipse}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Ellipse Stroke="{StaticResource AtlasV2.Brush.GoldBorder}" StrokeThickness="2"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AtlasV2.Friends.CharacterItem">
            <Border MinHeight="66"
                    Margin="0,0,0,7"
                    Padding="11,9"
                    Background="{StaticResource AtlasV2.Brush.SurfaceRaised}"
                    BorderBrush="{StaticResource AtlasV2.Brush.BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource AtlasV2.Text.Body}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding Details}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding PresenceText}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource AtlasV2.Text.Caption}"/>
                    </StackPanel>
                    <Ellipse Grid.Column="1"
                             Width="8"
                             Height="8"
                             Margin="10,5,1,0"
                             VerticalAlignment="Top">
                        <Ellipse.Style>
                            <Style TargetType="{x:Type Ellipse}">
                                <Setter Property="Fill" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AtlasV2.Brush.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AtlasV2.Friends.IncomingItem">
            <Border MinHeight="78"
                    Margin="0,0,0,7"
                    Padding="10"
                    Background="{StaticResource AtlasV2.Brush.SurfaceRaised}"
                    BorderBrush="{StaticResource AtlasV2.Brush.BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource AtlasV2.Friends.Avatar}"/>
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Username}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource AtlasV2.Text.Body}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        <TextBlock Grid.Row="1"
                                   Margin="0,2,0,7"
                                   Text="Demande reçue"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button MinWidth="82"
                                    Height="32"
                                    Padding="10,0"
                                    Style="{StaticResource AtlasV2.Button.GhostCompact}"
                                    Command="{Binding State.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType={x:Type views:FriendsDrawerV2}}}"
                                    CommandParameter="{Binding AccountId}"
                                    AutomationProperties.Name="Accepter la demande"
                                    Content="Accepter"/>
                            <Button Width="32"
                                    Height="32"
                                    Margin="6,0,0,0"
                                    Padding="8"
                                    Style="{StaticResource AtlasV2.Button.Icon}"
                                    Command="{Binding State.RejectRequestCommand, RelativeSource={RelativeSource AncestorType={x:Type views:FriendsDrawerV2}}}"
                                    CommandParameter="{Binding AccountId}"
                                    ToolTip="Refuser"
                                    AutomationProperties.Name="Refuser la demande">
                                <Path Data="{StaticResource AtlasV2.Icon.Close}"
                                      Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AtlasV2.Friends.OutgoingItem">
            <Border MinHeight="64"
                    Margin="0,0,0,7"
                    Padding="10"
                    Background="{StaticResource AtlasV2.Brush.SurfaceRaised}"
                    BorderBrush="{StaticResource AtlasV2.Brush.BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource AtlasV2.Friends.Avatar}"/>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Username}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource AtlasV2.Text.Body}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        <TextBlock Margin="0,2,0,0"
                                   Text="En attente"
                                   Style="{StaticResource AtlasV2.Text.Caption}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Height="32"
                            Padding="9,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource AtlasV2.Button.GhostCompact}"
                            Command="{Binding State.CancelRequestCommand, RelativeSource={RelativeSource AncestorType={x:Type views:FriendsDrawerV2}}}"
                            CommandParameter="{Binding AccountId}"
                            Content="Annuler"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AtlasV2.Friends.FriendItem">
            <Border MinHeight="66"
                    Margin="0,0,0,7"
                    Padding="9"
                    Background="{StaticResource AtlasV2.Brush.SurfaceRaised}"
                    BorderBrush="{StaticResource AtlasV2.Brush.BorderSoft}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Cursor="Hand"
                    ToolTip="Voir le profil"
                    MouseLeftButtonUp="FriendItem_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource AtlasV2.Friends.Avatar}"/>
                        <Ellipse Width="9"
                                 Height="9"
                                 Margin="0,0,-1,-1"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Stroke="{StaticResource AtlasV2.Brush.SurfaceRaised}"
                                 StrokeThickness="2">
                            <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                    <Setter Property="Fill" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AtlasV2.Brush.Success}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Username}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource AtlasV2.Text.Body}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding CharacterSummary}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasCharacter, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding PresenceText}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource AtlasV2.Text.Caption}">
                                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Success}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="FriendActionsButton"
                                Width="32"
                                Height="32"
                                Padding="6"
                                IsEnabled="{Binding CanRemove}"
                                Tag="{Binding ElementName=FriendActionsPopup}"
                                Click="FriendActionsButton_Click"
                                ToolTip="Actions"
                                AutomationProperties.Name="Actions pour cet ami">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource AtlasV2.Button.Icon}">
                                    <Setter Property="Opacity" Value="0.92"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Width="20"
                                  Height="8"
                                  Data="{StaticResource AtlasV2.Icon.MoreHorizontal}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"
                                  Fill="{StaticResource AtlasV2.Brush.Text}"
                                  StrokeThickness="0"/>
                        </Button>
                        <Popup x:Name="FriendActionsPopup"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                               PlacementTarget="{Binding ElementName=FriendActionsButton}"
                               Placement="Bottom"
                               HorizontalOffset="-128"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               StaysOpen="False">
                            <Button Width="174"
                                    Height="40"
                                    Margin="0,4,0,0"
                                    Padding="12,0"
                                    HorizontalContentAlignment="Left"
                                    Click="RemoveFriendMenuItem_Click"
                                    AutomationProperties.Name="Retirer de mes amis">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}"
                                           BasedOn="{StaticResource AtlasV2.Button.GhostCompact}">
                                        <Setter Property="Background" Value="#FF171E26"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Border}"/>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="15"
                                          Height="15"
                                          Margin="0,0,8,0"
                                          Data="{StaticResource AtlasV2.Icon.Trash}"
                                          Style="{StaticResource AtlasV2.Icon.Stroke}"
                                          Stroke="{StaticResource AtlasV2.Brush.Danger}"/>
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Retirer de mes amis"
                                               Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                </StackPanel>
                            </Button>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="OverlayRoot">
        <Border x:Name="Scrim"
                Background="{StaticResource AtlasV2.Brush.Scrim}"
                Opacity="0"
                IsHitTestVisible="False"
                MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>

        <Border x:Name="DrawerPanel"
                Width="360"
                Margin="0,10,10,10"
                Padding="18"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="#FC141A20"
                BorderBrush="{StaticResource AtlasV2.Brush.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Opacity="0"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Contained">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTranslate" X="376"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="AMIS ATLAS"
                                   Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                        <TextBlock Margin="0,4,0,0"
                                   Text="Mes amis"
                                   Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                   FontSize="24"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                        <Button x:Name="AddFriendToggleButton"
                                Width="38"
                                Height="38"
                                Padding="10"
                                Margin="0,0,4,0"
                                Style="{StaticResource AtlasV2.Button.Icon}"
                                ToolTip="Ajouter un ami"
                                AutomationProperties.Name="Ajouter un ami"
                                Click="AddFriendToggleButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.Plus}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                        <Button x:Name="CloseButton"
                                Width="38"
                                Height="38"
                                Padding="10"
                                Style="{StaticResource AtlasV2.Button.Icon}"
                                ToolTip="Fermer"
                                AutomationProperties.Name="Fermer le panneau Amis"
                                Click="CloseButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.Close}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="FriendsSummaryText"
                           Grid.Row="1"
                           Margin="0,18,0,12"
                           Text="{Binding State.Current.FriendsSummary, ElementName=Root, Mode=OneWay}"
                           Style="{StaticResource AtlasV2.Text.Caption}"/>

                <Border x:Name="AddFriendPanel"
                        Grid.Row="2"
                        MaxHeight="0"
                        Opacity="0"
                        IsHitTestVisible="False"
                        ClipToBounds="True">
                    <StackPanel Margin="0,0,0,12">
                    <TextBlock Margin="0,0,0,6"
                               Text="Pseudo Atlas"
                               Style="{StaticResource AtlasV2.Text.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                    <Border Height="42"
                            Background="{StaticResource AtlasV2.Brush.Field}"
                            BorderBrush="{StaticResource AtlasV2.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                             <TextBox x:Name="FriendSearchBox"
                                     Margin="12,0,6,0"
                                     MaxLength="32"
                                     Text="{Binding State.SearchText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AtlasV2.TextBox.Field}"
                                     AutomationProperties.Name="Nom d’utilisateur Atlas"
                                     KeyDown="FriendSearchBox_KeyDown"/>
                            <Button x:Name="SendFriendRequestButton"
                                    Grid.Column="1"
                                    Width="38"
                                    Height="38"
                                    Padding="10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AtlasV2.Button.Icon}"
                                    Command="{Binding State.SendRequestCommand, ElementName=Root}"
                                    ToolTip="Envoyer la demande"
                                    AutomationProperties.Name="Envoyer la demande d’ami">
                                <Path Data="{StaticResource AtlasV2.Icon.ArrowRight}"
                                      Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                            </Button>
                        </Grid>
                    </Border>
                    </StackPanel>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="AddFriendTranslate" Y="-5"/>
                    </Border.RenderTransform>
                </Border>

                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <ProgressBar x:Name="FriendsBusyProgress"
                                 Margin="0,0,0,8"
                                 IsIndeterminate="True"
                                 Visibility="{Binding State.Current.IsLoading, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                 Style="{StaticResource AtlasV2.Progress.Compact}"/>
                    <Border Margin="0,0,0,7"
                            Style="{StaticResource AtlasV2.Banner.Error}"
                            Visibility="{Binding State.Current.ShowsError, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                        <TextBlock Text="{Binding State.Current.ErrorMessage, ElementName=Root}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   Foreground="{StaticResource AtlasV2.Brush.Danger}"/>
                    </Border>
                    <Border Margin="0,0,0,7"
                            Padding="12,9"
                            Background="{StaticResource AtlasV2.Brush.SuccessSurface}"
                            BorderBrush="{StaticResource AtlasV2.Brush.SuccessBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding State.Current.ShowsNotice, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                        <TextBlock Text="{Binding State.Current.NoticeMessage, ElementName=Root}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   Foreground="{StaticResource AtlasV2.Brush.Success}"/>
                    </Border>
                    <TextBlock Text="{Binding State.Current.StatusMessage, ElementName=Root}"
                               TextWrapping="Wrap"
                               Style="{StaticResource AtlasV2.Text.Caption}"/>
                </StackPanel>

                <ScrollViewer x:Name="FriendsScrollViewer"
                              Grid.Row="4"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="0,0,5,0">
                        <StackPanel x:Name="IncomingRequestsSection"
                                    Margin="0,2,0,12"
                                    Visibility="{Binding State.Current.HasIncomingRequests, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                            <TextBlock Margin="0,0,0,7"
                                       Text="DEMANDES REÇUES"
                                       Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                            <ItemsControl ItemsSource="{Binding State.Current.IncomingRequests, ElementName=Root}"
                                          ItemTemplate="{StaticResource AtlasV2.Friends.IncomingItem}"/>
                        </StackPanel>

                        <StackPanel x:Name="OutgoingRequestsSection"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding State.Current.HasOutgoingRequests, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                            <TextBlock Margin="0,0,0,7"
                                       Text="DEMANDES ENVOYÉES"
                                       Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                            <ItemsControl ItemsSource="{Binding State.Current.OutgoingRequests, ElementName=Root}"
                                          ItemTemplate="{StaticResource AtlasV2.Friends.OutgoingItem}"/>
                        </StackPanel>

                        <StackPanel x:Name="OnlineFriendsSection"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding State.Current.HasOnlineFriends, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                            <TextBlock Margin="0,0,0,7"
                                       Text="EN JEU"
                                       Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                            <ItemsControl x:Name="OnlineFriendsItemsControl"
                                          ItemsSource="{Binding State.Current.OnlineFriends, ElementName=Root}"
                                          ItemTemplate="{StaticResource AtlasV2.Friends.FriendItem}"/>
                        </StackPanel>

                        <StackPanel x:Name="OfflineFriendsSection"
                                    Visibility="{Binding State.Current.HasOfflineFriends, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                            <TextBlock Margin="0,0,0,7"
                                       Text="HORS LIGNE"
                                       Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                            <ItemsControl x:Name="OfflineFriendsItemsControl"
                                          ItemsSource="{Binding State.Current.OfflineFriends, ElementName=Root}"
                                          ItemTemplate="{StaticResource AtlasV2.Friends.FriendItem}"/>
                        </StackPanel>

                        <StackPanel x:Name="FriendsEmptyState"
                                    Margin="12,42"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding State.Current.ShowsGlobalEmpty, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                            <Path Width="28"
                                  Height="28"
                                  Margin="0,0,0,10"
                                  Data="{StaticResource AtlasV2.Icon.Users}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"
                                  Stroke="{StaticResource AtlasV2.Brush.TextMuted}"/>
                            <TextBlock HorizontalAlignment="Center"
                                       Text="Aucun ami pour le moment"
                                       Style="{StaticResource AtlasV2.Text.Body}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="FriendProfilePanel"
                      Grid.RowSpan="5"
                      Panel.ZIndex="10"
                      Background="#FF141A20">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsFriendProfileOpen, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <Button x:Name="BackToFriendsButton"
                                Width="38"
                                Height="38"
                                Padding="10"
                                HorizontalAlignment="Left"
                                Style="{StaticResource AtlasV2.Button.Icon}"
                                ToolTip="Retour à la liste"
                                AutomationProperties.Name="Retour à la liste d’amis"
                                Click="BackToFriendsButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.ArrowLeft}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                        <TextBlock Margin="48,0"
                                   VerticalAlignment="Center"
                                   Text="Profil"
                                   Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                   FontSize="20"/>
                        <Button Width="38"
                                Height="38"
                                Padding="10"
                                HorizontalAlignment="Right"
                                Style="{StaticResource AtlasV2.Button.Icon}"
                                ToolTip="Fermer"
                                AutomationProperties.Name="Fermer le panneau Amis"
                                Click="CloseButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.Close}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,5,0"
                                    DataContext="{Binding State.SelectedFriend, ElementName=Root}">
                            <ContentControl HorizontalAlignment="Center"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource AtlasV2.Friends.ProfileAvatar}"/>
                            <TextBlock Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       Text="{Binding Username}"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                       FontSize="22"/>
                            <TextBlock Margin="12,4"
                                       HorizontalAlignment="Center"
                                       Text="{Binding DisplayStatusMessage}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource AtlasV2.Text.Body}"
                                       Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                            <TextBlock Margin="0,2,0,0"
                                       HorizontalAlignment="Center"
                                       Text="{Binding PresenceText}"
                                       >
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.Caption}">
                                        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Height="1" Margin="0,18" Background="{StaticResource AtlasV2.Brush.BorderSoft}"/>
                            <TextBlock Text="BIO" Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                            <TextBlock Margin="0,7,0,0"
                                       Text="{Binding DisplayBio}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource AtlasV2.Text.Body}"/>

                            <StackPanel Margin="0,20,0,0"
                                        Visibility="{Binding HasCharacter, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                <TextBlock Margin="0,0,0,7"
                                           Text="PERSONNAGE ACTIF"
                                           Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                                <Border Padding="12,10"
                                        Background="{StaticResource AtlasV2.Brush.CyanSurface}"
                                        BorderBrush="{StaticResource AtlasV2.Brush.CyanBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CharacterName}"
                                                   Style="{StaticResource AtlasV2.Text.Body}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="{Binding CharacterDetails}"
                                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                                   Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="{Binding CharacterZone}"
                                                   Visibility="{Binding HasCharacterZone, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                                   Style="{StaticResource AtlasV2.Text.Caption}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,20,0,0"
                                        Visibility="{Binding HasCharacters, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                <TextBlock Margin="0,0,0,7"
                                           Text="PERSONNAGES"
                                           Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                                <ItemsControl ItemsSource="{Binding AllCharacters}"
                                              ItemTemplate="{StaticResource AtlasV2.Friends.CharacterItem}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
