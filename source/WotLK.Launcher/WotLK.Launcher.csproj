<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Product>Atlas Launcher</Product>
    <AssemblyTitle>Atlas Launcher</AssemblyTitle>
    <Company>AnimeClub</Company>
    <Description>Launcher officiel du royaume Arthas pour WotLK Classic</Description>
    <Copyright>Copyright © 2026 AnimeClub</Copyright>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <InformationalVersion>1.4.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ArmoryPayloadPath Condition="'$(ArmoryPayloadPath)' == ''">$(MSBuildProjectDirectory)\Assets\Armory\armory-runtime.zip</ArmoryPayloadPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AtlasLocalClientBuild)' == 'true'">
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <DefineConstants>$(DefineConstants);ATLAS_LOCAL_CLIENT</DefineConstants>
    <InformationalVersion>$(Version)-local</InformationalVersion>
  </PropertyGroup>


  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <None Remove="Assets\Fonts\**\*" />
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\*.txt" />
    <Resource Include="Assets\Branding\*.png" />
    <Resource Include="Assets\Images\*.png" />
    <Resource Include="Assets\Images\*.jpg" />
    <Resource Include="Assets\Launcher\visuals\*.png" />
    <Resource Include="Assets\Launcher\addon-icons\*.png" />
    <Resource Include="Assets\Launcher\class-icons\*.jpg" />
    <EmbeddedResource Include="Assets\Security\launcher-update-public-keys.json" />
    <EmbeddedResource Include="$(ArmoryPayloadPath)" LogicalName="Atlas.Armory.Runtime.zip"
                      Condition="Exists('$(ArmoryPayloadPath)')" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Assets\Launcher\ExactSkin\docs\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
  </ItemGroup>

  <Target Name="RequirePublicArmoryRuntime" BeforeTargets="Publish" Condition="'$(AtlasLocalClientBuild)' != 'true'">
    <Error Condition="!Exists('$(ArmoryPayloadPath)')"
           Text="Le paquet public doit embarquer l'armurerie. Exécutez scripts/build-public-client.ps1." />
  </Target>
</Project>
