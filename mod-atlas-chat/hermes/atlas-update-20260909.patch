@@ -0,0 +1,23 @@
+using System;
+using HermesProxy.Configuration.Options;
+using HermesProxy.Enums;
+using HermesProxy.World.Server.Packets;
+
+namespace HermesProxy.World.Client;
+
+public partial class WorldClient
+{
+    internal static void ApplyDeathKnightCreationLevelPolicy(
+        EnumCharactersResult result, ClientOptions options,
+        ClientVersionBuild modernBuild, ClientVersionBuild legacyBuild)
+    {
+        if (!options.RequireDeathKnightLevel
+            && modernBuild == ClientVersionBuild.V3_4_3_54261
+            && legacyBuild == ClientVersionBuild.V3_3_5a_12340)
+        {
+            // The client gates DK creation using this account-level header. Individual
+            // character levels and cached character data must remain untouched.
+            result.MaxCharacterLevel = Math.Max(55, result.MaxCharacterLevel);
+        }
+    }
+}
