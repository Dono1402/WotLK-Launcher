+    std::unordered_set<uint32> realGuildBots;
+}
+
 void PrintStatsThread() { sRandomPlayerbotMgr.PrintStats(); }
 
 void activatePrintStatsThread()
@@ -311,7 +318,9 @@ void RandomPlayerbotMgr::UpdateAIInternal(uint32 /*elapsed*/, bool /*minimal*/)
     GetBots();
     // Copied deliberately: ProcessBot() erases from currentBots while this is
     // being iterated below, so the loops must run over a snapshot.
-    std::unordered_set<uint32> availableBots = currentBots;
+    std::vector<uint32> availableBots(currentBots.begin(), currentBots.end());
+    std::stable_partition(availableBots.begin(), availableBots.end(),
+        [](uint32 bot) { return realGuildBots.contains(bot); });
     uint32 availableBotCount = availableBots.size();
     uint32 onlineBotCount = playerBots.size();
 
@@ -1777,6 +1786,69 @@ void RandomPlayerbotMgr::Init()
     PlayerbotsDatabasePreparedStatement* stmt = PlayerbotsDatabase.GetPreparedStatement(PLAYERBOTS_DEL_RANDOM_BOTS_BY_EVENT);
     stmt->SetData(0, std::string("add"));
     PlayerbotsDatabase.Execute(stmt);
+    eventCache.clear();
+    currentBots.clear();
+    realGuildBots.clear();
+
+    if (!sPlayerbotAIConfig.randomBotAutologin ||
+        !sConfigMgr->GetOption<bool>("AiPlayerbot.RealGuildBotAutologin", false))
+        return;
+
+    uint32 maxAllowedBotCount = GetEventValue(0, "bot_count");
+    if (!maxAllowedBotCount || maxAllowedBotCount < sPlayerbotAIConfig.minRandomBots ||
+        maxAllowedBotCount > sPlayerbotAIConfig.maxRandomBots)
+    {
+        maxAllowedBotCount = urand(sPlayerbotAIConfig.minRandomBots, sPlayerbotAIConfig.maxRandomBots);
+        SetEventValue(0, "bot_count", maxAllowedBotCount,
+            urand(sPlayerbotAIConfig.randomBotCountChangeMinInterval,
+                sPlayerbotAIConfig.randomBotCountChangeMaxInterval));
+    }
+
+    if (!maxAllowedBotCount)
+        return;
+
+    std::unordered_set<uint32> randomBotAccounts(rndBotTypeAccounts.begin(), rndBotTypeAccounts.end());
+
+    QueryResult result = CharacterDatabase.Query(
+        "SELECT gm.guid, gm.guildid, c.account "
+        "FROM guild_member gm "
+        "INNER JOIN characters c ON c.guid = gm.guid "
+        "ORDER BY gm.guildid, gm.guid");
+
+    if (!result)
+    {
+        LOG_INFO("playerbots", "No guild members found while reserving real-guild randombots");
+        return;
+    }
+
+    do
+    {
+        Field* fields = result->Fetch();
+        uint32 bot = fields[0].Get<uint32>();
+        uint32 guildId = fields[1].Get<uint32>();
+        uint32 accountId = fields[2].Get<uint32>();
+
+        if (!PlayerbotGuildMgr::instance().IsRealGuild(guildId) || !randomBotAccounts.contains(accountId))
+            continue;
+
+        if (realGuildBots.size() >= maxAllowedBotCount)
+        {
+            LOG_WARN("playerbots",
+                "Real-guild randombot reservation reached the active bot count ({}); remaining guild bots cannot be pinned",
+                maxAllowedBotCount);
+            break;
+        }
+
+        // Load every existing event for this bot before create-on-write updates the cache.
+        GetEventValue(bot, "add");
+        SetEventValue(bot, "add", 1, 0);
+        SetEventValue(bot, "logout", 0, 0);
+        currentBots.insert(bot);
+        realGuildBots.insert(bot);
+    } while (result->NextRow());
+
+    LOG_INFO("playerbots", "Reserved {} randombots from guilds led by real players for priority login",
+        realGuildBots.size());
 }
 
