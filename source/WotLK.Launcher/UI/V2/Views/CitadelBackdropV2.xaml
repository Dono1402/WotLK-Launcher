<UserControl x:Class="WotLK.Launcher.UI.V2.Views.CitadelBackdropV2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsHitTestVisible="False" ClipToBounds="True"
             Background="#04101A">
    <UserControl.Resources>
        <BitmapImage x:Key="CitadelArtwork" UriSource="/WotLK.Launcher;component/Assets/Launcher/visuals/icecrown-citadel.png" CacheOption="OnLoad"/>
    </UserControl.Resources>
    <Grid>
        <!-- Reuse the existing artwork. The soft layer is decorative; controls are siblings above it. -->
        <Grid Margin="-8" IsHitTestVisible="False">
            <Grid.Effect><BlurEffect Radius="5" RenderingBias="Performance"/></Grid.Effect>
            <Rectangle Opacity="0.7" RenderOptions.BitmapScalingMode="HighQuality">
                <Rectangle.Fill><ImageBrush ImageSource="{StaticResource CitadelArtwork}" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Top"/></Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="CitadelFocus" HorizontalAlignment="Right" RenderOptions.BitmapScalingMode="HighQuality">
                <Rectangle.OpacityMask><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="0.3"/>
                </LinearGradientBrush></Rectangle.OpacityMask>
                <Rectangle.Fill><ImageBrush ImageSource="{StaticResource CitadelArtwork}" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Top"/></Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Rectangle>
            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#F2020B12" Offset="0"/>
                <GradientStop Color="#D2020D17" Offset="0.28"/>
                <GradientStop Color="#4813283A" Offset="0.68"/>
                <GradientStop Color="#38112B41" Offset="1"/>
            </LinearGradientBrush></Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#32040E19" Offset="0"/>
                <GradientStop Color="#00020C16" Offset="0.3"/>
                <GradientStop Color="#10030B13" Offset="0.65"/>
                <GradientStop Color="#C2020910" Offset="1"/>
            </LinearGradientBrush></Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
