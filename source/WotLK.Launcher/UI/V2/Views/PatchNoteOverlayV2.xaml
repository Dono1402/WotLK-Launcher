<UserControl x:Class="WotLK.Launcher.UI.V2.Views.PatchNoteOverlayV2"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WotLK.Launcher.UI.V2.Views"
             Visibility="Collapsed"
             IsHitTestVisible="False"
             Focusable="False"
             PreviewKeyDown="Root_PreviewKeyDown">
    <Grid>
        <Border x:Name="Scrim"
                Background="#A805080B"
                Opacity="0"
                IsHitTestVisible="False"
                MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>

        <Border x:Name="DialogCard"
                Width="680"
                MaxWidth="680"
                MaxHeight="560"
                Margin="24,18"
                Padding="26,22,26,26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource AtlasV2.Brush.SurfaceRaised}"
                BorderBrush="{StaticResource AtlasV2.Brush.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Opacity="0"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Contained"
                AutomationProperties.Name="Note de mise à jour Atlas Launcher">
            <Border.RenderTransform>
                <ScaleTransform x:Name="DialogScale" ScaleX="0.985" ScaleY="0.985"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  ShadowDepth="8"
                                  Opacity="0.42"
                                  Color="#000000"/>
            </Border.Effect>

            <Grid DataContext="{Binding State.Current, RelativeSource={RelativeSource AncestorType={x:Type views:PatchNoteOverlayV2}}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock VerticalAlignment="Center"
                               Text="NOTE DE MISE À JOUR"
                               Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                    <Button x:Name="CloseButton"
                            Width="38"
                            Height="38"
                            Padding="10"
                            HorizontalAlignment="Right"
                            Style="{StaticResource AtlasV2.Button.Icon}"
                            ToolTip="Fermer"
                            KeyboardNavigation.TabIndex="0"
                            AutomationProperties.Name="Fermer la note de mise à jour"
                            Click="CloseButton_Click">
                        <Path Data="{StaticResource AtlasV2.Icon.Close}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                    </Button>
                </Grid>

                <TextBlock x:Name="PatchNoteTitleText"
                           Grid.Row="1"
                           Margin="0,12,46,0"
                           Text="{Binding LatestPatchNoteTitle}"
                           TextWrapping="Wrap"
                           Style="{StaticResource AtlasV2.Text.SectionTitle}"
                           FontSize="27"
                           FontWeight="ExtraBold"/>

                <StackPanel Grid.Row="2"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                    <Border Padding="9,4"
                            Background="{StaticResource AtlasV2.Brush.CyanSurface}"
                            BorderBrush="{StaticResource AtlasV2.Brush.CyanBorder}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock x:Name="PatchNoteVersionText"
                                   Text="{Binding LatestPatchNoteVersion}"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                    </Border>
                    <TextBlock x:Name="PatchNoteDateText"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding LatestPatchNoteMetaText}"
                               Style="{StaticResource AtlasV2.Text.Caption}"
                               Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                </StackPanel>

                <ScrollViewer x:Name="BodyScrollViewer"
                              Grid.Row="3"
                              Margin="0,18,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/>
                    </ScrollViewer.Resources>
                    <TextBlock x:Name="PatchNoteBodyText"
                               Margin="0,0,8,0"
                               Text="{Binding LatestPatchNoteSummary}"
                               TextWrapping="Wrap"
                               Style="{StaticResource AtlasV2.Text.Body}"
                               FontSize="14"
                               LineHeight="22"
                               Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
