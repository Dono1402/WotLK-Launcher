diff --git a/HermesProxy.Tests/World/Server/AtlasAccountServiceBridgeTests.cs b/HermesProxy.Tests/World/Server/AtlasAccountServiceBridgeTests.cs
new file mode 100644
index 0000000..5500cdc
--- /dev/null
+++ b/HermesProxy.Tests/World/Server/AtlasAccountServiceBridgeTests.cs
@@ -0,0 +1,179 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using HermesProxy.World;
+using HermesProxy.World.Server;
+using HermesProxy.World.Server.Packets;
+using Xunit;
+
+namespace HermesProxy.Tests.World.Server;
+
+public class AtlasAccountServiceBridgeTests
+{
+    static readonly WowGuid128 Account = new(51, 29ul << 58);
+    static readonly WowGuid128 Character = new(981, 2ul << 58);
+    const uint Realm = 1;
+
+    [Fact]
+    public void ListUpdate_RevokesCancelledServicesInsteadOfLeavingThemInTheClientCache()
+    {
+        var bridge = new AtlasAccountServiceBridge();
+        using var request = bridge.Subscribe(1000)!;
+        Assert.Null(bridge.Subscribe(1100));
+        var initial = List(bridge, request, 10, 11);
+        Assert.True(bridge.Ready);
+        Assert.Equal(2, Assert.IsType<AtlasDistributionList>(Assert.Single(initial.Packets)).Distributions.Count);
+        var updated = List(bridge, request, 11, 12);
+        var revoked = Assert.IsType<AtlasDistributionUpdate>(updated.Packets[0]).Distribution;
+        Assert.Equal(10ul, revoked.Id); Assert.True(revoked.Revoked);
+        Assert.Equal(new ulong[] { 11, 12 }, Assert.IsType<AtlasDistributionList>(updated.Packets[1]).Distributions.Select(x => x.Id));
+        var empty = List(bridge, request);
+        Assert.Equal(3, empty.Packets.Count);
+        Assert.All(empty.Packets.Take(2), p => Assert.True(Assert.IsType<AtlasDistributionUpdate>(p).Distribution.Revoked));
+    }
+
+    [Fact]
+    public void Assignment_ValidatesBeforeConsuming_AndReturnsTheAuthoritativeNormalizedName()
+    {
+        var bridge = new AtlasAccountServiceBridge();
+        using var list = bridge.Subscribe(1000)!;
+        List(bridge, list, 10);
+        using var native = Request(true);
+        using var validation = bridge.Assign(native, true, Realm, false, 1100)!;
+        Assert.NotNull(validation);
+        Assert.Null(bridge.Assign(native, true, Realm, false, 1200));
+        var validated = Reply(bridge, validation, "Nativeproof");
+        Assert.Null(validated.ChangedName);
+        Assert.Equal(73u, Assert.IsType<AtlasAssignVasResponse>(Assert.Single(validated.Packets)).Token);
+        native.ValidateOnly = false;
+        using var confirmation = bridge.Assign(native, true, Realm, false, 1300)!;
+        var consumed = Reply(bridge, confirmation, "Nativeproof");
+        Assert.Equal(Character, consumed.ChangedCharacter);
+        Assert.Equal("Nativeproof", consumed.ChangedName);
+        var distribution = Assert.IsType<AtlasDistributionUpdate>(consumed.Packets[0]).Distribution;
+        Assert.Equal(3u, distribution.Status); Assert.Equal(Character, distribution.Character);
+        Assert.Equal(0u, Assert.IsType<AtlasAssignVasResponse>(consumed.Packets[1]).StoreError);
+        Assert.Empty(Reply(bridge, confirmation, "Nativeproof").Packets); // Duplicate server response.
+        // The core, which retains receipts, decides whether a consumed ID is an
+        // idempotent retry. A missing local distribution is not authority to debit.
+        Assert.NotNull(bridge.Assign(native, true, Realm, false, 1400));
+    }
+
+    [Fact]
+    public void UnavailableForeignRealmAndInWorldAssignments_AreRejected()
+    {
+        var bridge = new AtlasAccountServiceBridge();
+        using var native = Request(false);
+        Assert.Null(bridge.Assign(native, true, Realm, false, 1000));
+        using var list = bridge.Subscribe(1000)!;
+        List(bridge, list, 10);
+        Assert.Null(bridge.Assign(native, false, Realm, false, 1100));
+        Assert.Null(bridge.Assign(native, true, Realm + 1, false, 1100));
+        Assert.Null(bridge.Assign(native, true, Realm, true, 1100));
+        native.IsSupportedNameChange = false;
+        Assert.Null(bridge.Assign(native, true, Realm, false, 1100));
+    }
+
+    [Fact]
+    public void OldConnectionReplies_CannotAffectAReconnectedAccount()
+    {
+        var bridge = new AtlasAccountServiceBridge();
+        using var old = bridge.Subscribe(1000)!;
+        List(bridge, old, 10);
+        bridge.Reset();
+        Assert.False(bridge.Ready);
+        using var current = bridge.Subscribe(1001)!;
+        Assert.Empty(List(bridge, old, 42).Packets);
+        Assert.False(bridge.Ready);
+        var refreshed = List(bridge, current);
+        Assert.True(Assert.IsType<AtlasDistributionUpdate>(refreshed.Packets[0]).Distribution.Revoked);
+        Assert.True(bridge.Ready);
+    }
+
+    [Fact]
+    public void ForeignOrMalformedReplies_DoNotConsumeThePendingConfirmation()
+    {
+        var bridge = new AtlasAccountServiceBridge();
+        using var list = bridge.Subscribe(1000)!;
+        List(bridge, list, 10);
+        using var native = Request(false);
+        using var request = bridge.Assign(native, true, Realm, false, 1100)!;
+        byte[] body = AssignmentResponse(request, "Nativeproof");
+        for (int length = 5; length < body.Length; ++length)
+        {
+            using var truncated = new WorldPacket(1, body[..length]);
+            var result = bridge.Receive(truncated, Account, Realm);
+            Assert.True(result.Handled); Assert.Empty(result.Packets);
+        }
+        byte[] wrongGuid = (byte[])body.Clone(); wrongGuid[28] ^= 1;
+        using var foreign = new WorldPacket(1, wrongGuid);
+        Assert.Empty(bridge.Receive(foreign, Account, Realm).Packets);
+        byte[] invalidUtf8 = (byte[])body.Clone(); invalidUtf8[^1] = 0xff;
+        using var invalid = new WorldPacket(1, invalidUtf8);
+        Assert.Empty(bridge.Receive(invalid, Account, Realm).Packets);
+        Assert.Equal("Nativeproof", Reply(bridge, request, "Nativeproof").ChangedName);
+    }
+
+    [Fact]
+    public void ErrorReply_PreservesTheDistributionAndAllowsRetry()
+    {
+        var bridge = new AtlasAccountServiceBridge();
+        using var list = bridge.Subscribe(1000)!;
+        List(bridge, list, 10);
+        using var native = Request(false);
+        using var request = bridge.Assign(native, true, Realm, false, 1100)!;
+        var result = Reply(bridge, request, "Nativeproof", 1);
+        Assert.Null(result.ChangedName);
+        Assert.Equal(3u, Assert.IsType<AtlasAssignVasResponse>(Assert.Single(result.Packets)).StoreError);
+        Assert.NotNull(bridge.Assign(native, true, Realm, false, 1101));
+    }
+
+    [Fact]
+    public void PooledReceive_InspectsUnreadPayloadAndNeverIncludesRentalSlack()
+    {
+        var bridge = new AtlasAccountServiceBridge();
+        using var request = bridge.Subscribe(1000)!;
+        using var writer = ResponseHeader(request, 0);
+        writer.WriteUInt32(1); writer.WriteUInt64(10);
+        byte[] payload = writer.GetData();
+        byte[] rental = new byte[2048];
+        payload.CopyTo(rental, 2);
+        using var received = new WorldPacket(rental, payload.Length + 2, false);
+        Assert.Single(bridge.Receive(received, Account, Realm).Packets);
+        using var ordinary = new WorldPacket(1, new byte[] { 0 });
+        Assert.False(bridge.Receive(ordinary, Account, Realm).Handled);
+    }
+
+    static AtlasAssignNameChange Request(bool validate) => new(new WorldPacket()) {
+        Token = 73, DistributionId = 10, Character = Character, RealmAddress = Realm,
+        Name = "nativeproof", ValidateOnly = validate, IsSupportedNameChange = true,
+    };
+    static WorldPacket ResponseHeader(WorldPacket request, byte error)
+    {
+        using var input = new WorldPacket(1, request.GetData());
+        var writer = new WorldPacket(1);
+        writer.WriteBytes(input.ReadBytes(19)); writer.WriteUInt8(error);
+        return writer;
+    }
+    static AtlasAccountServiceBridge.Result List(AtlasAccountServiceBridge bridge, WorldPacket request, params ulong[] ids)
+    {
+        using var writer = ResponseHeader(request, 0);
+        writer.WriteUInt32((uint)ids.Length);
+        foreach (ulong id in ids) writer.WriteUInt64(id);
+        using var response = new WorldPacket(1, writer.GetData());
+        return bridge.Receive(response, Account, Realm);
+    }
+    static byte[] AssignmentResponse(WorldPacket request, string name, byte error = 0)
+    {
+        using var writer = ResponseHeader(request, error);
+        writer.WriteBytes(request.GetDataSpan().Slice(19, 17).ToArray());
+        byte[] bytes = System.Text.Encoding.UTF8.GetBytes(name);
+        writer.WriteUInt8((byte)bytes.Length); writer.WriteBytes(bytes);
+        return writer.GetData();
+    }
+    static AtlasAccountServiceBridge.Result Reply(AtlasAccountServiceBridge bridge, WorldPacket request, string name, byte error = 0)
+    {
+        using var response = new WorldPacket(1, AssignmentResponse(request, name, error));
+        return bridge.Receive(response, Account, Realm);
+    }
+}
diff --git a/HermesProxy.Tests/World/Server/AtlasAccountServicesPacketsTests.cs b/HermesProxy.Tests/World/Server/AtlasAccountServicesPacketsTests.cs
new file mode 100644
index 0000000..c193426
--- /dev/null
+++ b/HermesProxy.Tests/World/Server/AtlasAccountServicesPacketsTests.cs
@@ -0,0 +1,167 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Text.Json;
+using System.Collections.Generic;
+using Framework.Constants;
+using HermesProxy.World;
+using HermesProxy.World.Enums;
+using HermesProxy.World.Server;
+using HermesProxy.World.Server.Packets;
+using Xunit;
+using V343 = HermesProxy.World.Enums.V3_4_3_54261;
+
+namespace HermesProxy.Tests.World.Server;
+
+public class AtlasAccountServicesPacketsTests
+{
+    // Generated by emulating the actual 3.4.3.54261 client serializer with synthetic input.
+    const string ValidateHex = "490000007b000000000000000380d503080100000000000000000000000000020000000000002c00044e617469766570726f6f66";
+    const string ConfirmHex = "490000007b000000000000000380d503080100000000000000000000000000020000000000002c00004e617469766570726f6f66";
+    const string UnicodeHex = "490000007b000000000000000380d50308010000000000000000000000000002000000000000180004c389636c6174";
+
+    [Theory]
+    [InlineData(ValidateHex, true, "Nativeproof")]
+    [InlineData(ConfirmHex, false, "Nativeproof")]
+    [InlineData(UnicodeHex, true, "Éclat")]
+    public void ExactClientSerializerOutput_IsRead(string hex, bool validate, string name)
+    {
+        using var source = new WorldPacket(Frame(Convert.FromHexString(hex)));
+        using var request = new AtlasAssignNameChange(source);
+        request.Read();
+        Assert.Equal(73u, request.Token);
+        Assert.Equal(123ul, request.DistributionId);
+        Assert.Equal(981ul, request.Character.Low);
+        Assert.Equal(2ul << 58, request.Character.High);
+        Assert.Equal(1u, request.RealmAddress);
+        Assert.Equal(name, request.Name);
+        Assert.Equal(validate, request.ValidateOnly);
+        Assert.True(request.IsSupportedNameChange);
+    }
+
+    [Fact]
+    public void TruncatedOrExtendedAssignment_IsRejected()
+    {
+        var body = Convert.FromHexString(ValidateHex);
+        for (int length = 0; length < body.Length; ++length)
+        {
+            using var source = new WorldPacket(Frame(body[..length]));
+            using var request = new AtlasAssignNameChange(source);
+            Assert.ThrowsAny<Exception>(request.Read);
+        }
+        using var extended = new WorldPacket(Frame(body.Concat(new byte[] { 0 }).ToArray()));
+        using var extra = new AtlasAssignNameChange(extended);
+        Assert.Throws<InvalidDataException>(extra.Read);
+    }
+
+    [Theory]
+    [InlineData(31, 0)] // Rename does not change sex.
+    [InlineData(32, 1)] // Rename does not change race.
+    [InlineData(33, 1)] // Rename does not change faction.
+    [InlineData(40, 12)] // Transfer flag plus validation flag.
+    [InlineData(40, 6)] // Unsupported flag plus validation flag.
+    public void OtherVasOptions_AreNotAcceptedAsNameChanges(int offset, byte value)
+    {
+        var body = Convert.FromHexString(ValidateHex);
+        body[offset] = value;
+        using var source = new WorldPacket(Frame(body));
+        using var request = new AtlasAssignNameChange(source);
+        request.Read();
+        Assert.False(request.IsSupportedNameChange);
+    }
+
+    [Fact]
+    public void NativeOpcodes_MatchTheClientDispatchTable()
+    {
+        Assert.Equal(0x3742u, (uint)V343.Opcode.CMSG_BATTLE_PAY_DISTRIBUTION_ASSIGN_VAS);
+        Assert.Equal(0x2777u, (uint)V343.Opcode.SMSG_BATTLE_PAY_GET_DISTRIBUTION_LIST_RESPONSE);
+        Assert.Equal(0x2779u, (uint)V343.Opcode.SMSG_BATTLE_PAY_DISTRIBUTION_UPDATE);
+        Assert.Equal(0x2888u, (uint)V343.Opcode.SMSG_BATTLE_PAY_DISTRIBUTION_ASSIGN_VAS_RESPONSE);
+        Assert.Equal(0x27f1u, (uint)V343.Opcode.SMSG_GET_VAS_ACCOUNT_CHARACTER_LIST_RESULT);
+        Assert.Equal(0x27f5u, (uint)V343.Opcode.SMSG_ENUM_VAS_PURCHASE_STATES_RESPONSE);
+    }
+
+    [Fact]
+    public void ServerPackets_AreBoundedAndAvailableForNativeDecoderVerification()
+    {
+        var bodies = new Dictionary<string, string>();
+        foreach (int count in new[] { 0, 1, 2, 100 })
+        {
+            var list = new AtlasDistributionList();
+            for (int i = 0; i < count; ++i)
+                list.Distributions.Add(new AtlasDistribution { Id = (ulong)(1000 + i), RealmAddress = 1 });
+            bodies["distributions-" + count] = Emit(list);
+        }
+        var oversized = new AtlasDistributionList();
+        oversized.Distributions.AddRange(Enumerable.Range(0, 101).Select(i => new AtlasDistribution { Id = (ulong)i + 1 }));
+        Assert.Throws<InvalidOperationException>(oversized.Write);
+        bodies["consumed"] = Emit(new AtlasDistributionUpdate { Distribution = new AtlasDistribution { Id = 1000, Status = 3, Character = new WowGuid128(981, 2ul << 58), RealmAddress = 1 } });
+        bodies["revoked"] = Emit(new AtlasDistributionUpdate { Distribution = new AtlasDistribution { Id = 1000, Revoked = true, RealmAddress = 1 } });
+        bodies["products"] = Emit(new AtlasEmptyProductList());
+        bodies["purchases"] = Emit(new AtlasEmptyPurchaseList());
+        bodies["states"] = Emit(new AtlasEmptyVasStates());
+        bodies["glue-disabled"] = Emit(new FeatureSystemStatusGlueScreen { MaxCharactersPerRealm = 10, MinimumExpansionLevel = 5, MaximumExpansionLevel = 8, Unk14 = true });
+        bodies["glue-enabled"] = Emit(new FeatureSystemStatusGlueScreen { CharacterServicesEnabled = true, MaxCharactersPerRealm = 10, MinimumExpansionLevel = 5, MaximumExpansionLevel = 8, Unk14 = true });
+        bodies["assign-success"] = Emit(new AtlasAssignVasResponse { Token = 73 });
+        bodies["assign-rejected"] = Emit(new AtlasAssignVasResponse { Token = 73, StoreError = 3 });
+        // Exercise the exact handler mapping, not a hand-built entry that can hide missing fields.
+        var characters = WorldSocket.BuildAtlasVasCharacters(42, 7, true,
+            new[] { new OwnCharacterInfo { CharacterGuid = new WowGuid128(981, 2ul << 58), Name = "Nativeproof",
+                RaceId = (Race)1, ClassId = (Class)1, SexId = (Gender)0, Level = 80 } },
+            new WowGuid128(51, 29ul << 58), 1, "Atlas");
+        Assert.Equal("Atlas", Assert.Single(characters.Characters).RealmName);
+        Assert.Equal(0u, characters.Result);
+        bodies["characters"] = Emit(characters);
+        Assert.All(bodies.Values, body => Assert.InRange(body.Length / 2, 1, 16384));
+        string? output = Environment.GetEnvironmentVariable("HERMES_NATIVE_PACKET_OUTPUT");
+        if (!string.IsNullOrEmpty(output)) File.WriteAllText(output, JsonSerializer.Serialize(bodies, new JsonSerializerOptions { WriteIndented = true }));
+    }
+
+    [Fact]
+    public void NameChangeCharacterList_UsesTheCapturedClientWireType()
+    {
+        // CMSG_GET_VAS_ACCOUNT_CHARACTER_LIST from the unmodified 3.4.3.54261
+        // client: request token 1, wire service type 7. Lua's VAS enum is 4.
+        using var source = new WorldPacket(Frame(Convert.FromHexString("0100000007000000")));
+        using var request = new AtlasVasCharactersRequest(source);
+        request.Read();
+        Assert.Equal(1u, request.Token);
+        Assert.Equal(7u, request.WireServiceType);
+        var own = new OwnCharacterInfo { CharacterGuid = new WowGuid128(981, 2ul << 58), Name = "Nativeproof", Level = 35 };
+        var response = WorldSocket.BuildAtlasVasCharacters(request.Token, request.WireServiceType, true,
+            new[] { own }, new WowGuid128(51, 29ul << 58), 1, "Arthas");
+        Assert.Equal(0u, response.Result);
+        Assert.Equal(1u, response.Token);
+        Assert.Equal("Arthas", Assert.Single(response.Characters).RealmName);
+    }
+
+    [Theory]
+    [InlineData(7u, true, "Arthas", 0u)]
+    [InlineData(7u, true, "", 1u)]
+    [InlineData(7u, false, "Arthas", 1u)]
+    [InlineData(4u, true, "Arthas", 1u)] // Lua's enum value is not a rename wire type.
+    [InlineData(2u, true, "Arthas", 1u)]
+    public void VasSelector_UsesTheAuthenticatedRealmAndServiceGate(uint type, bool ready, string realm, uint expectedResult)
+    {
+        var own = new OwnCharacterInfo { CharacterGuid = new WowGuid128(981, 2ul << 58), Name = "Flowmage", Level = 35 };
+        var account = new WowGuid128(51, 29ul << 58);
+        var response = WorldSocket.BuildAtlasVasCharacters(42, type, ready, new[] { own }, account, 7, realm);
+        Assert.Equal(42u, response.Token);
+        Assert.Equal(expectedResult, response.Result);
+        if (expectedResult != 0) { Assert.Empty(response.Characters); return; }
+        var entry = Assert.Single(response.Characters);
+        Assert.Equal(realm, entry.RealmName);
+        Assert.Equal(7u, entry.RealmVirtualAddress);
+        Assert.Equal(account, entry.AccountId);
+        Assert.Equal(own.CharacterGuid, entry.CharacterGuid);
+        Assert.Equal("Flowmage", entry.Name);
+        Assert.Equal((byte)35, entry.Level);
+    }
+
+    static string Emit(ServerPacket packet)
+    {
+        packet.WritePacketData();
+        return Convert.ToHexString(packet.GetData()!);
+    }
+    static byte[] Frame(byte[] body) => new byte[2].Concat(body).ToArray();
+}
