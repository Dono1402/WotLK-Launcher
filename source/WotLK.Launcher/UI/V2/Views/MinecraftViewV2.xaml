<UserControl x:Class="WotLK.Launcher.UI.V2.Views.MinecraftViewV2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AtlasV2.Font.Inter}" Focusable="False">
    <Grid Margin="56,36,56,48" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,28,32">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                <Border Width="28" Height="2" Background="#8BD8A0" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock Text="ATLAS · JEUX" Foreground="#8BD8A0" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="Minecraft" FontSize="68" FontWeight="ExtraBold" Foreground="#F0F7F2"/>
            <TextBlock Text="Un nouvel univers arrive sur Atlas." Margin="0,16,0,0"
                       FontSize="23" Foreground="#D3E5DB" TextWrapping="Wrap"/>
            <Border Margin="0,32,0,0" Padding="12,7" HorizontalAlignment="Left"
                    Background="#203E32" BorderBrush="#537D5C" BorderThickness="1" CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="#A8D98E" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="Bientôt disponible" FontSize="13" FontWeight="SemiBold" Foreground="#B9E5A4"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Le téléchargement et le lancement de Minecraft seront disponibles dans une prochaine mise à jour."
                       Margin="0,18,0,0" FontSize="16" LineHeight="26" Foreground="#9DB9AF" TextWrapping="Wrap"/>
        </StackPanel>
        <!-- A lightweight vector landscape keeps this first workspace independent of game downloads. -->
        <Viewbox Grid.Column="1" Stretch="Uniform" VerticalAlignment="Center" IsHitTestVisible="False" Margin="10,0,0,0">
            <Canvas Width="500" Height="480">
                <Ellipse Width="440" Height="380" Canvas.Left="30" Canvas.Top="30">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#345E8060"/><GradientStop Color="#005E8060" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                </Ellipse>
                <Path Data="M25,317 L224,207 L477,342 L278,454 Z" Fill="#18372F"/>
                <Path Data="M94,233 L269,132 L432,226 L257,328 Z" Fill="#7CA865"/>
                <Path Data="M94,233 L257,328 L257,418 L94,323 Z" Fill="#4B4B35"/>
                <Path Data="M257,328 L432,226 L432,316 L257,418 Z" Fill="#303F30"/>
                <Path Data="M94,233 L257,328 L257,350 L94,255 Z" Fill="#577E45"/>
                <Path Data="M257,328 L432,226 L432,248 L257,350 Z" Fill="#405F38"/>
                <Path Data="M143,225 L232,174 L334,233 L245,284 Z" Fill="#9ABF76"/>
                <Path Data="M143,225 L245,284 L245,306 L143,247 Z" Fill="#709153"/>
                <Path Data="M245,284 L334,233 L334,255 L245,306 Z" Fill="#557B45"/>
                <Path Data="M321,174 L340,163 L358,174 L339,185 Z M321,174 L339,185 L339,244 L321,233 Z" Fill="#6B6744"/>
                <Path Data="M339,185 L358,174 L358,233 L339,244 Z" Fill="#4D5135"/>
                <Path Data="M278,116 L339,81 L401,117 L340,152 Z" Fill="#79A563"/>
                <Path Data="M278,116 L340,152 L340,206 L278,170 Z" Fill="#4F7B48"/>
                <Path Data="M340,152 L401,117 L401,171 L340,206 Z" Fill="#355C3C"/>
                <Path Data="M294,85 L339,59 L385,85 L340,112 Z" Fill="#8CB974"/>
                <Path Data="M294,85 L340,112 L340,147 L294,120 Z" Fill="#628C50"/>
                <Path Data="M340,112 L385,85 L385,120 L340,147 Z" Fill="#416E43"/>
                <Path Data="M152,298 L180,314 L180,341 L152,325 Z M207,357 L232,371 L232,398 L207,383 Z" Fill="#5D5C40"/>
                <Path Data="M304,355 L332,339 L332,365 L304,382 Z M374,286 L399,272 L399,298 L374,312 Z" Fill="#3A4C36"/>
                <Rectangle Width="5" Height="5" Fill="#B3DDA0" Canvas.Left="132" Canvas.Top="138" Opacity=".6"/>
                <Rectangle Width="4" Height="4" Fill="#B3DDA0" Canvas.Left="408" Canvas.Top="78" Opacity=".5"/>
                <Rectangle Width="4" Height="4" Fill="#B3DDA0" Canvas.Left="450" Canvas.Top="204" Opacity=".4"/>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
