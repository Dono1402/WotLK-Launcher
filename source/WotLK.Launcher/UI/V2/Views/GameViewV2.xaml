<UserControl x:Class="WotLK.Launcher.UI.V2.Views.GameViewV2"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dashboard="clr-namespace:WotLK.Launcher.Dashboard"
             xmlns:presentation="clr-namespace:WotLK.Launcher.UI.V2.Presentation"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="796"
             Background="Transparent"
             FontFamily="{StaticResource AtlasV2.Font.Inter}"
             FontWeight="Normal"
             Focusable="False"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WotLK.Launcher;component/UI/V2/Resources/AtlasV2.GamePilot.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <presentation:HeroTextConverter x:Key="HeroText"/>
            <SolidColorBrush x:Key="GamePilot.Online" Color="#35E1BF"/>
            <BitmapImage x:Key="GamePilot.Artwork" UriSource="/WotLK.Launcher;component/Assets/Images/AtlasGamePilotA.png" CacheOption="OnLoad"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer x:Name="GameScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" PanningMode="VerticalOnly">
            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/></ScrollViewer.Resources>
            <Grid x:Name="ViewportFrame" Height="{Binding ViewportHeight, ElementName=GameScrollViewer}" MinHeight="640">
                <Border x:Name="ContentFrame">
                    <Border x:Name="HeroCard" MinHeight="640" Background="#07111C" ClipToBounds="True">
                        <Grid DataContext="{Binding State, ElementName=Root}">
                            <!-- The same candidate covers the upper inset while the main layer is reframed.
                                 A short WPF mask blends the two; the supplied bitmap stays untouched. -->
                            <Rectangle IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
                                <Rectangle.Fill><ImageBrush ImageSource="{StaticResource GamePilot.Artwork}" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Top"/></Rectangle.Fill>
                            </Rectangle>
                            <Rectangle x:Name="HeroArtwork" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
                                <Rectangle.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00FFFFFF" Offset="0.055"/><GradientStop Color="#FFFFFFFF" Offset="0.115"/>
                                </LinearGradientBrush></Rectangle.OpacityMask>
                                <Rectangle.Fill>
                                    <ImageBrush AlignmentX="Right" AlignmentY="Top" Stretch="UniformToFill" ImageSource="{StaticResource GamePilot.Artwork}">
                                        <ImageBrush.RelativeTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1.06" ScaleY="1.06" CenterX="0.5" CenterY="0"/>
                                                <TranslateTransform X="0.008" Y="0.047"/>
                                            </TransformGroup>
                                        </ImageBrush.RelativeTransform>
                                    </ImageBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#ED030C15" Offset="0"/><GradientStop Color="#C6040D17" Offset="0.32"/>
                                    <GradientStop Color="#26061522" Offset="0.62"/><GradientStop Color="#240B2134" Offset="1"/>
                                </LinearGradientBrush></Rectangle.Fill>
                            </Rectangle>
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#10020A12" Offset="0"/><GradientStop Color="#00020A12" Offset="0.55"/>
                                    <GradientStop Color="#6C030D18" Offset="0.79"/><GradientStop Color="#D9020911" Offset="1"/>
                                </LinearGradientBrush></Rectangle.Fill>
                            </Rectangle>
                            <Border x:Name="HeroCopyPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="74,214,0,0">
                                <StackPanel x:Name="HeroCopyContent">
                                    <StackPanel x:Name="RealmEyebrow" Orientation="Horizontal" Height="26">
                                        <Border x:Name="RealmEyebrowLine" Width="38" Height="1" Background="#64D6FF" VerticalAlignment="Center" Margin="0,0,22,0"/>
                                        <TextBlock Text="{Binding RealmLabel, Converter={StaticResource HeroText}, ConverterParameter=Tracked}"
                                                   AutomationProperties.Name="{Binding RealmLabel}" FontSize="14" FontWeight="SemiBold" Foreground="#62D6FF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid x:Name="HeroTitleBlock" Height="212" Margin="8,17,0,0">
                                        <TextBlock x:Name="HeroTitle" Text="{Binding Title, Converter={StaticResource HeroText}, ConverterParameter=First}" FontSize="102" FontWeight="ExtraBold" VerticalAlignment="Top">
                                            <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0.26" EndPoint="0,0.82"><GradientStop Color="#FCFCFD" Offset="0"/><GradientStop Color="#DAE1E9" Offset="1"/></LinearGradientBrush></TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock x:Name="HeroTitleSecond" Text="{Binding Title, Converter={StaticResource HeroText}, ConverterParameter=Rest}" FontSize="99" FontWeight="ExtraBold" VerticalAlignment="Top" Margin="1,93.4,0,0">
                                            <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0.35" EndPoint="0,0.88"><GradientStop Color="#A8DCFD" Offset="0"/><GradientStop Color="#9ED7FC" Offset="0.25"/><GradientStop Color="#5EA0D7" Offset="1"/></LinearGradientBrush></TextBlock.Foreground>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock x:Name="HeroSubtitle" Text="{Binding Subtitle, Converter={StaticResource HeroText}, ConverterParameter=Sentence}" FontSize="38" Foreground="#D1DDF0" Margin="13,0,0,0"/>
                                    <StackPanel x:Name="HeroChips" Orientation="Horizontal" Margin="12,35,0,0">
                                        <Border Style="{StaticResource GamePilot.Chip}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M3,2 L17,16 M3,2 L3,6 M3,2 L7,2 M17,2 L3,16 M17,2 L17,6 M17,2 L13,2 M1,12 L6,17 M14,17 L19,12" Width="18" Height="18" Stretch="Uniform" Stroke="#BED5EE" StrokeThickness="1.6" Margin="0,0,13,0"/>
                                            <TextBlock Text="Raids épiques" Foreground="#AEC2DC" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel></Border>
                                        <Border Style="{StaticResource GamePilot.Chip}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource AtlasV2.Icon.Users}" Style="{StaticResource AtlasV2.Icon.Stroke}" Width="21" Height="19" Stroke="#BED5EE" Margin="0,0,13,0"/>
                                            <TextBlock Text="Communauté active" Foreground="#AEC2DC" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel></Border>
                                        <Border Style="{StaticResource GamePilot.Chip}" Margin="0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M2,4 L6,8 L10,1 L14,8 L18,4 L16,14 L4,14 Z M4,17 L16,17" Width="20" Height="19" Stretch="Uniform" Fill="#BED5EE" Stroke="#BED5EE" StrokeThickness="1.3" Margin="0,0,13,0"/>
                                            <TextBlock Text="L’expérience WotLK Classic" Foreground="#AEC2DC" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel></Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="HeroMotto" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,469,81,0" IsHitTestVisible="False" Opacity="0.82">
                                <TextBlock Text="L E  F R O I D&#10;N E  M E U R T&#10;J A M A I S" TextAlignment="Center" FontSize="18" LineHeight="33" Foreground="#C4E2F8" FontFamily="{StaticResource AtlasV2.Font.Inter}"/>
                                <Grid Margin="20,4,8,0" Height="22"><Border Height="1" Background="#8CADC5" VerticalAlignment="Center"/><Path Data="M10,0 L15,11 L10,22 L5,11 Z M10,5 L10,17" Stretch="Uniform" Width="12" Height="22" Stroke="#A5C5DB" StrokeThickness="1" HorizontalAlignment="Right" Margin="0,0,20,0"/></Grid>
                            </StackPanel>
                            <Grid x:Name="HeroBottomBar" Margin="59,0,59,59" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel x:Name="HeroStatusRegion" Grid.Column="0" Width="575" VerticalAlignment="Bottom">
                                    <Grid x:Name="GameOperationFeedback" Margin="0,0,0,14">
                                        <Border Padding="16,13"
                                                Background="{StaticResource GamePilot.Surface}"
                                                BorderBrush="{StaticResource AtlasV2.Brush.CyanBorder}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Visibility="{Binding ShowsProgress, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ProgressTitle}" TextTrimming="CharacterEllipsis"
                                                               Style="{StaticResource GamePilot.Text.Body}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" Text="{Binding ProgressPercentText}"
                                                               HorizontalAlignment="Right"
                                                               Style="{StaticResource GamePilot.Text.Caption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                                                </Grid>
                                                <ProgressBar Margin="0,9,0,8"
                                                             Style="{StaticResource AtlasV2.Progress.Compact}"
                                                             Value="{Binding Progress}"
                                                             IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ProgressPrimaryDetail}"
                                                               Style="{StaticResource GamePilot.Text.Caption}"
                                                               Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProgressSecondaryDetail}"
                                                               Margin="18,0,0,0"
                                                               HorizontalAlignment="Right"
                                                               Style="{StaticResource GamePilot.Text.Caption}"
                                                               Foreground="{StaticResource AtlasV2.Brush.TextMuted}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Padding="16,13"
                                                Background="{StaticResource GamePilot.Surface}"
                                                BorderBrush="{StaticResource AtlasV2.Brush.DangerBorder}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Visibility="{Binding ShowsError, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="15"
                                                          Height="15"
                                                          Margin="0,1,8,0"
                                                          Data="{StaticResource AtlasV2.Icon.AlertCircle}"
                                                          Style="{StaticResource AtlasV2.Icon.Stroke}"
                                                          Stroke="{StaticResource AtlasV2.Brush.Danger}"/>
                                                    <TextBlock Text="{Binding ErrorTitle}"
                                                               Style="{StaticResource GamePilot.Text.Body}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                                </StackPanel>
                                                <TextBlock Margin="23,5,0,0"
                                                           Text="{Binding ErrorSummary}"
                                                           Style="{StaticResource GamePilot.Text.Caption}"
                                                           Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                    </Grid>
                                    <Border x:Name="RealmStatusCard" Height="152" Padding="33,22,33,23" CornerRadius="14" Background="{StaticResource GamePilot.Surface}" BorderBrush="#344E63" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid x:Name="GameServerStatus"
                                              VerticalAlignment="Top" Height="28"
                                              Margin="0"
                                              HorizontalAlignment="Stretch"
                                              ToolTip="{Binding DashboardState.Current.RealmToolTip, ElementName=Root}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="RealmStatusDot"
                                                     Width="15"
                                                     Height="15"
                                                     Margin="0,0,16,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="{x:Type Ellipse}">
                                                        <Setter Property="Fill" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DashboardState.Current.RealmState, ElementName=Root}" Value="{x:Static dashboard:DashboardRealmState.Online}">
                                                                <Setter Property="Fill" Value="{StaticResource GamePilot.Online}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DashboardState.Current.RealmState, ElementName=Root}" Value="{x:Static dashboard:DashboardRealmState.Degraded}">
                                                                <Setter Property="Fill" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DashboardState.Current.RealmState, ElementName=Root}" Value="{x:Static dashboard:DashboardRealmState.Offline}">
                                                                <Setter Property="Fill" Value="{StaticResource AtlasV2.Brush.Danger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock x:Name="RealmStatusText"
                                                       Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding DashboardState.Current.RealmStatusWideLabel, ElementName=Root}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="20"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}"
                                                           BasedOn="{StaticResource GamePilot.Text.Body}">
                                                        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DashboardState.Current.RealmState, ElementName=Root}" Value="{x:Static dashboard:DashboardRealmState.Online}">
                                                                <Setter Property="Foreground" Value="{StaticResource GamePilot.Online}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DashboardState.Current.RealmState, ElementName=Root}" Value="{x:Static dashboard:DashboardRealmState.Degraded}">
                                                                <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DashboardState.Current.RealmState, ElementName=Root}" Value="{x:Static dashboard:DashboardRealmState.Offline}">
                                                                <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Danger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>


                                            <Border Grid.Row="1" Height="1" Background="#293E50"/>
                                            <Grid x:Name="RealmFacts" Grid.Row="2" Margin="5,16,0,0" TextBlock.Foreground="#E4EDF7" TextBlock.FontSize="16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="140*"/><ColumnDefinition Width="145*"/><ColumnDefinition Width="220*"/></Grid.ColumnDefinitions>
                                                <StackPanel ToolTip="Le nombre de joueurs est indisponible."><TextBlock Text="—"/><TextBlock Text="joueurs en ligne" FontSize="14" Foreground="#8FA9C7"/></StackPanel>
                                                <Border Grid.Column="1" BorderBrush="#283E50" BorderThickness="1,0,0,0" Padding="33,0,0,0" ToolTip="La latence est indisponible."><StackPanel><TextBlock Text="—"/><TextBlock Text="latence" FontSize="14" Foreground="#8FA9C7"/></StackPanel></Border>
                                                <Border Grid.Column="2" BorderBrush="#385266" BorderThickness="1,0,0,0" Padding="48,0,0,0"><StackPanel><TextBlock Text="{Binding RealmLabel, Converter={StaticResource HeroText}, ConverterParameter=Realm}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="WotLK Classic" FontSize="14" Foreground="#8FA9C7"/></StackPanel></Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="HeroActionRegion" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,21">
                                    <StackPanel x:Name="HeroActionPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="LatestPatchNoteAction" Width="210" Height="91" Margin="0,0,14,0" Padding="12,0" Style="{StaticResource GamePilot.Button}"
                                                IsEnabled="{Binding DashboardState.Current.CanOpenLatestPatchNote, ElementName=Root}" AutomationProperties.Name="Notes de version" Click="LatestPatchNoteAction_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Width="24" Height="27" Margin="0,0,19,0" Data="{StaticResource AtlasV2.Icon.FileText}" Style="{StaticResource AtlasV2.Icon.Stroke}" Stroke="#B6CCE8"/>
                                                <TextBlock x:Name="LatestPatchNoteLabel" Text="Notes de version" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                                            </StackPanel>
                                        </Button>
                                            <Button x:Name="PrimaryActionButton"
                                                    Width="322"
                                                    Height="91"
                                                    FontSize="26"
                                                    Style="{StaticResource GamePilot.Primary}"
                                                    IsEnabled="{Binding IsPrimaryActionEnabled}"
                                                    Command="{Binding PrimaryActionCommand}"
                                                    ToolTip="{Binding PrimaryActionUnavailableReason}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    AutomationProperties.Name="{Binding PrimaryActionLabel}">
                                                <StackPanel Orientation="Horizontal">
                                                <Path Width="24"
                                                      Height="26"
                                                      Margin="0,0,20,0"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Tag="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                                                      Stretch="Uniform">
                                                    <Path.Style>
                                                        <Style TargetType="{x:Type Path}">
                                                            <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Play}"/>
                                                            <Setter Property="Fill" Value="#111318"/>
                                                            <Setter Property="Stroke" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.NotInstalled}">
                                                                    <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Download}"/>
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                    <Setter Property="Stroke" Value="#111318"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.UpdateAvailable}">
                                                                    <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Refresh}"/>
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                    <Setter Property="Stroke" Value="#111318"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.Downloading}">
                                                                    <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Close}"/>
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                    <Setter Property="Stroke" Value="#111318"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.Installing}">
                                                                    <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Close}"/>
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                    <Setter Property="Stroke" Value="#111318"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Scenario}" Value="{x:Static presentation:GamePreviewScenario.Error}">
                                                                    <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Refresh}"/>
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                    <Setter Property="Stroke" Value="#111318"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsLaunchInProgress}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Refresh}"/>
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                    <Setter Property="Stroke" Value="#111318"/>
                                                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsLaunchInProgress}" Value="True"/>
                                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="LaunchSpinner">
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                                 From="0"
                                                                                                 To="360"
                                                                                                 Duration="0:0:0.9"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="LaunchSpinner"/></MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                    <TextBlock x:Name="PrimaryActionLabelText"
                                                               Text="{Binding PrimaryActionLabel}"
                                                               TextWrapping="Wrap" TextAlignment="Center"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>

                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </ScrollViewer>
        <Border x:Name="LocalNotification"
                Panel.ZIndex="20"
                MaxWidth="430"
                Margin="24,128,24,24"
                Padding="14,11"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{StaticResource AtlasV2.Brush.SurfaceRaised}"
                BorderThickness="1"
                CornerRadius="6"
                IsHitTestVisible="False"
                Visibility="{Binding State.ShowsNotification, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                AutomationProperties.Name="Notification locale">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.NotificationTone, ElementName=Root}" Value="{x:Static presentation:GameSemanticTone.Warning}">
                            <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State.NotificationTone, ElementName=Root}" Value="{x:Static presentation:GameSemanticTone.Error}">
                            <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Danger}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Path Width="15"
                      Height="15"
                      Margin="0,1,9,0"
                      Data="{StaticResource AtlasV2.Icon.AlertCircle}"
                      Style="{StaticResource AtlasV2.Icon.Stroke}"
                      Stroke="{Binding BorderBrush, ElementName=LocalNotification}"/>
                <TextBlock MaxWidth="370"
                           Text="{Binding State.NotificationMessage, ElementName=Root}"
                           Style="{StaticResource GamePilot.Text.Body}"
                           Foreground="{StaticResource AtlasV2.Brush.Text}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
