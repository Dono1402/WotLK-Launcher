<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="AtlasV2.Font.Manrope">pack://application:,,,/WotLK.Launcher;component/Assets/Fonts/#Manrope</FontFamily>
    <FontFamily x:Key="AtlasV2.Font.Inter">pack://application:,,,/WotLK.Launcher;component/Assets/Fonts/#Inter</FontFamily>
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
    </Style>
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <BooleanToVisibilityConverter x:Key="AtlasV2.Converter.BooleanToVisibility"/>

    <SolidColorBrush x:Key="AtlasV2.Brush.Window" Color="#090C10"/>
    <LinearGradientBrush x:Key="AtlasV2.Brush.WindowAmbient"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF0A0E13"/>
        <GradientStop Offset="0.58" Color="#FF0C1219"/>
        <GradientStop Offset="1" Color="#FF090C10"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AtlasV2.Brush.TopBar" Color="#0D1116"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Surface" Color="#12171D"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.SurfaceRaised" Color="#181E25"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.SurfaceHover" Color="#232B34"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.SurfacePressed" Color="#2B3540"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Border" Color="#303A45"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.BorderSoft" Color="#222B34"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Text" Color="#F7F5EF"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.TextSecondary" Color="#C6CED8"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.TextMuted" Color="#A2ADBA"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Gold" Color="#DEB75A"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.GoldHover" Color="#F0C96D"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.GoldPressed" Color="#C89B3F"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Cyan" Color="#61D5E8"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Success" Color="#51D7A2"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Warning" Color="#F2A33C"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Danger" Color="#EE6571"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.GoldSurface" Color="#2C2516"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.GoldBorder" Color="#715B29"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.CyanSurface" Color="#10252B"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.CyanBorder" Color="#27616C"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.SuccessSurface" Color="#10251E"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.SuccessBorder" Color="#28634E"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.DangerSurface" Color="#2A171C"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.DangerBorder" Color="#71343D"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Field" Color="#0D1217"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Scrim" Color="#9905080B"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.AuthScrim" Color="#D10A0E13"/>

    <!-- Shared translucent surfaces: only the backdrop is softened, so live text stays sharp. -->
    <LinearGradientBrush x:Key="AtlasV2.Brush.GlassSurface" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#D2071521" Offset="0"/>
        <GradientStop Color="#AE143048" Offset="0.52"/>
        <GradientStop Color="#DE07131E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AtlasV2.Brush.GlassRaised" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#BE0A1927" Offset="0"/>
        <GradientStop Color="#97182F44" Offset="0.55"/>
        <GradientStop Color="#D00B1B28" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AtlasV2.Brush.GlassBorder" Color="#80406480"/>
    <LinearGradientBrush x:Key="AtlasV2.Brush.GlassHighlight" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7A77B9E0" Offset="0"/>
        <GradientStop Color="#26457594" Offset="0.55"/>
        <GradientStop Color="#4A294861" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AtlasV2.Brush.TitleIce" StartPoint="0,0.18" EndPoint="0,0.84">
        <GradientStop Color="#FCFDFF" Offset="0"/>
        <GradientStop Color="#E1EFFC" Offset="0.5"/>
        <GradientStop Color="#A2CFF6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AtlasV2.Brush.TitlePearl" StartPoint="0,0.18" EndPoint="0,0.84">
        <GradientStop Color="#FCFCFD" Offset="0"/>
        <GradientStop Color="#F0F4F7" Offset="0.55"/>
        <GradientStop Color="#C8D7E3" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="AtlasV2.Text.Body" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="AtlasV2.Text.Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.Body}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
    </Style>

    <Style x:Key="AtlasV2.Text.Eyebrow" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.Body}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Gold}"/>
    </Style>

    <Style x:Key="AtlasV2.Text.SectionTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.Body}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
    </Style>

    <Style x:Key="AtlasV2.Text.Hero" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.Body}">
        <Setter Property="FontSize" Value="38"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
</ResourceDictionary>
