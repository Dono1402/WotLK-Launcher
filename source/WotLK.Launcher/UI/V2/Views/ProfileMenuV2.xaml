<UserControl x:Class="WotLK.Launcher.UI.V2.Views.ProfileMenuV2"
             x:Name="ProfileMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WotLK.Launcher.UI.V2.Views"
             Width="344"
             Visibility="Collapsed"
             IsHitTestVisible="False"
             Focusable="False"
             KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/AtlasV2.OverlaysPilot.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PresenceOption" TargetType="Button" BasedOn="{StaticResource AtlasV2.Overlay.Button}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid DataContext="{Binding State, RelativeSource={RelativeSource AncestorType={x:Type views:ProfileMenuV2}}}">
        <Border x:Name="MenuPanel"
                Padding="20"
                Background="{StaticResource AtlasV2.Overlay.Panel}"
                BorderBrush="{StaticResource AtlasV2.Overlay.Edge}"
                BorderThickness="1"
                CornerRadius="14"
                Opacity="0"
                Focusable="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="MenuTranslate" Y="-8"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="6"
                                  Opacity="0.34"
                                  Color="#000000"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="ProfileIdentityAvatar"
                          Width="42"
                          Height="42"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Ellipse Fill="{StaticResource AtlasV2.Brush.Gold}"/>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding Current.Initial}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111318"/>
                        <Ellipse x:Name="MenuProfileAvatarImage">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarImage}"
                                            Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                            <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse IsHitTestVisible="False"
                                 Stroke="{StaticResource AtlasV2.Brush.GoldBorder}"
                                 StrokeThickness="1.5"/>
                    </Grid>

                    <TextBlock x:Name="ProfileUsernameText"
                               Grid.Column="1"
                               Margin="2,0,8,0"
                               VerticalAlignment="Center"
                               Text="{Binding Current.Username}"
                               Style="{StaticResource AtlasV2.Text.Body}"
                               FontWeight="ExtraBold"
                               FontSize="18"
                               Foreground="{StaticResource AtlasV2.Brush.Text}"
                               TextTrimming="CharacterEllipsis"/>

                    <Button x:Name="CloseProfileButton"
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="8"
                            VerticalAlignment="Top"
                            Style="{StaticResource AtlasV2.Overlay.IconButton}"
                            ToolTip="Fermer"
                            AutomationProperties.Name="Fermer le profil"
                            KeyboardNavigation.TabIndex="0"
                            Click="CloseButton_Click">
                        <Path Data="{StaticResource AtlasV2.Icon.Close}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                    </Button>
                </Grid>

                <Border Height="1"
                        Margin="0,16,0,14"
                        Background="{StaticResource AtlasV2.Overlay.Divider}"/>

                <Border x:Name="EmailVerificationWarning"
                        Margin="0,12,0,0"
                        Padding="12,11"
                        Background="{StaticResource AtlasV2.Brush.Surface}"
                        BorderBrush="{StaticResource AtlasV2.Overlay.Divider}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Current.IsEmailVerified}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="EmailVerificationWarningIcon"
                              Width="17"
                              Height="17"
                              Data="{StaticResource AtlasV2.Icon.Mail}"
                              Stroke="{StaticResource AtlasV2.Brush.Warning}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{Binding Current.EmailStatusText}"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                    </Grid>
                </Border>

                <Border Margin="0,10,0,0"
                        Padding="11,9"
                        Background="#2AB93643"
                        BorderBrush="#70B93643"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Current.ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Current.ErrorMessage}"
                               TextWrapping="Wrap"
                               Style="{StaticResource AtlasV2.Text.Caption}"
                               Foreground="#F1A7AE"/>
                </Border>

                <StackPanel Margin="0,10,0,12">
                    <Button x:Name="PresenceToggleButton" Height="40" Padding="10,0"
                            Style="{StaticResource AtlasV2.Overlay.Button}" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="Modifier mon statut" KeyboardNavigation.TabIndex="1"
                            Click="PresenceToggleButton_Click">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Right" Width="18" Margin="10,0,0,0">
                                <TextBlock x:Name="PresenceChevron" Text="⌄" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPresenceUpdating}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <ProgressBar x:Name="PresenceBusyIndicator" Style="{StaticResource AtlasV2.Progress.Inline}"
                                             IsIndeterminate="{Binding IsPresenceUpdating}" AutomationProperties.Name="Modification du statut"/>
                            </Grid>
                            <Ellipse Width="9" Height="9" Fill="{Binding PresenceBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding PresenceLabel}" VerticalAlignment="Center" Foreground="{StaticResource AtlasV2.Brush.Text}" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Button>
                    <StackPanel x:Name="PresenceChoicesPanel" Visibility="Collapsed" IsEnabled="{Binding CanChangePresence}">
                        <Button KeyboardNavigation.TabIndex="2" Tag="online" Click="PresenceButton_Click" Style="{StaticResource PresenceOption}" AutomationProperties.Name="En ligne" ToolTip="Disponible. Passage automatique à Absent après 20 minutes sans activité.">
                            <StackPanel Orientation="Horizontal"><Ellipse Fill="#48C78E" Width="9" Height="9" Margin="0,0,10,0"/><TextBlock Text="En ligne"/><TextBlock Text=" ✓" Visibility="{Binding IsPresenceOnline, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/></StackPanel>
                        </Button>
                        <Button KeyboardNavigation.TabIndex="3" Tag="away" Click="PresenceButton_Click" Style="{StaticResource PresenceOption}" AutomationProperties.Name="Absent" ToolTip="Rester absent jusqu’à votre prochain choix de statut.">
                            <StackPanel Orientation="Horizontal"><Ellipse Fill="#E9B44C" Width="9" Height="9" Margin="0,0,10,0"/><TextBlock Text="Absent"/><TextBlock Text=" ✓" Visibility="{Binding IsPresenceAway, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/></StackPanel>
                        </Button>
                        <Button KeyboardNavigation.TabIndex="4" Tag="dnd" Click="PresenceButton_Click" Style="{StaticResource PresenceOption}" AutomationProperties.Name="Ne pas déranger" ToolTip="Désactiver les notifications de messages.">
                            <StackPanel Orientation="Horizontal"><Ellipse Fill="#EE6873" Width="9" Height="9" Margin="0,0,10,0"/><TextBlock Text="Ne pas déranger"/><TextBlock Text=" ✓" Visibility="{Binding IsPresenceDnd, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/></StackPanel>
                        </Button>
                        <Button KeyboardNavigation.TabIndex="5" Tag="offline" Click="PresenceButton_Click" Style="{StaticResource PresenceOption}" AutomationProperties.Name="Apparaître hors ligne" ToolTip="Apparaître hors ligne auprès de vos contacts, même pendant le jeu.">
                            <StackPanel Orientation="Horizontal"><Ellipse Fill="#8995A8" Width="9" Height="9" Margin="0,0,10,0"/><TextBlock Text="Apparaître hors ligne"/><TextBlock Text=" ✓" Visibility="{Binding IsPresenceOffline, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding PresenceError}" TextWrapping="Wrap" Margin="0,7,0,0" Foreground="#EE8790" FontSize="12">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button x:Name="ManageProfileButton"
                        Height="48"
                        Margin="0,14,0,0"
                        Padding="14,0"
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{Binding IsManageProfileEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:ProfileMenuV2}}}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="Gérer mon profil"
                        KeyboardNavigation.TabIndex="6"
                        Click="ManageProfileButton_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}"
                               BasedOn="{StaticResource AtlasV2.Overlay.Button}">
                            <Setter Property="ToolTip" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="ToolTip" Value="Connexion requise"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>
                        <Path Width="17"
                              Height="17"
                              Data="{StaticResource AtlasV2.Icon.User}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="Gérer mon profil"
                                   FontWeight="SemiBold"/>
                        <Path Grid.Column="2"
                              Width="15"
                              Height="15"
                              Data="{StaticResource AtlasV2.Icon.ArrowRight}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                    </Grid>
                </Button>

                <Button x:Name="ManageAccountButton"
                        Height="48"
                        Margin="0,9,0,0"
                        Padding="14,0"
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{Binding IsManageAccountEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:ProfileMenuV2}}}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="Gérer mon compte"
                        KeyboardNavigation.TabIndex="7"
                        Click="ManageAccountButton_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}"
                               BasedOn="{StaticResource AtlasV2.Overlay.Button}">
                            <Setter Property="ToolTip" Value="Sécurité et appareils connectés"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="ToolTip" Value="Connexion requise"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>
                        <Path Width="17"
                              Height="17"
                              Data="{StaticResource AtlasV2.Icon.Settings}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="Gérer mon compte"
                                   FontWeight="SemiBold"/>
                        <Path Grid.Column="2"
                              Width="15"
                              Height="15"
                              Data="{StaticResource AtlasV2.Icon.ArrowRight}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                    </Grid>
                </Button>

                <Button x:Name="LogoutButton"
                        Height="48"
                        Margin="0,9,0,0"
                        Padding="14,0"
                        HorizontalContentAlignment="Stretch"
                        Style="{StaticResource AtlasV2.Overlay.Button}"
                        Command="{Binding LogoutCommand}"
                        ToolTip="{Binding Current.LogoutToolTip}"
                        AutomationProperties.Name="Déconnexion"
                        KeyboardNavigation.TabIndex="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <Path Width="17"
                              Height="17"
                              Data="{StaticResource AtlasV2.Icon.LogOut}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding Current.LogoutLabel}"
                                   FontWeight="SemiBold"/>
                        <ProgressBar Grid.Column="2"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="{Binding Current.IsLoggingOut}"
                                     Style="{StaticResource AtlasV2.Progress.Inline}"/>
                    </Grid>
                </Button>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
