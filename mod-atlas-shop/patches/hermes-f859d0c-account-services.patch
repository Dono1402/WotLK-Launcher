diff --git a/HermesProxy/World/Server/AtlasAccountServiceBridge.cs b/HermesProxy/World/Server/AtlasAccountServiceBridge.cs
new file mode 100644
index 0000000..2a91759
--- /dev/null
+++ b/HermesProxy/World/Server/AtlasAccountServiceBridge.cs
@@ -0,0 +1,140 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text;
+using HermesProxy.World.Enums;
+using HermesProxy.World.Server.Packets;
+
+namespace HermesProxy.World.Server;
+
+// Per authenticated account, shared by realm and instance connections. The
+// private extension carries no account ID: the core uses its own WorldSession.
+public sealed class AtlasAccountServiceBridge
+{
+    public static ReadOnlySpan<byte> Magic => [0xff, (byte)'A', (byte)'T', (byte)'L', (byte)'S', 2];
+    readonly object _sync = new();
+    readonly HashSet<ulong> _available = new();
+    ulong _nonce;
+    uint _serial, _listRequest;
+    long _lastList = long.MinValue / 2;
+    bool _ready;
+    Pending? _pending;
+    sealed record Pending(uint Request, uint Token, ulong Distribution, WowGuid128 Character, bool Validate, long Started);
+
+    public AtlasAccountServiceBridge() => _nonce = NewNonce();
+    static ulong NewNonce()
+    {
+        ulong result;
+        do { result = BitConverter.ToUInt64(RandomNumberGenerator.GetBytes(8)); } while (result == 0);
+        return result;
+    }
+    public bool Ready { get { lock (_sync) return _ready; } }
+    public void Reset()
+    {
+        lock (_sync)
+        {
+            _nonce = NewNonce(); _ready = false; _pending = null; _lastList = long.MinValue / 2;
+            // Keep IDs until the next authoritative list can revoke them in the
+            // modern client's cache, including after a backend reconnection.
+        }
+    }
+    WorldPacket Header(byte kind, uint request)
+    {
+        var packet = new WorldPacket(Opcode.CMSG_ENUM_CHARACTERS);
+        packet.WriteBytes(Magic.ToArray());
+        packet.WriteUInt8(kind); packet.WriteUInt32(request); packet.WriteUInt64(_nonce);
+        return packet;
+    }
+    public WorldPacket? Subscribe(long now)
+    {
+        lock (_sync)
+        {
+            if (now - _lastList < 500) return null;
+            _lastList = now; _listRequest = ++_serial;
+            return Header(1, _listRequest);
+        }
+    }
+    public WorldPacket? Assign(AtlasAssignNameChange request, bool ownsCharacter, uint realm, bool inWorld, long now)
+    {
+        lock (_sync)
+        {
+            if (!_ready || !request.IsSupportedNameChange || !ownsCharacter || inWorld || request.RealmAddress != realm
+                || (_pending != null && now - _pending.Started < 12_000)) return null;
+            byte[] name = Encoding.UTF8.GetBytes(request.Name);
+            if (name.Length is 0 or > 48) return null;
+            uint serial = ++_serial;
+            _pending = new(serial, request.Token, request.DistributionId, request.Character, request.ValidateOnly, now);
+            var packet = Header(2, serial);
+            packet.WriteUInt64(request.DistributionId); packet.WriteUInt32((uint)request.Character.Low);
+            packet.WriteUInt32(request.Token); packet.WriteUInt8(request.ValidateOnly ? (byte)1 : (byte)0);
+            packet.WriteUInt8((byte)name.Length); packet.WriteBytes(name);
+            return packet;
+        }
+    }
+    public sealed record Result(bool Handled, List<ServerPacket> Packets, WowGuid128 ChangedCharacter = default, string? ChangedName = null,
+        bool ReadinessChanged = false);
+    public Result Receive(WorldPacket packet, WowGuid128 account, uint realm)
+    {
+        ReadOnlySpan<byte> bytes = packet.GetRemainingSpan();
+        if (bytes.Length < 5 || !bytes[..5].SequenceEqual(Magic[..5])) return new(false, new());
+        var output = new List<ServerPacket>();
+        if (bytes.Length < 20 || bytes.Length > 1024 || !bytes[..6].SequenceEqual(Magic)) return new(true, output);
+        using var body = new WorldPacket(1, bytes.ToArray());
+        body.ReadBytes(6);
+        byte kind = body.ReadUInt8();
+        uint request = body.ReadUInt32();
+        ulong nonce = body.ReadUInt64();
+        byte error = body.ReadUInt8();
+        lock (_sync)
+        {
+            if (nonce != _nonce || error > 1) return new(true, output);
+            if (kind == 1)
+            {
+                if (request != _listRequest || !body.CanRead(4)) return new(true, output);
+                uint count = body.ReadUInt32();
+                if (count > 100 || body.GetRemainingSpan().Length != count * 8 || (error != 0 && count != 0)) return new(true, output);
+                var incoming = new HashSet<ulong>();
+                for (uint i = 0; i < count; ++i)
+                {
+                    ulong id = body.ReadUInt64();
+                    if (id == 0 || !incoming.Add(id)) return new(true, output);
+                }
+                foreach (ulong removed in _available.Except(incoming))
+                    output.Add(new AtlasDistributionUpdate { Distribution = Distribution(removed, account, realm, revoked: true) });
+                _available.Clear(); _available.UnionWith(incoming);
+                bool readinessChanged = _ready != (error == 0);
+                _ready = error == 0;
+                var list = new AtlasDistributionList();
+                foreach (ulong id in incoming.Order()) list.Distributions.Add(Distribution(id, account, realm));
+                output.Add(list);
+                return new(true, output, ReadinessChanged: readinessChanged);
+            }
+            if (kind != 2 || _pending is not { } pending || request != pending.Request || !body.CanRead(18)) return new(true, output);
+            ulong distribution = body.ReadUInt64();
+            uint guid = body.ReadUInt32(), token = body.ReadUInt32();
+            byte validate = body.ReadUInt8(), length = body.ReadUInt8();
+            if (distribution != pending.Distribution || guid != pending.Character.Low || token != pending.Token
+                || validate != (pending.Validate ? 1 : 0) || length is 0 or > 48 || body.GetRemainingSpan().Length != length)
+                return new(true, output);
+            string name;
+            try { name = new UTF8Encoding(false, true).GetString(body.ReadBytes(length)); }
+            catch (DecoderFallbackException) { return new(true, output); }
+            if (name.IndexOf('\0') >= 0) return new(true, output);
+            _pending = null;
+            bool changed = error == 0 && !pending.Validate;
+            if (changed)
+            {
+                _available.Remove(distribution);
+                var consumed = Distribution(distribution, account, realm);
+                consumed.Status = 3; consumed.Character = pending.Character;
+                output.Add(new AtlasDistributionUpdate { Distribution = consumed });
+            }
+            output.Add(new AtlasAssignVasResponse { Token = token, StoreError = error == 0 ? 0u : 3u });
+            return new(true, output, changed ? pending.Character : default, changed ? name : null);
+        }
+    }
+    static AtlasDistribution Distribution(ulong id, WowGuid128 account, uint realm, bool revoked = false) =>
+        new() { Id = id, Account = account, RealmAddress = realm, Revoked = revoked };
+}
