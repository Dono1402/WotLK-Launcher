+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text.Json;
+using Framework.Constants;
+using HermesProxy.Enums;
+using HermesProxy.World;
+using HermesProxy.World.Enums;
+using HermesProxy.World.Server.Packets;
+using Xunit;
+
+namespace HermesProxy.Tests.World.Server;
+
+public class PlayerIdentityPacketsTests
+{
+    sealed class NameResponse : QueryPlayerNameResponse
+    {
+        public byte[] Fallback() { Write(); return _worldPacket.GetData(); }
+    }
+
+    [Fact]
+    public void NamePackets_MatchBothWritersAndExposeNativeClientFixtures()
+    {
+        const uint realm = 0x01010001;
+        var guid = new WowGuid128(981, (2ul << 58) | (1ul << 42));
+        var auth = new AuthResponse
+        {
+            Result = BattlenetRpcErrorCode.Ok,
+            SuccessInfo = new AuthResponse.AuthSuccessInfo
+            {
+                VirtualRealmAddress = realm, ActiveExpansionLevel = 3, AccountExpansionLevel = 3
+            }
+        };
+        auth.SuccessInfo.VirtualRealms.Add(new VirtualRealmInfo(realm, true, false, "Arthas", "Arthas"));
+        auth.WritePacketData();
+        var invalidation = new InvalidatePlayer { Guid = guid };
+        invalidation.WritePacketData();
+        var names = new Dictionary<string, string>();
+        foreach (string name in new[] { "Avant", "Après", "Éléonore", "Derniernom" })
+        {
+            NameResponse Create() => new()
+            {
+                Player = guid,
+                Data = new PlayerGuidLookupData
+                {
+                    Name = name, GuidActual = guid,
+                    AccountID = new WowGuid128(51, 29ul << 58),
+                    BnetAccountID = new WowGuid128(51, 30ul << 58),
+                    VirtualRealmAddress = realm, RaceID = (Race)11,
+                    Sex = (Gender)1, ClassID = (Class)7, Level = 60
+                }
+            };
+            var response = Create();
+            response.WritePacketData();
+            Assert.Equal(Create().Fallback(), response.GetData());
+            Assert.Equal(0x301bu, response.GetOpcode());
+            names.Add(name, Convert.ToHexString(response.GetData()!));
+        }
+        string? output = Environment.GetEnvironmentVariable("HERMES_IDENTITY_PACKET_OUTPUT");
+        if (!string.IsNullOrEmpty(output))
+            File.WriteAllText(output, JsonSerializer.Serialize(new
+            {
+                realm, guidLow = guid.Low, guidHigh = guid.High,
+                auth = Convert.ToHexString(auth.GetData()!),
+                invalidate = Convert.ToHexString(invalidation.GetData()!), names
+            }, new JsonSerializerOptions { WriteIndented = true }));
+    }
+}
