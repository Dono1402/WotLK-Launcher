+/// <summary>
+/// One entry in a Wrath Classic 3.4.3 talent-preview commit.
+/// The modern wire rank is one byte; the legacy 3.3.5a packet widens it to uint32.
+/// </summary>
+public readonly record struct PreviewTalentEntry(uint TalentID, byte Rank);
+
+/// <summary>
+/// Wrath Classic 3.4.3 CMSG_LEARN_PREVIEW_TALENTS (0x3553 / 13651).
+/// Wire layout: uint32 Count, then Count x (uint32 TalentID, uint8 Rank).
+/// </summary>
+public sealed class LearnPreviewTalents : ClientPacket
+{
+    private const int TalentWireSize = sizeof(uint) + sizeof(byte);
+    public const uint MaxTalentCount = 60;
+
+    public uint DeclaredCount { get; private set; }
+    public int PayloadBytes { get; private set; }
+    public List<PreviewTalentEntry> Talents { get; } = new();
+    public bool IsValid { get; private set; }
+
+    public LearnPreviewTalents(WorldPacket packet) : base(packet) { }
+
+    public override void Read()
+    {
+        PayloadBytes = _worldPacket.Remaining();
+        if (!_worldPacket.CanRead(sizeof(uint)))
+            return;
+
+        DeclaredCount = _worldPacket.ReadUInt32();
+        if (DeclaredCount > MaxTalentCount)
+            return;
+
+        int expectedTalentBytes = (int)DeclaredCount * TalentWireSize;
+        if (_worldPacket.Remaining() != expectedTalentBytes)
+            return;
+
+        Talents.Capacity = (int)DeclaredCount;
+        for (uint i = 0; i < DeclaredCount; ++i)
+        {
+            Talents.Add(new PreviewTalentEntry(
+                _worldPacket.ReadUInt32(),
+                _worldPacket.ReadUInt8()));
+        }
+
+        IsValid = true;
+    }
+}
