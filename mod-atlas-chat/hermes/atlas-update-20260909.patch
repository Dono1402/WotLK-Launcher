+using System.Text;
+using Framework.IO;
+using HermesProxy.World.Chat;
+using HermesProxy.World.Enums;
+using HermesProxy.World.Server.Packets;
+using Xunit;
+
+namespace HermesProxy.Tests.World.Server;
+
+public class AddonChatCompatibilityTests
+{
+    [Theory]
+    [InlineData("Ohptnfranck-", "Ohptnfranck")]
+    [InlineData("Flowmage-Arthas", "Flowmage")]
+    [InlineData("Flowmage", "Flowmage")]
+    public void LegacyTarget_RemovesModernRealmSuffix(string target, string expected)
+    {
+        Assert.Equal(expected, LegacyChatTarget.Normalize(target));
+    }
+
+    [Fact]
+    public void AddonPayload_Latin1RoundTrip_PreservesEveryByte()
+    {
+        byte[] payload = [0x01, 0x09, 0x7F, 0x80, 0xCA, 0xF7, 0xCC, 0xFF];
+        string encoded = Encoding.Latin1.GetString(payload);
+
+        using var writer = new ByteBuffer();
+        writer.WriteCString(encoded, Encoding.Latin1);
+        byte[] wire = writer.GetData();
+
+        Assert.Equal(payload, wire[..^1]);
+        Assert.Equal(0, wire[^1]);
+
+        using var reader = new ByteBuffer(wire);
+        Assert.Equal(encoded, reader.ReadString((uint)payload.Length, Encoding.Latin1));
+    }
+
+    [Fact]
+    public void LegacyAddonPayload_SplitsOnlyTheFirstTab()
+    {
+        uint language = (uint)Language.Addon;
+        string text = "WeakAuras\tchunk-one\tchunk-two";
+        string prefix = "";
+
+        bool accepted = ChatPkt.CheckAddonPrefix(["WeakAuras"], ref language, ref text, ref prefix);
+
+        Assert.True(accepted);
+        Assert.Equal((uint)Language.AddonBfA, language);
+        Assert.Equal("WeakAuras", prefix);
+        Assert.Equal("chunk-one\tchunk-two", text);
+    }
+}
