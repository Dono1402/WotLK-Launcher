<Window x:Class="WotLK.Launcher.UI.V2.LauncherShellV2"
        x:Name="ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:presentation="clr-namespace:WotLK.Launcher.UI.V2.Presentation"
        xmlns:views="clr-namespace:WotLK.Launcher.UI.V2.Views"
        Title="Atlas Launcher · Prévisualisation V2"
        Icon="/WotLK.Launcher;component/Assets/AppIcon.ico"
        Width="1597.6"
        Height="996.8"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        FontFamily="{StaticResource AtlasV2.Font.Inter}"
        Background="{DynamicResource AtlasV2.Brush.Window}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary Source="Resources/AtlasV2.Pilot.xaml"/>
    </Window.Resources>

    <Border Background="{StaticResource AtlasV2.Brush.WindowAmbient}"
            BorderBrush="#3A444F"
            BorderThickness="0"
            TextElement.FontFamily="{StaticResource AtlasV2.Font.Inter}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ContentTopRow" Height="124"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <views:CitadelBackdropV2 x:Name="SecondaryBackdrop" Grid.RowSpan="2"
                                     IsHitTestVisible="False" Focusable="False" Visibility="Collapsed"/>

            <views:GameViewV2 x:Name="GameView"
                              Grid.RowSpan="2"
                              State="{Binding GameState}"
                              DashboardState="{Binding DashboardState}"
                              LayoutMode="{Binding ShellState.LayoutMode}"
                              PatchNoteRequested="GameView_PatchNoteRequested"/>

            <views:ArmoryViewV2 x:Name="ArmoryView" Grid.RowSpan="2" Panel.ZIndex="10" Visibility="Collapsed"
                                WindowDragRequested="ArmoryView_WindowDragRequested"
                                HeaderHoverChanged="ArmoryView_HeaderHoverChanged"
                                CustomizeRequested="ArmoryView_CustomizeRequested"
                                ProfileSaveRequested="ArmoryView_ProfileSaveRequested"
                                AvatarChangeRequested="ArmoryView_AvatarChangeRequested"
                                AvatarRemoveRequested="ArmoryView_AvatarRemoveRequested"/>

            <Border x:Name="TopChromeDragZone" Grid.RowSpan="2" Panel.ZIndex="18"
                    Height="124" VerticalAlignment="Top" Background="Transparent" Focusable="False"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

            <Border x:Name="ProfileTitleBarHoverZone" Grid.RowSpan="2" Panel.ZIndex="19"
                    Height="24" VerticalAlignment="Top" Background="Transparent"
                    Focusable="False" Visibility="Collapsed"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseEnter="ProfileTitleBarHover_MouseEnter"
                    MouseLeave="ProfileTitleBarHover_MouseLeave"/>

            <Border x:Name="TitleBar"
                    Grid.RowSpan="2"
                    Panel.ZIndex="20"
                    Height="80"
                    Margin="22,22,22,0"
                    VerticalAlignment="Top"
                    Background="{StaticResource AtlasV2.Pilot.Shell.TopBar}"
                    BorderBrush="#703D566E"
                    BorderThickness="1"
                    CornerRadius="14"
                    TextElement.FontFamily="{StaticResource AtlasV2.Font.Inter}"
                    MouseEnter="ProfileTitleBarHover_MouseEnter"
                    MouseLeave="ProfileTitleBarHover_MouseLeave"
                    LostMouseCapture="ProfileTitleBarHover_MouseLeave"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ProfileTitleBarTransform"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="BrandIdentity" Grid.Column="0" Margin="24,0,72,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="BrandLogo" Width="42"
                               Height="42"
                               Source="/WotLK.Launcher;component/Assets/Branding/AtlasLauncherLogo.png"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="Uniform"/>
                        <TextBlock x:Name="BrandName" Grid.Column="1"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Atlas Launcher"
                                   Style="{StaticResource AtlasV2.Text.Body}"
                                   FontFamily="{StaticResource AtlasV2.Font.Inter}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextWrapping="NoWrap"
                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        <Border x:Name="LocalBuildBadge"
                                Grid.Column="2"
                                Margin="18,0,0,0"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                Background="{StaticResource AtlasV2.Brush.CyanSurface}"
                                BorderBrush="{StaticResource AtlasV2.Brush.CyanBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ToolTip="Version locale de test"
                                Visibility="{Binding ShellState.IsLocalBuild, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                            <TextBlock x:Name="LocalBuildBadgeText"
                                       Text="LOCAL"
                                       FontFamily="{StaticResource AtlasV2.Font.Inter}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                        </Border>
                        <Border x:Name="ProductDivider"
                                Grid.Column="3"
                                Width="1"
                                Height="22"
                                Margin="14,0"
                                Background="{StaticResource AtlasV2.Brush.Border}"/>
                        <TextBlock x:Name="ProductGameName"
                                   Grid.Column="4"
                                   VerticalAlignment="Center"
                                   Text="{Binding ShellState.GameName}"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   FontFamily="{StaticResource AtlasV2.Font.Inter}"
                                   FontSize="16"
                                   FontWeight="Normal"
                                   TextWrapping="NoWrap"
                                   Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                    </Grid>

                    <StackPanel x:Name="TopNavigation"
                                Grid.Column="1"
                                Orientation="Horizontal">
                        <Button x:Name="GameNavigationButton"
                                Style="{StaticResource AtlasV2.Pilot.Shell.Nav}"
                                Tag="Active"
                                Content="Jeu"
                                IsEnabled="{Binding ShellState.IsGameNavigationEnabled}"
                                Focusable="True"
                                Click="GameNavigationButton_Click"/>
                        <Button x:Name="AddonsNavigationButton"
                                Style="{StaticResource AtlasV2.Pilot.Shell.Nav}"
                                Content="Addons"
                                IsEnabled="{Binding ShellState.IsNavigationEnabled}"
                                Focusable="True"
                                Click="AddonsNavigationButton_Click"/>
                        <Button x:Name="PatchNotesNavigationButton"
                                Style="{StaticResource AtlasV2.Pilot.Shell.Nav}"
                                IsEnabled="{Binding ShellState.IsNavigationEnabled}"
                                Focusable="True"
                                Click="PatchNotesNavigationButton_Click">
                            <TextBlock x:Name="PatchNotesNavigationLabel"
                                       Text="Notes de version"/>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="TopBarActions" Grid.Column="3"
                                Margin="0,0,12,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="LauncherUpdateButton"
                                Width="40"
                                Height="40"
                                Margin="0,0,5,0"
                                ToolTip="Mettre à jour Atlas Launcher"
                                ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.Name="Mettre à jour Atlas Launcher"
                                Command="{Binding SettingsState.StartLauncherUpdateCommand}"
                                Click="LauncherUpdateButton_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource AtlasV2.Pilot.Shell.Icon}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Success}"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SettingsState.Current.Updates.IsUpdateAvailable}" Value="True"/>
                                                <Condition Binding="{Binding SettingsState.Current.Updates.IsUpdating}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SuccessSurface}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SuccessBorder}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Width="20"
                                  Height="20"
                                  Data="{StaticResource AtlasV2.Icon.Refresh}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>

                        <Button x:Name="ActivityButton"
                                Height="40"
                                Margin="0,0,5,0"
                                Padding="10,0"
                                ToolTip="Activité"
                                Focusable="True"
                                AutomationProperties.Name="Ouvrir le centre d’activité"
                                Click="ActivityButton_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource AtlasV2.Pilot.Shell.Icon}">
                                    <Setter Property="Width" Value="44"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivityState.Current.TopBarShowsPercent}" Value="True">
                                            <Setter Property="Width" Value="72"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActivityState.IsOpen}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfacePressed}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Width="17"
                                      Height="17"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource AtlasV2.Icon.Download}">
                                    <Path.Style>
                                        <Style TargetType="{x:Type Path}"
                                               BasedOn="{StaticResource AtlasV2.Icon.Stroke}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActivityState.Current.HasActiveOperation}" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ActivityState.Current.TopBarIsIndeterminate}" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="ActivityIndeterminateStoryboard">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.45"
                                                                                 To="1"
                                                                                 Duration="0:0:0.7"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="ActivityIndeterminateStoryboard"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock x:Name="ActivityPercentText"
                                           Grid.Column="1"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding ActivityState.Current.TopBarPercentText}"
                                           Style="{StaticResource AtlasV2.Text.Caption}"
                                           FontFamily="{StaticResource AtlasV2.Font.Inter}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AtlasV2.Brush.Cyan}"
                                           Visibility="{Binding ActivityState.Current.TopBarShowsPercent, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                                <Ellipse Grid.ColumnSpan="2"
                                         Width="6"
                                         Height="6"
                                         Margin="0,-16,-20,0"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Fill="{StaticResource AtlasV2.Brush.Danger}"
                                         Visibility="{Binding ActivityState.Current.HasRecentFailure, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                            </Grid>
                        </Button>

                        <Button x:Name="FriendsButton"
                                Width="40"
                                Height="40"
                                Margin="0,0,5,0"
                                Padding="10"
                                Style="{StaticResource AtlasV2.Pilot.Shell.Icon}"
                                ToolTip="Amis"
                                IsEnabled="{Binding ShellState.IsNavigationEnabled}"
                                AutomationProperties.Name="Ouvrir le panneau Amis"
                                Click="FriendsButton_Click">
                            <Path Width="18"
                                  Height="18"
                                  Data="{StaticResource AtlasV2.Icon.Users}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>

                        <Button x:Name="SettingsButton"
                                Margin="0,0,3,0"
                                Style="{StaticResource AtlasV2.Pilot.Shell.Icon}"
                                ToolTip="Paramètres"
                                IsEnabled="{Binding IsSettingsNavigationEnabled}"
                                AutomationProperties.Name="Paramètres"
                                Click="SettingsButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.Settings}">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}"
                                           BasedOn="{StaticResource AtlasV2.Icon.Stroke}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                         Value="Active">
                                                <Setter Property="Stroke" Value="#80DAFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <Border x:Name="ProfileDivider" Width="1" Height="25" Margin="10,0,14,0"
                                Background="#879AAEBF" VerticalAlignment="Center"/>

                        <Button x:Name="ProfileButton"
                                Width="40"
                                Height="40"
                                Margin="0,0,8,0"
                                Padding="0"
                                Style="{StaticResource AtlasV2.Pilot.Shell.Icon}"
                                 ToolTip="{Binding ShellState.ProfileToolTip}"
                                 IsEnabled="{Binding ShellState.IsProfileActionEnabled}"
                                 Visibility="{Binding ShellState.IsAuthenticated, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                Focusable="True"
                                AutomationProperties.Name="{Binding ShellState.ProfileToolTip}"
                                Click="ProfileButton_Click">
                            <Grid x:Name="ProfileAvatarVisual" Width="42" Height="42">
                                <Ellipse Fill="{StaticResource AtlasV2.Brush.Gold}"/>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding ShellState.ProfileInitial}"
                                           FontFamily="{StaticResource AtlasV2.Font.Inter}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#111318"/>
                                <Ellipse x:Name="ShellProfileAvatarImage">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding ShellState.ProfileAvatarImage}"
                                                    Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShellState.HasProfileAvatar}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse IsHitTestVisible="False"
                                         Stroke="{StaticResource AtlasV2.Brush.GoldBorder}"
                                         StrokeThickness="1.5"/>
                            </Grid>
                        </Button>

                        <Button x:Name="MinimizeWindowButton"
                                Style="{StaticResource AtlasV2.Pilot.Shell.Window}"
                                ToolTip="Réduire"
                                AutomationProperties.Name="Réduire"
                                Click="MinimizeButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.Minus}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                        <Button x:Name="MaximizeWindowButton"
                                Visibility="Collapsed"
                                IsEnabled="False"
                                Style="{StaticResource AtlasV2.Pilot.Shell.Window}"
                                ToolTip="Agrandir ou restaurer"
                                AutomationProperties.Name="Agrandir ou restaurer"
                                Click="MaximizeRestoreButton_Click">
                            <Grid>
                                <Path x:Name="MaximizeIcon"
                                      Data="{StaticResource AtlasV2.Icon.Maximize}"
                                      Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                <Path x:Name="RestoreIcon"
                                      Data="{StaticResource AtlasV2.Icon.Restore}"
                                      Style="{StaticResource AtlasV2.Icon.Stroke}"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="CloseWindowButton"
                                Style="{StaticResource AtlasV2.Pilot.Shell.Close}"
                                ToolTip="Réduire dans la zone de notification"
                                AutomationProperties.Name="Réduire dans la zone de notification"
                                Click="CloseWindowButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.Close}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Panel.ZIndex="30">
                <views:AddonsViewV2 x:Name="AddonsView"
                                    Visibility="Collapsed"
                                    State="{Binding AddonsState}"
                                    LayoutMode="{Binding ShellState.LayoutMode}"/>
                <views:PatchNotesViewV2 x:Name="PatchNotesView"
                                        Visibility="Collapsed"
                                        State="{Binding DashboardState}"
                                        LayoutMode="{Binding ShellState.LayoutMode}"/>
                <views:SettingsViewV2 x:Name="SettingsView"
                                       Visibility="Collapsed"
                                       State="{Binding SettingsState}"
                                       LayoutMode="{Binding ShellState.LayoutMode}"/>
                <views:AccountViewV2 x:Name="AccountView"
                                     Visibility="Collapsed"
                                     State="{Binding AccountState}"
                                     LayoutMode="{Binding ShellState.LayoutMode}"
                                     ModifyAvatarRequested="AccountView_ModifyAvatarRequested"
                                     RemoveAvatarRequested="AccountView_RemoveAvatarRequested"
                                     ConfirmAvatarDeleteRequested="AccountView_ConfirmAvatarDeleteRequested"/>
                <views:ActivityCenterPanelV2 x:Name="ActivityCenter"
                                             Panel.ZIndex="50"
                                             State="{Binding ActivityState}"
                                             IsOpen="{Binding ActivityState.IsOpen, Mode=TwoWay}"
                                             CloseRequested="ActivityCenter_CloseRequested"
                                             CancelRequested="ActivityCenter_CancelRequested"
                                             NavigationRequested="ActivityCenter_NavigationRequested"
                                             Closed="ActivityCenter_Closed"/>
                <views:FriendsDrawerV2 x:Name="FriendsDrawer"
                                       Panel.ZIndex="50"
                                       State="{Binding FriendsState}"
                                       IsOpen="{Binding FriendsState.IsOpen, Mode=TwoWay}"
                                       CloseRequested="FriendsDrawer_CloseRequested"
                                       Closed="FriendsDrawer_Closed"/>
                <views:PatchNoteOverlayV2 x:Name="PatchNoteOverlay"
                                          Panel.ZIndex="90"
                                          State="{Binding DashboardState}"
                                          IsOpen="{Binding PatchNoteState.IsOpen, Mode=TwoWay}"
                                          CloseRequested="PatchNoteOverlay_CloseRequested"
                                          Closed="PatchNoteOverlay_Closed"/>
                <views:AuthOverlayViewV2 x:Name="AuthOverlay"
                                         Panel.ZIndex="100"
                                         State="{Binding AuthState}"
                                         IsOpen="{Binding AuthState.IsOpen, Mode=TwoWay}"
                                          CloseRequested="AuthOverlay_CloseRequested"
                                          Closed="AuthOverlay_Closed"/>
                <views:AvatarCropOverlayV2 x:Name="AvatarCropOverlay"
                                           Panel.ZIndex="120"
                                           State="{Binding AvatarCropState}"
                                           IsOpen="{Binding AvatarCropState.IsOpen, Mode=TwoWay}"
                                           LayoutMode="{Binding ShellState.LayoutMode}"
                                           CloseRequested="AvatarCropOverlay_CloseRequested"
                                           UploadRequested="AvatarCropOverlay_UploadRequested"
                                           Closed="AvatarCropOverlay_Closed"/>
            </Grid>

            <views:ProfileMenuV2 x:Name="ProfileMenu"
                                 Grid.RowSpan="2"
                                 Margin="0,110,182,0"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Panel.ZIndex="150"
                                  State="{Binding ProfileState}"
                                  IsOpen="{Binding ProfileState.IsOpen, Mode=TwoWay}"
                                  IsManageProfileEnabled="{Binding AccountState.IsNavigationEnabled}"
                                  IsManageAccountEnabled="{Binding AccountState.IsNavigationEnabled}"
                                  CloseRequested="ProfileMenu_CloseRequested"
                                  ManageProfileRequested="ProfileMenu_ManageProfileRequested"
                                  ManageAccountRequested="ProfileMenu_ManageAccountRequested"
                                  Closed="ProfileMenu_Closed"/>
        </Grid>
    </Border>
</Window>
