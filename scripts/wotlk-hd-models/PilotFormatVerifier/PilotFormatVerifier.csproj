<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="WoWFormatLib"><HintPath>$(WoWFormatLibAssembly)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireFormatLibrary" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(WoWFormatLibAssembly)')" Text="Supply the separately built WoWFormatLib assembly with -p:WoWFormatLibAssembly=..." />
  </Target>
</Project>
