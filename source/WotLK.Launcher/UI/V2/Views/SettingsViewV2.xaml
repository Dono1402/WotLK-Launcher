<UserControl x:Class="WotLK.Launcher.UI.V2.Views.SettingsViewV2"
             x:Name="SettingsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="796"
             Background="{StaticResource AtlasV2.Brush.Window}"
             FontFamily="{StaticResource AtlasV2.Font.Manrope}"
             Focusable="False"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="AtlasV2.Settings.NavButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource AtlasV2.Button.Base}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextSecondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="Surface"
                              Background="{TemplateBinding Background}">
                            <Border x:Name="SelectionIndicator"
                                    Width="3"
                                    Margin="0,9,0,9"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AtlasV2.Brush.Gold}"
                                    CornerRadius="0,2,2,0"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{StaticResource AtlasV2.Brush.SurfaceHover}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource AtlasV2.Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{StaticResource AtlasV2.Brush.SurfaceRaised}"/>
                                <Setter TargetName="SelectionIndicator"
                                        Property="Visibility"
                                        Value="Visible"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource AtlasV2.Brush.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AtlasV2.Settings.OptionTitle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource AtlasV2.Text.Body}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
        </Style>

        <Style x:Key="AtlasV2.Settings.ReadOnlyAction"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource AtlasV2.Button.Base}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>

        <Style x:Key="AtlasV2.Settings.Action"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource AtlasV2.Button.Base}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>

        <Style x:Key="AtlasV2.Settings.Separator" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,17"/>
            <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.BorderSoft}"/>
        </Style>

        <Style x:Key="AtlasV2.Settings.DeferredField"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource AtlasV2.Field.Container}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.48"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AtlasV2.Settings.DeferredCard"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource AtlasV2.Card}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.48"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      PanningMode="VerticalOnly">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}"
                       BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/>
            </ScrollViewer.Resources>

            <Grid x:Name="ContentFrame"
                  MaxWidth="1280"
                  Margin="34,26,34,38"
                  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="PageHeader">
                    <TextBlock Text="ATLAS LAUNCHER"
                               Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                    <TextBlock x:Name="PageTitle"
                               Margin="0,6,0,0"
                               Text="Paramètres"
                               FontFamily="{StaticResource AtlasV2.Font.Manrope}"
                               FontSize="30"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                    <TextBlock Margin="0,5,0,0"
                               Text="Personnalise Atlas Launcher et ton client WotLK Classic."
                               Style="{StaticResource AtlasV2.Text.Body}"/>
                    <Border x:Name="RuntimeNotice"
                            Margin="0,12,0,0"
                            Padding="12,9"
                            Background="{StaticResource AtlasV2.Brush.DangerSurface}"
                            BorderBrush="{StaticResource AtlasV2.Brush.DangerBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="14"
                                  Height="14"
                                  Data="{StaticResource AtlasV2.Icon.AlertCircle}"
                                  Stroke="{StaticResource AtlasV2.Brush.Danger}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                            <TextBlock x:Name="RuntimeNoticeText"
                                       Grid.Column="1"
                                       Margin="8,0,0,0"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource AtlasV2.Text.Caption}"
                                       Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid x:Name="SettingsWorkspace" Grid.Row="1" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NavigationColumn" Width="224"/>
                        <ColumnDefinition x:Name="NavigationGap" Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="CategoryNavigation"
                            Grid.Column="0"
                            Padding="8,10,8,12"
                            VerticalAlignment="Top"
                            Background="#A811161C"
                            BorderBrush="{StaticResource AtlasV2.Brush.BorderSoft}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Margin="12,4,12,9"
                                       Text="CATÉGORIES"
                                       Style="{StaticResource AtlasV2.Text.Caption}"
                                       FontWeight="Bold"/>

                            <Button x:Name="GeneralCategoryButton"
                                    Style="{StaticResource AtlasV2.Settings.NavButton}"
                                    AutomationProperties.Name="Général"
                                    Click="GeneralCategoryButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17"
                                          Height="17"
                                          Data="{StaticResource AtlasV2.Icon.Sliders}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Général"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button x:Name="GameCategoryButton"
                                    Style="{StaticResource AtlasV2.Settings.NavButton}"
                                    AutomationProperties.Name="Jeu"
                                    Click="GameCategoryButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17"
                                          Height="17"
                                          Data="{StaticResource AtlasV2.Icon.Gamepad}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Jeu"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button x:Name="UpdatesCategoryButton"
                                    Style="{StaticResource AtlasV2.Settings.NavButton}"
                                    AutomationProperties.Name="Mises à jour"
                                    Click="UpdatesCategoryButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17"
                                          Height="17"
                                          Data="{StaticResource AtlasV2.Icon.Refresh}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Mises à jour"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button x:Name="NotificationsCategoryButton"
                                    Style="{StaticResource AtlasV2.Settings.NavButton}"
                                    AutomationProperties.Name="Notifications"
                                    Click="NotificationsCategoryButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17"
                                          Height="17"
                                          Data="{StaticResource AtlasV2.Icon.Bell}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Notifications"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button x:Name="DiagnosticCategoryButton"
                                    Style="{StaticResource AtlasV2.Settings.NavButton}"
                                    AutomationProperties.Name="Aide et diagnostic"
                                    Click="DiagnosticCategoryButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17"
                                          Height="17"
                                          Data="{StaticResource AtlasV2.Icon.Activity}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Aide et diagnostic"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Grid x:Name="CategoryContentHost" Grid.Column="2">
                        <StackPanel x:Name="GeneralPanel">
                            <TextBlock Text="Général"
                                       Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                       FontSize="24"/>

                            <Border Margin="0,12,0,0"
                                    Style="{StaticResource AtlasV2.Card}"
                                    Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Préférences du launcher"
                                               Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                               FontSize="18"/>

                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,20,0"
                                                   VerticalAlignment="Center"
                                                   Text="Langue de l’interface"
                                                   Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                        <ComboBox x:Name="InterfaceLanguageComboBox"
                                                  Grid.Column="1"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding State.Current.General.InterfaceLocale, ElementName=SettingsRoot, Mode=OneWay}"
                                                  IsHitTestVisible="{Binding State.Current.CanChangeInterfaceLocale, ElementName=SettingsRoot}"
                                                  Focusable="{Binding State.Current.CanChangeInterfaceLocale, ElementName=SettingsRoot}"
                                                  Style="{StaticResource AtlasV2.ComboBox.Field}"
                                                  SelectionChanged="InterfaceLanguageComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Français" Tag="fr-FR"/>
                                            <ComboBoxItem Content="English" Tag="en-US"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Style="{StaticResource AtlasV2.Settings.Separator}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,20,0"
                                                   VerticalAlignment="Center"
                                                   Text="Démarrer avec Windows"
                                                   Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                        <ToggleButton x:Name="StartWithWindowsToggle"
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding State.Current.General.StartWithWindows, ElementName=SettingsRoot, Mode=OneWay}"
                                                      IsHitTestVisible="{Binding State.Current.CanChangeStartWithWindows, ElementName=SettingsRoot}"
                                                      Focusable="{Binding State.Current.CanChangeStartWithWindows, ElementName=SettingsRoot}"
                                                      Style="{StaticResource AtlasV2.Toggle}"
                                                      Click="StartWithWindowsToggle_Click"/>
                                    </Grid>

                                    <Border Style="{StaticResource AtlasV2.Settings.Separator}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,20,0"
                                                   VerticalAlignment="Center"
                                                   Text="Réduire dans la zone de notification à la fermeture d’Atlas Launcher"
                                                   Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                        <ToggleButton x:Name="MinimizeToTrayOnCloseToggle"
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding State.Current.General.MinimizeToTrayOnClose, ElementName=SettingsRoot, Mode=OneWay}"
                                                      IsHitTestVisible="{Binding State.Current.CanChangeBehavior, ElementName=SettingsRoot}"
                                                      Focusable="{Binding State.Current.CanChangeBehavior, ElementName=SettingsRoot}"
                                                      Style="{StaticResource AtlasV2.Toggle}"
                                                      Click="MinimizeToTrayOnCloseToggle_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="GamePanel" Visibility="Collapsed">
                            <TextBlock Text="Jeu"
                                       Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                       FontSize="24"/>

                            <Border x:Name="InstallationCard"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource AtlasV2.Card}"
                                    Padding="22">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Width="18"
                                              Height="18"
                                              Data="{StaticResource AtlasV2.Icon.Folder}"
                                              Stroke="{StaticResource AtlasV2.Brush.Gold}"
                                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="Installation du jeu"
                                                   Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                                   FontSize="18"/>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding State.Current.Game.ClientVersion, ElementName=SettingsRoot}"
                                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                                   Foreground="{StaticResource AtlasV2.Brush.Success}"/>
                                    </Grid>

                                    <TextBlock Margin="0,20,0,0"
                                               Text="DOSSIER DU CLIENT"
                                               Style="{StaticResource AtlasV2.Text.Caption}"
                                               FontWeight="Bold"/>
                                    <Border Margin="0,8,0,0"
                                            Style="{StaticResource AtlasV2.Field.Container}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Width="16"
                                                  Height="16"
                                                  Data="{StaticResource AtlasV2.Icon.Folder}"
                                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                            <TextBlock x:Name="InstallPathText"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding State.Current.Game.InstallPath, ElementName=SettingsRoot}"
                                                       Style="{StaticResource AtlasV2.Text.Body}"
                                                       Foreground="{StaticResource AtlasV2.Brush.Text}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>

                                    <WrapPanel Margin="0,14,0,0">
                                        <Button x:Name="BrowseInstallPathButton"
                                                Margin="0,0,8,8"
                                                Content="Parcourir"
                                                Command="{Binding State.BrowseInstallPathCommand, ElementName=SettingsRoot}"
                                                IsHitTestVisible="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                Focusable="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                Style="{StaticResource AtlasV2.Settings.Action}"/>
                                        <Button x:Name="OpenGameFolderButton"
                                                Margin="0,0,8,8"
                                                Command="{Binding State.OpenGameFolderCommand, ElementName=SettingsRoot}"
                                                IsHitTestVisible="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                Focusable="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                Style="{StaticResource AtlasV2.Settings.Action}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14"
                                                      Height="14"
                                                      Margin="0,0,8,0"
                                                      Data="{StaticResource AtlasV2.Icon.Folder}"
                                                      Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                                <TextBlock VerticalAlignment="Center" Text="Ouvrir le dossier"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="VerifyRepairButton"
                                                Margin="0,0,0,8"
                                                Command="{Binding State.VerifyRepairCommand, ElementName=SettingsRoot}"
                                                IsHitTestVisible="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                Focusable="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                Style="{StaticResource AtlasV2.Settings.Action}"
                                                Click="VerifyRepairButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14"
                                                      Height="14"
                                                      Margin="0,0,8,0"
                                                      Data="{StaticResource AtlasV2.Icon.Refresh}"
                                                      Stroke="{StaticResource AtlasV2.Brush.Cyan}"
                                                      Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                                <TextBlock VerticalAlignment="Center" Text="Vérifier et réparer"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0"
                                    Style="{StaticResource AtlasV2.Card}"
                                    Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Configuration du jeu"
                                               Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                               FontSize="18"/>

                                    <Grid Margin="0,19,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,20,0"
                                                   VerticalAlignment="Center"
                                                   Text="Langue du jeu"
                                                   Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                        <ComboBox x:Name="GameLanguageComboBox"
                                                  Grid.Column="1"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding State.Current.Game.GameLocale, ElementName=SettingsRoot, Mode=OneWay}"
                                                  IsHitTestVisible="{Binding State.Current.CanChangeGameLocale, ElementName=SettingsRoot}"
                                                  Focusable="{Binding State.Current.CanChangeGameLocale, ElementName=SettingsRoot}"
                                                  Style="{StaticResource AtlasV2.ComboBox.Field}"
                                                  SelectionChanged="GameLanguageComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Français" Tag="frFR"/>
                                            <ComboBoxItem Content="English" Tag="enUS"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Style="{StaticResource AtlasV2.Settings.Separator}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,20,0"
                                                   VerticalAlignment="Center"
                                                   Text="Texte de quête instantané"
                                                   Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                        <ToggleButton x:Name="InstantQuestTextToggle"
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding State.Current.Game.InstantQuestText, ElementName=SettingsRoot, Mode=OneWay}"
                                                      IsHitTestVisible="{Binding State.Current.CanChangeInstantQuestText, ElementName=SettingsRoot}"
                                                      Focusable="{Binding State.Current.CanChangeInstantQuestText, ElementName=SettingsRoot}"
                                                      Style="{StaticResource AtlasV2.Toggle}"
                                                      Click="InstantQuestTextToggle_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="UpdatesPanel" Visibility="Collapsed">
                            <TextBlock Text="Mises à jour"
                                       Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                       FontSize="24"/>

                            <Border Margin="0,12,0,0"
                                    Style="{StaticResource AtlasV2.Card}"
                                    Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Atlas Launcher"
                                               Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                               FontSize="18"/>

                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Padding="15,12"
                                                Background="{StaticResource AtlasV2.Brush.Field}"
                                                BorderBrush="{StaticResource AtlasV2.Brush.BorderSoft}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="VERSION INSTALLÉE"
                                                           Style="{StaticResource AtlasV2.Text.Caption}"
                                                           FontWeight="Bold"/>
                                                <TextBlock x:Name="LauncherVersionText"
                                                           Margin="0,5,0,0"
                                                           Text="{Binding State.Current.Updates.InstalledLauncherVersion, ElementName=SettingsRoot}"
                                                           Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2"
                                                Padding="15,12"
                                                Background="{StaticResource AtlasV2.Brush.Field}"
                                                BorderBrush="{StaticResource AtlasV2.Brush.BorderSoft}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="VERSION DISPONIBLE"
                                                           Style="{StaticResource AtlasV2.Text.Caption}"
                                                           FontWeight="Bold"/>
                                                <TextBlock x:Name="AvailableLauncherVersionText"
                                                           Margin="0,5,0,0"
                                                           Text="{Binding State.Current.Updates.AvailableLauncherVersion, ElementName=SettingsRoot}"
                                                           Style="{StaticResource AtlasV2.Settings.OptionTitle}"
                                                           Foreground="{StaticResource AtlasV2.Brush.Gold}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="NotificationsPanel" Visibility="Collapsed">
                            <TextBlock Text="Notifications"
                                       Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                       FontSize="24"/>

                            <Border x:Name="NotificationsCard"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource AtlasV2.Card}"
                                    Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Événements"
                                               Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                               FontSize="18"/>

                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,20,0"
                                                   VerticalAlignment="Center"
                                                   Text="Connexions des amis"
                                                   Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                        <ToggleButton x:Name="FriendPresenceNotificationsToggle"
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding State.Current.Notifications.FriendPresence, ElementName=SettingsRoot, Mode=OneWay}"
                                                      IsHitTestVisible="{Binding State.Current.CanChangeFriendPresenceNotifications, ElementName=SettingsRoot}"
                                                      Focusable="{Binding State.Current.CanChangeFriendPresenceNotifications, ElementName=SettingsRoot}"
                                                      Style="{StaticResource AtlasV2.Toggle}"
                                                      Click="FriendPresenceNotificationsToggle_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="DiagnosticPanel" Visibility="Collapsed">
                            <TextBlock Text="Aide et diagnostic"
                                       Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                       FontSize="24"/>

                            <Border Margin="0,12,0,0"
                                    Style="{StaticResource AtlasV2.Card}"
                                    Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Outils"
                                               Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                               FontSize="18"/>
                                    <Grid Margin="0,19,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Path Width="16" Height="16" Data="{StaticResource AtlasV2.Icon.FileText}" Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,20,0"
                                                   VerticalAlignment="Center"
                                                   Text="Journaux locaux"
                                                   Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                        <Button x:Name="OpenLogsButton"
                                                Grid.Column="2"
                                                Content="Ouvrir les journaux"
                                                Command="{Binding State.OpenLogsCommand, ElementName=SettingsRoot}"
                                                IsHitTestVisible="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                Focusable="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                ToolTip="{Binding State.Current.Diagnostic.LogLocation, ElementName=SettingsRoot}"
                                                Style="{StaticResource AtlasV2.Settings.Action}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="StatusVersionsCard"
                                    Margin="0,14,0,0"
                                    Style="{StaticResource AtlasV2.Card}"
                                    Padding="22">
                                <StackPanel>
                                    <TextBlock Text="État et versions"
                                               Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                               FontSize="18"/>
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="État local" Style="{StaticResource AtlasV2.Text.Body}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding State.Current.Diagnostic.LocalState, ElementName=SettingsRoot}" Style="{StaticResource AtlasV2.Text.Body}" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                                    </Grid>
                                    <Grid Margin="0,11,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="État des services" Style="{StaticResource AtlasV2.Text.Body}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding State.Current.Diagnostic.ServiceState, ElementName=SettingsRoot}" Style="{StaticResource AtlasV2.Text.Body}" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.Success}"/>
                                    </Grid>
                                    <Grid Margin="0,11,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Atlas Launcher" Style="{StaticResource AtlasV2.Text.Body}"/>
                                        <TextBlock x:Name="DiagnosticLauncherVersionText" Grid.Column="1" Text="{Binding State.Current.Diagnostic.LauncherVersion, ElementName=SettingsRoot}" Style="{StaticResource AtlasV2.Text.Body}" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                    </Grid>
                                    <Grid Margin="0,11,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Client WotLK Classic" Style="{StaticResource AtlasV2.Text.Body}"/>
                                        <TextBlock x:Name="ClientVersionText" Grid.Column="1" Text="{Binding State.Current.Diagnostic.ClientVersion, ElementName=SettingsRoot}" Style="{StaticResource AtlasV2.Text.Body}" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border x:Name="SettingsActionBar"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{StaticResource AtlasV2.Brush.GoldSurface}"
                BorderBrush="{StaticResource AtlasV2.Brush.GoldBorder}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid x:Name="SettingsActionContent"
                  MaxWidth="1280"
                  HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="SettingsActionIconBadge"
                        Width="34"
                        Height="34"
                        VerticalAlignment="Center"
                        Background="#241D10"
                        BorderBrush="{StaticResource AtlasV2.Brush.GoldBorder}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Path x:Name="SettingsActionIcon"
                          Width="16"
                          Height="16"
                          Data="{StaticResource AtlasV2.Icon.AlertCircle}"
                          Stroke="{StaticResource AtlasV2.Brush.Gold}"
                          Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,20,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SettingsActionStatusText"
                               Text="Modifications non enregistrées"
                               Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                    <TextBlock x:Name="SettingsActionDetailText"
                               Margin="0,2,0,0"
                               Text="Les changements de cette catégorie n’ont pas encore été appliqués."
                               Style="{StaticResource AtlasV2.Text.Caption}"/>
                    <ProgressBar x:Name="SettingsActionProgress"
                                 Width="190"
                                 Margin="0,7,0,0"
                                 HorizontalAlignment="Left"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Style="{StaticResource AtlasV2.Progress.Compact}"/>
                </StackPanel>
                <StackPanel x:Name="SettingsActionButtons"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="CancelSettingsChangesButton"
                            Margin="0,0,10,0"
                            Content="Annuler"
                            Style="{StaticResource AtlasV2.Button.Base}"
                            Focusable="False"
                            IsHitTestVisible="False"/>
                    <Button x:Name="SaveSettingsChangesButton"
                            Content="Enregistrer"
                            Style="{StaticResource AtlasV2.Button.Primary}"
                            Height="44"
                            MinWidth="132"
                            Focusable="False"
                            IsHitTestVisible="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
