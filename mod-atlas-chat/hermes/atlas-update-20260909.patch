+using HermesProxy.Configuration.Options;
+using HermesProxy.Enums;
+using HermesProxy.World.Client;
+using HermesProxy.World.Server.Packets;
+using Xunit;
+
+namespace HermesProxy.Tests.World.Server;
+
+public class DeathKnightCreationPolicyTests
+{
+    [Theory]
+    [InlineData(1)]
+    [InlineData(40)]
+    [InlineData(55)]
+    [InlineData(80)]
+    public void Apply_DefaultOptions_PreservesReportedLevel(int level)
+    {
+        var options = new ClientOptions();
+        var result = new EnumCharactersResult { MaxCharacterLevel = level };
+
+        WorldClient.ApplyDeathKnightCreationLevelPolicy(result, options,
+            ClientVersionBuild.V3_4_3_54261, ClientVersionBuild.V3_3_5a_12340);
+
+        Assert.True(options.RequireDeathKnightLevel);
+        Assert.Equal(level, result.MaxCharacterLevel);
+    }
+
+    [Theory]
+    [InlineData(1, 55)]
+    [InlineData(40, 55)]
+    [InlineData(55, 55)]
+    [InlineData(80, 80)]
+    public void Apply_RequirementDisabled_UnlocksDKWithoutLoweringMaximum(int level, int expected)
+    {
+        var result = new EnumCharactersResult { MaxCharacterLevel = level };
+
+        WorldClient.ApplyDeathKnightCreationLevelPolicy(result,
+            new ClientOptions { RequireDeathKnightLevel = false },
+            ClientVersionBuild.V3_4_3_54261, ClientVersionBuild.V3_3_5a_12340);
+
+        Assert.Equal(expected, result.MaxCharacterLevel);
+        Assert.Empty(result.Characters);
+    }
+
+    [Theory]
+    [InlineData(ClientVersionBuild.V1_14_2_42597, ClientVersionBuild.V3_3_5a_12340)]
+    [InlineData(ClientVersionBuild.V3_4_3_54261, ClientVersionBuild.V2_4_3_8606)]
+    public void Apply_OtherVersions_PreservesReportedLevel(
+        ClientVersionBuild modernBuild, ClientVersionBuild legacyBuild)
+    {
+        var result = new EnumCharactersResult { MaxCharacterLevel = 1 };
+
+        WorldClient.ApplyDeathKnightCreationLevelPolicy(result,
+            new ClientOptions { RequireDeathKnightLevel = false }, modernBuild, legacyBuild);
+
+        Assert.Equal(1, result.MaxCharacterLevel);
+    }
+
+    [Fact]
+    public void Apply_ExistingCharacter_DoesNotChangeRealCharacterLevelOrRestrictions()
+    {
+        var result = new EnumCharactersResult { MaxCharacterLevel = 12, DisabledClassesMask = 8 };
+        var character = new EnumCharactersResult.CharacterInfo { ExperienceLevel = 12 };
+        result.Characters.Add(character);
+
+        WorldClient.ApplyDeathKnightCreationLevelPolicy(result,
+            new ClientOptions { RequireDeathKnightLevel = false },
+            ClientVersionBuild.V3_4_3_54261, ClientVersionBuild.V3_3_5a_12340);
+
+        Assert.Equal(55, result.MaxCharacterLevel);
+        Assert.Same(character, Assert.Single(result.Characters));
+        Assert.Equal((byte)12, character.ExperienceLevel);
+        Assert.Equal(8u, result.DisabledClassesMask);
+    }
+}
diff --git a/HermesProxy.Tests/World/Server/TalentPreviewTranslationTests.cs b/HermesProxy.Tests/World/Server/TalentPreviewTranslationTests.cs
new file mode 100644
index 0000000..d2d305a
--- /dev/null
+++ b/HermesProxy.Tests/World/Server/TalentPreviewTranslationTests.cs
@@ -0,0 +1,185 @@
+using System;
+using System.Buffers.Binary;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using HermesProxy.Enums;
+using HermesProxy.World;
+using HermesProxy.World.Enums;
+using HermesProxy.World.Server;
+using HermesProxy.World.Server.Packets;
+using Xunit;
+using V335 = HermesProxy.World.Enums.V3_3_5a_12340;
+using V343 = HermesProxy.World.Enums.V3_4_3_54261;
+
+namespace HermesProxy.Tests.World.Server;
+
+public class TalentPreviewTranslationTests
+{
+    private static readonly PreviewTalentEntry[] TwoTalents =
+    {
+        new(0x11223344u, 4),
+        new(0xA1B2C3D4u, 1),
+    };
+
+    [Fact]
+    public void V343_PreviewOpcode_MapsInBothDirections_WithoutChangingAdjacentOpcodes()
+    {
+        Assert.Equal(13650u, (uint)V343.Opcode.CMSG_LEARN_TALENT);
+        Assert.Equal(13651u, (uint)V343.Opcode.CMSG_LEARN_PREVIEW_TALENTS);
+        Assert.Equal(13652u, (uint)V343.Opcode.CMSG_PET_LEARN_TALENT);
+
+        Assert.True(GeneratedOpcodeTables.TryGet(
+            ClientVersionBuild.V3_4_3_54261,
+            out Opcode[] currentToUniversal,
+            out uint[] universalToCurrent));
+
+        Assert.Equal(Opcode.CMSG_LEARN_TALENT, currentToUniversal[13650]);
+        Assert.Equal(Opcode.CMSG_LEARN_PREVIEW_TALENTS, currentToUniversal[13651]);
+        Assert.Equal(Opcode.CMSG_PET_LEARN_TALENT, currentToUniversal[13652]);
+        Assert.Equal(13651u, universalToCurrent[(uint)Opcode.CMSG_LEARN_PREVIEW_TALENTS]);
+
+        Assert.Equal(0x4C1u, (uint)V335.Opcode.CMSG_LEARN_PREVIEW_TALENTS);
+        Assert.Equal(
+            0x4C1u,
+            Opcodes.GetOpcodeValueForVersion(
+                Opcode.CMSG_LEARN_PREVIEW_TALENTS,
+                ClientVersionBuild.V3_3_5a_12340));
+    }
+
+    [Fact]
+    public void PreviewHandler_IsRegisteredExactlyOnce()
+    {
+        var handlers = typeof(WorldSocket)
+            .GetMethods(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)
+            .SelectMany(method => method
+                .GetCustomAttributes<PacketHandlerAttribute>()
+                .Select(attribute => (Method: method, Attribute: attribute)))
+            .Where(entry => entry.Attribute.Opcode == Opcode.CMSG_LEARN_PREVIEW_TALENTS)
+            .ToList();
+
+        var handler = Assert.Single(handlers);
+        Assert.Equal(typeof(LearnPreviewTalents), handler.Method.GetParameters()[0].ParameterType);
+    }
+
+    [Fact]
+    public void PreviewParser_ReadsCountThenUInt32IdAndUInt8Rank()
+    {
+        using var preview = Parse(BuildModernPayload(TwoTalents));
+
+        Assert.True(preview.IsValid);
+        Assert.Equal(2u, preview.DeclaredCount);
+        Assert.Equal(14, preview.PayloadBytes);
+        Assert.Equal(TwoTalents, preview.Talents);
+    }
+
+    [Fact]
+    public void PreviewParser_AcceptsEmptyAndMaximumBatches()
+    {
+        using var empty = Parse(BuildModernPayload(Array.Empty<PreviewTalentEntry>()));
+        Assert.True(empty.IsValid);
+        Assert.Empty(empty.Talents);
+
+        PreviewTalentEntry[] maximum = Enumerable.Range(0, (int)LearnPreviewTalents.MaxTalentCount)
+            .Select(i => new PreviewTalentEntry((uint)(1000 + i), (byte)(i % 5)))
+            .ToArray();
+        using var full = Parse(BuildModernPayload(maximum));
+
+        Assert.True(full.IsValid);
+        Assert.Equal((uint)maximum.Length, full.DeclaredCount);
+        Assert.Equal(maximum, full.Talents);
+    }
+
+    [Theory]
+    [MemberData(nameof(MalformedPayloads))]
+    public void PreviewParser_RejectsMalformedPayloads(byte[] payload)
+    {
+        using var preview = Parse(payload);
+
+        Assert.False(preview.IsValid);
+        Assert.Empty(preview.Talents);
+    }
+
+    public static IEnumerable<object[]> MalformedPayloads()
+    {
+        yield return new object[] { new byte[] { 1, 0, 0 } };
+        yield return new object[] { BuildPayloadWithCount(1, new byte[] { 0x44, 0x33, 0x22, 0x11 }) };
+        yield return new object[] { BuildPayloadWithCount(1, new byte[] { 0x44, 0x33, 0x22, 0x11, 4, 0xFF }) };
+        yield return new object[] { BuildPayloadWithCount(61, Array.Empty<byte>()) };
+        yield return new object[] { BuildPayloadWithCount(uint.MaxValue, Array.Empty<byte>()) };
+    }
+
+    [Fact]
+    public void LegacyBuilder_WidensRankAndPreservesOrder()
+    {
+        using WorldPacket packet = WorldSocket.BuildLegacyLearnPreviewTalentsPacket(TwoTalents);
+
+        Assert.Equal(0x4C1u, packet.GetOpcode());
+        byte[] data = packet.GetData();
+        Assert.Equal(20, data.Length);
+
+        using var reader = new WorldPacket(0x4C1u, data);
+        Assert.Equal(2u, reader.ReadUInt32());
+        Assert.Equal(0x11223344u, reader.ReadUInt32());
+        Assert.Equal(4u, reader.ReadUInt32());
+        Assert.Equal(0xA1B2C3D4u, reader.ReadUInt32());
+        Assert.Equal(1u, reader.ReadUInt32());
+        Assert.Equal(0, reader.Remaining());
+    }
+
+    [Fact]
+    public void LegacyBuilder_AcceptsMaximumAndRejectsOversizedBatch()
+    {
+        using WorldPacket empty = WorldSocket.BuildLegacyLearnPreviewTalentsPacket(
+            Array.Empty<PreviewTalentEntry>());
+        Assert.Equal(4, empty.GetData().Length);
+
+        PreviewTalentEntry[] maximum = Enumerable.Range(0, (int)LearnPreviewTalents.MaxTalentCount)
+            .Select(i => new PreviewTalentEntry((uint)(2000 + i), (byte)(i % 5)))
+            .ToArray();
+        using WorldPacket packet = WorldSocket.BuildLegacyLearnPreviewTalentsPacket(maximum);
+
+        Assert.Equal(4 + maximum.Length * 8, packet.GetData().Length);
+
+        PreviewTalentEntry[] oversized = new PreviewTalentEntry[(int)LearnPreviewTalents.MaxTalentCount + 1];
+        Assert.Throws<ArgumentOutOfRangeException>(
+            () => WorldSocket.BuildLegacyLearnPreviewTalentsPacket(oversized));
+    }
+
+    private static LearnPreviewTalents Parse(byte[] payload)
+    {
+        byte[] wire = new byte[payload.Length + sizeof(ushort)];
+        BinaryPrimitives.WriteUInt16LittleEndian(
+            wire,
+            (ushort)V343.Opcode.CMSG_LEARN_PREVIEW_TALENTS);
+        payload.CopyTo(wire, sizeof(ushort));
+
+        var preview = new LearnPreviewTalents(new WorldPacket(wire));
+        preview.Read();
+        return preview;
+    }
+
+    private static byte[] BuildModernPayload(IReadOnlyList<PreviewTalentEntry> talents)
+    {
+        byte[] body = new byte[sizeof(uint) + talents.Count * (sizeof(uint) + sizeof(byte))];
+        BinaryPrimitives.WriteUInt32LittleEndian(body, (uint)talents.Count);
+        int offset = sizeof(uint);
+
+        foreach (PreviewTalentEntry talent in talents)
+        {
+            BinaryPrimitives.WriteUInt32LittleEndian(body.AsSpan(offset), talent.TalentID);
+            offset += sizeof(uint);
+            body[offset++] = talent.Rank;
+        }
+
+        return body;
+    }
+
+    private static byte[] BuildPayloadWithCount(uint count, byte[] trailingData)
+    {
+        byte[] body = new byte[sizeof(uint) + trailingData.Length];
+        BinaryPrimitives.WriteUInt32LittleEndian(body, count);
+        trailingData.CopyTo(body, sizeof(uint));
+        return body;
+    }
+}
diff --git a/HermesProxy.Tests/World/TransportPathRotation343Tests.cs b/HermesProxy.Tests/World/TransportPathRotation343Tests.cs
new file mode 100644
index 0000000..e3bf6e2
--- /dev/null
+++ b/HermesProxy.Tests/World/TransportPathRotation343Tests.cs
@@ -0,0 +1,126 @@
+using System;
+using System.Collections;
+using System.Collections.Generic;
+using System.Numerics;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using HermesProxy;
+using HermesProxy.Enums;
+using HermesProxy.World;
+using HermesProxy.World.Client;
+using HermesProxy.World.Enums;
+using HermesProxy.World.Objects;
+using HermesProxy.World.Server.Packets;
+using Xunit;
+
+namespace HermesProxy.Tests.World;
+
+public class TransportPathRotation343Tests
+{
+    [Theory]
+    [InlineData(176080u)]
+    [InlineData(176081u)]
+    [InlineData(176082u)]
+    [InlineData(176083u)]
+    [InlineData(176084u)]
+    [InlineData(176085u)]
+    public void TramCreateKeepsSparsePathPivotSeparateFromLiveFacing(uint entry)
+    {
+        var (client, session, guid) = CreateHarness(entry);
+        var create = NewCreate(guid, session);
+        create.ObjectData.EntryID = (int)entry;
+        create.CreateData.MoveInfo.Rotation = new Quaternion(0f, 0f, 0.70710677f, 0.70710677f);
+        create.CreateData.MoveInfo.Orientation = 0.6f;
+        int rotation = LegacyVersion.GetUpdateField(GameObjectField.GAMEOBJECT_PARENTROTATION);
+
+        Store(client, ref guid, create, new() { [rotation + 2] = new UpdateField(1f) });
+
+        Assert.Equal(new float?[] { 0f, 0f, 1f, 0f }, create.GameObjectData.ParentRotation);
+        Assert.Equal(Quaternion.CreateFromAxisAngle(Vector3.UnitZ, 0.6f), create.CreateData.MoveInfo.Rotation);
+    }
+
+    [Fact]
+    public void CreateUsesCachedUnmaskedComponentsAndAllZeroFallsBackToIdentity()
+    {
+        var (client, session, guid) = CreateHarness(193182);
+        int rotation = LegacyVersion.GetUpdateField(GameObjectField.GAMEOBJECT_PARENTROTATION);
+        session.GameState.ObjectCacheLegacy[guid] = new() { [rotation + 3] = new UpdateField(0.8f) };
+        var create = NewCreate(guid, session);
+
+        Store(client, ref guid, create, new() { [rotation + 2] = new UpdateField(0.6f) });
+        Assert.Equal(new float?[] { 0f, 0f, 0.6f, 0.8f }, create.GameObjectData.ParentRotation);
+
+        session.GameState.ObjectCacheLegacy.Clear();
+        var empty = NewCreate(guid, session);
+        Store(client, ref guid, empty, new());
+        Assert.Equal(new float?[] { 0f, 0f, 0f, 1f }, empty.GameObjectData.ParentRotation);
+    }
+
+    [Fact]
+    public void ValuesForTrackedTransportForwardChangedPivotAndCachedComponentsOnly()
+    {
+        var (client, session, guid) = CreateHarness(193182);
+        int rotation = LegacyVersion.GetUpdateField(GameObjectField.GAMEOBJECT_PARENTROTATION);
+        session.GameState.SynthesizedTransports[guid] = default;
+        session.GameState.ObjectCacheLegacy[guid] = new() { [rotation + 3] = new UpdateField(0.8f) };
+        var values = new ObjectUpdate(guid, UpdateTypeModern.Values, session);
+
+        Store(client, ref guid, values, new() { [rotation + 2] = new UpdateField(0.6f) });
+
+        Assert.Equal(new float?[] { 0f, 0f, 0.6f, 0.8f }, values.GameObjectData.ParentRotation);
+        Assert.Null(values.GameObjectData.Flags);
+        var untrackedGuid = WowGuid128.Create(HighGuidType703.GameObject, 0, 190722, 2);
+        var untracked = new ObjectUpdate(untrackedGuid, UpdateTypeModern.Values, session);
+        Store(client, ref untrackedGuid, untracked, new() { [rotation + 2] = new UpdateField(0.6f) });
+        Assert.All(untracked.GameObjectData.ParentRotation, component => Assert.Null(component));
+    }
+
+    [Fact]
+    public void DestructibleCreateRetainsAtlasModelIdInsteadOfTransportPivot()
+    {
+        var (client, session, guid) = CreateHarness(190722);
+        session.GameState.DestructibleModelIdByEntry[190722] = 42;
+        var create = NewCreate(guid, session);
+        create.ObjectData.EntryID = 190722;
+        int bytes = LegacyVersion.GetUpdateField(GameObjectField.GAMEOBJECT_BYTES_1);
+        int rotation = LegacyVersion.GetUpdateField(GameObjectField.GAMEOBJECT_PARENTROTATION);
+
+        Store(client, ref guid, create, new()
+        {
+            [bytes] = new UpdateField((uint)GameObjectTypeModern.DestructibleBuilding << 8),
+            [rotation + 2] = new UpdateField(1f)
+        });
+
+        Assert.Equal(42, BitConverter.SingleToInt32Bits(create.GameObjectData.ParentRotation[0]!.Value));
+        Assert.Equal(new float?[] { 0f, 0f, 1f }, create.GameObjectData.ParentRotation[1..]);
+    }
+
+    private static (WorldClient Client, GlobalSessionData Session, WowGuid128 Guid) CreateHarness(uint entry)
+    {
+        Assert.SkipUnless(ModernVersion.Build == ClientVersionBuild.V3_4_3_54261,
+            "Run with HERMES_TEST_MODERN_BUILD=3.4.3; this fixture exercises the 3.4.3-only transport path.");
+        var session = (GlobalSessionData)RuntimeHelpers.GetUninitializedObject(typeof(GlobalSessionData));
+        session.GameState = GameSessionData.CreateNewGameSessionData(session);
+        var client = (WorldClient)RuntimeHelpers.GetUninitializedObject(typeof(WorldClient));
+        typeof(WorldClient).GetField("_globalSession", BindingFlags.Instance | BindingFlags.NonPublic)!
+            .SetValue(client, session);
+        return (client, session, WowGuid128.Create(HighGuidType703.GameObject, 0, entry, 1));
+    }
+
+    private static ObjectUpdate NewCreate(WowGuid128 guid, GlobalSessionData session)
+    {
+        var update = new ObjectUpdate(guid, UpdateTypeModern.CreateObject1, session);
+        update.CreateData.MoveInfo = new MovementInfo();
+        return update;
+    }
+
+    private static void Store(WorldClient client, ref WowGuid128 guid, ObjectUpdate update,
+        Dictionary<int, UpdateField> fields)
+    {
+        var mask = new BitArray(LegacyVersion.GetUpdateField(GameObjectField.GAMEOBJECT_END));
+        foreach (int index in fields.Keys)
+            mask[index] = true;
+        client.StoreObjectUpdate(ref guid, ObjectType.GameObject, mask, fields, new AuraUpdate(guid, false), null,
+            update.CreateData != null, update, mask);
+    }
+}
