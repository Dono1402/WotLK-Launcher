diff --git a/HermesProxy.Tests/World/Chat/AtlasLauncherWhisperTests.cs b/HermesProxy.Tests/World/Chat/AtlasLauncherWhisperTests.cs
new file mode 100644
index 0000000..66c87fe
--- /dev/null
+++ b/HermesProxy.Tests/World/Chat/AtlasLauncherWhisperTests.cs
@@ -0,0 +1,141 @@
+using System;
+using System.Buffers.Binary;
+using System.Runtime.CompilerServices;
+using System.Text;
+using Framework.IO;
+using HermesProxy.Enums;
+using HermesProxy.World;
+using HermesProxy.World.Chat;
+using HermesProxy.World.Enums;
+using Xunit;
+
+namespace HermesProxy.Tests.World.Chat;
+
+public class AtlasLauncherWhisperTests
+{
+    [Theory]
+    [InlineData("Dono1402#Launcher", "Dono1402")]
+    [InlineData("Dono_42#launcher", "Dono_42")]
+    [InlineData("Dono_42#Launcher-Arthas", "Dono_42")]
+    [InlineData("123#Launcher", "123")]
+    public void ReplyUsesAtlasAccountAndPreservesFullMessage(string target, string account)
+    {
+        string text = "Bonjour 😀 |Hitem:123|h[Objet]|h .atlasmsg Autre " + new string('x', 600);
+        using var request = AtlasLauncherWhisper.CreateLegacyRequest(target, text, 7);
+        Assert.NotNull(request);
+        using var reader = new ByteBuffer(request.GetData());
+        Assert.Equal((uint)ChatMessageTypeWotLK.Whisper, reader.ReadUInt32());
+        Assert.Equal(7u, reader.ReadUInt32());
+        Assert.Equal(account + "#Launcher", reader.ReadCString());
+        Assert.Equal(".atlasmsg " + account + " " + text, reader.ReadCString());
+        Assert.False(reader.CanRead());
+    }
+
+    [Theory]
+    [InlineData("Character")]
+    [InlineData("Character-Arthas")]
+    [InlineData("ab#Launcher")]
+    [InlineData("Ami#LauncherOther")]
+    [InlineData("Ami#Launcher\0")]
+    [InlineData("Admin|Hplayer:gm|h#Launcher")]
+    [InlineData("Jean Paul#Launcher")]
+    [InlineData("Admin;command#Launcher")]
+    public void NormalTargetsAndInvalidAliasesAreNotRoutedToAtlas(string target)
+        => Assert.False(AtlasLauncherWhisper.TryGetUsername(target, out _));
+
+    [Fact]
+    public void AliasAndBodyLimitsCannotSplitOrInjectLegacyRequests()
+    {
+        Assert.True(AtlasLauncherWhisper.TryGetUsername(new string('x', 32) + "#Launcher", out _));
+        Assert.False(AtlasLauncherWhisper.TryGetUsername(new string('x', 33) + "#Launcher", out _));
+        using var maximum = AtlasLauncherWhisper.CreateLegacyRequest("Dono#Launcher", new string('x', 1000), 7);
+        Assert.NotNull(maximum);
+        Assert.Null(AtlasLauncherWhisper.CreateLegacyRequest("Dono#Launcher", new string('x', 1001), 7));
+        Assert.Null(AtlasLauncherWhisper.CreateLegacyRequest("Dono#Launcher", "a\0b", 7));
+        Assert.Null(AtlasLauncherWhisper.CreateLegacyRequest("Dono#Launcher", "\ud800", 7));
+        Assert.Null(AtlasLauncherWhisper.CreateLegacyRequest("Dono#Launcher", "  ", 7));
+        Assert.Null(AtlasLauncherWhisper.CreateLegacyRequest("Dono#Launcher", "Addon message", (uint)Language.Addon));
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void CoreNamedEnvelopeProducesReplyableModernWhisperWithoutFakePlayer(bool sent)
+    {
+        byte[] body = CoreBody(sent, "Dono_42#Launcher", "Bonjour 日本語 😀 ||Hplayer:texte");
+        Assert.True(AtlasLauncherWhisper.TryReadLegacyBody(body, out var envelope));
+        Assert.Equal(sent, envelope.Sent);
+        Assert.Equal("Dono_42#Launcher", envelope.Alias);
+        Assert.Equal("Bonjour 日本語 😀 ||Hplayer:texte", envelope.Text);
+        Assert.Equal(42ul, envelope.Receiver.Low);
+        var session = (GlobalSessionData)RuntimeHelpers.GetUninitializedObject(typeof(GlobalSessionData));
+        var player = new WowGuid128(42, 0x0800000000000000);
+        var modern = AtlasLauncherWhisper.CreateModernPacket(session, envelope, player, 1);
+        Assert.Equal(sent ? ChatMessageTypeModern.WhisperInform : ChatMessageTypeModern.Whisper, modern.SlashCmd);
+        Assert.Equal(sent ? "" : envelope.Alias, modern.SenderName);
+        Assert.Equal(sent ? envelope.Alias : "", modern.TargetName);
+        Assert.Equal(sent ? player : WowGuid128.Empty, modern.SenderGUID);
+        Assert.Equal(sent ? WowGuid128.Empty : player, modern.TargetGUID);
+        Assert.True(modern.SenderAccountGUID.IsEmpty());
+        Assert.False(modern.FakeSenderName);
+        byte[] wire = new byte[2048];
+        int length = modern.WriteToSpan(wire);
+        Assert.True(length > 0);
+        if (ModernVersion.Build == ClientVersionBuild.V3_4_3_54261)
+        {
+            using var reader = new WorldPacket(1, wire[..length]);
+            Assert.Equal((byte)modern.SlashCmd, reader.ReadUInt8());
+            Assert.Equal((uint)Language.Universal, reader.ReadUInt32());
+            Assert.Equal(modern.SenderGUID, reader.ReadPackedGuid128());
+            Assert.True(reader.ReadPackedGuid128().IsEmpty()); // guild
+            Assert.True(reader.ReadPackedGuid128().IsEmpty()); // account
+            Assert.Equal(modern.TargetGUID, reader.ReadPackedGuid128());
+            Assert.Equal(modern.TargetVirtualAddress, reader.ReadUInt32());
+            Assert.Equal(modern.SenderVirtualAddress, reader.ReadUInt32());
+            reader.Skip(12); // achievement, display time, spell
+            uint senderBytes = reader.ReadBits<uint>(11), targetBytes = reader.ReadBits<uint>(11);
+            Assert.Equal(0u, reader.ReadBits<uint>(5)); Assert.Equal(0u, reader.ReadBits<uint>(7));
+            uint textBytes = reader.ReadBits<uint>(12);
+            Assert.Equal(0u, reader.ReadBits<uint>(15)); // no GM flag
+            Assert.False(reader.ReadBit()); Assert.False(reader.ReadBit());
+            Assert.False(reader.ReadBit()); Assert.False(reader.ReadBit());
+            Assert.Equal(modern.SenderName, reader.ReadString(senderBytes));
+            Assert.Equal(modern.TargetName, reader.ReadString(targetBytes));
+            Assert.Equal(envelope.Text, reader.ReadString(textBytes));
+            Assert.Equal(0, reader.Remaining());
+        }
+    }
+
+    [Fact]
+    public void OnlyTheBoundedAtlasEnvelopeIsRecognized()
+    {
+        byte[] good = CoreBody(false, "Dono#Launcher", "Bonjour");
+        for (int length = 0; length < good.Length; length++)
+            Assert.False(AtlasLauncherWhisper.TryReadLegacyBody(good.AsSpan(0, length), out _));
+        foreach (int offset in new[] { 0, 1, 5, 13, 17, good.Length - 2, good.Length - 1 })
+        {
+            byte[] bad = (byte[])good.Clone(); bad[offset] = 255;
+            Assert.False(AtlasLauncherWhisper.TryReadLegacyBody(bad, out _));
+        }
+        Assert.False(AtlasLauncherWhisper.TryReadLegacyBody(CoreBody(false, "RealGameMaster", "Bonjour"), out _));
+        Assert.False(AtlasLauncherWhisper.TryReadLegacyBody(CoreBody(false, "Dono#Launcher", "a\0b"), out _));
+        Assert.False(AtlasLauncherWhisper.TryReadLegacyBody(CoreBody(false, "Dono#Launcher", new string('x', 231)), out _));
+        Assert.True(AtlasLauncherWhisper.TryReadLegacyBody(CoreBody(false, new string('x', 32) + "#Launcher", new string('x', 230)), out _));
+        byte[] npc = (byte[])good.Clone();
+        int receiverOffset = 21 + (int)BinaryPrimitives.ReadUInt32LittleEndian(npc.AsSpan(17));
+        BinaryPrimitives.WriteUInt64LittleEndian(npc.AsSpan(receiverOffset), 0xF13000000000002A);
+        Assert.False(AtlasLauncherWhisper.TryReadLegacyBody(npc, out _));
+    }
+
+    private static byte[] CoreBody(bool sent, string alias, string text)
+    {
+        using var bytes = new ByteBuffer();
+        bytes.WriteUInt8((byte)(sent ? ChatMessageTypeWotLK.WhisperInform : ChatMessageTypeWotLK.Whisper));
+        bytes.WriteUInt32((uint)Language.Universal); bytes.WriteUInt64(0); bytes.WriteUInt32(0);
+        bytes.WriteUInt32((uint)Encoding.UTF8.GetByteCount(alias) + 1); bytes.WriteCString(alias);
+        bytes.WriteUInt64(42);
+        bytes.WriteUInt32((uint)Encoding.UTF8.GetByteCount(text) + 1); bytes.WriteCString(text);
+        bytes.WriteUInt8(0);
+        return bytes.GetData();
+    }
+}
