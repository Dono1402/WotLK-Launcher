diff --git a/HermesProxy/World/Client/PacketHandlers/AtlasAccountServicesHandler.cs b/HermesProxy/World/Client/PacketHandlers/AtlasAccountServicesHandler.cs
new file mode 100644
index 0000000..186bc8a
--- /dev/null
+++ b/HermesProxy/World/Client/PacketHandlers/AtlasAccountServicesHandler.cs
@@ -0,0 +1,35 @@
+using Framework.Constants;
+using HermesProxy.Enums;
+using HermesProxy.World.Enums;
+
+namespace HermesProxy.World.Client;
+
+public partial class WorldClient
+{
+    bool HandleAtlasAccountServices(WorldPacket packet)
+    {
+        if (ModernVersion.Build != ClientVersionBuild.V3_4_3_54261) return false;
+        var session = GetSession();
+        var result = session.AtlasAccountServices.Receive(packet,
+            WowGuid128.Create(HighGuidType703.WowAccount, session.GameAccountInfo.Id), session.RealmId.GetAddress());
+        if (!result.Handled) return false;
+        if (result.ReadinessChanged) session.RealmSocket?.SendFeatureSystemStatusGlueScreen();
+        bool refreshCharacters = false;
+        if (result.ChangedName != null)
+        {
+            foreach (var own in session.GameState.OwnCharacters)
+                if (own.CharacterGuid == result.ChangedCharacter && own.Name != result.ChangedName)
+                {
+                    own.Name = result.ChangedName;
+                    refreshCharacters = true;
+                }
+            if (session.GameState.CachedPlayers.TryGetValue(result.ChangedCharacter, out var cached))
+                cached.Name = result.ChangedName;
+        }
+        foreach (var response in result.Packets) SendPacketToClient(response);
+        // Replayed receipts still receive their success response, but do not
+        // produce duplicate enum requests against the core's ordinary rate limit.
+        if (refreshCharacters) SendPacketToServer(new WorldPacket(Opcode.CMSG_ENUM_CHARACTERS));
+        return true;
+    }
+}
diff --git a/HermesProxy/World/Client/PacketHandlers/CharacterHandler.cs b/HermesProxy/World/Client/PacketHandlers/CharacterHandler.cs
