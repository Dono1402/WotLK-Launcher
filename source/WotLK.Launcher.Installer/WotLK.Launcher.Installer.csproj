<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Payload\WotLK.Launcher.exe" />
    <None Remove="Assets\**\*.png" />
    <Resource Include="Assets\**\*.png" />
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="..\WotLK.Launcher\Assets\Branding\AtlasLauncherLogo.png"
              Link="Assets\Branding\AtlasLauncherLogo.png" />
    <Resource Include="..\WotLK.Launcher\Assets\Images\ArthasIcecrownHero.png"
              Link="Assets\Images\ArthasIcecrownHero.png" />
    <Resource Include="..\WotLK.Launcher\Assets\Fonts\Manrope-Regular.ttf"
              Link="Assets\Fonts\Manrope-Regular.ttf" />
    <Resource Include="..\WotLK.Launcher\Assets\Fonts\Manrope-Medium.ttf"
              Link="Assets\Fonts\Manrope-Medium.ttf" />
    <Resource Include="..\WotLK.Launcher\Assets\Fonts\Manrope-SemiBold.ttf"
              Link="Assets\Fonts\Manrope-SemiBold.ttf" />
    <Resource Include="..\WotLK.Launcher\Assets\Fonts\Manrope-Bold.ttf"
              Link="Assets\Fonts\Manrope-Bold.ttf" />
    <Resource Include="..\WotLK.Launcher\Assets\Fonts\Manrope-ExtraBold.ttf"
              Link="Assets\Fonts\Manrope-ExtraBold.ttf" />
  </ItemGroup>

</Project>
