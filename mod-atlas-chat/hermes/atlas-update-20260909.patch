diff --git a/HermesProxy/BnetServer/Services/Services/Resources.cs b/HermesProxy/BnetServer/Services/Services/Resources.cs
new file mode 100644
index 0000000..0196fdc
--- /dev/null
+++ b/HermesProxy/BnetServer/Services/Services/Resources.cs
@@ -0,0 +1,39 @@
+using System;
+using System.Buffers.Binary;
+using System.Security.Cryptography;
+using Bgs.Protocol;
+using Bgs.Protocol.Resources.V1;
+using Framework.Constants;
+using Framework.Logging;
+using Google.Protobuf;
+
+namespace BNetServer.Services;
+
+public partial class BnetServices
+{
+    private const uint PrivateServerContentRegion = 1;
+
+    [Service(ServiceRequirement.LoggedIn, OriginalHash.ResourcesService, 1)]
+    BattlenetRpcErrorCode HandleGetContentHandle(ContentHandleRequest request, ContentHandle response)
+    {
+        byte[] seed = new byte[12];
+        BinaryPrimitives.WriteUInt32LittleEndian(seed.AsSpan(0, 4), request.Program);
+        BinaryPrimitives.WriteUInt32LittleEndian(seed.AsSpan(4, 4), request.Stream);
+        BinaryPrimitives.WriteUInt32LittleEndian(seed.AsSpan(8, 4), request.Version);
+
+        byte[] hash = SHA256.HashData(seed);
+        byte[] handleHash = hash.AsSpan(0, 16).ToArray();
+
+        response.Region = PrivateServerContentRegion;
+        response.Usage = request.Stream;
+        response.Hash = ByteString.CopyFrom(handleHash);
+
+        Log.Print(LogType.Network,
+            $"ResourcesService.GetContentHandle: program=0x{request.Program:X8} stream=0x{request.Stream:X8} " +
+            $"version=0x{request.Version:X8} region={response.Region} usage=0x{response.Usage:X8} " +
+            $"hash={Convert.ToHexString(handleHash)}.");
+
+        return BattlenetRpcErrorCode.Ok;
+    }
+}
+
