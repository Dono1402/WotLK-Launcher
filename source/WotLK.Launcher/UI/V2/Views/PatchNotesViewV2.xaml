<UserControl x:Class="WotLK.Launcher.UI.V2.Views.PatchNotesViewV2"
             x:Name="PatchNotesRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WotLK.Launcher.UI.V2.Views"
             xmlns:presentation="clr-namespace:WotLK.Launcher.UI.V2.Presentation"
             Background="Transparent"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="AtlasV2.PatchNotes.ReleaseCard" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.GlassSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GlassHighlight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="AtlasV2.PatchNotes.MetadataColumn" TargetType="{x:Type ColumnDefinition}">
            <Setter Property="Width" Value="196"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDraft}" Value="True"><Setter Property="Width" Value="252"/></DataTrigger>
                <DataTrigger Binding="{Binding LayoutMode, ElementName=PatchNotesRoot}" Value="{x:Static presentation:AdaptiveLayoutMode.Compact}"><Setter Property="Width" Value="190"/></DataTrigger>
                <DataTrigger Binding="{Binding LayoutMode, ElementName=PatchNotesRoot}" Value="{x:Static presentation:AdaptiveLayoutMode.Stacked}"><Setter Property="Width" Value="156"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AtlasV2.PatchNotes.Metadata" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDraft}" Value="True">
                    <Setter Property="Padding" Value="18,16"/>
                    <Setter Property="Background" Value="#472C2917"/>
                    <Setter Property="BorderBrush" Value="#586B5728"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="AtlasV2.PatchNotes.BulletTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="10"
                         Height="10"
                         Margin="0,8,0,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Fill="{StaticResource AtlasV2.Brush.Cyan}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding}"
                           TextWrapping="Wrap"
                           Style="{StaticResource AtlasV2.Text.Body}"
                           FontSize="17"
                           FontWeight="Normal"
                           LineHeight="26"
                           Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="PatchNotesScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}"
                   BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/>
        </ScrollViewer.Resources>

        <Grid x:Name="ContentFrame"
              MaxWidth="1520"
              Margin="92,0,76,36"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="2" Margin="0,0,20,0" SnapsToDevicePixels="True" Background="{StaticResource AtlasV2.Brush.Cyan}"/>
                        <TextBlock Text="ATLAS LAUNCHER"
                                   Style="{StaticResource AtlasV2.Text.Eyebrow}"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                    </StackPanel>
                    <TextBlock x:Name="PageTitle"
                               Margin="0,0,0,0"
                               Text="Notes de version"
                               FontFamily="{StaticResource AtlasV2.Font.Inter}"
                               FontSize="64"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource AtlasV2.Brush.TitleIce}"/>
                    <TextBlock x:Name="PageDescription" Margin="0,0,0,0"
                               Text="Découvrez les dernières mises à jour, améliorations et corrections du launcher."
                               Style="{StaticResource AtlasV2.Text.Body}" FontSize="21" FontWeight="Normal"/>
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="1"
                         Height="3"
                         Margin="0,22,0,0"
                         IsIndeterminate="True"
                         Style="{StaticResource AtlasV2.Progress.Compact}"
                         Visibility="{Binding State.Current.IsLoading, ElementName=PatchNotesRoot, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>

            <Grid Grid.Row="2" Margin="0,25,0,0">
                <Border Padding="24"
                        Background="{StaticResource AtlasV2.Brush.GlassSurface}"
                        BorderBrush="{StaticResource AtlasV2.Brush.GlassHighlight}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.Current.PatchNotes.Count, ElementName=PatchNotesRoot}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <Path Width="24"
                              Height="24"
                              Data="{StaticResource AtlasV2.Icon.FileText}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        <TextBlock Margin="0,12,0,0"
                                   Text="Aucune note publiée"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource AtlasV2.Text.SectionTitle}"/>
                        <TextBlock Margin="0,5,0,0"
                                   Text="Les prochaines nouveautés apparaîtront ici."
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource AtlasV2.Text.Body}"/>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="PatchNotesList"
                              ItemsSource="{Binding State.Current.PatchNotes, ElementName=PatchNotesRoot}">
                    <ItemsControl.Style>
                        <Style TargetType="{x:Type ItemsControl}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.Current.PatchNotes.Count, ElementName=PatchNotesRoot}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AtlasV2.PatchNotes.ReleaseCard}">
                                <Grid>
                                    <Border Width="4" Height="150" Margin="0,14,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="0,3,3,0"
                                            Background="{StaticResource AtlasV2.Brush.Gold}"
                                            Visibility="{Binding IsDraft, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                                    <Grid Margin="22,22,22,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Style="{StaticResource AtlasV2.PatchNotes.MetadataColumn}"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource AtlasV2.PatchNotes.Metadata}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Version}"
                                                   FontFamily="{StaticResource AtlasV2.Font.Inter}"
                                                   FontSize="22"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AtlasV2.Brush.Gold}"/>
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="{Binding PublishedText}"
                                                   FontSize="16"
                                                   FontWeight="Normal"
                                                   Style="{StaticResource AtlasV2.Text.Caption}"/>
                                        <Border Margin="0,16,0,0"
                                                Padding="14,6"
                                                HorizontalAlignment="Left"
                                                Background="#40171914"
                                                BorderBrush="{StaticResource AtlasV2.Brush.GoldBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Visibility="{Binding IsDraft, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                            <TextBlock Text="BROUILLON LOCAL"
                                                       FontFamily="{StaticResource AtlasV2.Font.Inter}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource AtlasV2.Brush.Gold}"/>
                                        </Border>
                                    </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Width="1"
                                            Margin="16,0,0,0"
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource AtlasV2.Brush.GlassBorder}"/>

                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                                   FontSize="30" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="{Binding Intro}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource AtlasV2.Text.Body}"
                                                   FontSize="18" FontWeight="Normal"
                                                   LineHeight="26"
                                                   Visibility="{Binding HasIntro, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Margin="22,2,0,0" Padding="24,8,4,8" BorderThickness="1,0,0,0"
                                                    BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDraft}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding LayoutMode, ElementName=PatchNotesRoot}" Value="{x:Static presentation:AdaptiveLayoutMode.Compact}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding LayoutMode, ElementName=PatchNotesRoot}" Value="{x:Static presentation:AdaptiveLayoutMode.Stacked}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="24" Height="24" Margin="0,0,18,0" Data="{StaticResource AtlasV2.Icon.FileText}" Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                                    <StackPanel>
                                                        <TextBlock Text="Brouillon en cours" Style="{StaticResource AtlasV2.Text.Caption}" FontSize="13" Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                                                        <TextBlock Text="Modifications locales" Margin="0,4,0,0" Style="{StaticResource AtlasV2.Text.Caption}" FontSize="12"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <ItemsControl Margin="0,22,0,0" AlternationCount="2147483647"
                                                      ItemsSource="{Binding Sections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Border Height="1" Margin="0,18,0,16" Background="{StaticResource AtlasV2.Brush.GlassBorder}">
                                                            <Border.Style>
                                                                <Style TargetType="{x:Type Border}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}}" Value="0">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontFamily="{StaticResource AtlasV2.Font.Inter}"
                                                                   FontSize="20"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                                        <ItemsControl Margin="0,6,0,0"
                                                                      ItemsSource="{Binding Items}"
                                                                      ItemTemplate="{StaticResource AtlasV2.PatchNotes.BulletTemplate}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
