<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:presentation="clr-namespace:WotLK.Launcher.UI.V2.Presentation">
    <Style x:Key="AtlasV2.ServiceOption" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#DCE7EE"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="14,14"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Margin="3,2">
                        <Border x:Name="SelectedSurface" Background="#193F6475" CornerRadius="7" Opacity="0"/>
                        <Border x:Name="HoverSurface" Background="#1E8BAABB" CornerRadius="7" Opacity="0"/>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                            <Ellipse x:Name="ServiceDot" Width="5" Height="5" Fill="#8FD4F3" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            <Path x:Name="SelectedMark" Grid.Column="2" Data="M1,5 L4,8 L10,1" Width="11" Height="9"
                                  Stroke="#E3C887" StrokeThickness="1.5" Stretch="Uniform" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Static presentation:LauncherService.Minecraft}">
                            <Setter TargetName="ServiceDot" Property="Fill" Value="#A5D18F"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedSurface" Property="Opacity" Value="1"/>
                            <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.ServiceSelector" TargetType="ComboBox">
        <Setter Property="Foreground" Value="#E3EDF2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource AtlasV2.ServiceOption}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid Background="Transparent">
                        <primitives:ToggleButton x:Name="ServiceToggle" Focusable="False" IsTabStop="False" ClickMode="Press"
                                                 IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <primitives:ToggleButton.Template><ControlTemplate TargetType="primitives:ToggleButton">
                                <Border Background="Transparent"/>
                            </ControlTemplate></primitives:ToggleButton.Template>
                        </primitives:ToggleButton>
                        <Border x:Name="ServiceAccent" Width="2" Height="15" CornerRadius="1" HorizontalAlignment="Left"
                                Background="#89CDE9" Opacity=".7" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="12,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Path Width="10" Height="6" Data="M0,0 L5,5 L10,0" Stroke="#D5BC85" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"
                              Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                              RenderTransformOrigin=".5,.5">
                            <Path.RenderTransform><RotateTransform x:Name="ServiceChevron"/></Path.RenderTransform>
                        </Path>
                        <Border x:Name="HoverLine" Height="1" Margin="12,0,5,4" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00D6BE88"/><GradientStop Color="#D6BE88" Offset=".45"/><GradientStop Color="#00D6BE88" Offset="1"/>
                            </LinearGradientBrush></Border.Background>
                        </Border>
                        <Border x:Name="FocusLine" Height="1" Margin="12,0,5,4" VerticalAlignment="Bottom"
                                Background="#D6BE88" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-8" VerticalOffset="8"
                               AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                            <Border x:Name="ServiceMenuSurface" Width="250" Margin="12" Padding="9,13,9,9"
                                    Background="#F70D202D" BorderBrush="#5263747A" BorderThickness="1" CornerRadius="12">
                                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity=".28"/></Border.Effect>
                                <Border.RenderTransform><TranslateTransform x:Name="ServiceMenuOffset"/></Border.RenderTransform>
                                <StackPanel>
                                    <TextBlock Text="JEUX ET SERVICES" Margin="16,0,12,9" FontSize="10" FontWeight="SemiBold" Foreground="#91A9B8"/>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedValue" Value="{x:Static presentation:LauncherService.Minecraft}">
                            <Setter TargetName="ServiceAccent" Property="Background" Value="#A5D18F"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverLine" Storyboard.TargetProperty="Opacity" To=".8" Duration="0:0:0.16"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusLine" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ServiceChevron" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetName="ServiceMenuSurface" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="ServiceMenuOffset" Storyboard.TargetProperty="Y" From="-6" To="0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ServiceChevron" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
