                                        </Button>
                                        <Button x:Name="AddonInventoryCategoryButton" CommandParameter="Inventaire" Style="{StaticResource CategoryChipButton}" Click="AddonCategoryButton_Click">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Inventaire"/><TextBlock x:Name="AddonInventoryCountText" Margin="7,0,0,0" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
                                        </Button>
