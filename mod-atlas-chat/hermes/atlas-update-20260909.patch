diff --git a/HermesProxy/World/Chat/AtlasLauncherWhisper.cs b/HermesProxy/World/Chat/AtlasLauncherWhisper.cs
new file mode 100644
index 0000000..7ff62d6
--- /dev/null
+++ b/HermesProxy/World/Chat/AtlasLauncherWhisper.cs
@@ -0,0 +1,93 @@
+using System;
+using System.Buffers.Binary;
+using System.Text;
+using HermesProxy.Enums;
+using HermesProxy.World.Enums;
+using HermesProxy.World.Server.Packets;
+
+namespace HermesProxy.World.Chat;
+
+internal readonly record struct AtlasWhisperEnvelope(bool Sent, string Alias, string Text, WowGuid64 Receiver);
+
+internal static class AtlasLauncherWhisper
+{
+    private const string Suffix = "#Launcher";
+    private static readonly UTF8Encoding StrictUtf8 = new(false, true);
+
+    internal static bool TryGetUsername(string target, out string username)
+    {
+        username = "";
+        // Modern player links may append the local realm; it is not part of an
+        // Atlas account's name. The core still checks the accepted friendship.
+        string alias = LegacyChatTarget.Normalize(target);
+        if (!alias.EndsWith(Suffix, StringComparison.OrdinalIgnoreCase)) return false;
+        string name = alias[..^Suffix.Length];
+        if (name.Length is < 3 or > 32) return false;
+        foreach (char c in name)
+            if (!(c is >= 'A' and <= 'Z' or >= 'a' and <= 'z' or >= '0' and <= '9' or '_')) return false;
+        username = name;
+        return true;
+    }
+
+    internal static WorldPacket? CreateLegacyRequest(string target, string body, uint language)
+    {
+        if (!TryGetUsername(target, out string username) || language == (uint)Language.Addon
+            || body.Length is < 1 or > 1000 || body.Contains('\0') || string.IsNullOrWhiteSpace(body)) return null;
+        try { _ = StrictUtf8.GetByteCount(body); }
+        catch (EncoderFallbackException) { return null; }
+        var packet = new WorldPacket(Opcode.CMSG_MESSAGECHAT);
+        packet.WriteUInt32((uint)ChatMessageTypeWotLK.Whisper);
+        packet.WriteUInt32(language); // Preserve the player's learned language.
+        packet.WriteCString(username + Suffix);
+        // AzerothCore processes commands before resolving a character target.
+        // The module derives the sender from WorldSession; no account id is supplied.
+        packet.WriteCString(".atlasmsg " + username + " " + body);
+        return packet;
+    }
+
+    internal static bool TryReadLegacyBody(ReadOnlySpan<byte> data, out AtlasWhisperEnvelope envelope)
+    {
+        envelope = default;
+        // Only the explicit-name SMSG_GM_MESSAGECHAT body emitted by mod-atlas-chat:
+        // whisper type, Universal, zero sender GUID/flags, name+NUL, real receiver,
+        // text+NUL, CHAT_TAG_NONE. No character, GM identity or chat cache is invented.
+        if (data.Length is < 48 or > 307) return false;
+        var type = (ChatMessageTypeWotLK)data[0];
+        if (type is not (ChatMessageTypeWotLK.Whisper or ChatMessageTypeWotLK.WhisperInform)
+            || BinaryPrimitives.ReadUInt32LittleEndian(data[1..]) != (uint)Language.Universal
+            || BinaryPrimitives.ReadUInt64LittleEndian(data[5..]) != 0
+            || BinaryPrimitives.ReadUInt32LittleEndian(data[13..]) != 0) return false;
+        uint nameBytes = BinaryPrimitives.ReadUInt32LittleEndian(data[17..]);
+        if (nameBytes is < 13 or > 42 || data.Length < 21 + nameBytes + 14) return false;
+        int endName = 21 + (int)nameBytes;
+        if (data[endName - 1] != 0) return false;
+        try
+        {
+            string alias = StrictUtf8.GetString(data.Slice(21, (int)nameBytes - 1));
+            if (alias.Contains('-') || !TryGetUsername(alias, out _)) return false;
+            ulong receiver = BinaryPrimitives.ReadUInt64LittleEndian(data[endName..]);
+            if (receiver is 0 or > uint.MaxValue) return false;
+            uint textBytes = BinaryPrimitives.ReadUInt32LittleEndian(data[(endName + 8)..]);
+            if (textBytes is < 2 or > 231 || data.Length != endName + 12 + textBytes + 1
+                || data[^2] != 0 || data[^1] != 0) return false;
+            string text = StrictUtf8.GetString(data.Slice(endName + 12, (int)textBytes - 1));
+            if (text.Contains('\0')) return false;
+            envelope = new(type == ChatMessageTypeWotLK.WhisperInform, alias, text, new WowGuid64(receiver));
+            return true;
+        }
+        catch (DecoderFallbackException) { return false; }
+    }
+
+    internal static ChatPkt CreateModernPacket(GlobalSessionData session, AtlasWhisperEnvelope envelope,
+        WowGuid128 player, uint realmAddress)
+    {
+        var packet = new ChatPkt(session,
+            envelope.Sent ? ChatMessageTypeModern.WhisperInform : ChatMessageTypeModern.Whisper,
+            envelope.Text, (uint)Language.Universal,
+            senderName: envelope.Sent ? "" : envelope.Alias,
+            receiverName: envelope.Sent ? envelope.Alias : "");
+        if (envelope.Sent) { packet.SenderGUID = player; packet.SenderVirtualAddress = realmAddress; }
+        else { packet.TargetGUID = player; packet.TargetVirtualAddress = realmAddress; }
+        return packet;
+    }
+}
