<UserControl x:Class="WotLK.Launcher.UI.V2.Views.SettingsViewV2"
             x:Name="SettingsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="796"
             Background="Transparent"
             FontFamily="{StaticResource AtlasV2.Font.Inter}"
             Focusable="False"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WotLK.Launcher;component/UI/V2/Resources/AtlasV2.SettingsPilot.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      PanningMode="VerticalOnly">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}"
                       BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/>
            </ScrollViewer.Resources>

            <Grid x:Name="ContentFrame"
                  MaxWidth="1900"
                  Margin="67,17,60,66"
                  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="PageHeader" Margin="16,0,0,0">
                    <StackPanel x:Name="PageEyebrow" Orientation="Horizontal" Height="26">
                        <Border x:Name="PageEyebrowLine" Width="36" Height="2" Margin="4,0,22,0"
                                Background="#54E4F5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PageEyebrowText" Text="A T L A S  L A U N C H E R"
                                   AutomationProperties.Name="ATLAS LAUNCHER" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#54E4F5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="PageTitle"
                               Margin="0,8,0,0"
                               Text="Paramètres"
                               FontFamily="{StaticResource AtlasV2.Font.Inter}"
                               FontSize="72"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource AtlasV2.Brush.TitlePearl}"/>
                    <TextBlock x:Name="PageSubtitle" Text="Personnalisez votre expérience Atlas Launcher."
                               FontSize="26" FontWeight="Regular" Foreground="#BED3E5" TextWrapping="Wrap"/>
                    <Border x:Name="RuntimeNotice"
                            Margin="0,12,0,0"
                            Padding="12,9"
                            Background="{StaticResource AtlasV2.Brush.DangerSurface}"
                            BorderBrush="{StaticResource AtlasV2.Brush.DangerBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="14"
                                  Height="14"
                                  Data="{StaticResource AtlasV2.Icon.AlertCircle}"
                                  Stroke="{StaticResource AtlasV2.Brush.Danger}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                            <TextBlock x:Name="RuntimeNoticeText"
                                       Grid.Column="1"
                                       Margin="8,0,0,0"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource SettingsPilot.Caption}"
                                       Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid x:Name="SettingsWorkspace" Grid.Row="1" Margin="0,37,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NavigationColumn" Width="347"/>
                        <ColumnDefinition x:Name="NavigationGap" Width="17"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="CategoryNavigation"
                            Grid.Column="0"
                            Padding="14"
                            MinHeight="544"
                            VerticalAlignment="Top"
                            Background="{StaticResource AtlasV2.Brush.GlassSurface}"
                            BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel>
                            <TextBlock x:Name="CategoryHeading" Margin="18,20,18,20"
                                        Text="CATÉGORIES"
                                        Style="{StaticResource SettingsPilot.Caption}"
                                        FontWeight="SemiBold"/>

                            <Button x:Name="GeneralCategoryButton"
                                    Style="{StaticResource AtlasV2.Settings.NavButton}"
                                    AutomationProperties.Name="Général"
                                    Click="GeneralCategoryButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17"
                                          Height="17"
                                          Data="{StaticResource AtlasV2.Icon.Sliders}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Général"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button x:Name="GameCategoryButton"
                                    Style="{StaticResource AtlasV2.Settings.NavButton}"
                                    AutomationProperties.Name="Jeu"
                                    Click="GameCategoryButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17"
                                          Height="17"
                                          Data="{StaticResource AtlasV2.Icon.Gamepad}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Jeu"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button x:Name="UpdatesCategoryButton"
                                    Style="{StaticResource AtlasV2.Settings.NavButton}"
                                    AutomationProperties.Name="Mises à jour"
                                    Click="UpdatesCategoryButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17"
                                          Height="17"
                                          Data="{StaticResource AtlasV2.Icon.Refresh}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Mises à jour"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button x:Name="NotificationsCategoryButton"
                                    Style="{StaticResource AtlasV2.Settings.NavButton}"
                                    AutomationProperties.Name="Notifications"
                                    Click="NotificationsCategoryButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17"
                                          Height="17"
                                          Data="{StaticResource AtlasV2.Icon.Bell}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Notifications"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Button>

                            <Button x:Name="DiagnosticCategoryButton"
                                    Style="{StaticResource AtlasV2.Settings.NavButton}"
                                    AutomationProperties.Name="Aide et diagnostic"
                                    Click="DiagnosticCategoryButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Width="17"
                                          Height="17"
                                          Data="{StaticResource AtlasV2.Icon.Activity}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="Aide et diagnostic"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CategoryContentSurface" Grid.Column="2" MinHeight="544" Padding="20,22"
                            VerticalAlignment="Top" Background="{StaticResource AtlasV2.Brush.GlassRaised}"
                            BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="14">
                    <Grid x:Name="CategoryContentHost">
                        <StackPanel x:Name="GeneralPanel"
                                    TextOptions.TextFormattingMode="Ideal"
                                    TextOptions.TextRenderingMode="ClearType">
                            <TextBlock Text="Général" Style="{StaticResource SettingsPilot.SectionTitle}"
                                       FontSize="{DynamicResource SettingsPilot.Font.CategoryTitle}"/>
                            <TextBlock x:Name="GeneralIntro" Text="Configurez les paramètres de base du launcher."
                                       FontSize="20" FontWeight="Regular" Foreground="#A6BDD2" TextWrapping="Wrap"/>
                            <Border x:Name="GeneralPreferencesCard" Margin="0,26,0,0"
                                    Style="{StaticResource SettingsPilot.Card}" Padding="28,32,38,36">
                                <StackPanel>
                                    <TextBlock Text="Préférences du launcher" Style="{StaticResource SettingsPilot.SectionTitle}"/>
                                    <TextBlock x:Name="GeneralCardDescription" Margin="0,4,0,0"
                                               Text="Personnalisez le comportement et l’apparence d’Atlas Launcher."
                                               FontSize="18" FontWeight="Regular" Foreground="#A6BDD2" TextWrapping="Wrap"/>

                                    <Grid x:Name="InterfaceLanguageRow" Margin="0,24,0,0" MinHeight="60">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="InterfaceLanguageIconColumn" Width="66"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition x:Name="InterfaceLanguageFieldColumn" Width="322"/>
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="InterfaceLanguageIcon" Width="30" Height="30" Margin="6,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform"
                                              Data="M16,2 A14,14 0 1 1 15.99,2 M2,16 H30 M16,2 C7,9 7,23 16,30 M16,2 C25,9 25,23 16,30 M4,8 C11,12 21,12 28,8 M4,24 C11,20 21,20 28,24"
                                              Stroke="#D6E8F5" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <StackPanel x:Name="InterfaceLanguageCopy" Grid.Column="1" Margin="0,10,20,0" VerticalAlignment="Center">
                                            <TextBlock Text="Langue de l’interface" Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                            <TextBlock Margin="0,5,0,0" Text="Choisissez la langue d’affichage du launcher."
                                                       Style="{StaticResource SettingsPilot.Helper}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="InterfaceLanguageComboBox" Grid.Column="2" VerticalAlignment="Center"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding State.Current.General.InterfaceLocale, ElementName=SettingsRoot, Mode=OneWay}"
                                                  IsHitTestVisible="{Binding State.Current.CanChangeInterfaceLocale, ElementName=SettingsRoot}"
                                                  Focusable="{Binding State.Current.CanChangeInterfaceLocale, ElementName=SettingsRoot}"
                                                  Style="{StaticResource SettingsPilot.ComboBox}"
                                                  SelectionChanged="InterfaceLanguageComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Français" Tag="fr-FR"/>
                                            <ComboBoxItem Content="English" Tag="en-US"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border x:Name="GeneralFirstSeparator" Margin="66,24,0,19" Style="{StaticResource AtlasV2.Settings.Separator}"/>

                                    <Grid x:Name="StartWithWindowsRow" MinHeight="54">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="StartWithWindowsIconColumn" Width="66"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="StartWithWindowsIcon" Width="30" Height="30" Margin="6,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform"
                                              Data="M2,4 L14,2 V15 H2 Z M17,2 L31,0 V15 H17 Z M2,18 H14 V31 L2,29 Z M17,18 H31 V33 L17,31 Z"
                                              Fill="#D6E8F5"/>
                                        <StackPanel x:Name="StartWithWindowsCopy" Grid.Column="1" Margin="0,6,20,0" VerticalAlignment="Center">
                                            <TextBlock Text="Démarrer avec Windows" Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                            <TextBlock Margin="0,5,0,0" Text="Lance automatiquement Atlas Launcher au démarrage de Windows."
                                                       Style="{StaticResource SettingsPilot.Helper}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="StartWithWindowsToggle" Grid.Column="2" VerticalAlignment="Center"
                                                      IsChecked="{Binding State.Current.General.StartWithWindows, ElementName=SettingsRoot, Mode=OneWay}"
                                                      IsHitTestVisible="{Binding State.Current.CanChangeStartWithWindows, ElementName=SettingsRoot}"
                                                      Focusable="{Binding State.Current.CanChangeStartWithWindows, ElementName=SettingsRoot}"
                                                      Style="{StaticResource SettingsPilot.Toggle}" Click="StartWithWindowsToggle_Click"/>
                                    </Grid>

                                    <Border x:Name="GeneralSecondSeparator" Margin="66,24,0,19" Style="{StaticResource AtlasV2.Settings.Separator}"/>

                                    <Grid x:Name="MinimizeToTrayRow" MinHeight="54">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="MinimizeToTrayIconColumn" Width="66"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="MinimizeToTrayIcon" Width="30" Height="30" Margin="6,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Data="{StaticResource AtlasV2.Icon.Bell}"
                                              Style="{StaticResource AtlasV2.Icon.Stroke}" Stroke="#D6E8F5"/>
                                        <StackPanel x:Name="MinimizeToTrayCopy" Grid.Column="1" Margin="0,6,20,0" VerticalAlignment="Center">
                                            <TextBlock Text="Réduire dans la zone de notification à la fermeture d’Atlas Launcher"
                                                       Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                            <TextBlock Margin="0,5,0,0" Text="Le launcher continuera de fonctionner dans la zone de notification."
                                                       Style="{StaticResource SettingsPilot.Helper}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="MinimizeToTrayOnCloseToggle" Grid.Column="2" VerticalAlignment="Center"
                                                      IsChecked="{Binding State.Current.General.MinimizeToTrayOnClose, ElementName=SettingsRoot, Mode=OneWay}"
                                                      IsHitTestVisible="{Binding State.Current.CanChangeBehavior, ElementName=SettingsRoot}"
                                                      Focusable="{Binding State.Current.CanChangeBehavior, ElementName=SettingsRoot}"
                                                      Style="{StaticResource SettingsPilot.Toggle}" Click="MinimizeToTrayOnCloseToggle_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="GamePanel" Visibility="Collapsed">
                            <TextBlock Text="Jeu"
                                       Style="{StaticResource SettingsPilot.SectionTitle}"
                                       FontSize="{DynamicResource SettingsPilot.Font.CategoryTitle}"/>

                            <Border x:Name="InstallationCard"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource SettingsPilot.Card}"
                                    Padding="{DynamicResource SettingsPilot.CardPadding}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Width="18"
                                              Height="18"
                                              Data="{StaticResource AtlasV2.Icon.Folder}"
                                              Stroke="{StaticResource AtlasV2.Brush.Gold}"
                                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="Installation du jeu"
                                                   Style="{StaticResource SettingsPilot.SectionTitle}"
                                                   FontSize="{DynamicResource SettingsPilot.Font.SectionTitle}"/>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding State.Current.Game.ClientVersion, ElementName=SettingsRoot}"
                                                   Style="{StaticResource SettingsPilot.Caption}"
                                                   Foreground="{StaticResource AtlasV2.Brush.Success}"/>
                                    </Grid>

                                    <TextBlock Margin="0,20,0,0"
                                               Text="DOSSIER DU CLIENT"
                                               Style="{StaticResource SettingsPilot.Caption}"
                                               FontWeight="SemiBold"/>
                                    <Border Margin="0,8,0,0"
                                            Style="{StaticResource SettingsPilot.Field}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Width="16"
                                                  Height="16"
                                                  Data="{StaticResource AtlasV2.Icon.Folder}"
                                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                            <TextBlock x:Name="InstallPathText"
                                                       Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding State.Current.Game.InstallPath, ElementName=SettingsRoot}"
                                                       Style="{StaticResource SettingsPilot.Body}"
                                                       Foreground="{StaticResource AtlasV2.Brush.Text}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>

                                    <WrapPanel Margin="0,14,0,0">
                                        <Button x:Name="BrowseInstallPathButton"
                                                Margin="0,0,8,8"
                                                Content="Parcourir"
                                                Command="{Binding State.BrowseInstallPathCommand, ElementName=SettingsRoot}"
                                                IsHitTestVisible="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                Focusable="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                Style="{StaticResource AtlasV2.Settings.Action}"/>
                                        <Button x:Name="OpenGameFolderButton"
                                                Margin="0,0,8,8"
                                                Command="{Binding State.OpenGameFolderCommand, ElementName=SettingsRoot}"
                                                IsHitTestVisible="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                Focusable="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                Style="{StaticResource AtlasV2.Settings.Action}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14"
                                                      Height="14"
                                                      Margin="0,0,8,0"
                                                      Data="{StaticResource AtlasV2.Icon.Folder}"
                                                      Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                                <TextBlock VerticalAlignment="Center" Text="Ouvrir le dossier"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="VerifyRepairButton"
                                                Margin="0,0,0,8"
                                                Command="{Binding State.VerifyRepairCommand, ElementName=SettingsRoot}"
                                                IsHitTestVisible="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                Focusable="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                Style="{StaticResource AtlasV2.Settings.Action}"
                                                Click="VerifyRepairButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14"
                                                      Height="14"
                                                      Margin="0,0,8,0"
                                                      Data="{StaticResource AtlasV2.Icon.Refresh}"
                                                      Stroke="{StaticResource AtlasV2.Brush.Cyan}"
                                                      Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                                <TextBlock VerticalAlignment="Center" Text="Vérifier et réparer"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0"
                                    Style="{StaticResource SettingsPilot.Card}"
                                    Padding="{DynamicResource SettingsPilot.CardPadding}">
                                <StackPanel>
                                    <TextBlock Text="Configuration du jeu"
                                               Style="{StaticResource SettingsPilot.SectionTitle}"
                                               FontSize="{DynamicResource SettingsPilot.Font.SectionTitle}"/>

                                    <Grid Margin="0,19,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,20,0"
                                                   VerticalAlignment="Center"
                                                   Text="Langue du jeu"
                                                   Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                        <ComboBox x:Name="GameLanguageComboBox"
                                                  Grid.Column="1"
                                                  SelectedValuePath="Tag"
                                                  SelectedValue="{Binding State.Current.Game.GameLocale, ElementName=SettingsRoot, Mode=OneWay}"
                                                  IsHitTestVisible="{Binding State.Current.CanChangeGameLocale, ElementName=SettingsRoot}"
                                                  Focusable="{Binding State.Current.CanChangeGameLocale, ElementName=SettingsRoot}"
                                                  Style="{StaticResource SettingsPilot.ComboBox}"
                                                  SelectionChanged="GameLanguageComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Français" Tag="frFR"/>
                                            <ComboBoxItem Content="English" Tag="enUS"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Style="{StaticResource AtlasV2.Settings.Separator}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,20,0"
                                                   VerticalAlignment="Center"
                                                   Text="Texte de quête instantané"
                                                   Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                        <ToggleButton x:Name="InstantQuestTextToggle"
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding State.Current.Game.InstantQuestText, ElementName=SettingsRoot, Mode=OneWay}"
                                                      IsHitTestVisible="{Binding State.Current.CanChangeInstantQuestText, ElementName=SettingsRoot}"
                                                      Focusable="{Binding State.Current.CanChangeInstantQuestText, ElementName=SettingsRoot}"
                                                      Style="{StaticResource SettingsPilot.Toggle}"
                                                      Click="InstantQuestTextToggle_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="UpdatesPanel" Visibility="Collapsed">
                            <TextBlock Text="Mises à jour"
                                       Style="{StaticResource SettingsPilot.SectionTitle}"
                                       FontSize="{DynamicResource SettingsPilot.Font.CategoryTitle}"/>

                            <WrapPanel Margin="0,24,0,0" VerticalAlignment="Center">
                                <TextBlock Margin="0,0,7,8" Text="Atlas Launcher"
                                           Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                <TextBlock x:Name="LauncherVersionText" Margin="0,0,12,8"
                                           Text="{Binding State.Current.Updates.InstalledLauncherVersion, ElementName=SettingsRoot}"
                                           Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                <TextBlock Margin="0,0,12,8" Text="·" Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                <TextBlock x:Name="LauncherUpdateStatusText" Margin="0,0,0,8"
                                           Text="{Binding State.Current.Updates.StatusText, ElementName=SettingsRoot}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Settings.OptionTitle}">
                                            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State.Current.Updates.IsUpToDate, ElementName=SettingsRoot}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State.Current.Updates.IsUpdateAvailable, ElementName=SettingsRoot}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State.Current.Updates.IsChecking, ElementName=SettingsRoot}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State.Current.Updates.IsUpdating, ElementName=SettingsRoot}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State.Current.Updates.HasError, ElementName=SettingsRoot}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Warning}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel x:Name="NotificationsPanel" Visibility="Collapsed">
                            <TextBlock Text="Notifications"
                                       Style="{StaticResource SettingsPilot.SectionTitle}"
                                       FontSize="{DynamicResource SettingsPilot.Font.CategoryTitle}"/>

                            <Border x:Name="NotificationsCard"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource SettingsPilot.Card}"
                                    Padding="{DynamicResource SettingsPilot.CardPadding}">
                                <StackPanel>
                                    <TextBlock Text="Événements"
                                               Style="{StaticResource SettingsPilot.SectionTitle}"
                                               FontSize="{DynamicResource SettingsPilot.Font.SectionTitle}"/>

                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,20,0"
                                                   VerticalAlignment="Center"
                                                   Text="Connexions des amis"
                                                   Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                        <ToggleButton x:Name="FriendPresenceNotificationsToggle"
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding State.Current.Notifications.FriendPresence, ElementName=SettingsRoot, Mode=OneWay}"
                                                      IsHitTestVisible="{Binding State.Current.CanChangeFriendPresenceNotifications, ElementName=SettingsRoot}"
                                                      Focusable="{Binding State.Current.CanChangeFriendPresenceNotifications, ElementName=SettingsRoot}"
                                                      Style="{StaticResource SettingsPilot.Toggle}"
                                                      Click="FriendPresenceNotificationsToggle_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="DiagnosticPanel" Visibility="Collapsed">
                            <TextBlock Text="Aide et diagnostic"
                                       Style="{StaticResource SettingsPilot.SectionTitle}"
                                       FontSize="{DynamicResource SettingsPilot.Font.CategoryTitle}"/>

                            <Border Margin="0,12,0,0"
                                    Style="{StaticResource SettingsPilot.Card}"
                                    Padding="{DynamicResource SettingsPilot.CardPadding}">
                                <StackPanel>
                                    <TextBlock Text="Outils"
                                               Style="{StaticResource SettingsPilot.SectionTitle}"
                                               FontSize="{DynamicResource SettingsPilot.Font.SectionTitle}"/>
                                    <Grid Margin="0,19,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Path Width="16" Height="16" Data="{StaticResource AtlasV2.Icon.FileText}" Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,20,0"
                                                   VerticalAlignment="Center"
                                                   Text="Journaux locaux"
                                                   Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                                        <Button x:Name="OpenLogsButton"
                                                Grid.Column="2"
                                                Content="Ouvrir les journaux"
                                                Command="{Binding State.OpenLogsCommand, ElementName=SettingsRoot}"
                                                IsHitTestVisible="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                Focusable="{Binding State.Current.IsRuntimeConnected, ElementName=SettingsRoot}"
                                                ToolTip="{Binding State.Current.Diagnostic.LogLocation, ElementName=SettingsRoot}"
                                                Style="{StaticResource AtlasV2.Settings.Action}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="StatusVersionsCard"
                                    Margin="0,14,0,0"
                                    Style="{StaticResource SettingsPilot.Card}"
                                    Padding="{DynamicResource SettingsPilot.CardPadding}">
                                <StackPanel>
                                    <TextBlock Text="État et versions"
                                               Style="{StaticResource SettingsPilot.SectionTitle}"
                                               FontSize="{DynamicResource SettingsPilot.Font.SectionTitle}"/>
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="État local" Style="{StaticResource SettingsPilot.Body}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding State.Current.Diagnostic.LocalState, ElementName=SettingsRoot}" Style="{StaticResource SettingsPilot.Body}" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                                    </Grid>
                                    <Grid Margin="0,11,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="État des services" Style="{StaticResource SettingsPilot.Body}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding State.Current.Diagnostic.ServiceState, ElementName=SettingsRoot}" Style="{StaticResource SettingsPilot.Body}" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.Success}"/>
                                    </Grid>
                                    <Grid Margin="0,11,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Atlas Launcher" Style="{StaticResource SettingsPilot.Body}"/>
                                        <TextBlock x:Name="DiagnosticLauncherVersionText" Grid.Column="1" Text="{Binding State.Current.Diagnostic.LauncherVersion, ElementName=SettingsRoot}" Style="{StaticResource SettingsPilot.Body}" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                    </Grid>
                                    <Grid Margin="0,11,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Client WotLK Classic" Style="{StaticResource SettingsPilot.Body}"/>
                                        <TextBlock x:Name="ClientVersionText" Grid.Column="1" Text="{Binding State.Current.Diagnostic.ClientVersion, ElementName=SettingsRoot}" Style="{StaticResource SettingsPilot.Body}" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border x:Name="SettingsActionBar"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{StaticResource AtlasV2.Brush.GoldSurface}"
                BorderBrush="{StaticResource AtlasV2.Brush.GoldBorder}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid x:Name="SettingsActionContent"
                  MaxWidth="1280"
                  HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="SettingsActionIconBadge"
                        Width="34"
                        Height="34"
                        VerticalAlignment="Center"
                        Background="#241D10"
                        BorderBrush="{StaticResource AtlasV2.Brush.GoldBorder}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Path x:Name="SettingsActionIcon"
                          Width="16"
                          Height="16"
                          Data="{StaticResource AtlasV2.Icon.AlertCircle}"
                          Stroke="{StaticResource AtlasV2.Brush.Gold}"
                          Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,20,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SettingsActionStatusText"
                               Text="Modifications non enregistrées"
                               Style="{StaticResource AtlasV2.Settings.OptionTitle}"/>
                    <TextBlock x:Name="SettingsActionDetailText"
                               Margin="0,2,0,0"
                               Text="Les changements de cette catégorie n’ont pas encore été appliqués."
                               Style="{StaticResource SettingsPilot.Caption}"/>
                    <ProgressBar x:Name="SettingsActionProgress"
                                 Width="190"
                                 Margin="0,7,0,0"
                                 HorizontalAlignment="Left"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Style="{StaticResource AtlasV2.Progress.Compact}"/>
                </StackPanel>
                <StackPanel x:Name="SettingsActionButtons"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="CancelSettingsChangesButton"
                            Margin="0,0,10,0"
                            Content="Annuler"
                            Style="{StaticResource AtlasV2.Button.Base}"
                            Focusable="False"
                            IsHitTestVisible="False"/>
                    <Button x:Name="SaveSettingsChangesButton"
                            Content="Enregistrer"
                            Style="{StaticResource AtlasV2.Button.Primary}"
                            Height="44"
                            MinWidth="132"
                            Focusable="False"
                            IsHitTestVisible="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
