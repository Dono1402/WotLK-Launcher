<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Presentation tokens can be overridden on one GameView, never application-wide. -->
    <BitmapImage x:Key="GamePilot.Artwork" UriSource="/WotLK.Launcher;component/Assets/Images/AtlasGamePilotA.png" CacheOption="OnLoad"/>
    <SolidColorBrush x:Key="GamePilot.EyebrowLine" Color="#64D6FF"/>
    <SolidColorBrush x:Key="GamePilot.Eyebrow" Color="#62D6FF"/>
    <SolidColorBrush x:Key="GamePilot.Motto" Color="#C4E2F8"/>
    <SolidColorBrush x:Key="GamePilot.CardBorder" Color="#344E63"/>
    <SolidColorBrush x:Key="GamePilot.CardDivider" Color="#293E50"/>
    <SolidColorBrush x:Key="GamePilot.FactDivider" Color="#283E50"/>
    <SolidColorBrush x:Key="GamePilot.RealmDivider" Color="#385266"/>
    <SolidColorBrush x:Key="GamePilot.FactCaption" Color="#8FA9C7"/>
    <SolidColorBrush x:Key="GamePilot.ButtonForeground" Color="#BDD1E8"/>
    <SolidColorBrush x:Key="GamePilot.ButtonBorder" Color="#394D60"/>
    <SolidColorBrush x:Key="GamePilot.DisabledSurface" Color="#0C1A27"/>
    <SolidColorBrush x:Key="GamePilot.DisabledBorder" Color="#28384A"/>
    <SolidColorBrush x:Key="GamePilot.DisabledForeground" Color="#93A7BE"/>
    <SolidColorBrush x:Key="GamePilot.DisabledGold" Color="#75643E"/>
    <LinearGradientBrush x:Key="GamePilot.TitleAccent" StartPoint="0,0.35" EndPoint="0,0.88">
        <GradientStop Color="#A8DCFD" Offset="0"/><GradientStop Color="#9ED7FC" Offset="0.25"/><GradientStop Color="#5EA0D7" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GamePilot.HorizontalShade" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#ED030C15" Offset="0"/><GradientStop Color="#C6040D17" Offset="0.32"/>
        <GradientStop Color="#26061522" Offset="0.62"/><GradientStop Color="#240B2134" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GamePilot.VerticalShade" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#10020A12" Offset="0"/><GradientStop Color="#00020A12" Offset="0.55"/>
        <GradientStop Color="#6C030D18" Offset="0.79"/><GradientStop Color="#D9020911" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="GamePilot.Text.Body" TargetType="TextBlock" BasedOn="{StaticResource AtlasV2.Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="GamePilot.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource AtlasV2.Text.Caption}">
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <LinearGradientBrush x:Key="GamePilot.Surface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EE152B3E" Offset="0"/>
        <GradientStop Color="#EC08131D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GamePilot.Gold" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFD05D" Offset="0"/>
        <GradientStop Color="#F4C257" Offset="0.45"/>
        <GradientStop Color="#D19B42" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="GamePilot.Button" TargetType="Button" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource GamePilot.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource GamePilot.ButtonForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GamePilot.ButtonBorder}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <Border x:Name="Hover" CornerRadius="12" Background="White" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.09"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Hover" Property="Opacity" Value="0"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource GamePilot.DisabledSurface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GamePilot.DisabledBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource GamePilot.DisabledForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="GamePilot.Primary" TargetType="Button" BasedOn="{StaticResource GamePilot.Button}">
        <Setter Property="Background" Value="{StaticResource GamePilot.Gold}"/>
        <Setter Property="BorderBrush" Value="#FFE27B"/>
        <Setter Property="Foreground" Value="#100D08"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource GamePilot.DisabledGold}"/>
                <Setter Property="BorderBrush" Value="#8A7547"/>
                <Setter Property="Foreground" Value="#E4DED0"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="GamePilot.Chip" TargetType="Border">
        <Setter Property="Background" Value="#D60A1420"/>
        <Setter Property="BorderBrush" Value="#293C4C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="Height" Value="43"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>
</ResourceDictionary>
