@@ -0,0 +1,71 @@
+using System;
+using System.Text;
+using BNetServer.Networking;
+using Framework.Web;
+using Xunit;
+
+namespace HermesProxy.Tests.BnetServer;
+
+public class BnetRestApiSessionDiagnosticsTests
+{
+    private const string Secret = "ATLAS_SYNTHETIC_PRIVATE_VALUE_20260909";
+
+    [Theory]
+    [InlineData("{\"password\":\"" + Secret + "\"}")]
+    [InlineData("{\"inputs\":[{\"value\":\"" + Secret + "\",\"input_id\":\"password\"}]}")]
+    [InlineData("{\"pass\\u0077ord\":\"" + Secret + "\"}")]
+    [InlineData("{\"unrecognized_property\":\"" + Secret + "\"}")]
+    [InlineData("password=" + Secret)]
+    [InlineData("{\"password\":\"" + Secret)]
+    [InlineData("\u0000\u0001\u00ff" + Secret)]
+    [InlineData("\"" + Secret + "\"")]
+    public void BodyAndHeaderValuesAreNeverEmittedEvenWhenTheyCannotBeParsed(string body)
+    {
+        string raw = "POST /bnetserver/login/Win/54261/frFR?login_ticket=" + Secret + " HTTP/1.1\r\n"
+            + "Host: " + Secret + "\r\nAuthorization: Bearer " + Secret + "\r\nCookie: ticket=" + Secret
+            + "\r\nContent-Length: " + Encoding.UTF8.GetByteCount(body) + "\r\n\r\n" + body;
+        byte[] wire = Encoding.UTF8.GetBytes(raw);
+        HttpHeader request = Assert.IsType<HttpHeader>(HttpHelper.ParseRequest(wire, wire.Length));
+
+        string diagnostic = BnetRestApiSession.FormatRequestDiagnostic(request);
+
+        AssertSafe(diagnostic);
+        Assert.Contains("method=POST route=/bnetserver/login/*", diagnostic);
+        Assert.Contains("parsedContentLength=" + body.Length, diagnostic);
+        Assert.Equal(body, request.Content); // The auth request stays unchanged.
+    }
+
+    [Theory]
+    [InlineData("/bnetserver/login/srp?token=" + Secret, "/bnetserver/login/srp")]
+    [InlineData("/bnetserver/login?login_ticket=" + Secret, "/bnetserver/login")]
+    [InlineData("/bnetserver/login/" + Secret, "/bnetserver/login/*")]
+    [InlineData("/bnetserver/" + Secret, "<other>")]
+    [InlineData("/" + Secret, "<other>")]
+    public void UrlValuesAreReplacedByAKnownRouteCategory(string path, string expectedRoute)
+    {
+        string diagnostic = BnetRestApiSession.FormatRequestDiagnostic(new HttpHeader
+        {
+            Method = Secret,
+            Path = path,
+            Content = Secret,
+            ContentLength = Secret.Length
+        });
+
+        AssertSafe(diagnostic);
+        Assert.StartsWith("method=<other> route=" + expectedRoute + " ", diagnostic);
+    }
+
+    [Fact]
+    public void NullMetadataIsSafe()
+    {
+        Assert.Equal("method=<other> route=<other> contentLength=0 parsedContentLength=0; values omitted",
+            BnetRestApiSession.FormatRequestDiagnostic(new HttpHeader()));
+    }
+
+    private static void AssertSafe(string diagnostic)
+    {
+        Assert.DoesNotContain(Secret, diagnostic);
+        Assert.DoesNotContain(Convert.ToHexString(Encoding.UTF8.GetBytes(Secret)), diagnostic);
+        Assert.Contains("values omitted", diagnostic);
+    }
+}
