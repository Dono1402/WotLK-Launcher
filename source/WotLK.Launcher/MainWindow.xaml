                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                        <StackPanel>
                                                            <TextBlock Foreground="{StaticResource GoldHoverBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Text="Adresse non validée"/>
                                                            <TextBlock Margin="0,5,0,0"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="10"
                                                                       Text="Le téléchargement et le jeu restent disponibles."
                                                                       TextWrapping="Wrap"/>
                                                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                                <Button x:Name="ResendVerificationButton"
                                                                        Content="RENVOYER"
                                                                        Style="{StaticResource SecondaryActionButton}"
                                                                        Click="ResendVerificationButton_Click"/>
                                                                <Button Margin="8,0,0,0"
                                                                        Content="MODIFIER"
                                                                        Style="{StaticResource SecondaryActionButton}"
                                                                        Click="ShowChangeEmailButton_Click"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="ChangeEmailPanel"
                                                            Margin="0,12,0,0"
                                                            Padding="13"
                                                            Background="#15191E"
                                                            BorderBrush="#414850"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Visibility="Collapsed">
                                                        <StackPanel>
                                                            <TextBlock Foreground="{StaticResource TextBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Text="Nouvelle adresse e-mail"/>
                                                            <Border Height="40"
                                                                    Margin="0,9,0,0"
                                                                    Padding="11,0"
                                                                    Background="#0E1115"
                                                                    BorderBrush="#414850"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4">
                                                                <TextBox x:Name="ChangeEmailBox"
                                                                         Style="{StaticResource FieldTextBox}"/>
                                                            </Border>
                                                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                                <Button Content="ENREGISTRER"
                                                                        Style="{StaticResource SecondaryActionButton}"
                                                                        Click="SaveEmailButton_Click"/>
                                                                <Button Margin="8,0,0,0"
                                                                        Content="ANNULER"
                                                                        Style="{StaticResource SecondaryActionButton}"
                                                                        Click="CancelChangeEmailButton_Click"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <Border Margin="0,16,0,0"
                                                    Padding="20"
                                                    Background="#1A1E23"
                                                    BorderBrush="#3C434B"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Foreground="{StaticResource TextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="Recommandations"/>
                                                    <Grid Margin="0,14,0,0">
                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Adresse e-mail"/>
                                                        <TextBlock x:Name="ProfileEmailCompletionText" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Avatar"/>
                                                        <TextBlock x:Name="ProfileAvatarCompletionText" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Double authentification"/>
                                                        <TextBlock x:Name="ProfileTwoFactorCompletionText" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Codes de récupération"/>
                                                        <TextBlock x:Name="ProfileRecoveryCompletionText" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <Border Padding="20"
                                                    Background="#1A1E23"
                                                    BorderBrush="#3C434B"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Foreground="{StaticResource TextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="Mot de passe"/>
                                                    <TextBlock Margin="0,14,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="MOT DE PASSE ACTUEL"/>
                                                    <Border Height="40" Margin="0,7,0,0" Padding="11,0" Background="#0E1115" BorderBrush="#414850" BorderThickness="1" CornerRadius="4">
                                                        <PasswordBox x:Name="CurrentPasswordBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" VerticalContentAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Margin="0,13,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="NOUVEAU MOT DE PASSE"/>
                                                    <Border Height="40" Margin="0,7,0,0" Padding="11,0" Background="#0E1115" BorderBrush="#414850" BorderThickness="1" CornerRadius="4">
                                                        <PasswordBox x:Name="NewPasswordBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" VerticalContentAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Margin="0,13,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="CONFIRMATION"/>
                                                    <Border Height="40" Margin="0,7,0,0" Padding="11,0" Background="#0E1115" BorderBrush="#414850" BorderThickness="1" CornerRadius="4">
                                                        <PasswordBox x:Name="ConfirmNewPasswordBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" VerticalContentAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock x:Name="PasswordChangeStatusText" MinHeight="18" Margin="0,9,0,0" Foreground="#F18A91" FontSize="10" TextWrapping="Wrap"/>
                                                    <Button x:Name="ChangePasswordButton"
                                                            Margin="0,5,0,0"
                                                            Content="MODIFIER LE MOT DE PASSE"
                                                            Style="{StaticResource SecondaryActionButton}"
                                                            Click="ChangePasswordButton_Click"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Margin="0,16,0,0"
                                                    Padding="20"
                                                    Background="#1A1E23"
                                                    BorderBrush="#3C434B"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Text="Sécurité renforcée"/>
                                                    <Grid Margin="0,14,0,0">
                                                        <StackPanel>
                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Double authentification"/>
                                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="Protection supplémentaire du compte."/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="TwoFactorStatusText" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource TextMutedBrush}" Text="Non configurée"/>
                                                    </Grid>
                                                    <Grid Margin="0,15,0,0">
                                                        <StackPanel>
                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="Codes de récupération"/>
                                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="Accès de secours au compte."/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="RecoveryCodesStatusText" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource TextMutedBrush}" Text="Non générés"/>
                                                    </Grid>
                                                    <TextBlock Margin="0,14,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="10"
                                                               Text="L’activation de ces deux fonctions arrivera avec l’étape e-mail Brevo."
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="0,16,0,0"
                                            Padding="20"
                                            Background="#1A1E23"
                                            BorderBrush="#3C434B"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Text="Sessions actives"/>
                                                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="Appareils connectés à votre compte Atlas."/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="ACTUALISER"
                                                        Style="{StaticResource SecondaryActionButton}"
                                                        Click="RefreshSessionsButton_Click"/>
                                            </Grid>
                                            <ItemsControl x:Name="SessionsItemsControl" Margin="0,13,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border MinHeight="62"
                                                                Margin="0,0,0,7"
                                                                Padding="15,10"
                                                                Background="#15191E"
                                                                BorderBrush="#373E45"
                                                                BorderThickness="1"
                                                                CornerRadius="4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="180"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Text="{Binding DeviceName}"/>
                                                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="{Binding LastSeenText}"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="{Binding ExpiresText}"/>
                                                                <Button Grid.Column="2"
                                                                        Margin="12,0,0,0"
                                                                        Content="RÉVOQUER"
                                                                        CommandParameter="{Binding Id}"
                                                                        IsEnabled="{Binding CanRevoke}"
                                                                        Style="{StaticResource SecondaryActionButton}"
                                                                        Click="RevokeSessionButton_Click"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="154"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="44,28,42,22" VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource IceBrush}" FontSize="10" FontWeight="Bold" Text="ATLAS LAUNCHER"/>
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiExtraBoldFont}" FontSize="32" Text="Paramètres"/>
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Text="Installation, langue et comportement du launcher."/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#F214171B" BorderBrush="#383E45" BorderThickness="0,1,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="42,24,42,30">
                                    <Border Padding="20" Background="#1A1E23" BorderBrush="#3C434B" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Text="Installation du jeu"/>
                                            <TextBlock Margin="0,14,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="DOSSIER DU CLIENT"/>
                                            <Grid Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Height="42" Padding="12,0" Background="#0E1115" BorderBrush="#414850" BorderThickness="1" CornerRadius="4">
                                                    <TextBox x:Name="SettingsInstallPathBox" Style="{StaticResource FieldTextBox}" IsReadOnly="True" Focusable="False"/>
                                                </Border>
                                                <Button Grid.Column="2" Content="PARCOURIR" Style="{StaticResource SecondaryActionButton}" Click="SettingsBrowseInstallPathButton_Click"/>
                                            </Grid>
                                            <TextBlock Margin="0,15,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="LANGUE DU JEU"/>
                                            <ComboBox x:Name="SettingsLanguageComboBox"
                                                      Width="260"
                                                      Margin="0,7,0,0"
                                                      HorizontalAlignment="Left"
                                                      Style="{StaticResource DarkComboBox}"
                                                      SelectionChanged="SettingsLanguageComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Français" Tag="frFR"/>
                                                <ComboBoxItem Content="English" Tag="enUS"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,16,0,0" Padding="20" Background="#1A1E23" BorderBrush="#3C434B" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Text="Comportement"/>
                                            <CheckBox x:Name="AutomaticUpdatesCheckBox"
                                                      Margin="0,16,0,0"
                                                      Content="Rechercher automatiquement les mises à jour du launcher"
                                                      Style="{StaticResource SettingsCheckBox}"
                                                      Checked="SettingsCheckBox_Changed"
                                                      Unchecked="SettingsCheckBox_Changed"/>
                                            <CheckBox x:Name="CloseOnGameStartCheckBox"
                                                      Margin="0,15,0,0"
                                                      Content="Fermer le launcher après le démarrage du jeu"
                                                      Style="{StaticResource SettingsCheckBox}"
                                                      Checked="SettingsCheckBox_Changed"
                                                      Unchecked="SettingsCheckBox_Changed"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,16,0,0" Padding="20" Background="#1A1E23" BorderBrush="#3C434B" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" Text="Diagnostic"/>
                                                    <TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="Les logs techniques restent locaux à ce PC."/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="OUVRIR LES LOGS" Style="{StaticResource SecondaryActionButton}" Click="OpenLogsButton_Click"/>
                                            </Grid>
                                            <TextBox x:Name="SettingsLogBox"
                                                     Height="120"
                                                     Margin="0,15,0,0"
                                                     Style="{StaticResource LogTextBox}"
                                                     IsReadOnly="True"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="AuthOverlay"
                  Grid.Row="1"
                  Panel.ZIndex="100"
                  Background="#F20B0E12">
                <Image Source="Assets/Launcher/visuals/icecrown-citadel.png"
                       Stretch="UniformToFill"
                       Opacity="0.23"
                       IsHitTestVisible="False"/>
                <Border Background="#A80A0D10" IsHitTestVisible="False"/>

                <Border Width="450"
                        Padding="34,30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#F515181C"
                        BorderBrush="#464D55"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <StackPanel x:Name="LoginPanel">
                            <TextBlock Foreground="{StaticResource GoldBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Text="COMPTE ATLAS"/>
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource TextBrush}"
                                       FontFamily="{StaticResource UiExtraBoldFont}"
                                       FontSize="29"
                                       Text="Connexion"/>
                            <TextBlock Margin="0,7,0,21"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Text="Retrouve Arthas et lance le jeu sans ressaisir tes identifiants."/>

                            <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="NOM D'UTILISATEUR"/>
                            <Border Height="44"
                                    Margin="0,7,0,15"
                                    Padding="13,0"
                                    Background="#0E1115"
                                    BorderBrush="#414850"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <TextBox x:Name="LoginUsernameBox"
                                         Style="{StaticResource FieldTextBox}"/>
                            </Border>

                            <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="MOT DE PASSE"/>
                            <Border Height="44"
                                    Margin="0,7,0,0"
                                    Padding="13,0"
                                    Background="#0E1115"
                                    BorderBrush="#414850"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <PasswordBox x:Name="LoginPasswordBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextBrush}"
                                             FontFamily="Segoe UI"
                                             FontSize="14"
                                             VerticalContentAlignment="Center"
                                             KeyDown="LoginPasswordBox_KeyDown"/>
                            </Border>

                            <TextBlock x:Name="LoginErrorText"
                                       MinHeight="20"
                                       Margin="0,10,0,0"
                                       Foreground="#F18A91"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                            <Button x:Name="LoginButton"
                                    Margin="0,8,0,0"
                                    Content="SE CONNECTER"
                                    Style="{StaticResource PrimaryActionButton}"
                                    Click="LoginButton_Click"/>
                            <Button Margin="0,12,0,0"
                                    Height="38"
                                    Content="CRÉER UN COMPTE"
                                    Click="ShowRegisterButton_Click"/>
                        </StackPanel>

                        <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                            <TextBlock Foreground="{StaticResource GoldBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Text="NOUVEAU COMPTE"/>
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource TextBrush}"
                                       FontFamily="{StaticResource UiExtraBoldFont}"
                                       FontSize="29"
                                       Text="Rejoindre Arthas"/>
                            <TextBlock Margin="0,7,0,18"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Text="La validation de l'e-mail pourra être faite plus tard."/>

                            <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10"
                                       Text="NOM D'UTILISATEUR"/>
                            <Border Height="40" Margin="0,6,0,11" Padding="12,0"
                                    Background="#0E1115" BorderBrush="#414850" BorderThickness="1" CornerRadius="4">
                                <TextBox x:Name="RegisterUsernameBox" Style="{StaticResource FieldTextBox}"/>
                            </Border>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10"
                                       Text="ADRESSE E-MAIL"/>
                            <Border Height="40" Margin="0,6,0,11" Padding="12,0"
                                    Background="#0E1115" BorderBrush="#414850" BorderThickness="1" CornerRadius="4">
                                <TextBox x:Name="RegisterEmailBox" Style="{StaticResource FieldTextBox}"/>
                            </Border>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10"
                                       Text="MOT DE PASSE"/>
                            <Border Height="40" Margin="0,6,0,11" Padding="12,0"
                                    Background="#0E1115" BorderBrush="#414850" BorderThickness="1" CornerRadius="4">
                                <PasswordBox x:Name="RegisterPasswordBox"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
                                             FontSize="14" VerticalContentAlignment="Center"/>
                            </Border>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10"
                                       Text="CONFIRMATION"/>
                            <Border Height="40" Margin="0,6,0,0" Padding="12,0"
                                    Background="#0E1115" BorderBrush="#414850" BorderThickness="1" CornerRadius="4">
                                <PasswordBox x:Name="RegisterPasswordConfirmBox"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
                                             FontSize="14" VerticalContentAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="RegisterErrorText"
                                       MinHeight="20"
                                       Margin="0,9,0,0"
                                       Foreground="#F18A91"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                            <Button x:Name="RegisterButton"
                                    Margin="0,7,0,0"
                                    Content="CRÉER MON COMPTE"
                                    Style="{StaticResource PrimaryActionButton}"
                                    Click="RegisterButton_Click"/>
                            <Button Margin="0,10,0,0"
                                    Height="36"
                                    Content="RETOUR À LA CONNEXION"
                                    Click="ShowLoginButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="ToastBorder"
                    Grid.Row="1"
                    Panel.ZIndex="300"
                    Width="390"
                    MaxHeight="150"
                    Margin="0,16,18,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#F21A1E23"
                    BorderBrush="#4A5159"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ToastAccentBorder"
                            Background="{StaticResource IceBrush}"
                            CornerRadius="3,0,0,3"/>
                    <Grid Grid.Column="1" Margin="15,12,9,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ToastTitleText"
                                       Foreground="{StaticResource TextBrush}"
                                       FontFamily="{StaticResource UiSemiBoldFont}"
                                       FontSize="13"
                                       Text="Information"/>
                            <TextBlock x:Name="ToastMessageText"
                                       Margin="0,5,4,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10"
                                       LineHeight="14"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="26"
                                Height="26"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Content="&#xE711;"
                                Style="{StaticResource IconButton}"
                                ToolTip="Fermer"
                                Click="ToastCloseButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
