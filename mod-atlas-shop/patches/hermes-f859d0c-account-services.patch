diff --git a/HermesProxy/World/Server/Packets/AtlasAccountServicesPackets.cs b/HermesProxy/World/Server/Packets/AtlasAccountServicesPackets.cs
new file mode 100644
index 0000000..21f9440
--- /dev/null
+++ b/HermesProxy/World/Server/Packets/AtlasAccountServicesPackets.cs
@@ -0,0 +1,190 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using HermesProxy.World.Enums;
+
+namespace HermesProxy.World.Server.Packets;
+
+// Interoperability contract verified against the 3.4.3.54261 client parsers.
+// This deliberately supports only account-owned paid name changes.
+public sealed class AtlasStoreEmptyRequest : ClientPacket
+{
+    public AtlasStoreEmptyRequest(WorldPacket packet) : base(packet) { }
+    public override void Read()
+    {
+        if (_worldPacket.CanRead()) throw new InvalidDataException("Unexpected store request payload.");
+    }
+}
+
+public sealed class AtlasVasCharactersRequest : ClientPacket
+{
+    public AtlasVasCharactersRequest(WorldPacket packet) : base(packet) { }
+    public uint Token;
+    public uint ServiceType;
+    public override void Read()
+    {
+        Token = _worldPacket.ReadUInt32();
+        ServiceType = _worldPacket.ReadUInt32();
+        if (_worldPacket.CanRead()) throw new InvalidDataException("Unexpected VAS character request payload.");
+    }
+}
+
+public sealed class AtlasAssignNameChange : ClientPacket
+{
+    public AtlasAssignNameChange(WorldPacket packet) : base(packet) { }
+    public uint Token;
+    public ulong DistributionId;
+    public WowGuid128 Character;
+    public uint RealmAddress;
+    public string Name = string.Empty;
+    public bool ValidateOnly;
+    public bool IsSupportedNameChange;
+
+    public override void Read()
+    {
+        Token = _worldPacket.ReadUInt32();
+        DistributionId = _worldPacket.ReadUInt64();
+        Character = _worldPacket.ReadPackedGuid128();
+        RealmAddress = _worldPacket.ReadUInt32();
+        uint targetRealm = _worldPacket.ReadUInt32();
+        var targetAccount = _worldPacket.ReadPackedGuid128();
+        var targetBnet = _worldPacket.ReadPackedGuid128();
+        var guild = _worldPacket.ReadPackedGuid128();
+        byte sex = _worldPacket.ReadUInt8();
+        byte race = _worldPacket.ReadUInt8();
+        byte faction = _worldPacket.ReadUInt8();
+        uint customizationCount = _worldPacket.ReadUInt32();
+        if (customizationCount > 72) throw new InvalidDataException("Too many VAS customizations.");
+        for (uint i = 0; i < customizationCount; ++i)
+        {
+            _worldPacket.ReadUInt32();
+            _worldPacket.ReadUInt32();
+        }
+        uint nameLength = _worldPacket.ReadBits<uint>(6);
+        uint accountLength = _worldPacket.ReadBits<uint>(7);
+        uint bnetLength = _worldPacket.ReadBits<uint>(7);
+        bool transfer = _worldPacket.ReadBit();
+        ValidateOnly = _worldPacket.ReadBit();
+        bool other = _worldPacket.ReadBit();
+        _worldPacket.ResetBitReader();
+        if (!_worldPacket.CanRead(checked((int)(nameLength + accountLength + bnetLength))))
+            throw new InvalidDataException("Truncated VAS assignment strings.");
+        Name = _worldPacket.ReadString(nameLength);
+        _worldPacket.ReadString(accountLength);
+        _worldPacket.ReadString(bnetLength);
+        if (_worldPacket.CanRead()) throw new InvalidDataException("Unexpected VAS assignment payload.");
+        IsSupportedNameChange = DistributionId != 0 && Character.Low is > 0 and <= uint.MaxValue && Character.High >> 58 == 2
+            && targetRealm == 0 && targetAccount == WowGuid128.Empty && targetBnet == WowGuid128.Empty
+            && guild == WowGuid128.Empty && sex == 2 && race == 0 && faction == 0
+            && customizationCount == 0 && accountLength == 0 && bnetLength == 0 && !transfer && !other
+            && nameLength is > 0 and <= 48 && Name.IndexOf('\0') < 0;
+    }
+}
+
+public sealed class AtlasDistribution
+{
+    public const uint RenameProductId = 0x41544C01;
+    public ulong Id;
+    public uint Status = 1;
+    public WowGuid128 Account;
+    public WowGuid128 Character;
+    public uint RealmAddress;
+    public bool Revoked;
+
+    public void Write(WorldPacket packet)
+    {
+        if (Id == 0) throw new InvalidOperationException("A distribution requires a persistent identifier.");
+        packet.WriteUInt64(Id);
+        packet.WriteUInt32(Status);
+        packet.WriteUInt32(RenameProductId);
+        packet.WritePackedGuid128(Account);
+        packet.WritePackedGuid128(Character);
+        packet.WriteUInt32(RealmAddress);
+        packet.WriteUInt32(RealmAddress);
+        packet.WriteUInt64(0); // No purchase is made through the Blizzard store.
+        packet.WriteUInt32(0); // Not in review.
+        packet.WriteBit(true); // Includes its product, required by GetVASDistributions.
+        packet.WriteBit(Revoked);
+        packet.FlushBits();
+        packet.WriteUInt32(RenameProductId);
+        packet.WriteUInt8(5); // Paid name change product. Classified as ValueAddedServiceType 4.
+        for (int i = 0; i < 5; ++i) packet.WriteUInt32(0);
+        packet.WriteUInt32(1u << 10); // Account service token flag.
+        for (int i = 0; i < 4; ++i) packet.WriteUInt32(0);
+        packet.WriteUInt8(0); // Product string length.
+        packet.WriteBit(false);
+        packet.WriteBit(false); // No optional choice type.
+        packet.WriteBits(0u, 7); // No item deliveries.
+        packet.WriteBit(false); // No optional store display info.
+        packet.FlushBits();
+    }
+}
+
+public sealed class AtlasDistributionList : ServerPacket
+{
+    public AtlasDistributionList() : base(Opcode.SMSG_BATTLE_PAY_GET_DISTRIBUTION_LIST_RESPONSE) { }
+    public List<AtlasDistribution> Distributions = new();
+    public override void Write()
+    {
+        if (Distributions.Count > 100) throw new InvalidOperationException("Account service limit exceeded.");
+        _worldPacket.WriteUInt32(0);
+        _worldPacket.WriteBits((uint)Distributions.Count, 11);
+        _worldPacket.FlushBits();
+        foreach (var entry in Distributions) entry.Write(_worldPacket);
+    }
+}
+
+public sealed class AtlasDistributionUpdate : ServerPacket
+{
+    public AtlasDistributionUpdate() : base(Opcode.SMSG_BATTLE_PAY_DISTRIBUTION_UPDATE) { }
+    public AtlasDistribution Distribution = new();
+    public override void Write() => Distribution.Write(_worldPacket);
+}
+
+public sealed class AtlasAssignVasResponse : ServerPacket
+{
+    public AtlasAssignVasResponse() : base(Opcode.SMSG_BATTLE_PAY_DISTRIBUTION_ASSIGN_VAS_RESPONSE) { }
+    public uint Token;
+    public uint StoreError;
+    public uint VasError;
+    public override void Write()
+    {
+        _worldPacket.WriteUInt32(Token);
+        _worldPacket.WriteUInt32(StoreError);
+        _worldPacket.WriteUInt32(VasError);
+    }
+}
+
+public sealed class AtlasVasCharactersResult : ServerPacket
+{
+    public AtlasVasCharactersResult() : base(Opcode.SMSG_GET_VAS_ACCOUNT_CHARACTER_LIST_RESULT) { }
+    public uint Token;
+    public uint Result;
+    public List<AccountCharacterListEntry> Characters = new();
+    public override void Write()
+    {
+        _worldPacket.WriteUInt32(Token);
+        _worldPacket.WriteUInt32(Result);
+        _worldPacket.WriteUInt32(0);
+        _worldPacket.WriteUInt32((uint)Characters.Count);
+        foreach (var entry in Characters) entry.Write(_worldPacket);
+    }
+}
+
+public sealed class AtlasEmptyProductList : ServerPacket
+{
+    public AtlasEmptyProductList() : base(Opcode.SMSG_BATTLE_PAY_GET_PRODUCT_LIST_RESPONSE) { }
+    public override void Write() { for (int i = 0; i < 6; ++i) _worldPacket.WriteUInt32(0); }
+}
+
+public sealed class AtlasEmptyPurchaseList : ServerPacket
+{
+    public AtlasEmptyPurchaseList() : base(Opcode.SMSG_BATTLE_PAY_GET_PURCHASE_LIST_RESPONSE) { }
+    public override void Write() { _worldPacket.WriteUInt32(0); _worldPacket.WriteUInt32(0); }
+}
+
+public sealed class AtlasEmptyVasStates : ServerPacket
+{
+    public AtlasEmptyVasStates() : base(Opcode.SMSG_ENUM_VAS_PURCHASE_STATES_RESPONSE) { }
+    public override void Write() { _worldPacket.WriteBits(0u, 6); _worldPacket.FlushBits(); }
+}
