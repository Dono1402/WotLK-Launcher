<UserControl x:Class="WotLK.Launcher.UI.V2.Views.FriendsDrawerV2"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WotLK.Launcher.UI.V2.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="796"
             Background="Transparent"
             Visibility="Collapsed"
             IsHitTestVisible="False"
             Focusable="False"
             PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/AtlasV2.OverlaysPilot.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="AtlasV2.Friends.IconButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource AtlasV2.Overlay.IconButton}">
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="ToolTipService.IsEnabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
        </Style>
        <Style x:Key="AtlasV2.Friends.GroupToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="2,2">
                            <DockPanel>
                                <Path x:Name="GroupChevron" Width="10" Height="10" Margin="0,0,7,0"
                                      Data="{StaticResource AtlasV2.Icon.ChevronDown}"
                                      Style="{StaticResource AtlasV2.Icon.Stroke}" Stroke="{TemplateBinding Foreground}"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><RotateTransform Angle="-90"/></Path.RenderTransform>
                                </Path>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="GroupChevron" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="0"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AtlasV2.Overlay.CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="AtlasV2.Friends.Avatar">
            <Grid Width="38" Height="38">
                <Ellipse Fill="{Binding AvatarColor}"/>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding Initial}"
                           FontFamily="{StaticResource AtlasV2.Font.Inter}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#111318"/>
                <Ellipse AutomationProperties.Name="Photo de profil Atlas">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding AvatarImage}"
                                    Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                    <Ellipse.Style>
                        <Style TargetType="{x:Type Ellipse}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Ellipse StrokeThickness="1">
                    <Ellipse.Style>
                        <Style TargetType="{x:Type Ellipse}">
                            <Setter Property="Stroke" Value="{StaticResource AtlasV2.Overlay.CardEdge}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                                    <Setter Property="Opacity" Value="0.82"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AtlasV2.Friends.ProfileAvatar">
            <Grid Width="82" Height="82">
                <Ellipse Fill="{Binding AvatarColor}"/>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding Initial}"
                           FontSize="27"
                           FontWeight="ExtraBold"
                           Foreground="#111318"/>
                <Ellipse>
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                    <Ellipse.Style>
                        <Style TargetType="{x:Type Ellipse}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Ellipse Stroke="{StaticResource AtlasV2.Brush.GoldBorder}" StrokeThickness="2"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AtlasV2.Friends.CharacterItem">
            <Border MinHeight="66"
                    Margin="0,0,0,7"
                    Padding="11,9"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{StaticResource AtlasV2.Overlay.Card}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Overlay.Divider}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFeatured}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AtlasV2.Overlay.CardHover}"/>
                                <Setter Property="BorderBrush" Value="{Binding ClassColor}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0">
                        <Path Width="22" Height="22" Data="{StaticResource AtlasV2.Icon.User}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}" Stroke="{Binding ClassColor}"/>
                        <Image Source="{Binding ClassIconPath}" Stretch="Uniform"
                               ToolTip="{Binding ClassName}"
                               AutomationProperties.Name="{Binding ClassName}"
                               Visibility="{Binding HasClassIcon, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}"
                                   ToolTip="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Style="{StaticResource AtlasV2.Text.Body}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        <TextBlock Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   FontSize="13"
                                   Foreground="{Binding ClassColor}">
                            <Run Text="{Binding ClassName}"/><Run Text=" · "/><Run Text="niveau "/><Run Text="{Binding Level}"/>
                        </TextBlock>
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding ZoneName}"
                                   FontSize="13"
                                   Visibility="{Binding HasZone, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                   Style="{StaticResource AtlasV2.Text.Caption}"/>
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding ProfilePresenceText}"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource AtlasV2.Text.Caption}"/>
                    </StackPanel>
                    <Ellipse Grid.Column="2"
                             Width="8"
                             Height="8"
                             Margin="10,5,1,0"
                             VerticalAlignment="Top">
                        <Ellipse.Style>
                            <Style TargetType="{x:Type Ellipse}">
                                <Setter Property="Fill" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AtlasV2.Brush.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AtlasV2.Friends.IncomingItem">
            <Border MinHeight="78"
                    Margin="0,0,0,7"
                    Padding="10"
                    Background="{StaticResource AtlasV2.Overlay.Card}"
                    BorderBrush="{StaticResource AtlasV2.Overlay.Divider}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource AtlasV2.Friends.Avatar}"/>
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Username}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource AtlasV2.Text.Body}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        <TextBlock Grid.Row="1"
                                   Margin="0,2,0,7"
                                   Text="Demande reçue"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button MinWidth="82"
                                    Height="32"
                                    Padding="10,0"
                                    Style="{StaticResource AtlasV2.Overlay.CompactButton}"
                                    Command="{Binding State.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType={x:Type views:FriendsDrawerV2}}}"
                                    CommandParameter="{Binding AccountId}"
                                    AutomationProperties.Name="Accepter la demande"
                                    Content="Accepter"/>
                            <Button Width="32"
                                    Height="32"
                                    Margin="6,0,0,0"
                                    Padding="8"
                                    Style="{StaticResource AtlasV2.Overlay.IconButton}"
                                    Command="{Binding State.RejectRequestCommand, RelativeSource={RelativeSource AncestorType={x:Type views:FriendsDrawerV2}}}"
                                    CommandParameter="{Binding AccountId}"
                                    ToolTip="Refuser"
                                    AutomationProperties.Name="Refuser la demande">
                                <Path Data="{StaticResource AtlasV2.Icon.Close}"
                                      Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AtlasV2.Friends.OutgoingItem">
            <Border MinHeight="64"
                    Margin="0,0,0,7"
                    Padding="10"
                    Background="{StaticResource AtlasV2.Overlay.Card}"
                    BorderBrush="{StaticResource AtlasV2.Overlay.Divider}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource AtlasV2.Friends.Avatar}"/>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Username}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource AtlasV2.Text.Body}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        <TextBlock Margin="0,2,0,0"
                                   Text="En attente"
                                   Style="{StaticResource AtlasV2.Text.Caption}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Height="32"
                            Padding="9,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource AtlasV2.Overlay.CompactButton}"
                            Command="{Binding State.CancelRequestCommand, RelativeSource={RelativeSource AncestorType={x:Type views:FriendsDrawerV2}}}"
                            CommandParameter="{Binding AccountId}"
                            Content="Annuler"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AtlasV2.Friends.FriendItem">
            <Border x:Name="FriendCard" MinHeight="62"
                    Margin="0,0,0,5"
                    Padding="8,6"
                    Background="{StaticResource AtlasV2.Overlay.Card}"
                    BorderBrush="{StaticResource AtlasV2.Overlay.Divider}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Tag="{Binding ElementName=FriendActionsPopup}"
                    PreviewMouseRightButtonUp="FriendCard_PreviewMouseRightButtonUp"
                    PreviewKeyDown="FriendCard_PreviewKeyDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OpenFriendProfileButton" Grid.ColumnSpan="3" Panel.ZIndex="1"
                            Margin="-5" Style="{StaticResource AtlasV2.Overlay.FriendHitTarget}"
                            IsTabStop="True" ToolTipService.IsEnabled="True"
                            AutomationProperties.Name="{Binding Username}"
                            ToolTip="{Binding IdentityHint}" ToolTipOpening="FriendIdentityToolTip_Opening"
                            Click="OpenFriendProfileButton_Click"/>
                    <Grid x:Name="FriendAvatarFrame" Width="38" Height="38" VerticalAlignment="Center">
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource AtlasV2.Friends.Avatar}"/>
                        <Ellipse x:Name="FriendPresenceBadge" Width="9"
                                 Height="9"
                                 Margin="0,0,-1,-1"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Stroke="{StaticResource AtlasV2.Overlay.Card}"
                                 StrokeThickness="2"
                                 Fill="{Binding PresenceColor}"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FriendUsernameText" Text="{Binding Username}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource AtlasV2.Text.Body}"
                                    FontWeight="SemiBold" FontSize="15"
                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        <TextBlock x:Name="FriendCharacterText" Margin="0,1,0,0"
                                   Text="{Binding CharacterSummary}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasCharacter, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                    FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource AtlasV2.Text.Caption}">
                                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCharacterActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="FriendPresenceText" Margin="0,1,0,0" FontSize="12"
                                   Text="{Binding PresenceText}"
                                   Foreground="{Binding PresenceColor}"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="QuickMessageButton" Grid.Column="2" Panel.ZIndex="2"
                            Width="28" Height="28" Padding="6" VerticalAlignment="Center"
                            Opacity="0" IsHitTestVisible="False"
                            Style="{StaticResource AtlasV2.Friends.IconButton}"
                            ToolTip="{Binding State.MessageActionLabel, RelativeSource={RelativeSource AncestorType={x:Type views:FriendsDrawerV2}}}"
                            AutomationProperties.Name="{Binding State.MessageActionLabel, RelativeSource={RelativeSource AncestorType={x:Type views:FriendsDrawerV2}}}"
                            Click="QuickMessageButton_Click">
                        <Path Data="{StaticResource AtlasV2.Icon.Mail}" Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                    </Button>
                        <Popup x:Name="FriendActionsPopup" Grid.ColumnSpan="2"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                               PlacementTarget="{Binding ElementName=OpenFriendProfileButton}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               StaysOpen="False"
                               Closed="FriendActionsPopup_Closed">
                            <Border Width="238" Margin="0,4,0,0" Padding="5" CornerRadius="10"
                                    Background="{StaticResource AtlasV2.Overlay.Panel}"
                                    BorderBrush="{StaticResource AtlasV2.Overlay.CardEdge}" BorderThickness="1"
                                    TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
                                    PreviewKeyDown="FriendActionsMenu_PreviewKeyDown"
                                    KeyboardNavigation.TabNavigation="Cycle">
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style x:Key="FriendActionMenuButton" TargetType="{x:Type Button}"
                                               BasedOn="{StaticResource AtlasV2.Overlay.CompactButton}">
                                            <Setter Property="IsTabStop" Value="True"/>
                                            <Setter Property="Height" Value="40"/>
                                            <Setter Property="Padding" Value="10,0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Button x:Name="ViewPublicProfileMenuItem"
                                            Style="{StaticResource FriendActionMenuButton}"
                                            Click="ViewPublicProfileMenuItem_Click" AutomationProperties.Name="Voir le profil">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="15" Height="15" Margin="0,0,10,0"
                                                  Data="{StaticResource AtlasV2.Icon.User}" Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                            <TextBlock Text="Voir le profil" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SendMessageMenuItem"
                                            Style="{StaticResource FriendActionMenuButton}"
                                            Click="SendMessageMenuItem_Click" AutomationProperties.Name="Envoyer un message">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="15" Height="15" Margin="0,0,10,0"
                                                  Data="{StaticResource AtlasV2.Icon.Mail}" Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                            <TextBlock Text="Envoyer un message" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RemoveFriendMenuItem" IsEnabled="{Binding CanRemove}"
                                            Style="{StaticResource FriendActionMenuButton}"
                                            Click="RemoveFriendMenuItem_Click" AutomationProperties.Name="Retirer cet ami">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="15" Height="15" Margin="0,0,10,0"
                                                  Data="{StaticResource AtlasV2.Icon.Trash}" Style="{StaticResource AtlasV2.Icon.Stroke}"
                                                  Stroke="{StaticResource AtlasV2.Brush.Danger}"/>
                                            <TextBlock Text="Retirer cet ami" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="FriendCard" Property="IsMouseOver" Value="True">
                    <Setter TargetName="FriendCard" Property="Background" Value="{StaticResource AtlasV2.Overlay.CardHover}"/>
                    <Setter TargetName="QuickMessageButton" Property="Opacity" Value="1"/>
                    <Setter TargetName="QuickMessageButton" Property="IsHitTestVisible" Value="True"/>
                </Trigger>
                <Trigger SourceName="FriendCard" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="FriendCard" Property="Background" Value="{StaticResource AtlasV2.Overlay.CardHover}"/>
                    <Setter TargetName="QuickMessageButton" Property="Opacity" Value="1"/>
                    <Setter TargetName="QuickMessageButton" Property="IsHitTestVisible" Value="True"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
            </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="OverlayRoot">
        <Border x:Name="Scrim"
                Background="{StaticResource AtlasV2.Brush.Scrim}"
                Opacity="0"
                IsHitTestVisible="False"
                MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>

        <Border x:Name="DrawerPanel"
                Width="392"
                Margin="0,10,10,10"
                Padding="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="{StaticResource AtlasV2.Overlay.Panel}"
                BorderBrush="{StaticResource AtlasV2.Overlay.CardEdge}"
                BorderThickness="1"
                CornerRadius="14"
                Opacity="0"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Contained">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTranslate" X="408"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="Mes amis" Margin="0,0,82,0" VerticalAlignment="Center"
                               FontSize="24" Style="{StaticResource AtlasV2.Overlay.Title}"/>
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                        <Button x:Name="AddFriendToggleButton"
                                Width="38"
                                Height="38"
                                Padding="10"
                                Margin="0,0,4,0"
                                Style="{StaticResource AtlasV2.Friends.IconButton}"
                                ToolTip="Ajouter un ami"
                                AutomationProperties.Name="Ajouter un ami"
                                Click="AddFriendToggleButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.Plus}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                        <Button x:Name="CloseButton"
                                Width="38"
                                Height="38"
                                Padding="10"
                                Style="{StaticResource AtlasV2.Friends.IconButton}"
                                ToolTip="Fermer"
                                AutomationProperties.Name="Fermer le panneau Amis"
                                Click="CloseButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.Close}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="FriendsSummaryText"
                           Grid.Row="1"
                           Margin="0,4,0,10" FontSize="12"
                           Text="{Binding State.Current.FriendsSummary, ElementName=Root, Mode=OneWay}"
                           Style="{StaticResource AtlasV2.Text.Caption}"/>

                <Border x:Name="FriendsFilterPanel" Grid.Row="2" Height="34" Margin="0,0,0,8"
                        Visibility="{Binding State.ShowsFilter, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                        Background="{StaticResource AtlasV2.Overlay.Field}"
                        BorderBrush="{StaticResource AtlasV2.Overlay.Divider}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Path Width="13" Height="13" Data="{StaticResource AtlasV2.Icon.Search}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}" Stroke="{StaticResource AtlasV2.Brush.TextMuted}"/>
                        <TextBox x:Name="FriendsFilterBox" Grid.Column="1" FontSize="12" MaxLength="64"
                                 Style="{StaticResource AtlasV2.TextBox.Field}"
                                 Text="{Binding State.FilterText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding State.FilterHint, ElementName=Root}"/>
                        <TextBlock Grid.Column="1" IsHitTestVisible="False" VerticalAlignment="Center"
                                   Text="{Binding State.FilterHint, ElementName=Root}" FontSize="12"
                                   Foreground="{StaticResource AtlasV2.Brush.TextMuted}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FriendsFilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button x:Name="ClearFriendsFilterButton" Grid.Column="2" Width="26" Height="26" Padding="7"
                                Style="{StaticResource AtlasV2.Friends.IconButton}"
                                Visibility="{Binding State.HasFilter, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                ToolTip="{Binding State.ClearFilterLabel, ElementName=Root}"
                                AutomationProperties.Name="{Binding State.ClearFilterLabel, ElementName=Root}"
                                Click="ClearFriendsFilterButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.Close}" Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                    </Grid>
                </Border>

                <Border x:Name="AddFriendPanel"
                        Grid.Row="3"
                        MaxHeight="0"
                        Opacity="0"
                        IsHitTestVisible="False"
                        ClipToBounds="True">
                    <StackPanel Margin="0,0,0,12">
                    <TextBlock Margin="0,0,0,6"
                               Text="Pseudo Atlas"
                               Style="{StaticResource AtlasV2.Text.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                    <Border Height="42"
                            Background="{StaticResource AtlasV2.Overlay.Field}"
                            BorderBrush="{StaticResource AtlasV2.Overlay.CardEdge}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                             <TextBox x:Name="FriendSearchBox"
                                     Margin="12,0,6,0"
                                     MaxLength="32"
                                     Text="{Binding State.SearchText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AtlasV2.TextBox.Field}"
                                     AutomationProperties.Name="Nom d’utilisateur Atlas"
                                     KeyDown="FriendSearchBox_KeyDown"/>
                            <Button x:Name="SendFriendRequestButton"
                                    Grid.Column="1"
                                    Width="38"
                                    Height="38"
                                    Padding="10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AtlasV2.Friends.IconButton}"
                                    Command="{Binding State.SendRequestCommand, ElementName=Root}"
                                    ToolTip="Envoyer la demande"
                                    AutomationProperties.Name="Envoyer la demande d’ami">
                                <Path Data="{StaticResource AtlasV2.Icon.ArrowRight}"
                                      Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                            </Button>
                        </Grid>
                    </Border>
                    </StackPanel>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="AddFriendTranslate" Y="-5"/>
                    </Border.RenderTransform>
                </Border>

                <StackPanel Grid.Row="4" Margin="0,0,0,6"
                            Visibility="{Binding State.Current.ShowsFeedback, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                    <ProgressBar x:Name="FriendsBusyProgress"
                                 Margin="0,0,0,8"
                                 IsIndeterminate="True"
                                 Visibility="{Binding State.Current.IsLoading, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                 Style="{StaticResource AtlasV2.Progress.Compact}"/>
                    <Border Margin="0,0,0,7"
                            Style="{StaticResource AtlasV2.Banner.Error}"
                            Visibility="{Binding State.Current.ShowsError, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                        <TextBlock Text="{Binding State.Current.ErrorMessage, ElementName=Root}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   Foreground="{StaticResource AtlasV2.Brush.Danger}"/>
                    </Border>
                    <Border Margin="0,0,0,7"
                            Padding="12,9"
                            Background="{StaticResource AtlasV2.Brush.SuccessSurface}"
                            BorderBrush="{StaticResource AtlasV2.Brush.SuccessBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding State.Current.ShowsNotice, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                        <TextBlock Text="{Binding State.Current.NoticeMessage, ElementName=Root}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   Foreground="{StaticResource AtlasV2.Brush.Success}"/>
                    </Border>
                    <TextBlock Text="{Binding State.Current.StatusMessage, ElementName=Root}"
                               Visibility="{Binding State.Current.HasStatusMessage, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                               TextWrapping="Wrap"
                               Style="{StaticResource AtlasV2.Text.Caption}"/>
                </StackPanel>

                <Grid Grid.Row="5">
                    <ItemsControl x:Name="FriendsList" Margin="0,0,5,0" VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer x:Name="PART_ScrollViewer" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="FriendsList_ScrollChanged">
                                    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/></ScrollViewer.Resources>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Friend}" HorizontalContentAlignment="Stretch">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="ContentTemplate" Value="{StaticResource AtlasV2.Friends.FriendItem}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="incoming"><Setter Property="ContentTemplate" Value="{StaticResource AtlasV2.Friends.IncomingItem}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="outgoing"><Setter Property="ContentTemplate" Value="{StaticResource AtlasV2.Friends.OutgoingItem}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="incoming-header"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                                                    <TextBlock Text="DEMANDES REÇUES" Margin="0,7,0,7" Style="{StaticResource AtlasV2.Overlay.Eyebrow}"/>
                                                </DataTemplate></Setter.Value></Setter></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="outgoing-header"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                                                    <TextBlock Text="DEMANDES ENVOYÉES" Margin="0,7,0,7" Style="{StaticResource AtlasV2.Overlay.Eyebrow}"/>
                                                </DataTemplate></Setter.Value></Setter></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="online-header"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                                                    <ToggleButton Tag="online-header" Style="{StaticResource AtlasV2.Friends.GroupToggle}"
                                                        Content="{Binding State.OnlineGroupLabel, RelativeSource={RelativeSource AncestorType={x:Type views:FriendsDrawerV2}}}"
                                                        AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                                        IsChecked="{Binding State.IsOnlineGroupExpanded, RelativeSource={RelativeSource AncestorType={x:Type views:FriendsDrawerV2}}, Mode=TwoWay}"/>
                                                </DataTemplate></Setter.Value></Setter></DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="offline-header"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                                                    <ToggleButton Tag="offline-header" Style="{StaticResource AtlasV2.Friends.GroupToggle}" Foreground="{StaticResource AtlasV2.Brush.TextMuted}"
                                                        Content="{Binding State.OfflineGroupLabel, RelativeSource={RelativeSource AncestorType={x:Type views:FriendsDrawerV2}}}"
                                                        AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                                        IsChecked="{Binding State.IsOfflineGroupExpanded, RelativeSource={RelativeSource AncestorType={x:Type views:FriendsDrawerV2}}, Mode=TwoWay}"/>
                                                </DataTemplate></Setter.Value></Setter></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        <StackPanel x:Name="FriendsFilterEmptyState" Margin="12,20" HorizontalAlignment="Center"
                                    Visibility="{Binding State.ShowsFilterEmpty, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                            <TextBlock Text="{Binding State.NoFilterResultsLabel, ElementName=Root}" TextWrapping="Wrap"
                                       TextAlignment="Center" FontSize="12" Style="{StaticResource AtlasV2.Text.Caption}"/>
                        </StackPanel>
                        <StackPanel x:Name="FriendsEmptyState" Margin="12,42" HorizontalAlignment="Center"
                            Visibility="{Binding State.ShowsGlobalEmpty, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                            <Path Width="28" Height="28" Margin="0,0,0,10" Data="{StaticResource AtlasV2.Icon.Users}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}" Stroke="{StaticResource AtlasV2.Brush.TextMuted}"/>
                            <TextBlock Text="Aucun ami pour le moment" Style="{StaticResource AtlasV2.Text.Body}" FontWeight="SemiBold"
                                       Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                        </StackPanel>
                    </Grid>

                <Grid x:Name="FriendProfilePanel"
                      Grid.RowSpan="6"
                      Panel.ZIndex="10"
                      Background="{StaticResource AtlasV2.Overlay.Panel}">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State.IsFriendProfileOpen, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <Button x:Name="BackToFriendsButton"
                                Width="38"
                                Height="38"
                                Padding="10"
                                HorizontalAlignment="Left"
                                Style="{StaticResource AtlasV2.Overlay.IconButton}"
                                ToolTip="Retour à la liste"
                                AutomationProperties.Name="Retour à la liste d’amis"
                                Click="BackToFriendsButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.ArrowLeft}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                        <TextBlock Margin="48,0"
                                   VerticalAlignment="Center"
                                   Text="Profil"
                                   Style="{StaticResource AtlasV2.Overlay.Section}"
                                   FontSize="20"/>
                        <Button Width="38"
                                Height="38"
                                Padding="10"
                                HorizontalAlignment="Right"
                                Style="{StaticResource AtlasV2.Overlay.IconButton}"
                                ToolTip="Fermer"
                                AutomationProperties.Name="Fermer le panneau Amis"
                                Click="CloseButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.Close}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Margin="0,0,5,0"
                                    DataContext="{Binding State.SelectedFriend, ElementName=Root}">
                            <ContentControl HorizontalAlignment="Center"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource AtlasV2.Friends.ProfileAvatar}"/>
                            <TextBlock Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       Text="{Binding Username}"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource AtlasV2.Overlay.Section}"
                                       FontSize="22"/>
                            <TextBlock Margin="12,4"
                                       HorizontalAlignment="Center"
                                       Text="{Binding DisplayStatusMessage}"
                                       Visibility="{Binding HasStatusMessage, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource AtlasV2.Text.Body}"
                                       Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                            <TextBlock Margin="0,2,0,0"
                                       HorizontalAlignment="Center"
                                       Text="{Binding ProfilePresenceText}"
                                       Foreground="{Binding PresenceColor}"
                                       FontSize="13"
                                       Style="{StaticResource AtlasV2.Text.Caption}"/>

                            <Border Height="1" Margin="0,18" Background="{StaticResource AtlasV2.Overlay.Divider}"/>
                            <TextBlock Text="BIO" Style="{StaticResource AtlasV2.Overlay.Eyebrow}"/>
                            <TextBlock Margin="0,7,0,0"
                                       Text="{Binding DisplayBio}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource AtlasV2.Text.Body}"/>

                            <StackPanel Margin="0,20,0,0"
                                        Visibility="{Binding HasFeaturedCharacter, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                <TextBlock Margin="0,0,0,7"
                                           Text="{Binding FeaturedCharacterTitle}"
                                           Style="{StaticResource AtlasV2.Overlay.Eyebrow}"/>
                                <ContentControl x:Name="FeaturedCharacterCard" Content="{Binding FeaturedCharacter}"
                                                ContentTemplate="{StaticResource AtlasV2.Friends.CharacterItem}"/>
                            </StackPanel>

                            <StackPanel Margin="0,20,0,0"
                                        Visibility="{Binding HasOtherCharacters, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                <TextBlock Margin="0,0,0,7"
                                           Text="AUTRES PERSONNAGES"
                                           Style="{StaticResource AtlasV2.Overlay.Eyebrow}"/>
                                <ItemsControl x:Name="OtherCharactersList" ItemsSource="{Binding OtherCharacters}"
                                              ItemTemplate="{StaticResource AtlasV2.Friends.CharacterItem}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="RemoveFriendConfirmationLayer" Panel.ZIndex="20"
              Visibility="Collapsed" IsHitTestVisible="False"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle"
              KeyboardNavigation.DirectionalNavigation="Contained">
            <Border Background="#C9030B13"
                    MouseLeftButtonDown="RemoveFriendConfirmationScrim_MouseLeftButtonDown"/>
            <Border x:Name="RemoveFriendConfirmationPanel" Width="440" Margin="24" Padding="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource AtlasV2.Overlay.Panel}"
                    BorderBrush="{StaticResource AtlasV2.Overlay.Edge}" BorderThickness="1" CornerRadius="14">
                <StackPanel>
                    <Border Width="42" Height="42" Margin="0,0,0,16" HorizontalAlignment="Left"
                            Background="{StaticResource AtlasV2.Overlay.Card}"
                            BorderBrush="{StaticResource AtlasV2.Overlay.CardEdge}" BorderThickness="1" CornerRadius="10">
                        <Path Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="{StaticResource AtlasV2.Icon.Trash}" Style="{StaticResource AtlasV2.Icon.Stroke}"
                              Stroke="{StaticResource AtlasV2.Brush.Danger}"/>
                    </Border>
                    <TextBlock x:Name="RemoveFriendTitleText" Text="Retirer cet ami ?"
                               Style="{StaticResource AtlasV2.Overlay.Title}" FontSize="24" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RemoveFriendUsernameText" Margin="0,10,0,0"
                               Style="{StaticResource AtlasV2.Text.Body}" FontWeight="SemiBold"
                               Foreground="{StaticResource AtlasV2.Brush.Cyan}" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,7,0,0" Text="Cette personne sera retirée de ta liste d’amis."
                               Style="{StaticResource AtlasV2.Text.Body}" TextWrapping="Wrap"
                               Foreground="{StaticResource AtlasV2.Overlay.Muted}"/>
                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CancelRemoveFriendButton" Content="Annuler"
                                Style="{StaticResource AtlasV2.Overlay.Button}" Click="CancelRemoveFriendButton_Click"/>
                        <Button x:Name="ConfirmRemoveFriendButton" Grid.Column="2" Content="Retirer"
                                Style="{StaticResource AtlasV2.Overlay.PrimaryButton}" Click="ConfirmRemoveFriendButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
