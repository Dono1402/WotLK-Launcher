<UserControl x:Class="WotLK.Launcher.UI.V2.Views.AvatarCropOverlayV2"
             x:Name="CropOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WotLK.Launcher.UI.V2.Views"
             Visibility="Collapsed"
             IsHitTestVisible="False"
             Focusable="False"
             KeyboardNavigation.TabNavigation="Cycle"
             KeyboardNavigation.ControlTabNavigation="Cycle">
    <Grid DataContext="{Binding State, RelativeSource={RelativeSource AncestorType={x:Type views:AvatarCropOverlayV2}}}">
        <Border x:Name="OverlayScrim"
                Background="{StaticResource AtlasV2.Brush.AuthScrim}"
                MouseLeftButtonDown="OverlayScrim_MouseLeftButtonDown"/>

        <Border x:Name="DialogPanel"
                Width="960"
                MaxHeight="720"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource AtlasV2.Brush.SurfaceRaised}"
                BorderBrush="{StaticResource AtlasV2.Brush.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Focusable="True"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DialogTranslate" Y="10"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  ShadowDepth="8"
                                  Opacity="0.42"
                                  Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="26,22,20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PHOTO DE PROFIL"
                                   Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                        <TextBlock Margin="0,5,0,0"
                                   Text="Recadrer la photo"
                                   FontSize="25"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        <TextBlock Margin="0,4,0,0"
                                   Text="Photo de profil Atlas"
                                   Style="{StaticResource AtlasV2.Text.Body}"/>
                    </StackPanel>
                    <Button x:Name="CloseCropButton"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Padding="9"
                            VerticalAlignment="Top"
                            Style="{StaticResource AtlasV2.Button.Icon}"
                            ToolTip="Fermer"
                            AutomationProperties.Name="Fermer le recadrage"
                            Click="CloseButton_Click">
                        <Path Data="{StaticResource AtlasV2.Icon.Close}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        BorderBrush="{StaticResource AtlasV2.Brush.BorderSoft}"
                        BorderThickness="0,1,0,1">
                    <ScrollViewer x:Name="DialogScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}"
                                   BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/>
                        </ScrollViewer.Resources>

                        <Grid x:Name="CropWorkspace" Margin="26,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CropColumn" Width="510"/>
                                <ColumnDefinition x:Name="CropGapColumn" Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="CropEditorColumn">
                                <Border Padding="13,10"
                                        Background="{StaticResource AtlasV2.Brush.CyanSurface}"
                                        BorderBrush="{StaticResource AtlasV2.Brush.CyanBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="16" Height="16"
                                              Data="{StaticResource AtlasV2.Icon.Move}"
                                              Stroke="{StaticResource AtlasV2.Brush.Cyan}"
                                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                        <TextBlock Margin="9,0,0,0"
                                                   Text="Position et cadrage"
                                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                                   Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                                    </StackPanel>
                                </Border>

                                <Grid Width="390"
                                      Height="390"
                                      Margin="0,18,0,0"
                                      HorizontalAlignment="Center">
                                    <Ellipse Fill="#070A0E"
                                             Stroke="{StaticResource AtlasV2.Brush.BorderSoft}"
                                             StrokeThickness="1"/>
                                    <Grid x:Name="CropViewport"
                                          Width="360"
                                          Height="360"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Background="#080C10"
                                          Cursor="SizeAll"
                                          ClipToBounds="True"
                                          PreviewMouseWheel="CropViewport_PreviewMouseWheel"
                                          MouseLeftButtonDown="CropViewport_MouseLeftButtonDown"
                                          MouseMove="CropViewport_MouseMove"
                                          MouseLeftButtonUp="CropViewport_MouseLeftButtonUp"
                                          LostMouseCapture="CropViewport_LostMouseCapture">
                                        <Grid.Clip>
                                            <EllipseGeometry Center="180,180" RadiusX="180" RadiusY="180"/>
                                        </Grid.Clip>
                                        <Rectangle IsHitTestVisible="False">
                                            <Rectangle.Fill>
                                                <ImageBrush x:Name="CropEditorBrush"
                                                            ImageSource="{Binding Current.AvatarImage}"
                                                            ViewboxUnits="Absolute"
                                                            Stretch="Fill"/>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                    <Ellipse Width="360"
                                             Height="360"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             IsHitTestVisible="False"
                                             Stroke="{StaticResource AtlasV2.Brush.Gold}"
                                             StrokeThickness="2"/>
                                    <Ellipse Width="238"
                                             Height="238"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             IsHitTestVisible="False"
                                             Stroke="#557F8B99"
                                             StrokeThickness="1"
                                             StrokeDashArray="4,4"/>
                                </Grid>

                            </StackPanel>

                            <StackPanel x:Name="PreviewColumn" Grid.Column="2">
                                <TextBlock Text="Aperçus"
                                           Style="{StaticResource AtlasV2.Text.SectionTitle}"/>
                                <Border Height="1"
                                        Margin="0,9,0,18"
                                        Background="{StaticResource AtlasV2.Brush.BorderSoft}"/>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <StackPanel Margin="0,0,22,0">
                                        <Ellipse Width="128" Height="128"
                                                 Stroke="{StaticResource AtlasV2.Brush.GoldBorder}"
                                                 StrokeThickness="1">
                                            <Ellipse.Fill>
                                                 <ImageBrush x:Name="Preview128Brush"
                                                            ImageSource="{Binding Current.AvatarImage}"
                                                            ViewboxUnits="Absolute"
                                                            Stretch="Fill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"
                                                   Text="128 px"
                                                   Style="{StaticResource AtlasV2.Text.Caption}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,20,0">
                                        <Ellipse Width="64" Height="64"
                                                 Stroke="{StaticResource AtlasV2.Brush.Border}"
                                                 StrokeThickness="1">
                                            <Ellipse.Fill>
                                                 <ImageBrush x:Name="Preview64Brush"
                                                            ImageSource="{Binding Current.AvatarImage}"
                                                            ViewboxUnits="Absolute"
                                                            Stretch="Fill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"
                                                   Text="64 px"
                                                   Style="{StaticResource AtlasV2.Text.Caption}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <Ellipse Width="32" Height="32"
                                                 Stroke="{StaticResource AtlasV2.Brush.Border}"
                                                 StrokeThickness="1">
                                            <Ellipse.Fill>
                                                 <ImageBrush x:Name="Preview32Brush"
                                                            ImageSource="{Binding Current.AvatarImage}"
                                                            ViewboxUnits="Absolute"
                                                            Stretch="Fill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"
                                                   Text="32 px"
                                                   Style="{StaticResource AtlasV2.Text.Caption}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Margin="0,26,0,0"
                                        Padding="14,13"
                                        Background="{StaticResource AtlasV2.Brush.Surface}"
                                        BorderBrush="{StaticResource AtlasV2.Brush.BorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <StackPanel>
                                        <TextBlock Text="Format préparé"
                                                   Style="{StaticResource AtlasV2.Text.Body}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="Image carrée · affichage circulaire · haute définition"
                                                   Style="{StaticResource AtlasV2.Text.Caption}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="CropErrorBanner"
                                        Margin="0,16,0,0"
                                        Style="{StaticResource AtlasV2.Banner.Error}"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Width="15" Height="15"
                                              Data="{StaticResource AtlasV2.Icon.AlertCircle}"
                                              Stroke="{StaticResource AtlasV2.Brush.Danger}"
                                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="{Binding Current.ErrorMessage}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                                   Foreground="#F1A7AE"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="UploadStatusBanner"
                                        Margin="0,16,0,0"
                                        Padding="14,12"
                                        Background="{StaticResource AtlasV2.Brush.CyanSurface}"
                                        BorderBrush="{StaticResource AtlasV2.Brush.CyanBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Current.StatusMessage}"
                                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                                   Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                                        <ProgressBar x:Name="UploadProgressBar"
                                                     Height="3"
                                                     Margin="0,9,0,0"
                                                     IsIndeterminate="True"
                                                     Style="{StaticResource AtlasV2.Progress.Compact}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="2" Margin="26,17,26,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="Atlas Launcher"
                               Style="{StaticResource AtlasV2.Text.Caption}"/>
                    <Button x:Name="CancelCropButton"
                            Grid.Column="1"
                            MinWidth="112"
                            Margin="12,0,0,0"
                            Content="Annuler"
                            Style="{StaticResource AtlasV2.Button.Secondary}"
                            Click="CloseButton_Click"/>
                    <Button x:Name="SaveCropButton"
                            Grid.Column="2"
                            MinWidth="164"
                            Margin="10,0,0,0"
                            Style="{StaticResource AtlasV2.Button.Primary}"
                            Click="SaveCropButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16" Height="16"
                                  Data="{StaticResource AtlasV2.Icon.Upload}"
                                  Stroke="#111318"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                            <TextBlock x:Name="SaveCropLabel"
                                       Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="Utiliser la photo"
                                       FontWeight="Bold"/>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
