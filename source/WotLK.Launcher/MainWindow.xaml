                                                                    <TextBlock Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" Text="{Binding Username}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="8" Text="{Binding CharacterText}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <Ellipse x:Name="GamePresenceDot" Grid.Column="2" Width="7" Height="7" Fill="#68717B"/>
                                                            </Grid>
                                                        </Border>
