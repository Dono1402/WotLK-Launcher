<UserControl x:Class="WotLK.Launcher.UI.V2.Views.AddonsViewV2"
             x:Name="AddonsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
              xmlns:presentation="clr-namespace:WotLK.Launcher.UI.V2.Presentation"
              xmlns:localization="clr-namespace:WotLK.Launcher.UI.V2.Localization"
              xmlns:views="clr-namespace:WotLK.Launcher.UI.V2.Views"
              Background="Transparent"
              Focusable="False" PreviewKeyDown="AddonsRoot_PreviewKeyDown">
    <UserControl.Resources>
        <Geometry x:Key="AtlasV2.Addons.Star">M12,2 L15,8.5 L22,9.3 L17,14.2 L18.3,21 L12,17.7 L5.7,21 L7,14.2 L2,9.3 L9,8.5 Z</Geometry>
        <DataTemplate x:Key="AtlasV2.Addons.ChoiceTemplate">
            <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="AtlasV2.Addons.PackTemplate">
            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="AtlasV2.Addons.ProfileTemplate">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" localization:LauncherLocalizationOptions.IsUserText="True"/>
        </DataTemplate>
        <Style x:Key="AtlasV2.Addons.LibraryButton" TargetType="Button" BasedOn="{StaticResource AtlasV2.Button.GhostCompact}">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="IsTabStop" Value="True"/>
            <Setter Property="ToolTipService.IsEnabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
        </Style>
        <Style x:Key="AtlasV2.Addons.PrimaryCompact" TargetType="Button" BasedOn="{StaticResource AtlasV2.Button.Primary}">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="IsTabStop" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
        </Style>
        <Style x:Key="AtlasV2.Addons.IconButton" TargetType="Button" BasedOn="{StaticResource AtlasV2.Button.Icon}">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="6"/>
            <Setter Property="IsTabStop" Value="True"/><Setter Property="ToolTipService.IsEnabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
        </Style>
        <Style x:Key="AtlasV2.Addons.SelectionCheck" TargetType="CheckBox">
            <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource AtlasV2.Brush.GlassHighlight}"
                                Background="{StaticResource AtlasV2.Brush.Field}">
                            <Path x:Name="Tick" Margin="3" Visibility="Collapsed" Data="{StaticResource AtlasV2.Icon.Check}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}" Stroke="{StaticResource AtlasV2.Brush.Cyan}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Gold}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Cyan}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AtlasV2.Addons.MenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemSurface" Padding="12,9" Background="Transparent" CornerRadius="5">
                        <ContentPresenter ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource AtlasV2.Brush.GlassRaised}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="AtlasV2.Addons.ListItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="RowSurface"
                                 Padding="16,6"
                                Background="{StaticResource AtlasV2.Brush.GlassSurface}"
                                BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{StaticResource AtlasV2.Brush.GlassRaised}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowSurface" Property="Background" Value="{StaticResource AtlasV2.Brush.GlassRaised}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AtlasV2.Addons.StateChip" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#192129"/>
            <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.Installed}">
                    <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SuccessSurface}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.SuccessBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.UpdateAvailable}">
                    <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.GoldSurface}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GoldBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.Installing}">
                    <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.CyanSurface}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.CyanBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.Updating}">
                    <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.CyanSurface}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.CyanBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.Removing}">
                    <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.CyanSurface}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.CyanBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.Repairing}">
                    <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.CyanSurface}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.CyanBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.Error}">
                    <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.DangerSurface}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.DangerBorder}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AtlasV2.Addons.StateText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.Caption}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.Installed}">
                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.UpdateAvailable}">
                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.Installing}">
                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.Updating}">
                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.Removing}">
                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.Repairing}">
                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.Error}">
                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AtlasV2.Addons.Action" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.GhostCompact}">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="IsTabStop" Value="True"/><Setter Property="ToolTipService.IsEnabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.CyanBorder}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.UpdateAvailable}">
                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GoldBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.Error}">
                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Danger}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.DangerBorder}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AtlasV2.Addons.Filter" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Segment}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#BB082C47"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GlassBorder}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <DataTrigger Binding="{Binding LayoutMode, ElementName=AddonsRoot}" Value="{x:Static presentation:AdaptiveLayoutMode.Stacked}">
                    <Setter Property="Height" Value="34"/>
                    <Setter Property="Padding" Value="9,0"/>
                    <Setter Property="FontSize" Value="12"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AtlasV2.Addons.CategoryColumn" TargetType="{x:Type ColumnDefinition}">
            <Setter Property="Width" Value="130"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LayoutMode, ElementName=AddonsRoot}" Value="{x:Static presentation:AdaptiveLayoutMode.Compact}">
                    <Setter Property="Width" Value="110"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LayoutMode, ElementName=AddonsRoot}" Value="{x:Static presentation:AdaptiveLayoutMode.Stacked}">
                    <Setter Property="Width" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AtlasV2.Addons.VersionColumn" TargetType="{x:Type ColumnDefinition}">
            <Setter Property="Width" Value="185"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LayoutMode, ElementName=AddonsRoot}" Value="{x:Static presentation:AdaptiveLayoutMode.Compact}">
                    <Setter Property="Width" Value="165"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LayoutMode, ElementName=AddonsRoot}" Value="{x:Static presentation:AdaptiveLayoutMode.Stacked}">
                    <Setter Property="Width" Value="145"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AtlasV2.Addons.CategoryIcon" TargetType="{x:Type Path}" BasedOn="{StaticResource AtlasV2.Icon.Stroke}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Stroke" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
            <Setter Property="Data" Value="{StaticResource AtlasV2.Icon.Package}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Category}" Value="Collections">
                    <Setter Property="Data" Value="M3,7 V21 H21 V7 H12 L10,3 H3 Z M3,8 H21"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Quêtes">
                    <Setter Property="Data" Value="M12,5 C9,2 5,2 2,4 V21 C6,19 9,19 12,22 C15,19 18,19 22,21 V4 C18,2 15,2 12,5 Z M12,5 V22"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Interface">
                    <Setter Property="Data" Value="M2,3 H22 V18 H2 Z M12,18 V22 M7,22 H17"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Économie">
                    <Setter Property="Data" Value="M9,5 A7,3 0 1 0 23,5 A7,3 0 1 0 9,5 M9,5 V10 C9,14 23,14 23,10 V5 M16,13 V17 C16,21 2,21 2,17 V12 M2,12 C2,8 16,8 16,12 C16,16 2,16 2,12 M2,17 V22 C2,26 16,26 16,22 V17 M23,10 V15 C23,18 19,18 16,18"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Inventaire">
                    <Setter Property="Data" Value="M6,9 H18 L21,22 H3 Z M8,10 V5 A4,4 0 0 1 16,5 V10 M6,15 H18 V22 H6 Z M12,14 V17"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Combat">
                    <Setter Property="Data" Value="M3,3 L15,15 M1,1 L6,3 L3,6 Z M13,17 L17,13 M15,15 L21,21 M3,21 L15,9 M1,23 L6,21 L3,18 Z M13,7 L17,11 M15,9 L21,3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid x:Name="ContentFrame"
              MaxWidth="1520"
              Margin="84,6,82,20"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="2" Margin="0,0,20,0" SnapsToDevicePixels="True" Background="{StaticResource AtlasV2.Brush.Cyan}"/>
                        <TextBlock Text="BIBLIOTHÈQUE ATLAS"
                               Style="{StaticResource AtlasV2.Text.Eyebrow}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                    </StackPanel>
                    <TextBlock x:Name="PageTitle"
                               Margin="0,0,0,0"
                               Text="ADDONS"
                               Style="{StaticResource AtlasV2.Text.Hero}"
                                FontSize="48"
                               Foreground="{StaticResource AtlasV2.Brush.TitleIce}"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Right"
                               Text="WOTLK CLASSIC"
                               Style="{StaticResource AtlasV2.Text.Caption}"
                                FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AtlasV2.Brush.TextMuted}"/>
                    <TextBlock Margin="0,3,0,0"
                               HorizontalAlignment="Right"
                               Text="Interface 30403"
                               Style="{StaticResource AtlasV2.Text.Caption}"
                                FontSize="12"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1">
                <Border x:Name="GameRunningBanner"
                        Margin="0,0,0,12"
                        Style="{StaticResource AtlasV2.Banner.Warning}"
                        Visibility="{Binding State.Current.IsGameRunning, ElementName=AddonsRoot, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Width="17"
                              Height="17"
                              Margin="0,0,11,0"
                              Data="{StaticResource AtlasV2.Icon.Info}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"
                              Stroke="{StaticResource AtlasV2.Brush.Gold}"/>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Le jeu est ouvert. Les changements restent disponibles et seront pris en compte après /reload."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                    </Grid>
                </Border>

                <Border x:Name="CatalogErrorBanner"
                        Margin="0,0,0,12"
                        Style="{StaticResource AtlasV2.Banner.Error}"
                        Visibility="{Binding State.Current.ShowsCatalogError, ElementName=AddonsRoot, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Width="17"
                              Height="17"
                              Margin="0,0,11,0"
                              Data="{StaticResource AtlasV2.Icon.AlertCircle}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"
                              Stroke="{StaticResource AtlasV2.Brush.Danger}"/>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{Binding State.Current.CatalogErrorMessage, ElementName=AddonsRoot}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                    </Grid>
                </Border>

                <Border x:Name="OperationNotice"
                        Margin="0,0,0,12"
                        Padding="13,10"
                        Background="{StaticResource AtlasV2.Brush.CyanSurface}"
                        BorderBrush="{StaticResource AtlasV2.Brush.CyanBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding State.Current.ShowsNotification, ElementName=AddonsRoot, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                    <TextBlock Text="{Binding State.Current.NotificationMessage, ElementName=AddonsRoot}"
                               Style="{StaticResource AtlasV2.Text.Caption}"
                               Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Padding="1"
                        Background="{StaticResource AtlasV2.Brush.GlassSurface}"
                        BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AllFilterButton"
                                Style="{StaticResource AtlasV2.Addons.Filter}"
                                Tag="Active"
                                Content="{Binding State.Current.AllFilterLabel, ElementName=AddonsRoot}"
                                IsEnabled="{Binding State.Current.IsInteractive, ElementName=AddonsRoot}"
                                Click="AllFilterButton_Click"/>
                        <Button x:Name="InstalledFilterButton"
                                Style="{StaticResource AtlasV2.Addons.Filter}"
                                Content="{Binding State.Current.InstalledFilterLabel, ElementName=AddonsRoot}"
                                IsEnabled="{Binding State.Current.IsInteractive, ElementName=AddonsRoot}"
                                Click="InstalledFilterButton_Click"/>
                        <Button x:Name="UpdatesFilterButton"
                                Style="{StaticResource AtlasV2.Addons.Filter}"
                                Content="{Binding State.Current.UpdatesFilterLabel, ElementName=AddonsRoot}"
                                IsEnabled="{Binding State.Current.IsInteractive, ElementName=AddonsRoot}"
                                Click="UpdatesFilterButton_Click"/>
                        <Button x:Name="FavoritesFilterButton" Style="{StaticResource AtlasV2.Addons.Filter}"
                                Content="{Binding State.Current.FavoritesFilterLabel, ElementName=AddonsRoot}"
                                IsEnabled="{Binding State.Current.IsInteractive, ElementName=AddonsRoot}" Click="FavoritesFilterButton_Click"/>
                        <Button x:Name="ManualFilterButton" Style="{StaticResource AtlasV2.Addons.Filter}"
                                Content="{Binding State.Current.ManualFilterLabel, ElementName=AddonsRoot}"
                                IsEnabled="{Binding State.Current.IsInteractive, ElementName=AddonsRoot}" Click="ManualFilterButton_Click"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SearchField"
                        Grid.Column="1"
                        Height="38"
                        Margin="12,0,0,0"
                        Background="{StaticResource AtlasV2.Brush.GlassSurface}"
                        BorderBrush="{StaticResource AtlasV2.Brush.GlassHighlight}"
                        CornerRadius="10"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AtlasV2.Field.Container}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Width="15"
                              Height="15"
                              VerticalAlignment="Center"
                              Data="{StaticResource AtlasV2.Icon.Search}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        <TextBox x:Name="SearchInput"
                                 Grid.Column="1"
                                 Margin="8,0,6,0"
                                 Text="{Binding State.Current.SearchText, ElementName=AddonsRoot, Mode=OneWay}"
                                 Style="{StaticResource AtlasV2.TextBox.Field}"
                                 FontSize="12" AutomationProperties.Name="Rechercher un addon"
                                 ToolTip="Rechercher un addon (Ctrl+F)"
                                 IsEnabled="{Binding State.Current.IsInteractive, ElementName=AddonsRoot}"
                                 TextChanged="SearchInput_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Grid.Column="1"
                                   Margin="8,0,6,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="Rechercher un addon"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   FontSize="12"/>
                        <Button x:Name="ClearSearchButton" Grid.Column="2" Style="{StaticResource AtlasV2.Addons.IconButton}"
                                Visibility="{Binding State.HasSearch, ElementName=AddonsRoot, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                AutomationProperties.Name="Effacer la recherche" ToolTip="Effacer la recherche" Click="ClearSearchButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.Close}" Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                    </Grid>
                </Border>

                <Button x:Name="UpdateAllButton"
                        Grid.Column="2"
                        Margin="12,0,0,0" MinWidth="136"
                        Style="{StaticResource AtlasV2.Addons.PrimaryCompact}"
                        IsEnabled="{Binding State.Current.CanUpdateAll, ElementName=AddonsRoot}"
                        Click="UpdateAllButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="15"
                              Height="15"
                              Margin="0,0,8,0"
                              Data="{StaticResource AtlasV2.Icon.Download}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"
                              Stroke="#111318"/>
                        <TextBlock Text="{Binding State.Current.UpdateAllLabel, ElementName=AddonsRoot}"/>
                    </StackPanel>
                </Button>

                <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="CategorySelector" Width="174" Height="32" FontSize="12"
                              TextSearch.TextPath="DisplayLabel"
                              Style="{StaticResource AtlasV2.ComboBox.Field}" ItemTemplate="{StaticResource AtlasV2.Addons.ChoiceTemplate}" SelectedValuePath="Key"
                              AutomationProperties.Name="Filtrer par catégorie" SelectionChanged="CategorySelector_SelectionChanged"/>
                    <ComboBox x:Name="SortSelector" Grid.Column="1" Width="190" Height="32" Margin="8,0,0,0" FontSize="12"
                              TextSearch.TextPath="DisplayLabel"
                              Style="{StaticResource AtlasV2.ComboBox.Field}" ItemTemplate="{StaticResource AtlasV2.Addons.ChoiceTemplate}" SelectedValuePath="Key"
                              AutomationProperties.Name="Trier les addons" SelectionChanged="SortSelector_SelectionChanged"/>
                    <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"
                               Text="{Binding State.Current.ResultsLabel, ElementName=AddonsRoot}" Style="{StaticResource AtlasV2.Text.Caption}"/>
                    <Button x:Name="LibraryToggleButton" Grid.Column="3" Content="Packs et profils" Style="{StaticResource AtlasV2.Addons.LibraryButton}"
                            IsEnabled="{Binding State.Current.IsInteractive, ElementName=AddonsRoot}" Click="LibraryToggleButton_Click"/>
                </Grid>
            </Grid>

            <Border x:Name="LibraryPanel" Grid.Row="3" Margin="0,0,0,12" Padding="14,10"
                    Background="{StaticResource AtlasV2.Brush.GlassSurface}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}"
                    BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding State.IsLibraryOpen, ElementName=AddonsRoot, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Composer une sélection" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        <TextBlock Text="{Binding State.SelectionSummary, ElementName=AddonsRoot}" FontSize="12" HorizontalAlignment="Right"
                                   Style="{StaticResource AtlasV2.Text.Caption}"/>
                    </DockPanel>
                    <WrapPanel Margin="0,0,-8,0">
                        <ComboBox x:Name="PackSelector" Width="142" Height="32" Margin="0,0,8,6" FontSize="12"
                                  TextSearch.TextPath="DisplayName"
                                  Style="{StaticResource AtlasV2.ComboBox.Field}" ItemTemplate="{StaticResource AtlasV2.Addons.PackTemplate}" SelectedValuePath="Id"
                                  AutomationProperties.Name="Choisir un pack" SelectionChanged="PackSelector_SelectionChanged"/>
                        <Button x:Name="LoadPackButton" Content="Charger le pack" Margin="0,0,14,6" Style="{StaticResource AtlasV2.Addons.LibraryButton}" Click="LoadPackButton_Click"/>
                        <ComboBox x:Name="ProfileSelector" Width="180" Height="32" Margin="0,0,8,6" FontSize="12"
                                  TextSearch.TextPath="Name"
                                  Style="{StaticResource AtlasV2.ComboBox.Field}" ItemTemplate="{StaticResource AtlasV2.Addons.ProfileTemplate}" SelectedValuePath="Name"
                                  AutomationProperties.Name="Choisir un profil personnel" IsEnabled="{Binding State.HasProfiles, ElementName=AddonsRoot}"
                                  SelectionChanged="ProfileSelector_SelectionChanged"/>
                        <Button x:Name="LoadProfileButton" Content="Charger le profil" Margin="0,0,8,6" Style="{StaticResource AtlasV2.Addons.LibraryButton}"
                                IsEnabled="{Binding State.HasSelectedProfile, ElementName=AddonsRoot}" Click="LoadProfileButton_Click"/>
                        <Button x:Name="RemoveProfileButton" Content="Supprimer le profil" Margin="0,0,14,6" Style="{StaticResource AtlasV2.Addons.LibraryButton}"
                                IsEnabled="{Binding State.HasSelectedProfile, ElementName=AddonsRoot}" Click="RemoveProfileButton_Click"/>
                        <Button Content="Importer" Margin="0,0,8,6" Style="{StaticResource AtlasV2.Addons.LibraryButton}"
                                Command="{Binding State.ImportProfileCommand, ElementName=AddonsRoot}"/>
                        <Button Content="Exporter" Margin="0,0,0,6" Style="{StaticResource AtlasV2.Addons.LibraryButton}"
                                Command="{Binding State.ExportProfileCommand, ElementName=AddonsRoot}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,-8,0">
                        <Border Width="212" Height="32" Margin="0,0,8,6" Padding="10,0" Background="{StaticResource AtlasV2.Brush.Field}"
                                BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <TextBox x:Name="ProfileNameInput" MaxLength="60" FontSize="12" Style="{StaticResource AtlasV2.TextBox.Field}"
                                         Text="{Binding State.ProfileName, ElementName=AddonsRoot, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Nom du profil de sélection"/>
                                <TextBlock Text="Nom du profil" IsHitTestVisible="False" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource AtlasV2.Brush.TextMuted}">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ProfileNameInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Button x:Name="SaveProfileButton" Content="Enregistrer" Margin="0,0,14,6" Style="{StaticResource AtlasV2.Addons.LibraryButton}"
                                IsEnabled="{Binding State.CanSaveProfile, ElementName=AddonsRoot}" Click="SaveProfileButton_Click"/>
                        <Button Content="Cocher les résultats" Margin="0,0,8,6" Style="{StaticResource AtlasV2.Addons.LibraryButton}" Click="SelectVisibleButton_Click"/>
                        <Button Content="Vider" Margin="0,0,14,6" Style="{StaticResource AtlasV2.Addons.LibraryButton}"
                                IsEnabled="{Binding State.HasSelection, ElementName=AddonsRoot}" Click="ClearSelectionButton_Click"/>
                        <Button x:Name="InstallSelectionButton" Content="Installer la sélection" Height="32" Margin="0,0,0,6"
                                Style="{StaticResource AtlasV2.Addons.PrimaryCompact}"
                                Command="{Binding State.InstallSelectionCommand, ElementName=AddonsRoot}"
                                CommandParameter="{Binding State.SelectedAddonIds, ElementName=AddonsRoot}"/>
                    </WrapPanel>
                    <TextBlock Text="Charge un pack ou un profil, puis coche les addons à installer dans la liste."
                               FontSize="12" TextWrapping="Wrap" Style="{StaticResource AtlasV2.Text.Caption}"/>
                </StackPanel>
            </Border>

            <Border x:Name="BatchProgressPanel" Grid.Row="4" Margin="0,0,0,10" Padding="12,8" CornerRadius="6"
                    Background="{StaticResource AtlasV2.Brush.CyanSurface}" BorderBrush="{StaticResource AtlasV2.Brush.CyanBorder}" BorderThickness="1"
                    Visibility="{Binding State.Current.ShowsBatchProgress, ElementName=AddonsRoot, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                <DockPanel>
                    <Button x:Name="RetryFailedButton" DockPanel.Dock="Right" Content="Reprendre" Height="28" Margin="12,0,0,0"
                            Style="{StaticResource AtlasV2.Addons.LibraryButton}" Command="{Binding State.RetryFailedCommand, ElementName=AddonsRoot}"
                            Visibility="{Binding State.Current.CanRetryFailed, ElementName=AddonsRoot, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                    <TextBlock Text="{Binding State.Current.BatchProgressLabel, ElementName=AddonsRoot}" VerticalAlignment="Center"
                               FontSize="12" Style="{StaticResource AtlasV2.Text.Caption}"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="16,0,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Style="{StaticResource AtlasV2.Addons.CategoryColumn}"/>
                        <ColumnDefinition Style="{StaticResource AtlasV2.Addons.VersionColumn}"/>
                        <ColumnDefinition Width="118"/>
                        <ColumnDefinition Width="116"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="ADDON" Style="{StaticResource AtlasV2.Text.Caption}" FontSize="12" FontWeight="Medium"/>
                    <TextBlock Grid.Column="3" Text="VERSION ET ÉTAT" Style="{StaticResource AtlasV2.Text.Caption}" FontSize="12" FontWeight="Medium"/>
                    <TextBlock Grid.Column="4" Grid.ColumnSpan="2" HorizontalAlignment="Right" Text="ACTION" Style="{StaticResource AtlasV2.Text.Caption}" FontSize="12" FontWeight="Medium"/>
                </Grid>

                <Grid Grid.Row="1">
                    <ListBox x:Name="AddonList" IsTabStop="True" AutomationProperties.Name="Catalogue des addons"
                             ItemsSource="{Binding State.Current.VisibleAddons, ElementName=AddonsRoot}"
                             ItemContainerStyle="{StaticResource AtlasV2.Addons.ListItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectionChanged="AddonList_SelectionChanged" MouseLeftButtonUp="AddonList_MouseLeftButtonUp">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/>
                        </ListBox.Resources>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type presentation:AddonUiItem}">
                                <Grid MinHeight="54">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*" MinWidth="160"/>
                                        <ColumnDefinition Style="{StaticResource AtlasV2.Addons.CategoryColumn}"/>
                                        <ColumnDefinition Style="{StaticResource AtlasV2.Addons.VersionColumn}"/>
                                        <ColumnDefinition Width="118"/>
                                        <ColumnDefinition Width="116"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="AddonSelectionCheck" Style="{StaticResource AtlasV2.Addons.SelectionCheck}" Margin="0,0,6,0"
                                              IsChecked="{Binding IsSelectedForBatch, Mode=OneWay}" IsEnabled="{Binding CanSelectForBatch}"
                                              AutomationProperties.Name="{Binding SelectionLabel}" Click="AddonSelectionCheck_Click"
                                              Visibility="{Binding State.IsLibraryOpen, RelativeSource={RelativeSource AncestorType={x:Type views:AddonsViewV2}}, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                                    <Grid Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border Background="#AA061019" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="6"/>
                                        <Image Margin="4"
                                               Source="{Binding IconPath}"
                                               Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="{x:Type Image}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasOfficialIcon}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Path Width="23"
                                              Height="23"
                                              Data="{StaticResource AtlasV2.Icon.Package}">
                                            <Path.Style>
                                                <Style TargetType="{x:Type Path}" BasedOn="{StaticResource AtlasV2.Icon.Stroke}">
                                                    <Setter Property="Stroke" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasOfficialIcon}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <DockPanel>
                                            <Button x:Name="FavoriteAddonButton" DockPanel.Dock="Right" Width="24" Height="22" Padding="4"
                                                    Style="{StaticResource AtlasV2.Addons.IconButton}" IsEnabled="{Binding IsCatalogEntry}"
                                                    ToolTip="{Binding FavoriteLabel}" AutomationProperties.Name="{Binding FavoriteLabel}" Click="FavoriteAddonButton_Click">
                                                <Path Data="{StaticResource AtlasV2.Addons.Star}">
                                                    <Path.Style><Style TargetType="Path" BasedOn="{StaticResource AtlasV2.Icon.Stroke}">
                                                        <Setter Property="Stroke" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                                        <Setter Property="Fill" Value="Transparent"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                                                            <Setter Property="Fill" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                                                        </DataTrigger></Style.Triggers>
                                                    </Style></Path.Style>
                                                </Path>
                                            </Button>
                                            <TextBlock x:Name="AddonNameText" Text="{Binding Name}"
                                                       ToolTip="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Style="{StaticResource AtlasV2.Text.Body}"
                                                       FontSize="15" VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                        </DockPanel>
                                        <TextBlock x:Name="AddonDescriptionText" Margin="0,2,0,0"
                                                   Text="{Binding Description}"
                                                   TextWrapping="NoWrap"
                                                   ToolTip="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12"
                                                   FontWeight="Normal">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.Caption}">
                                                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" ToolTip="{Binding CompatibilityHint}">
                                            <TextBlock Text="{Binding CompatibilitySummary}" FontSize="12">
                                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AtlasV2.Text.Caption}">
                                                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAtlasValidated}" Value="True"><Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Success}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInterfaceCompatible}" Value="False"><Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Danger}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text=" · Limite connue" FontSize="12" Foreground="{StaticResource AtlasV2.Brush.Gold}"
                                                       Visibility="{Binding HasKnownLimitations, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                                        </StackPanel>
                                        <Grid Margin="0,7,0,0"
                                              Visibility="{Binding ShowsProgress, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Height="5"
                                                         VerticalAlignment="Center"
                                                         Value="{Binding ProgressPercent, TargetNullValue=0}"
                                                         IsIndeterminate="{Binding IsIndeterminate}"
                                                         Style="{StaticResource AtlasV2.Progress.Compact}"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="10,0,0,0"
                                                       Text="{Binding ProgressPercent, StringFormat={}{0:0} %}"
                                                       Style="{StaticResource AtlasV2.Text.Caption}"
                                                       FontSize="10"
                                                       Visibility="{Binding ShowsProgressPercent, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                                        </Grid>
                                        <TextBlock Margin="0,3,0,0"
                                                   MaxWidth="310"
                                                   HorizontalAlignment="Left"
                                                   Text="{Binding ProgressDetail}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource AtlasV2.Brush.TextMuted}"
                                                   Visibility="{Binding ShowsProgressDetail, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding ErrorMessage}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                                   Foreground="{StaticResource AtlasV2.Brush.Danger}"
                                                   Visibility="{Binding ShowsError, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Margin="0,8,8,8" Padding="6,0,0,0" ClipToBounds="True" ToolTip="{Binding Category}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Width="14" Height="14" Style="{StaticResource AtlasV2.Addons.CategoryIcon}" Stroke="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center"
                                                       Text="{Binding Category}" TextWrapping="NoWrap"
                                                       Style="{StaticResource AtlasV2.Text.Caption}"
                                                       FontSize="12" FontWeight="Normal"
                                                       Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="3" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CompactVersionSummary}"
                                                   ToolTip="{Binding VersionSummary}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                                   FontSize="12"
                                                   FontWeight="Normal"
                                                   Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                                        <TextBlock Margin="0,4,0,0" Text="{Binding StatusLabel}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource AtlasV2.Addons.StateText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VisualState}" Value="{x:Static presentation:AddonVisualState.Installed}">
                                                            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Content="{Binding ActionLabel}"
                                            Style="{StaticResource AtlasV2.Addons.Action}"
                                            Visibility="{Binding ShowsRowAction, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                            IsEnabled="{Binding CanInvokePrimary}"
                                            Click="AddonPrimaryButton_Click"/>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="AddonDetailsButton" Content="Détails" Padding="9,0" Margin="0,0,5,0"
                                                Style="{StaticResource AtlasV2.Addons.LibraryButton}"
                                                ToolTip="{Binding DetailActionLabel}" AutomationProperties.Name="{Binding DetailActionLabel}"
                                                Click="AddonDetailsButton_Click"/>
                                        <Button x:Name="AddonMoreActionsButton" Style="{StaticResource AtlasV2.Addons.IconButton}"
                                                ToolTip="Actions de maintenance" AutomationProperties.Name="Actions de maintenance de cet addon"
                                                IsEnabled="{Binding IsCatalogEntry}" Click="AddonMoreActionsButton_Click">
                                            <Path Data="{StaticResource AtlasV2.Icon.MoreHorizontal}" Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                            <Button.ContextMenu>
                                                <ContextMenu Background="{StaticResource AtlasV2.Brush.SurfaceRaised}" BorderBrush="{StaticResource AtlasV2.Brush.GlassHighlight}"
                                                             BorderThickness="1" Padding="4" ItemContainerStyle="{StaticResource AtlasV2.Addons.MenuItem}"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Vérifier les fichiers" IsEnabled="{Binding CanVerify}" Click="VerifyAddonMenuItem_Click"/>
                                                    <MenuItem Header="Réinstaller" IsEnabled="{Binding CanReinstall}" Click="ReinstallAddonMenuItem_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid x:Name="EmptyState"
                          Background="{StaticResource AtlasV2.Brush.GlassSurface}"
                          Visibility="{Binding State.Current.ShowsEmpty, ElementName=AddonsRoot, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                        <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="58" Height="58" HorizontalAlignment="Center" Background="{StaticResource AtlasV2.Brush.SurfaceRaised}" BorderBrush="{StaticResource AtlasV2.Brush.Border}" BorderThickness="1" CornerRadius="7">
                                <Path Width="25" Height="25" Data="{StaticResource AtlasV2.Icon.Package}" Style="{StaticResource AtlasV2.Icon.Stroke}" Stroke="{StaticResource AtlasV2.Brush.TextMuted}"/>
                            </Border>
                            <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Text="{Binding State.Current.EmptyTitle, ElementName=AddonsRoot}" Style="{StaticResource AtlasV2.Text.SectionTitle}"/>
                            <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding State.Current.EmptyDescription, ElementName=AddonsRoot}" Style="{StaticResource AtlasV2.Text.Caption}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="DetailLayer"
              Panel.ZIndex="40"
              Visibility="{Binding State.Current.IsDetailOpen, ElementName=AddonsRoot, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
            <Border Background="#8A05080B" MouseLeftButtonDown="DetailBackdrop_MouseLeftButtonDown"/>
            <Border x:Name="DetailPanel"
                    Width="390"
                    HorizontalAlignment="Right"
                    Background="#F70B1B29"
                    BorderBrush="{StaticResource AtlasV2.Brush.GlassHighlight}"
                    BorderThickness="1,0,0,0"
                    MouseLeftButtonDown="DetailPanel_MouseLeftButtonDown">
                <Grid Margin="24,22,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="54" Height="54">
                            <Border Background="{StaticResource AtlasV2.Brush.Field}" BorderBrush="{StaticResource AtlasV2.Brush.Border}" BorderThickness="1" CornerRadius="7"/>
                            <Image Margin="5" Source="{Binding State.Current.SelectedAddon.IconPath, ElementName=AddonsRoot}" Stretch="Uniform"/>
                            <Path Width="25" Height="25" Data="{StaticResource AtlasV2.Icon.Package}">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}" BasedOn="{StaticResource AtlasV2.Icon.Stroke}">
                                        <Setter Property="Stroke" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State.Current.SelectedAddon.HasOfficialIcon, ElementName=AddonsRoot}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="0,2,8,0">
                            <TextBlock Text="{Binding State.Current.SelectedAddon.Name, ElementName=AddonsRoot}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                       FontSize="19"/>
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding State.Current.SelectedAddon.Category, ElementName=AddonsRoot}"
                                       Style="{StaticResource AtlasV2.Text.Caption}"
                                       Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                        </StackPanel>
                        <Button x:Name="CloseDetailButton"
                                Grid.Column="2"
                                Style="{StaticResource AtlasV2.Button.Icon}"
                                ToolTip="Fermer"
                                Click="CloseDetailButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.Close}" Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,24,0,18"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border HorizontalAlignment="Left"
                                    DataContext="{Binding State.Current.SelectedAddon, ElementName=AddonsRoot}"
                                    Style="{StaticResource AtlasV2.Addons.StateChip}">
                                <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource AtlasV2.Addons.StateText}"/>
                            </Border>
                            <TextBlock Margin="0,18,0,0"
                                       Text="{Binding State.Current.SelectedAddon.Description, ElementName=AddonsRoot}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource AtlasV2.Text.Body}"
                                       Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>

                            <Border Height="1" Margin="0,22,0,20" Background="{StaticResource AtlasV2.Brush.BorderSoft}"/>
                            <TextBlock Text="VERSION" Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                            <TextBlock Margin="0,7,0,0" Text="{Binding State.Current.SelectedAddon.AvailableVersionText, ElementName=AddonsRoot}" Style="{StaticResource AtlasV2.Text.Body}"/>
                            <TextBlock Margin="0,5,0,0" Text="{Binding State.Current.SelectedAddon.InstalledVersionText, ElementName=AddonsRoot}" Style="{StaticResource AtlasV2.Text.Caption}"/>

                            <TextBlock Margin="0,22,0,0" Text="COMPATIBILITÉ" Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                            <TextBlock Margin="0,7,0,0" Text="{Binding State.Current.SelectedAddon.CompatibilityText, ElementName=AddonsRoot}" Style="{StaticResource AtlasV2.Text.Body}"/>

                            <TextBlock Margin="0,22,0,0" Text="FICHIERS GÉRÉS" Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                            <TextBlock Margin="0,7,0,0" Text="{Binding State.Current.SelectedAddon.ManagedFoldersText, ElementName=AddonsRoot}" TextWrapping="Wrap" Style="{StaticResource AtlasV2.Text.Body}"/>
                            <TextBlock Margin="0,6,0,0" Text="{Binding State.Current.SelectedAddon.DependenciesText, ElementName=AddonsRoot}" TextWrapping="Wrap" Style="{StaticResource AtlasV2.Text.Caption}"/>

                            <Border Margin="0,22,0,0" Padding="12,10" Background="{StaticResource AtlasV2.Brush.CyanSurface}" BorderBrush="{StaticResource AtlasV2.Brush.CyanBorder}" BorderThickness="1" CornerRadius="6" Visibility="{Binding State.Current.IsGameRunning, ElementName=AddonsRoot, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                <TextBlock Text="Le jeu est ouvert : utilise /reload après le changement." TextWrapping="Wrap" Style="{StaticResource AtlasV2.Text.Caption}" Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RemoveSelectedAddonButton"
                                Height="44"
                                Padding="13,0"
                                Style="{StaticResource AtlasV2.Button.GhostCompact}"
                                Foreground="{StaticResource AtlasV2.Brush.Danger}"
                                BorderBrush="{StaticResource AtlasV2.Brush.DangerBorder}"
                                Content="Supprimer"
                                IsEnabled="{Binding State.Current.SelectedAddon.CanRemove, ElementName=AddonsRoot}"
                                Click="RemoveSelectedAddonButton_Click"/>
                        <Button x:Name="DetailPrimaryButton"
                                Grid.Column="1"
                                Height="44"
                                MinWidth="132"
                                Margin="12,0,0,0"
                                Padding="16,0"
                                Style="{StaticResource AtlasV2.Button.Primary}"
                                Content="{Binding State.Current.SelectedAddon.ActionLabel, ElementName=AddonsRoot}"
                                IsEnabled="{Binding State.Current.SelectedAddon.CanInvokePrimary, ElementName=AddonsRoot}"
                                Visibility="{Binding State.Current.SelectedAddon.ShowsAction, ElementName=AddonsRoot, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                Click="DetailPrimaryButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="DeleteConfirmationLayer"
              Panel.ZIndex="70"
              Background="{StaticResource AtlasV2.Brush.Scrim}"
              Visibility="{Binding State.Current.IsDeleteConfirmationOpen, ElementName=AddonsRoot, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
            <Border x:Name="DeleteConfirmationPanel"
                    KeyboardNavigation.TabNavigation="Cycle"
                    Width="430"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F70B1B29"
                    BorderBrush="{StaticResource AtlasV2.Brush.GlassHighlight}"
                    Style="{StaticResource AtlasV2.Card}">
                <StackPanel>
                    <TextBlock x:Name="DeleteConfirmationTitle"
                               Text="Supprimer Questie ?"
                               Style="{StaticResource AtlasV2.Text.SectionTitle}"
                               FontSize="19"/>
                    <TextBlock Margin="0,9,0,0"
                               Text="Seuls les fichiers gérés par Atlas seront supprimés."
                               TextWrapping="Wrap"
                               Style="{StaticResource AtlasV2.Text.Body}"
                               Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                    <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="CancelDeleteButton"
                                Content="Annuler"
                                Style="{StaticResource AtlasV2.Button.Secondary}"
                                Click="CancelDeleteButton_Click"/>
                        <Button x:Name="ConfirmDeleteButton"
                                MinWidth="132"
                                Margin="10,0,0,0"
                                Content="Supprimer"
                                Style="{StaticResource AtlasV2.Button.Primary}"
                                Background="{StaticResource AtlasV2.Brush.Danger}"
                                BorderBrush="{StaticResource AtlasV2.Brush.Danger}"
                                Click="ConfirmDeleteButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
