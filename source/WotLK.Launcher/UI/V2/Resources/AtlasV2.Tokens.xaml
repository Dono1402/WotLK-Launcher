<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="AtlasV2.Font.Manrope">pack://application:,,,/WotLK.Launcher;component/Assets/Fonts/#Manrope</FontFamily>

    <SolidColorBrush x:Key="AtlasV2.Brush.Window" Color="#090C10"/>
    <LinearGradientBrush x:Key="AtlasV2.Brush.WindowAmbient"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF0A0E13"/>
        <GradientStop Offset="0.58" Color="#FF0C1219"/>
        <GradientStop Offset="1" Color="#FF090C10"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AtlasV2.Brush.TopBar" Color="#0D1116"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Surface" Color="#12171D"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.SurfaceRaised" Color="#181E25"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.SurfaceHover" Color="#232B34"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.SurfacePressed" Color="#2B3540"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Border" Color="#303A45"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.BorderSoft" Color="#222B34"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Text" Color="#F7F5EF"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.TextSecondary" Color="#B6C0CC"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.TextMuted" Color="#7F8B99"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Gold" Color="#DEB75A"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.GoldHover" Color="#F0C96D"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.GoldPressed" Color="#C89B3F"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Cyan" Color="#61D5E8"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Success" Color="#51D7A2"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Danger" Color="#EE6571"/>
    <SolidColorBrush x:Key="AtlasV2.Brush.Scrim" Color="#9905080B"/>

    <Style x:Key="AtlasV2.Text.Body" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Manrope}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="AtlasV2.Text.Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.Body}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
    </Style>

    <Style x:Key="AtlasV2.Text.Eyebrow" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.Body}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Gold}"/>
    </Style>

    <Style x:Key="AtlasV2.Text.SectionTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.Body}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
    </Style>

    <Style x:Key="AtlasV2.Text.Hero" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.Body}">
        <Setter Property="FontSize" Value="38"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
</ResourceDictionary>
