+public class ItemSparseStatWidthTests
+{
+    [Theory]
+    [InlineData(0, 0)]
+    [InlineData(127, 127)]
+    [InlineData(128, 128)]
+    [InlineData(162, 162)]
+    [InlineData(219, 219)]
+    [InlineData(-129, -129)]
+    [InlineData(32767, 32767)]
+    [InlineData(-32768, -32768)]
+    [InlineData(int.MaxValue, 32767)]
+    [InlineData(int.MinValue, -32768)]
+    public void UpdateRecordPreservesSignedSixteenBitStatsAndClampsMalformedValues(int value, short expected)
+    {
+        var row = new GameData.ItemSparseRecord();
+        var item = new ItemTemplate { StatsCount = 10 };
+        Array.Fill(item.StatValues, value);
+
+        GameData.UpdateItemSparseRecord(row, item);
+
+        Assert.All(row.StatValue, stat => Assert.Equal(expected, stat));
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(1)]
+    [InlineData(5)]
+    [InlineData(10)]
+    public void UpdateRecordClearsUnusedStatSlots(uint statsCount)
+    {
+        var row = new GameData.ItemSparseRecord();
+        Array.Fill(row.StatValue, (short)219);
+        var item = new ItemTemplate { StatsCount = statsCount };
+        Array.Fill(item.StatValues, 162);
+
+        GameData.UpdateItemSparseRecord(row, item);
+
+        for (int index = 0; index < 10; index++)
+            Assert.Equal(index < statsCount ? (short)162 : (short)0, row.StatValue[index]);
+    }
+
+    [Fact]
+    public void HotfixSerializesFullInt16StatsFor343AndClampsOnlyOlderWireLayouts()
+    {
+        short[] stats = [162, 219, 128, -129, short.MaxValue, short.MinValue, 0, 1, -1, 127];
+        var row = new GameData.ItemSparseRecord { StatValue = stats.ToArray(), RequiredLevel = 80 };
+        using var buffer = new ByteBuffer();
+
+        GameData.WriteItemSparseHotfix(row, buffer);
+
+        byte[] bytes = buffer.GetData();
+        Assert.Equal((byte)80, bytes[^1]);
+        if (ModernVersion.Build == ClientVersionBuild.V3_4_3_54261)
+        {
+            // The 341/343 ItemSparse wire layout has 30 one-byte fields after the
+            // 10 Int16 StatModifierBonusAmount values. Checking all ten slots also
+            // catches accidental narrowing or displacement of the following fields.
+            int firstStat = bytes.Length - 30 - 10 * sizeof(short);
+            for (int index = 0; index < 10; index++)
+                Assert.Equal(stats[index], BinaryPrimitives.ReadInt16LittleEndian(
+                    bytes.AsSpan(firstStat + index * sizeof(short), sizeof(short))));
+        }
+        else
+        {
+            // Older layouts retain ten signed bytes directly before RequiredLevel.
+            int firstStat = bytes.Length - 1 - 10;
+            for (int index = 0; index < 10; index++)
+                Assert.Equal((sbyte)Math.Clamp(stats[index], sbyte.MinValue, sbyte.MaxValue),
+                    unchecked((sbyte)bytes[firstStat + index]));
+        }
+
+        Assert.Equal(stats, row.StatValue); // Writing an older packet must not narrow the cache.
+    }
+}
