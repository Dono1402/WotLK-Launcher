        <GeometryDrawing Geometry="M8,6 L10,8 M5,11 L7,12 M5,20 L7,19 M9,26 L10,24 M23,26 L22,24 M27,20 L25,19 M27,11 L25,12 M23,6 L22,8"><GeometryDrawing.Pen><Pen Brush="#FBE29B" Thickness="1"/></GeometryDrawing.Pen></GeometryDrawing>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>
    <SolidColorBrush x:Key="ShopGold" Color="#FFCA53"/>
    <SolidColorBrush x:Key="ShopIce" Color="#53DFFD"/>
    <Geometry x:Key="ShopIcon.Clock">M12 2 A10 10 0 1 1 11.999 2 M12 6 V12 L16 15</Geometry>
    <Geometry x:Key="ShopIcon.Chevron">M9 5 L16 12 L9 19</Geometry>
    <Geometry x:Key="ShopIcon.Cart">M2 3 H5 L7.5 15 H18 L21 7 H6 M9 20 A1 1 0 1 1 8.999 20 M18 20 A1 1 0 1 1 17.999 20</Geometry>
    <Geometry x:Key="ShopIcon.Shield">M12 2 L20 5 V11 C20 16 16 20 12 22 C8 20 4 16 4 11 V5 Z M8 11 L11 14 L16 8</Geometry>
    <Geometry x:Key="ShopIcon.Lock">M7 10 V7 A5 5 0 0 1 17 7 V10 M5 10 H19 V22 H5 Z M12 14 V18</Geometry>
    <Geometry x:Key="ShopIcon.Link">M14 3 H21 V10 M21 3 L10 14 M10 3 H3 V21 H21 V14</Geometry>
    <Style x:Key="ShopIcon" TargetType="Path" BasedOn="{StaticResource AtlasV2.Icon.Stroke}"><Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Stroke" Value="#ACD6F4"/><Setter Property="StrokeThickness" Value="1.5"/></Style>
    <Style x:Key="ShopPanel" TargetType="Border" BasedOn="{StaticResource AtlasV2.Card}"><Setter Property="Background" Value="{StaticResource AtlasV2.Brush.GlassSurface}"/><Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GlassBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="26"/></Style>
    <Style x:Key="ShopBody" TargetType="TextBlock"><Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/><Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/><Setter Property="Foreground" Value="#BCD8EB"/><Setter Property="FontSize" Value="15"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
    <Style x:Key="ShopCaption" TargetType="TextBlock" BasedOn="{StaticResource ShopBody}"><Setter Property="FontSize" Value="14"/><Setter Property="LineHeight" Value="20"/><Setter Property="Foreground" Value="#A6C8E2"/></Style>
    <Style x:Key="ShopEyebrow" TargetType="TextBlock" BasedOn="{StaticResource ShopBody}"><Setter Property="Foreground" Value="{StaticResource ShopIce}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="ShopHeading" TargetType="TextBlock" BasedOn="{StaticResource ShopBody}"><Setter Property="Foreground" Value="#F8FAFF"/><Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="LineHeight" Value="28"/></Style>
    <Style x:Key="ShopAction" TargetType="Button">
        <Setter Property="Height" Value="48"/><Setter Property="Padding" Value="16,0"/><Setter Property="Background" Value="#9E05111A"/><Setter Property="BorderBrush" Value="#37576B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#EAF4FF"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#6DBFEC"/><Setter TargetName="Surface" Property="Background" Value="#CC123347"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DF1A4055"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ShopField" TargetType="ComboBox" BasedOn="{StaticResource AtlasV2.ComboBox.Field}"><Setter Property="Height" Value="42"/><Setter Property="Background" Value="#EB030F17"/><Setter Property="BorderBrush" Value="#344C5A"/><Setter Property="FontSize" Value="14"/></Style>
    <Style x:Key="ShopProduct" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Field}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Grid>

                <Border x:Name="Card" BorderBrush="#547389" BorderThickness="1" CornerRadius="14" Background="#DB04121D"><ContentPresenter/></Border>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#FFD56A"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#FFE69E"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
