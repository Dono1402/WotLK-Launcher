+
+    internal static WorldPacket BuildLegacyLearnPreviewTalentsPacket(
+        IReadOnlyList<PreviewTalentEntry> talents)
+    {
+        ArgumentNullException.ThrowIfNull(talents);
+        if (talents.Count > LearnPreviewTalents.MaxTalentCount)
+            throw new ArgumentOutOfRangeException(nameof(talents), "A talent preview cannot contain more than 60 entries.");
+
+        WorldPacket packet = new WorldPacket(Opcode.CMSG_LEARN_PREVIEW_TALENTS);
+        packet.WriteUInt32((uint)talents.Count);
+        foreach (PreviewTalentEntry talent in talents)
+        {
+            packet.WriteUInt32(talent.TalentID);
+            packet.WriteUInt32(talent.Rank);
+        }
+
+        return packet;
+    }
