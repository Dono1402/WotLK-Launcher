<UserControl x:Class="WotLK.Launcher.UI.V2.Views.ProfileMenuV2"
             x:Name="ProfileMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WotLK.Launcher.UI.V2.Views"
             Width="344"
             Visibility="Collapsed"
             IsHitTestVisible="False"
             Focusable="False"
             KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/AtlasV2.OverlaysPilot.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid DataContext="{Binding State, RelativeSource={RelativeSource AncestorType={x:Type views:ProfileMenuV2}}}">
        <Border x:Name="MenuPanel"
                Padding="20"
                Background="{StaticResource AtlasV2.Overlay.Panel}"
                BorderBrush="{StaticResource AtlasV2.Overlay.Edge}"
                BorderThickness="1"
                CornerRadius="14"
                Opacity="0"
                Focusable="True">
            <Border.RenderTransform>
                <TranslateTransform x:Name="MenuTranslate" Y="-8"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="6"
                                  Opacity="0.34"
                                  Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="ProfileIdentityAvatar"
                          Width="42"
                          Height="42"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top">
                        <Ellipse Fill="{StaticResource AtlasV2.Brush.Gold}"/>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding Current.Initial}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#111318"/>
                        <Ellipse x:Name="MenuProfileAvatarImage">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarImage}"
                                            Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                            <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse IsHitTestVisible="False"
                                 Stroke="{StaticResource AtlasV2.Brush.GoldBorder}"
                                 StrokeThickness="1.5"/>
                    </Grid>

                    <TextBlock x:Name="ProfileUsernameText"
                               Grid.Column="1"
                               Margin="2,0,8,0"
                               VerticalAlignment="Center"
                               Text="{Binding Current.Username}"
                               Style="{StaticResource AtlasV2.Text.Body}"
                               FontWeight="ExtraBold"
                               FontSize="18"
                               Foreground="{StaticResource AtlasV2.Brush.Text}"
                               TextTrimming="CharacterEllipsis"/>

                    <Button x:Name="CloseProfileButton"
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="8"
                            VerticalAlignment="Top"
                            Style="{StaticResource AtlasV2.Overlay.IconButton}"
                            ToolTip="Fermer"
                            AutomationProperties.Name="Fermer le profil"
                            KeyboardNavigation.TabIndex="0"
                            Click="CloseButton_Click">
                        <Path Data="{StaticResource AtlasV2.Icon.Close}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                    </Button>
                </Grid>

                <Border Height="1"
                        Margin="0,16,0,14"
                        Background="{StaticResource AtlasV2.Overlay.Divider}"/>

                <Border x:Name="EmailVerificationWarning"
                        Padding="12,11"
                        Background="{StaticResource AtlasV2.Brush.Surface}"
                        BorderBrush="{StaticResource AtlasV2.Overlay.Divider}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Current.IsEmailVerified}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="EmailVerificationWarningIcon"
                              Width="17"
                              Height="17"
                              Data="{StaticResource AtlasV2.Icon.Mail}"
                              Stroke="{StaticResource AtlasV2.Brush.Warning}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{Binding Current.EmailStatusText}"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                    </Grid>
                </Border>

                <Border Margin="0,10,0,0"
                        Padding="11,9"
                        Background="#2AB93643"
                        BorderBrush="#70B93643"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Current.ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Current.ErrorMessage}"
                               TextWrapping="Wrap"
                               Style="{StaticResource AtlasV2.Text.Caption}"
                               Foreground="#F1A7AE"/>
                </Border>

                <Button x:Name="ManageProfileButton"
                        Height="48"
                        Margin="0,14,0,0"
                        Padding="14,0"
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{Binding IsManageProfileEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:ProfileMenuV2}}}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="Gérer mon profil"
                        KeyboardNavigation.TabIndex="1"
                        Click="ManageProfileButton_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}"
                               BasedOn="{StaticResource AtlasV2.Overlay.Button}">
                            <Setter Property="ToolTip" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="ToolTip" Value="Connexion requise"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>
                        <Path Width="17"
                              Height="17"
                              Data="{StaticResource AtlasV2.Icon.User}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="Gérer mon profil"
                                   FontWeight="SemiBold"/>
                        <Path Grid.Column="2"
                              Width="15"
                              Height="15"
                              Data="{StaticResource AtlasV2.Icon.ArrowRight}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                    </Grid>
                </Button>

                <Button x:Name="ManageAccountButton"
                        Height="48"
                        Margin="0,9,0,0"
                        Padding="14,0"
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{Binding IsManageAccountEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:ProfileMenuV2}}}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="Gérer mon compte"
                        KeyboardNavigation.TabIndex="2"
                        Click="ManageAccountButton_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}"
                               BasedOn="{StaticResource AtlasV2.Overlay.Button}">
                            <Setter Property="ToolTip" Value="Sécurité et appareils connectés"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="ToolTip" Value="Connexion requise"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>
                        <Path Width="17"
                              Height="17"
                              Data="{StaticResource AtlasV2.Icon.Settings}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="Gérer mon compte"
                                   FontWeight="SemiBold"/>
                        <Path Grid.Column="2"
                              Width="15"
                              Height="15"
                              Data="{StaticResource AtlasV2.Icon.ArrowRight}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                    </Grid>
                </Button>

                <Button x:Name="LogoutButton"
                        Height="48"
                        Margin="0,9,0,0"
                        Padding="14,0"
                        HorizontalContentAlignment="Stretch"
                        Style="{StaticResource AtlasV2.Overlay.Button}"
                        Command="{Binding LogoutCommand}"
                        ToolTip="{Binding Current.LogoutToolTip}"
                        AutomationProperties.Name="Déconnexion"
                        KeyboardNavigation.TabIndex="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <Path Width="17"
                              Height="17"
                              Data="{StaticResource AtlasV2.Icon.LogOut}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding Current.LogoutLabel}"
                                   FontWeight="SemiBold"/>
                        <ProgressBar Grid.Column="2"
                                     Width="34"
                                     Height="3"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True">
                            <ProgressBar.Style>
                                <Style TargetType="{x:Type ProgressBar}"
                                       BasedOn="{StaticResource AtlasV2.Progress.Compact}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Current.IsLoggingOut}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
