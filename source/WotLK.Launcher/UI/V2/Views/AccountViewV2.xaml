<UserControl x:Class="WotLK.Launcher.UI.V2.Views.AccountViewV2" x:Name="AccountView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:presentation="clr-namespace:WotLK.Launcher.UI.V2.Presentation" xmlns:views="clr-namespace:WotLK.Launcher.UI.V2.Views" Background="Transparent" FontFamily="{StaticResource AtlasV2.Font.Inter}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/WotLK.Launcher;component/UI/V2/Resources/AtlasV2.AccountPilot.xaml" /></ResourceDictionary.MergedDictionaries>
        <Style x:Key="AtlasV2.Account.TabButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Account.Tab}">
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="24,0" />
        </Style>

        <Style x:Key="AtlasV2.Account.Label" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Account.Text.Caption}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AtlasV2.Account.Value" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Account.Text.Body}">
            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AtlasV2.Account.AvatarAction" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
            <Setter Property="Width" Value="160" />
            <Setter Property="Height" Value="160" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Background" Value="#9EDEB75A" />
            <Setter Property="BorderBrush" Value="#B8F0C96D" />
            <Setter Property="Foreground" Value="#111318" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Border x:Name="Chrome" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="27">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B8F0C96D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D9C89B3F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AtlasV2.Account.AvatarRemoveAction" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Background" Value="#E62A171C" />
            <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.DangerBorder}" />
            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Danger}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AtlasV2.Brush.Danger}" />
                                <Setter Property="Foreground" Value="#111318" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ResourceDictionary></UserControl.Resources>

    <Grid>
    <ScrollViewer x:Name="AccountScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}" />
        </ScrollViewer.Resources>

        <Grid x:Name="ContentFrame" MaxWidth="1220" Margin="34,28,34,42" HorizontalAlignment="Stretch" DataContext="{Binding State, RelativeSource={RelativeSource AncestorType={x:Type views:AccountViewV2}}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"><Border Margin="0,0,18,0" Height="2" Width="32" Background="{StaticResource AtlasV2.Brush.Cyan}" VerticalAlignment="Center" /><TextBlock x:Name="PageEyebrow" Text="COMPTE ATLAS" Style="{StaticResource AtlasV2.Account.Text.Eyebrow}" /></StackPanel>
                    <TextBlock x:Name="PageTitle" Margin="0,10,0,0" Text="Mon compte" FontFamily="{StaticResource AtlasV2.Font.Inter}" FontSize="54" FontWeight="ExtraBold" Foreground="{StaticResource AtlasV2.Brush.TitlePearl}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,22,0,0" Padding="0" HorizontalAlignment="Left" Background="#9C071A28" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="0,0,0,1" CornerRadius="7,7,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ProfileTabButton" Content="Profil" Style="{StaticResource AtlasV2.Account.TabButton}" Click="ProfileTabButton_Click" Visibility="Collapsed" IsTabStop="False" />
                    <Button x:Name="SecurityTabButton" Content="Sécurité" Style="{StaticResource AtlasV2.Account.TabButton}" Click="SecurityTabButton_Click" />
                    <Button x:Name="SessionsTabButton" Content="Sessions" Style="{StaticResource AtlasV2.Account.TabButton}" Click="SessionsTabButton_Click" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,22,0,0">
                <Grid x:Name="ProfilePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="AvatarColumn" Width="352" />
                        <ColumnDefinition x:Name="ProfileGapColumn" Width="24" />
                        <ColumnDefinition Width="*" x:Name="ProfileDetailsWidth" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="AvatarCard" Grid.RowSpan="2" Padding="26,24" VerticalAlignment="Top" Background="{StaticResource AtlasV2.Brush.GlassRaised}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="12">
                        <StackPanel HorizontalAlignment="Center">
                            <Grid x:Name="AvatarInteractionArea" Width="160" Height="160" MouseEnter="AvatarInteractionArea_MouseEnter" MouseLeave="AvatarInteractionArea_MouseLeave" GotKeyboardFocus="AvatarInteractionArea_GotKeyboardFocus" LostKeyboardFocus="AvatarInteractionArea_LostKeyboardFocus">
                                <Ellipse Fill="{StaticResource AtlasV2.Brush.Gold}" />
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Current.Initial}" FontSize="48" FontWeight="ExtraBold" Foreground="#111318" />
                                <Ellipse x:Name="ProfileAvatarImage">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Current.AvatarImage}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Current.HasProfileAvatar}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse IsHitTestVisible="False" Stroke="{StaticResource AtlasV2.Brush.GoldBorder}" StrokeThickness="2" />

                                <Grid x:Name="AvatarActionsOverlay" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                    </Grid.RenderTransform>
                                    <Ellipse Fill="#B8070A0E" />
                                    <Button x:Name="ModifyAvatarButton" Panel.ZIndex="1" Style="{StaticResource AtlasV2.Account.AvatarAction}" IsEnabled="{Binding Current.CanModifyAvatar}" ToolTip="Changer la photo" AutomationProperties.Name="Changer la photo de profil" Click="ModifyAvatarButton_Click">
                                        <Button.Clip>
                                            <EllipseGeometry Center="80,80" RadiusX="80" RadiusY="80" />
                                        </Button.Clip>
                                        <Path Width="22" Height="22" Data="{StaticResource AtlasV2.Icon.Upload}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Style="{StaticResource AtlasV2.Icon.Stroke}" />
                                    </Button>
                                    <Button x:Name="RemoveAvatarButton" Panel.ZIndex="2" Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource AtlasV2.Account.AvatarRemoveAction}" IsEnabled="{Binding Current.CanRemoveAvatar}" Visibility="{Binding Current.HasProfileAvatar, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}" ToolTip="Supprimer la photo" AutomationProperties.Name="Supprimer la photo de profil" Click="RemoveAvatarButton_Click">
                                        <Path Width="15" Height="15" Data="{StaticResource AtlasV2.Icon.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Style="{StaticResource AtlasV2.Icon.Stroke}" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <TextBlock Margin="0,17,0,0" HorizontalAlignment="Center" Text="{Binding Current.Username}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.Text}" />
                            <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" Text="{Binding Current.MemberSince}" Style="{StaticResource AtlasV2.Account.Text.Caption}" />

                            <Border x:Name="AvatarAvailabilityBanner" Margin="0,14,0,0" Padding="12,10" HorizontalAlignment="Stretch" Background="{StaticResource AtlasV2.Brush.GoldSurface}" BorderBrush="{StaticResource AtlasV2.Brush.GoldBorder}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                                <TextBlock Text="{Binding Current.AvatarAvailabilityMessage}" TextWrapping="Wrap" Style="{StaticResource AtlasV2.Account.Text.Caption}" Foreground="{StaticResource AtlasV2.Brush.Gold}" />
                            </Border>

                            <Border x:Name="AvatarErrorBanner" Margin="0,14,0,0" Style="{StaticResource AtlasV2.Banner.Error}" Visibility="Collapsed">
                                <TextBlock Text="{Binding Current.AvatarErrorMessage}" TextWrapping="Wrap" Style="{StaticResource AtlasV2.Account.Text.Caption}" Foreground="#F1A7AE" />
                            </Border>

                            <Border x:Name="AvatarOperationBanner" Margin="0,16,0,0" Padding="12,10" HorizontalAlignment="Stretch" Background="{StaticResource AtlasV2.Brush.CyanSurface}" BorderBrush="{StaticResource AtlasV2.Brush.CyanBorder}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="{Binding Current.AvatarStatusMessage}" Style="{StaticResource AtlasV2.Account.Text.Caption}" Foreground="{StaticResource AtlasV2.Brush.Cyan}" />
                                    <ProgressBar x:Name="AvatarOperationProgress" Height="3" Margin="0,8,0,0" IsIndeterminate="True" Style="{StaticResource AtlasV2.Progress.Compact}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="ProfileDetailsColumn" Grid.Column="2">
                        <Border Padding="24" Background="{StaticResource AtlasV2.Brush.GlassRaised}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="Identité" Margin="0,0,0,20" Style="{StaticResource AtlasV2.Account.Text.Section}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="NOM D’UTILISATEUR" Style="{StaticResource AtlasV2.Account.Label}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Current.Username}" Style="{StaticResource AtlasV2.Account.Value}" />
                                </Grid>
                                <Border Height="1" Margin="0,17" Background="{StaticResource AtlasV2.Brush.BorderSoft}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ADRESSE E-MAIL" Style="{StaticResource AtlasV2.Account.Label}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Current.Email}" Style="{StaticResource AtlasV2.Account.Value}" />
                                    <Border x:Name="EmailVerificationBadge" Grid.Column="2" Padding="9,5" Background="{StaticResource AtlasV2.Brush.SuccessSurface}" BorderBrush="{StaticResource AtlasV2.Brush.SuccessBorder}" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="EmailVerificationIcon" Width="13" Height="13" Data="{StaticResource AtlasV2.Icon.Check}" Stroke="{StaticResource AtlasV2.Brush.Success}" Style="{StaticResource AtlasV2.Icon.Stroke}" />
                                            <TextBlock x:Name="EmailVerificationText" Margin="6,0,0,0" Text="Vérifiée" Style="{StaticResource AtlasV2.Account.Text.Caption}" Foreground="{StaticResource AtlasV2.Brush.Success}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,18,0,0" Padding="24" Background="{StaticResource AtlasV2.Brush.GlassRaised}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="Profil public" Style="{StaticResource AtlasV2.Account.Text.Section}" />

                                <Grid Margin="0,18,0,0">
                                    <TextBlock Text="STATUT PERSONNEL" Style="{StaticResource AtlasV2.Account.Label}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding StatusLengthText}" Style="{StaticResource AtlasV2.Account.Text.Caption}" />
                                </Grid>
                                <Border Height="42" Margin="0,7,0,0" Background="{StaticResource AtlasV2.Brush.Field}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="6">
                                    <TextBox x:Name="SocialStatusBox" Margin="12,0" MaxLength="80" Text="{Binding StatusMessageDraft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AtlasV2.TextBox.Field}" AutomationProperties.Name="Statut personnel" />
                                </Border>

                                <Grid Margin="0,17,0,0">
                                    <TextBlock Text="BIO" Style="{StaticResource AtlasV2.Account.Label}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding BioLengthText}" Style="{StaticResource AtlasV2.Account.Text.Caption}" />
                                </Grid>
                                <Border Height="112" Margin="0,7,0,0" Padding="12,9" Background="{StaticResource AtlasV2.Brush.Field}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="6">
                                    <TextBox x:Name="SocialBioBox" MaxLength="280" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" Foreground="{StaticResource AtlasV2.Brush.Text}" CaretBrush="{StaticResource AtlasV2.Brush.Cyan}" SelectionBrush="{StaticResource AtlasV2.Brush.Cyan}" FontFamily="{StaticResource AtlasV2.Font.Inter}" FontSize="14" Text="{Binding BioDraft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bio publique" />
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <TextBlock x:Name="SocialProfileFeedbackText" MaxWidth="420" Margin="0,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource AtlasV2.Account.Text.Caption}" Visibility="Collapsed" />
                                    <Button x:Name="SaveSocialProfileButton" Width="150" Height="42" HorizontalAlignment="Right" Style="{StaticResource AtlasV2.Account.Button.Primary}" IsEnabled="{Binding CanSaveSocialProfile}" Content="Enregistrer" Click="SaveSocialProfileButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>

                <StackPanel x:Name="SecurityPanel" Visibility="Collapsed">
                    <Border x:Name="AccountNoticeBanner" Margin="0,0,0,14" Padding="14,11" Background="{StaticResource AtlasV2.Brush.SuccessSurface}" BorderBrush="{StaticResource AtlasV2.Brush.SuccessBorder}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed">
                        <TextBlock Text="{Binding Current.AccountNoticeMessage}" TextWrapping="Wrap" Style="{StaticResource AtlasV2.Account.Text.Body}" Foreground="{StaticResource AtlasV2.Brush.Success}" />
                    </Border>
                    <Border x:Name="AccountErrorBanner" Margin="0,0,0,14" Style="{StaticResource AtlasV2.Banner.Error}" Visibility="Collapsed">
                        <TextBlock Text="{Binding Current.AccountErrorMessage}" TextWrapping="Wrap" Style="{StaticResource AtlasV2.Account.Text.Body}" Foreground="#F1A7AE" />
                    </Border>

                    <Border Padding="28" Background="{StaticResource AtlasV2.Brush.GlassRaised}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="{StaticResource AtlasV2.Brush.CyanSurface}" BorderBrush="{StaticResource AtlasV2.Brush.CyanBorder}" BorderThickness="1" CornerRadius="7" VerticalAlignment="Center">
                                <Path Width="19" Height="19" Data="{StaticResource AtlasV2.Icon.Mail}" Stroke="{StaticResource AtlasV2.Brush.Cyan}" Style="{StaticResource AtlasV2.Icon.Stroke}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="Adresse e-mail" Style="{StaticResource AtlasV2.Account.Text.Section}" />
                                <WrapPanel x:Name="SecurityEmailLine" Margin="0,7,0,0" Orientation="Horizontal">
                                    <TextBlock x:Name="SecurityEmailAddress" Text="{Binding Current.Email}" Style="{StaticResource AtlasV2.Account.Text.Body}" Foreground="{StaticResource AtlasV2.Brush.Text}" />
                                    <TextBlock x:Name="SecurityEmailStatus" Margin="8,0,0,0" Text="(Vérifiée)" Style="{StaticResource AtlasV2.Account.Text.Caption}" VerticalAlignment="Center" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" x:Name="EmailActions" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Button x:Name="ResendVerificationButton" Margin="0,0,10,0" Content="Renvoyer la validation" Style="{StaticResource AtlasV2.Account.Button.Compact}" IsEnabled="{Binding Current.CanResendVerification}" Click="ResendVerificationButton_Click" />
                                <Button x:Name="ModifyEmailButton" Content="Modifier" Style="{StaticResource AtlasV2.Account.Button.Secondary}" IsEnabled="{Binding Current.CanChangeEmail}" Click="ModifyEmailButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,16,0,0" Padding="28" Background="{StaticResource AtlasV2.Brush.GlassRaised}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="{StaticResource AtlasV2.Brush.GoldSurface}" BorderBrush="{StaticResource AtlasV2.Brush.GoldBorder}" BorderThickness="1" CornerRadius="7" VerticalAlignment="Center">
                                <Path Width="19" Height="19" Data="{StaticResource AtlasV2.Icon.Key}" Stroke="{StaticResource AtlasV2.Brush.Gold}" Style="{StaticResource AtlasV2.Icon.Stroke}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="Mot de passe" Style="{StaticResource AtlasV2.Account.Text.Section}" />
                            </StackPanel>
                            <Button x:Name="ModifyPasswordButton" Grid.Column="2" Content="Modifier le mot de passe" Style="{StaticResource AtlasV2.Account.Button.Secondary}" IsEnabled="{Binding Current.CanChangePassword}" Click="ModifyPasswordButton_Click" />
                        </Grid>
                    </Border>

                    <Border Margin="0,16,0,0" Padding="28" Background="{StaticResource AtlasV2.Brush.GlassRaised}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="{StaticResource AtlasV2.Brush.CyanSurface}" BorderBrush="{StaticResource AtlasV2.Brush.CyanBorder}" BorderThickness="1" CornerRadius="7" VerticalAlignment="Center">
                                <Path Width="19" Height="19" Data="{StaticResource AtlasV2.Icon.ShieldCheck}" Stroke="{StaticResource AtlasV2.Brush.Cyan}" Style="{StaticResource AtlasV2.Icon.Stroke}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="Double authentification" Style="{StaticResource AtlasV2.Account.Text.Section}" />
                            </StackPanel>
                            <TextBlock Text="À venir" Grid.Column="2" Margin="20,0,0,0" Style="{StaticResource AtlasV2.Account.Text.Caption}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="SessionsPanel" Visibility="Collapsed">
                    <Border x:Name="SessionsNoticeBanner" Margin="0,0,0,14" Padding="14,11" Background="{StaticResource AtlasV2.Brush.SuccessSurface}" BorderBrush="{StaticResource AtlasV2.Brush.SuccessBorder}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed">
                        <TextBlock Text="{Binding Current.AccountNoticeMessage}" TextWrapping="Wrap" Style="{StaticResource AtlasV2.Account.Text.Body}" Foreground="{StaticResource AtlasV2.Brush.Success}" />
                    </Border>
                    <Border x:Name="SessionsErrorBanner" Margin="0,0,0,14" Style="{StaticResource AtlasV2.Banner.Error}" Visibility="Collapsed">
                        <TextBlock Text="{Binding Current.AccountErrorMessage}" TextWrapping="Wrap" Style="{StaticResource AtlasV2.Account.Text.Body}" Foreground="#F1A7AE" />
                    </Border>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Appareils connectés" Style="{StaticResource AtlasV2.Account.Text.Section}" />
                            <TextBlock x:Name="SessionsSummaryText" Margin="0,4,0,0" Text="{Binding Current.ActiveSessionCount, StringFormat={}{0} appareils connectés}" Style="{StaticResource AtlasV2.Account.Text.Body}" />
                        </StackPanel>
                        <TextBlock Text="Déconnexion groupée · À venir" Grid.Column="1" Margin="24,0,0,0" Style="{StaticResource AtlasV2.Account.Text.Caption}" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel x:Name="SessionsPreviewList">
                        <Border Padding="20" Background="{StaticResource AtlasV2.Brush.GlassRaised}" BorderBrush="{StaticResource AtlasV2.Brush.SuccessBorder}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Width="24" Height="24" Data="{StaticResource AtlasV2.Icon.Laptop}" Stroke="{StaticResource AtlasV2.Brush.Cyan}" Style="{StaticResource AtlasV2.Icon.Stroke}" />
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Windows · Atlas Launcher" Style="{StaticResource AtlasV2.Account.Value}" />
                                        <Border Margin="10,0,0,0" Padding="8,3" Background="{StaticResource AtlasV2.Brush.SuccessSurface}" CornerRadius="5">
                                            <TextBlock Text="Cet appareil" Style="{StaticResource AtlasV2.Account.Text.Caption}" Foreground="{StaticResource AtlasV2.Brush.Success}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,5,0,0" Text="Liège, Belgique · active maintenant" Style="{StaticResource AtlasV2.Account.Text.Caption}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0" Padding="20" Background="{StaticResource AtlasV2.Brush.GlassRaised}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Width="22" Height="22" Data="{StaticResource AtlasV2.Icon.Smartphone}" Style="{StaticResource AtlasV2.Icon.Stroke}" />
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="Atlas Launcher · portable" Style="{StaticResource AtlasV2.Account.Value}" />
                                    <TextBlock Margin="0,5,0,0" Text="Namur, Belgique · il y a 2 jours" Style="{StaticResource AtlasV2.Account.Text.Caption}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Déconnecter" Style="{StaticResource AtlasV2.Account.Button.Compact}" IsEnabled="False" ToolTip="Preview fictive" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <ItemsControl x:Name="SessionsRealList" Visibility="Collapsed" ItemsSource="{Binding Current.Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type presentation:AccountSessionViewState}">
                                <Border Margin="0,0,0,12" Padding="20" Background="{StaticResource AtlasV2.Brush.GlassRaised}" BorderThickness="1" CornerRadius="12">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GlassBorder}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.SuccessBorder}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Width="23" Height="23" Data="{StaticResource AtlasV2.Icon.Monitor}" Stroke="{StaticResource AtlasV2.Brush.Cyan}" Style="{StaticResource AtlasV2.Icon.Stroke}" />
                                        <StackPanel Grid.Column="1" Margin="14,0,18,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DeviceName}" Style="{StaticResource AtlasV2.Account.Value}" />
                                                <Border Margin="10,0,0,0" Padding="8,3" Background="{StaticResource AtlasV2.Brush.SuccessSurface}" CornerRadius="5">
                                                    <Border.Style>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Cet appareil" Style="{StaticResource AtlasV2.Account.Text.Caption}" Foreground="{StaticResource AtlasV2.Brush.Success}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,5,0,0" Text="{Binding LastActivityText}" Style="{StaticResource AtlasV2.Account.Text.Caption}" />
                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource AtlasV2.Account.Text.Caption}">
                                                <Run Text="{Binding CreatedText}" /><Run Text=" · " /><Run Text="{Binding ExpiresText}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Tag="{Binding Id}" IsEnabled="{Binding CanRevoke}" Click="RevokeSessionButton_Click">
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Account.Button.Compact}">
                                                    <Setter Property="Content" Value="Déconnecter" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRevoking}" Value="True">
                                                            <Setter Property="Content" Value="Déconnexion…" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="SessionsMessageCard" Padding="20" Visibility="Collapsed" Background="{StaticResource AtlasV2.Brush.GlassRaised}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="12">
                        <TextBlock Text="{Binding Current.SessionsMessage}" TextWrapping="Wrap" Style="{StaticResource AtlasV2.Account.Text.Body}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>

        <Grid x:Name="DeleteConfirmationLayer" Panel.ZIndex="30" Background="{StaticResource AtlasV2.Brush.Scrim}" Visibility="Collapsed" IsHitTestVisible="False" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" MouseLeftButtonDown="DeleteConfirmationLayer_MouseLeftButtonDown">
            <Border x:Name="DeleteConfirmationPanel" Width="430" Margin="20" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource AtlasV2.Account.ModalSurface}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="12" Focusable="True">
                <StackPanel>
                    <TextBlock Text="Supprimer ta photo de profil ?" Style="{StaticResource AtlasV2.Account.Text.Section}" />
                    <TextBlock Margin="0,8,0,0" Text="Ton initiale sera utilisée à la place." TextWrapping="Wrap" Style="{StaticResource AtlasV2.Account.Text.Body}" />
                    <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="CancelDeleteAvatarButton" MinWidth="108" Content="Annuler" Style="{StaticResource AtlasV2.Account.Button.Secondary}" Click="CancelDeleteAvatarButton_Click" />
                        <Button x:Name="ConfirmDeleteAvatarButton" MinWidth="112" Margin="10,0,0,0" Content="Supprimer" Style="{StaticResource AtlasV2.Account.Button.Primary}" Click="ConfirmDeleteAvatarButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="EmailEditorLayer" Panel.ZIndex="31" Background="{StaticResource AtlasV2.Brush.Scrim}" Visibility="Collapsed" IsHitTestVisible="False" DataContext="{Binding State, RelativeSource={RelativeSource AncestorType={x:Type views:AccountViewV2}}}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" MouseLeftButtonDown="EmailEditorLayer_MouseLeftButtonDown">
            <Border x:Name="EmailEditorPanel" Width="480" Margin="20" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource AtlasV2.Account.ModalSurface}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="12" Focusable="True">
                <StackPanel>
                    <TextBlock Text="Modifier l’adresse e-mail" Style="{StaticResource AtlasV2.Account.Text.Section}" />
                    <TextBlock Margin="0,7,0,0" Text="La nouvelle adresse devra être validée." Style="{StaticResource AtlasV2.Account.Text.Body}" />
                    <TextBlock Margin="0,22,0,7" Text="NOUVELLE ADRESSE E-MAIL" Style="{StaticResource AtlasV2.Account.Label}" />
                    <Border x:Name="NewEmailField" Style="{StaticResource AtlasV2.Account.Field}">
                        <TextBox x:Name="NewEmailBox" MaxLength="254" Style="{StaticResource AtlasV2.TextBox.Field}" />
                    </Border>
                    <Border x:Name="EmailEditorErrorBanner" Margin="0,14,0,0" Style="{StaticResource AtlasV2.Banner.Error}" Visibility="Collapsed">
                        <TextBlock Text="{Binding Current.AccountErrorMessage}" TextWrapping="Wrap" Style="{StaticResource AtlasV2.Account.Text.Caption}" Foreground="#F1A7AE" />
                    </Border>
                    <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="CancelEmailChangeButton" MinWidth="108" Content="Annuler" Style="{StaticResource AtlasV2.Account.Button.Secondary}" Click="CancelEmailChangeButton_Click" />
                        <Button x:Name="ConfirmEmailChangeButton" MinWidth="128" Margin="10,0,0,0" Content="Enregistrer" Style="{StaticResource AtlasV2.Account.Button.Primary}" Click="ConfirmEmailChangeButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="PasswordEditorLayer" Panel.ZIndex="32" Background="{StaticResource AtlasV2.Brush.Scrim}" Visibility="Collapsed" IsHitTestVisible="False" DataContext="{Binding State, RelativeSource={RelativeSource AncestorType={x:Type views:AccountViewV2}}}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" MouseLeftButtonDown="PasswordEditorLayer_MouseLeftButtonDown">
            <Border x:Name="PasswordEditorPanel" Width="500" Margin="20" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource AtlasV2.Account.ModalSurface}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="12" Focusable="True">
                <StackPanel>
                    <TextBlock Text="Modifier le mot de passe" Style="{StaticResource AtlasV2.Account.Text.Section}" />
                    <TextBlock Margin="0,7,0,0" Text="Le nouveau mot de passe doit contenir entre 10 et 128 caractères." TextWrapping="Wrap" Style="{StaticResource AtlasV2.Account.Text.Body}" />

                    <TextBlock Margin="0,20,0,7" Text="MOT DE PASSE ACTUEL" Style="{StaticResource AtlasV2.Account.Label}" />
                    <Border x:Name="CurrentPasswordField" Style="{StaticResource AtlasV2.Account.Field}">
                        <PasswordBox x:Name="CurrentPasswordBoxV2" MaxLength="128" Style="{StaticResource AtlasV2.PasswordBox.Field}" />
                    </Border>
                    <TextBlock Margin="0,14,0,7" Text="NOUVEAU MOT DE PASSE" Style="{StaticResource AtlasV2.Account.Label}" />
                    <Border x:Name="NewPasswordField" Style="{StaticResource AtlasV2.Account.Field}">
                        <PasswordBox x:Name="NewPasswordBoxV2" MaxLength="128" Style="{StaticResource AtlasV2.PasswordBox.Field}" />
                    </Border>
                    <TextBlock Margin="0,14,0,7" Text="CONFIRMER LE NOUVEAU MOT DE PASSE" Style="{StaticResource AtlasV2.Account.Label}" />
                    <Border x:Name="ConfirmPasswordField" Style="{StaticResource AtlasV2.Account.Field}">
                        <PasswordBox x:Name="ConfirmPasswordBoxV2" MaxLength="128" Style="{StaticResource AtlasV2.PasswordBox.Field}" />
                    </Border>

                    <Border x:Name="PasswordEditorErrorBanner" Margin="0,14,0,0" Style="{StaticResource AtlasV2.Banner.Error}" Visibility="Collapsed">
                        <TextBlock Text="{Binding Current.AccountErrorMessage}" TextWrapping="Wrap" Style="{StaticResource AtlasV2.Account.Text.Caption}" Foreground="#F1A7AE" />
                    </Border>
                    <StackPanel x:Name="PasswordBusyPanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="Modification en cours…" Style="{StaticResource AtlasV2.Account.Text.Caption}" Foreground="{StaticResource AtlasV2.Brush.Cyan}" />
                        <ProgressBar Height="3" Margin="0,7,0,0" IsIndeterminate="True" Style="{StaticResource AtlasV2.Progress.Compact}" />
                    </StackPanel>
                    <StackPanel Margin="0,22,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="CancelPasswordChangeButton" MinWidth="108" Content="Annuler" Style="{StaticResource AtlasV2.Account.Button.Secondary}" Click="CancelPasswordChangeButton_Click" />
                        <Button x:Name="ConfirmPasswordChangeButton" MinWidth="128" Margin="10,0,0,0" Content="Modifier" Style="{StaticResource AtlasV2.Account.Button.Primary}" Click="ConfirmPasswordChangeButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
