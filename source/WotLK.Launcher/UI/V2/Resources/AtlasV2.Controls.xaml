<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <Style x:Key="AtlasV2.FocusVisual.Button">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="2"
                            BorderBrush="{StaticResource AtlasV2.Brush.Cyan}"
                            BorderThickness="2"
                            CornerRadius="5"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.Button.Base" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Manrope}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.64"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="Height" Value="52"/>
        <Setter Property="MinWidth" Value="170"/>
        <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.Gold}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Gold}"/>
        <Setter Property="Foreground" Value="#111318"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.GoldHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GoldHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.GoldPressed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GoldPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#75643E"/>
                <Setter Property="BorderBrush" Value="#8A7547"/>
                <Setter Property="Foreground" Value="#D8D2C4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.Button.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="Height" Value="52"/>
        <Setter Property="Background" Value="#D9141A20"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfaceHover}"/>
                <Setter Property="BorderBrush" Value="#536170"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfacePressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.Button.Icon" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Border}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfacePressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.Button.GhostCompact" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.BorderSoft}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfaceHover}"/>
                <Setter Property="BorderBrush" Value="#4A5867"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfacePressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.Button.Window" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Icon}">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Padding" Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>

    <Style x:Key="AtlasV2.Button.WindowClose" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Window}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#B93643"/>
                <Setter Property="BorderBrush" Value="#B93643"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#962B36"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.Button.Nav" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="Height" Value="64"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="NavSurface" Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <Border x:Name="Indicator"
                                Height="2"
                                Margin="12,0"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource AtlasV2.Brush.Gold}"
                                Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
                            <Setter TargetName="NavSurface" Property="Background" Value="#121820"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
                            <Setter TargetName="NavSurface" Property="Background" Value="#171E26"/>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.Progress.Compact" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
        <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.BorderSoft}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid Height="{TemplateBinding Height}"
                          ClipToBounds="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"/>
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3"/>
                        <Border x:Name="IndeterminateSegment"
                                Width="82"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3"
                                Opacity="0.9"
                                Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="IndeterminateTransform" X="-82"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IndeterminateSegment" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="-82"
                                                         To="330"
                                                         Duration="0:0:1.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="IndeterminateStoryboard"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="22"/>
    </Style>

    <Style x:Key="AtlasV2.StatusChip" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#B312171D"/>
        <Setter Property="BorderBrush" Value="#44515E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style x:Key="AtlasV2.ScrollBar.Dark" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Width="6" Background="Transparent">
                        <primitives:Track x:Name="PART_Track"
                                          IsDirectionReversed="True"
                                          Focusable="False">
                            <primitives:Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False"
                                              Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </primitives:Track.DecreaseRepeatButton>
                            <primitives:Track.Thumb>
                                <Thumb MinHeight="30"
                                       Margin="0,2"
                                       Background="#3B4652">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbSurface"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbSurface" Property="Background" Value="#536170"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbSurface" Property="Background" Value="#637285"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </primitives:Track.Thumb>
                            <primitives:Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False"
                                              Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </primitives:Track.IncreaseRepeatButton>
                        </primitives:Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
