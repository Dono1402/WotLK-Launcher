<Window x:Class="WotLK.Launcher.UI.V2.LauncherShellV2"
        x:Name="ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:WotLK.Launcher.UI.V2.Views"
        Title="Atlas Launcher · Prévisualisation V2"
        Icon="/WotLK.Launcher;component/Assets/AppIcon.ico"
        Width="1440"
        Height="860"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AtlasV2.Brush.Window}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource AtlasV2.Brush.WindowAmbient}"
            BorderBrush="#3A444F"
            BorderThickness="1"
            TextElement.FontFamily="{StaticResource AtlasV2.Font.Manrope}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{StaticResource AtlasV2.Brush.TopBar}"
                    BorderBrush="{StaticResource AtlasV2.Brush.BorderSoft}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="20,0,14,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Width="30"
                               Height="30"
                               Source="/WotLK.Launcher;component/Assets/Branding/AtlasLauncherLogo.png"
                               Stretch="Uniform"/>
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Atlas Launcher"
                                   Style="{StaticResource AtlasV2.Text.Body}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        <Border x:Name="ProductDivider"
                                Grid.Column="2"
                                Width="1"
                                Height="22"
                                Margin="14,0"
                                Background="{StaticResource AtlasV2.Brush.Border}"/>
                        <TextBlock x:Name="ProductGameName"
                                   Grid.Column="3"
                                   VerticalAlignment="Center"
                                   Text="{Binding ShellState.GameName}"
                                   Style="{StaticResource AtlasV2.Text.Caption}"
                                   Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                    </Grid>

                    <StackPanel x:Name="TopNavigation"
                                Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource AtlasV2.Button.Nav}"
                                Tag="Active"
                                Content="Jeu"
                                Focusable="False"/>
                        <Button Style="{StaticResource AtlasV2.Button.Nav}"
                                Content="Addons"
                                Focusable="False"/>
                        <Button Style="{StaticResource AtlasV2.Button.Nav}"
                                Content="Actualités"
                                Focusable="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border x:Name="RealmStatusChip"
                                Height="36"
                                Margin="0,0,8,0"
                                Padding="11,0"
                                Background="{StaticResource AtlasV2.Brush.Surface}"
                                BorderBrush="{StaticResource AtlasV2.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7"
                                         Height="7"
                                         Margin="0,0,7,0"
                                         Fill="{StaticResource AtlasV2.Brush.Success}"/>
                                <TextBlock x:Name="RealmStatusText"
                                           VerticalAlignment="Center"
                                           Text="{Binding ShellState.RealmStatus}"
                                           Style="{StaticResource AtlasV2.Text.Caption}"
                                           Foreground="{StaticResource AtlasV2.Brush.Success}"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="FriendsButton"
                                Height="40"
                                Margin="0,0,5,0"
                                Padding="11,0"
                                Style="{StaticResource AtlasV2.Button.Base}"
                                ToolTip="Amis"
                                AutomationProperties.Name="Ouvrir le panneau Amis"
                                Click="FriendsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="17"
                                      Height="17"
                                      Data="{StaticResource AtlasV2.Icon.Users}"
                                      Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                <TextBlock x:Name="FriendsButtonText"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="Amis"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Margin="0,0,3,0"
                                Style="{StaticResource AtlasV2.Button.Icon}"
                                ToolTip="Paramètres"
                                Focusable="False"
                                AutomationProperties.Name="Paramètres">
                            <Path Data="{StaticResource AtlasV2.Icon.Settings}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>

                        <Button Width="40"
                                Height="40"
                                Margin="0,0,8,0"
                                Padding="0"
                                Style="{StaticResource AtlasV2.Button.Icon}"
                                ToolTip="Profil Dono1402"
                                Focusable="False"
                                AutomationProperties.Name="Profil Dono1402">
                            <Border Width="34"
                                    Height="34"
                                    Background="{StaticResource AtlasV2.Brush.Gold}"
                                    CornerRadius="17">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="D"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#111318"/>
                            </Border>
                        </Button>

                        <TextBlock x:Name="VersionText"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding ShellState.LauncherVersion}"
                                   Style="{StaticResource AtlasV2.Text.Caption}"/>

                        <Button Style="{StaticResource AtlasV2.Button.Window}"
                                ToolTip="Réduire"
                                AutomationProperties.Name="Réduire"
                                Click="MinimizeButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.Minus}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                        <Button Style="{StaticResource AtlasV2.Button.Window}"
                                ToolTip="Agrandir ou restaurer"
                                AutomationProperties.Name="Agrandir ou restaurer"
                                Click="MaximizeRestoreButton_Click">
                            <Grid>
                                <Path x:Name="MaximizeIcon"
                                      Data="{StaticResource AtlasV2.Icon.Maximize}"
                                      Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                <Path x:Name="RestoreIcon"
                                      Data="{StaticResource AtlasV2.Icon.Restore}"
                                      Style="{StaticResource AtlasV2.Icon.Stroke}"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource AtlasV2.Button.WindowClose}"
                                ToolTip="Fermer"
                                AutomationProperties.Name="Fermer"
                                Click="CloseWindowButton_Click">
                            <Path Data="{StaticResource AtlasV2.Icon.Close}"
                                  Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <views:GameViewV2 State="{Binding GameState}"
                                  LayoutMode="{Binding ShellState.LayoutMode}"/>
                <views:FriendsDrawerV2 x:Name="FriendsDrawer"
                                       Panel.ZIndex="50"
                                       State="{Binding FriendsState}"
                                       IsOpen="{Binding FriendsState.IsOpen, Mode=TwoWay}"
                                       CloseRequested="FriendsDrawer_CloseRequested"
                                       Closed="FriendsDrawer_Closed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
