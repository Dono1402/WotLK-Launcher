<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- High opacity keeps the underlying page from showing through the text. -->
    <LinearGradientBrush x:Key="AtlasV2.Overlay.Panel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF10283B" Offset="0"/>
        <GradientStop Color="#FF0C1C2B" Offset="0.45"/>
        <GradientStop Color="#FF07131F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AtlasV2.Overlay.Card" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2183349" Offset="0"/>
        <GradientStop Color="#FA0D2030" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AtlasV2.Overlay.CardHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FA21465F" Offset="0"/>
        <GradientStop Color="#FE132C41" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AtlasV2.Overlay.Edge" Color="#6375ACD0"/>
    <SolidColorBrush x:Key="AtlasV2.Overlay.CardEdge" Color="#3F72A2C3"/>
    <SolidColorBrush x:Key="AtlasV2.Overlay.Field" Color="#F7081521"/>
    <SolidColorBrush x:Key="AtlasV2.Overlay.Divider" Color="#3F6A99BA"/>
    <SolidColorBrush x:Key="AtlasV2.Overlay.Text" Color="#EDF5FC"/>
    <SolidColorBrush x:Key="AtlasV2.Overlay.Muted" Color="#ADC2D5"/>
    <LinearGradientBrush x:Key="AtlasV2.Overlay.Gold" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFEFCA67" Offset="0"/>
        <GradientStop Color="#FFD8AA3E" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="AtlasV2.Overlay.Eyebrow" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.Eyebrow}">
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#77D6F6"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="AtlasV2.Overlay.Title" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.SectionTitle}">
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Overlay.Text}"/>
        <Setter Property="FontSize" Value="28"/>
    </Style>
    <Style x:Key="AtlasV2.Overlay.Section" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.SectionTitle}">
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Overlay.Text}"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <Style x:Key="AtlasV2.Overlay.Button" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="{StaticResource AtlasV2.Overlay.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Overlay.CardEdge}"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Overlay.Text}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" CornerRadius="10" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Overlay.CardHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FF24435B"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AtlasV2.Overlay.IconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Overlay.Button}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="9"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="#B9D9ED"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Overlay.CardHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AtlasV2.Overlay.CompactButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Overlay.Button}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="AtlasV2.Overlay.PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Overlay.Button}">
        <Setter Property="Background" Value="{StaticResource AtlasV2.Overlay.Gold}"/>
        <Setter Property="BorderBrush" Value="#F3CD70"/>
        <Setter Property="Foreground" Value="#07131F"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFF0CE78"/>
                <Setter Property="BorderBrush" Value="#FFFFE3A0"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FFD5AB45"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AtlasV2.Overlay.FriendHitTarget" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
