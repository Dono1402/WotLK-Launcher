<UserControl x:Class="WotLK.Launcher.UI.V2.Views.ShopViewV2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WotLK.Launcher.UI.V2.Views"
             xmlns:localization="clr-namespace:WotLK.Launcher.UI.V2.Localization"
             localization:LauncherLocalizationOptions.IsUserText="True"
             FontFamily="{StaticResource AtlasV2.Font.Inter}" TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" Background="Transparent" Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/AtlasV2.Shop.xaml"/></ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ShopChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
            <Style x:Key="ServiceCardButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.GlassSurface}"/><Setter Property="Foreground" Value="#F7FAFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GlassBorder}"/><Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="CardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" ClipToBounds="True">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="Background" Value="{StaticResource AtlasV2.Brush.GlassRaised}"/><Setter TargetName="CardBorder" Property="BorderBrush" Value="#76ACCB"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#EDCC82"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers>
            <DataTrigger Binding="{Binding IsConversionOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding IsServiceOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding IsWalletOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers></Style></ScrollViewer.Style>
        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/></ScrollViewer.Resources>
        <Grid x:Name="ContentFrame" Margin="64,6,64,24" MaxWidth="1440">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20">
                <Grid x:Name="CatalogueHeader">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><Border Width="34" Height="2" Background="{StaticResource AtlasV2.Brush.Cyan}" Margin="0,0,20,0"/><TextBlock Text="ATLAS LAUNCHER" Style="{StaticResource AtlasV2.Text.Eyebrow}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.Cyan}"/></StackPanel>
                        <TextBlock x:Name="PageTitle" Text="{Binding PageHeading}" Style="{StaticResource AtlasV2.Text.Hero}" FontSize="48" Foreground="{StaticResource AtlasV2.Brush.TitleIce}"/>
                        <TextBlock x:Name="PageDescription" Text="{Binding Subtitle}" Style="{StaticResource AtlasV2.Text.Body}" FontSize="14" Margin="0,0,0,20"/>
                        <TextBlock Text="{Binding ServicesHeading}" Style="{StaticResource ShopHeading}" FontSize="20"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Border x:Name="ConversionBanner">
                            <Button x:Name="MoreConversionButton" Style="{StaticResource ShopAction}" Height="72" Width="280" Padding="12,0" Click="Credits_Click" AutomationProperties.Name="{Binding ConversionHeading}" ToolTip="{Binding ConversionHeading}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Image x:Name="ConversionCoins" Source="/WotLK.Launcher;component/Assets/Shop/Conversion_or_transparent.png" Width="92" Height="56" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding ConversionShortcutLabel}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.TitlePearl}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" ToolTip="{Binding ConversionRateDescription}" AutomationProperties.Name="{Binding ConversionRateDescription}">
                                            <TextBlock x:Name="ShortcutRateNumber" Text="{Binding ConversionRateNumber}" FontSize="12" Foreground="{StaticResource ShopGold}" VerticalAlignment="Center"/>
                                            <Image x:Name="ShortcutGoldCoin" Source="{StaticResource ShopGoldCoin}" Width="15" Height="15" Margin="4,0,5,0" AutomationProperties.Name="{Binding ConversionGoldUnitLabel}"/>
                                            <TextBlock Text="{Binding ConversionRateValue}" FontSize="12" Foreground="{StaticResource ShopGold}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>
                        <Button x:Name="RefreshButton" Style="{StaticResource ShopAction}" Width="32" Height="32" Padding="7" Margin="14,0,0,0" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click" ToolTip="{Binding RefreshLabel}" AutomationProperties.Name="{Binding RefreshLabel}"><Path Data="{StaticResource AtlasV2.Icon.Refresh}" Style="{StaticResource ShopIcon}" Width="16" Height="16"/></Button>
                    </StackPanel>
                </Grid>
                <ProgressBar Height="3" Margin="0,10,0,0" IsIndeterminate="True" Style="{StaticResource AtlasV2.Progress.Compact}" Visibility="{Binding IsLoading, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                <Border Background="#DA071925" CornerRadius="6" Padding="14" Margin="0,12,0,0" Visibility="{Binding ShowStatus, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"><TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource ShopBody}"/></Border>
            </StackPanel>
            <ItemsControl x:Name="ProductList" Grid.Row="1" ItemsSource="{Binding Offers}" Margin="0,0,-18,0" AutomationProperties.Name="{Binding CategoryLabel}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Button Style="{StaticResource ServiceCardButton}" Margin="0,0,18,18" Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=views:ShopViewV2}}" Click="Service_Click" AutomationProperties.Name="{Binding Name}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="168"/></Grid.RowDefinitions>
                            <Border Height="{Binding CardImageHeight, RelativeSource={RelativeSource AncestorType=views:ShopViewV2}}" CornerRadius="13,13,0,0" RenderOptions.BitmapScalingMode="HighQuality"><Border.Background><ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill"/></Border.Background></Border>
                            <Border Grid.Row="1" Height="1" Background="{StaticResource AtlasV2.Brush.GlassHighlight}" VerticalAlignment="Top"/>
                            <Grid Grid.Row="1" Margin="16,14,16,14">
                                <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="54"/><RowDefinition Height="24"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal"><Image Source="/WotLK.Launcher;component/Assets/Shop/Logo_Atlas_transparent.png" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="{Binding Realm}" FontSize="10" FontWeight="SemiBold" Foreground="#9FBBD0" VerticalAlignment="Center"/></StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap" FontSize="20" FontWeight="Bold" LineHeight="24" Foreground="{StaticResource AtlasV2.Brush.TitlePearl}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" Text="{Binding Category}" Foreground="#AACCE3" FontSize="13" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="3" Text="{Binding DisplayPrice}" TextWrapping="Wrap" LineHeight="21" Foreground="#EAD391" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </ScrollViewer>
    <ScrollViewer x:Name="ServiceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsServiceOpen, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/></ScrollViewer.Resources>
        <Grid x:Name="ServiceFrame" Margin="60,18,60,30" MaxWidth="1500">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Button x:Name="ServiceBackButton" Style="{StaticResource ShopAction}" Content="{Binding BackToShopLabel}" Click="ServiceBack_Click" HorizontalAlignment="Left" Background="#99142432" Margin="0,0,0,26"/>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition x:Name="DetailColumn" Width="400"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding OfferName}" Style="{StaticResource ShopHeading}" FontSize="36" Margin="0,0,0,20"/>
                    <Image Source="{Binding OfferArtwork}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" MaxHeight="390" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding OfferDescription}" Style="{StaticResource ShopBody}" FontSize="18" LineHeight="28" Margin="0,24,0,24"/>
                    <TextBlock Text="{Binding ConditionsLabel}" Style="{StaticResource ShopHeading}" FontSize="22" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding OfferConditions}" Style="{StaticResource ShopBody}" FontSize="15" LineHeight="24"/>
                </StackPanel>
                <Border x:Name="DetailsPanel" Grid.Column="2" Style="{StaticResource ShopPanel}" Padding="22,17,22,15" VerticalAlignment="Top" >
                    <StackPanel>
                        <Grid Margin="-8,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Fill="#65134160" Width="48" Height="48"/><Path Data="{StaticResource AtlasV2.Icon.User}" Style="{StaticResource ShopIcon}" Width="28" Height="32" Stroke="#87D9FF"/>
                            <StackPanel Grid.Column="1" Margin="13,0,0,0"><TextBlock Text="{Binding SelectionHeading}" Style="{StaticResource ShopEyebrow}" LineHeight="18"/><TextBlock Text="{Binding OfferName}" Style="{StaticResource ShopHeading}" FontSize="21" LineHeight="26" Margin="0,4,0,0"/></StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding BeneficiaryLabel}" Style="{StaticResource ShopBody}" Foreground="#E9F3FF" FontSize="14" Margin="0,13,0,7"/>
                        <ComboBox x:Name="CharacterPicker" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}" ItemTemplate="{StaticResource ShopChoice}" Style="{StaticResource ShopField}" IsEnabled="{Binding HasCharacters}" AutomationProperties.Name="{Binding BeneficiaryLabel}"/>
                        <TextBlock Text="{Binding CharacterHint}" Style="{StaticResource ShopCaption}" Margin="0,8,0,0"/>
                        <StackPanel Visibility="{Binding HasPrices, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                        <TextBlock Text="{Binding PaymentLabel}" Style="{StaticResource ShopBody}" Foreground="#E9F3FF" FontSize="14" Margin="0,14,0,6"/>
                        <ComboBox x:Name="CurrencyPicker" ItemsSource="{Binding Prices}" SelectedItem="{Binding SelectedPrice, Mode=TwoWay}" ItemTemplate="{StaticResource ShopChoice}" Style="{StaticResource ShopField}" IsEnabled="{Binding HasPrices}" AutomationProperties.Name="{Binding PaymentLabel}"/>
                        <TextBlock Text="{Binding PaymentHint}" Style="{StaticResource ShopCaption}" MinHeight="30" Margin="0,6,0,11"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PriceLabel}" FontSize="21" FontWeight="SemiBold" Foreground="#F1DFB9" Margin="0,22,0,20">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasPrices}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#294C64" Background="#6501101B" Padding="17,12,17,10" ToolTip="{Binding OfferConditions}" ToolTipService.ShowDuration="30000">
                            <StackPanel><TextBlock Text="{Binding RecapHeading}" Style="{StaticResource ShopBody}" FontWeight="SemiBold" Margin="0,0,0,11"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding OfferName}" Style="{StaticResource ShopBody}" FontSize="14"/><TextBlock Grid.Column="1" Text="{Binding SelectedAmount}" Style="{StaticResource ShopBody}" FontSize="14" Margin="8,0,0,0"/></Grid>
                                <TextBlock x:Name="SummaryText" Text="{Binding SummaryCharacter}" Style="{StaticResource ShopBody}" FontSize="14" Margin="0,2,0,0"/>
                                <Border Height="1" Background="#284356" Margin="0,8,0,9"/>
                                <Grid><TextBlock Text="{Binding TotalLabel}" Style="{StaticResource ShopBody}" Foreground="#EFF5FF"/><TextBlock Text="{Binding SelectedAmount}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource ShopGold}" HorizontalAlignment="Right"/></Grid>
                            </StackPanel>
                        </Border>
                        <Button x:Name="PurchaseButton" Style="{StaticResource ShopAction}" IsEnabled="{Binding CanPurchase}" Margin="0,11,0,8" Background="#AA705E2D" BorderBrush="#B59A54" Foreground="#FFF0CE"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ShopIcon.Lock}" Style="{StaticResource ShopIcon}" Width="17" Height="19" Stroke="#EBD194"/><TextBlock Text="{Binding SoonLabel}" Margin="15,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <TextBlock Text="{Binding PurchaseHint}" Style="{StaticResource ShopCaption}"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </ScrollViewer>
    <views:ShopConversionViewV2 x:Name="ConversionView"/>
    <views:ShopWalletViewV2 x:Name="WalletView"/>
    </Grid>
</UserControl>
