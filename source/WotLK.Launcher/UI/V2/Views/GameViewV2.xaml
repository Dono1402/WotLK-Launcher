<UserControl x:Class="WotLK.Launcher.UI.V2.Views.GameViewV2"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:presentation="clr-namespace:WotLK.Launcher.UI.V2.Presentation"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="796"
             Background="{StaticResource AtlasV2.Brush.Window}"
             FontFamily="{StaticResource AtlasV2.Font.Manrope}"
             Focusable="False"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <ScrollViewer x:Name="GameScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  PanningMode="VerticalOnly">
        <Border x:Name="ContentFrame"
                MaxWidth="1600"
                Margin="34,26,34,34"
                HorizontalAlignment="Stretch">
            <StackPanel DataContext="{Binding State, ElementName=Root}">
                <Border x:Name="HeroCard"
                        Height="300"
                        Margin="0,0,0,24"
                        Background="#10161D"
                        BorderBrush="{StaticResource AtlasV2.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <Image Source="/WotLK.Launcher;component/Assets/Images/ArthasIcecrownHero.png"
                               Width="780"
                               HorizontalAlignment="Right"
                               Stretch="UniformToFill"
                               Opacity="0.83"/>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Offset="0" Color="#FF0D1218"/>
                                    <GradientStop Offset="0.46" Color="#F20D1218"/>
                                    <GradientStop Offset="0.72" Color="#9410171F"/>
                                    <GradientStop Offset="1" Color="#180B0F14"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Border x:Name="HeroCopyPanel"
                                Padding="44,32"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center" MaxWidth="620">
                                <TextBlock Text="{Binding RealmLabel}"
                                           Style="{StaticResource AtlasV2.Text.Eyebrow}"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="HeroTitle"
                                           Text="{Binding Title}"
                                           Style="{StaticResource AtlasV2.Text.Hero}"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Subtitle}"
                                           Style="{StaticResource AtlasV2.Text.Body}"
                                           FontSize="17"
                                           Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"
                                           Margin="0,0,0,18"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Style="{StaticResource AtlasV2.StatusChip}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7"
                                                     Margin="0,0,7,0"
                                                     Fill="{StaticResource AtlasV2.Brush.Success}"/>
                                            <TextBlock Text="{Binding RealmStatus}"
                                                       Style="{StaticResource AtlasV2.Text.Caption}"
                                                       Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource AtlasV2.StatusChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="10" Height="10"
                                                  Margin="0,0,7,0"
                                                  Data="{StaticResource AtlasV2.Icon.Check}"
                                                  Stroke="{StaticResource AtlasV2.Brush.Cyan}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Stretch="Uniform"/>
                                            <TextBlock Text="{Binding ClientStatus}"
                                                       Style="{StaticResource AtlasV2.Text.Caption}"
                                                       Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource AtlasV2.Button.Primary}"
                                            Margin="0,0,10,0"
                                            AutomationProperties.Name="Jouer">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="16" Height="16"
                                                  Margin="0,0,9,0"
                                                  Data="{StaticResource AtlasV2.Icon.Play}"
                                                  Fill="#111318"
                                                  Stretch="Uniform"/>
                                            <TextBlock Text="JOUER" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource AtlasV2.Button.Secondary}"
                                            AutomationProperties.Name="Options">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="16" Height="16"
                                                  Margin="0,0,9,0"
                                                  Data="{StaticResource AtlasV2.Icon.Sliders}"
                                                  Stroke="{StaticResource AtlasV2.Brush.TextSecondary}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform"/>
                                            <TextBlock Text="OPTIONS" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Padding="11,7"
                                Margin="0,0,20,18"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="#B20B1016"
                                BorderBrush="#385165"
                                BorderThickness="1"
                                CornerRadius="5">
                            <TextBlock Style="{StaticResource AtlasV2.Text.Caption}">
                                <Run Text="CLIENT "/>
                                <Run Text="{Binding ClientVersion}" Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <Grid x:Name="CardsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NewsColumn" Width="2*"/>
                        <ColumnDefinition x:Name="CardGapColumn" Width="24"/>
                        <ColumnDefinition x:Name="InstallColumn" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="FirstCardRow" Height="Auto"/>
                        <RowDefinition x:Name="CardGapRow" Height="0"/>
                        <RowDefinition x:Name="SecondCardRow" Height="0"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="NewsCard"
                            Grid.Row="0"
                            Grid.Column="0"
                            MinHeight="228"
                            Style="{StaticResource AtlasV2.Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,17">
                                <TextBlock Text="{Binding NewsCategory}"
                                           Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                                <TextBlock Text="{Binding NewsVersion}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource AtlasV2.Text.Caption}"
                                           Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding NewsTitle}"
                                       Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                       Margin="0,0,0,9"/>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding NewsSummary}"
                                       Style="{StaticResource AtlasV2.Text.Body}"
                                       MaxWidth="760"
                                       HorizontalAlignment="Left"/>
                            <Grid Grid.Row="3" Margin="0,20,0,0">
                                <TextBlock Text="{Binding NewsDate}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource AtlasV2.Text.Caption}"/>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <TextBlock Text="Lire le patch note"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource AtlasV2.Text.Body}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                    <Path Width="15" Height="15"
                                          Margin="8,0,0,0"
                                          Data="{StaticResource AtlasV2.Icon.ArrowRight}"
                                          Stroke="{StaticResource AtlasV2.Brush.Gold}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="InstallCard"
                            Grid.Row="0"
                            Grid.Column="2"
                            MinHeight="228"
                            Style="{StaticResource AtlasV2.Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="Installation"
                                           Style="{StaticResource AtlasV2.Text.SectionTitle}"/>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7"
                                             Margin="0,0,7,0"
                                             Fill="{StaticResource AtlasV2.Brush.Success}"/>
                                    <TextBlock Text="Prêt"
                                               Style="{StaticResource AtlasV2.Text.Caption}"
                                               Foreground="{StaticResource AtlasV2.Brush.Success}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,0,0,13">
                                <Path Width="17" Height="17"
                                      HorizontalAlignment="Left"
                                      Data="{StaticResource AtlasV2.Icon.Folder}"
                                      Stroke="{StaticResource AtlasV2.Brush.Gold}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"/>
                                <TextBlock Margin="28,0,0,0"
                                           Text="{Binding InstallPath}"
                                           Style="{StaticResource AtlasV2.Text.Body}"
                                           Foreground="{StaticResource AtlasV2.Brush.Text}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <Border Grid.Row="2" Height="1" Margin="0,0,0,13"
                                    Background="{StaticResource AtlasV2.Brush.BorderSoft}"/>
                            <Grid Grid.Row="3">
                                <TextBlock Text="Version du client"
                                           Style="{StaticResource AtlasV2.Text.Caption}"/>
                                <TextBlock Text="{Binding ClientVersion}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource AtlasV2.Text.Body}"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                            </Grid>
                            <Grid Grid.Row="4" Margin="0,10,0,0">
                                <TextBlock Text="Langue"
                                           Style="{StaticResource AtlasV2.Text.Caption}"/>
                                <TextBlock Text="{Binding Language}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource AtlasV2.Text.Body}"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                <Border Height="3"
                                        Margin="0,38,0,0"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource AtlasV2.Brush.BorderSoft}"
                                        CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsClientReady}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
