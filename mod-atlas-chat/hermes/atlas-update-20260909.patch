@@ -0,0 +1,257 @@
+using System;
+using System.IO;
+using System.Net;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Threading;
+using System.Threading.Tasks;
+using BNetServer.Networking;
+using Framework.Constants;
+using Framework.Logging;
+using Framework.Util;
+using HermesProxy;
+using HermesProxy.Auth;
+using HermesProxy.Configuration.Options;
+using HermesProxy.World.Server;
+using Microsoft.Extensions.Hosting;
+using Microsoft.Extensions.Options;
+
+namespace BNetServer.Auth;
+
+public sealed class LauncherTicketHostedService : BackgroundService
+{
+    private const string SharedSecretHeader = "X-Atlas-Internal-Secret";
+    private const int MaxRequestBytes = 16 * 1024;
+
+    private readonly AzerothCoreBridge _bridge;
+    private readonly IOptionsMonitor<ClientOptions> _clientOptions;
+    private readonly IOptionsMonitor<LegacyServerOptions> _legacyServerOptions;
+    private readonly IOptionsMonitor<ProxyNetworkOptions> _networkOptions;
+    private readonly IOptionsMonitor<DiagnosticsOptions> _diagnosticsOptions;
+    private readonly IOptionsMonitor<ThrottlingOptions> _throttlingOptions;
+    private readonly IOptionsMonitor<AzerothCoreBridgeOptions> _bridgeOptions;
+    private HttpListener? _listener;
+
+    public LauncherTicketHostedService(
+        AzerothCoreBridge bridge,
+        IOptionsMonitor<ClientOptions> clientOptions,
+        IOptionsMonitor<LegacyServerOptions> legacyServerOptions,
+        IOptionsMonitor<ProxyNetworkOptions> networkOptions,
+        IOptionsMonitor<DiagnosticsOptions> diagnosticsOptions,
+        IOptionsMonitor<ThrottlingOptions> throttlingOptions,
+        IOptionsMonitor<AzerothCoreBridgeOptions> bridgeOptions)
+    {
+        _bridge = bridge;
+        _clientOptions = clientOptions;
+        _legacyServerOptions = legacyServerOptions;
+        _networkOptions = networkOptions;
+        _diagnosticsOptions = diagnosticsOptions;
+        _throttlingOptions = throttlingOptions;
+        _bridgeOptions = bridgeOptions;
+    }
+
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        AzerothCoreBridgeOptions options = _bridgeOptions.CurrentValue;
+        if (!options.Enabled || string.IsNullOrWhiteSpace(options.InternalTicketSharedSecret))
+        {
+            Log.Print(
+                LogType.Server,
+                "Launcher ticket endpoint disabled: no internal shared secret configured.");
+            return;
+        }
+
+        _listener = new HttpListener();
+        _listener.Prefixes.Add(
+            $"http://127.0.0.1:{options.InternalTicketPort}/internal/launcher-ticket/");
+        _listener.Start();
+        Log.Print(
+            LogType.Server,
+            $"Launcher ticket endpoint listening on 127.0.0.1:{options.InternalTicketPort}.");
+
+        try
+        {
+            while (!stoppingToken.IsCancellationRequested)
+            {
+                HttpListenerContext context =
+                    await _listener.GetContextAsync().WaitAsync(stoppingToken);
+                await HandleAsync(context, stoppingToken);
+            }
+        }
+        catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested)
+        {
+        }
+        finally
+        {
+            _listener.Close();
+        }
+    }
+
+    public override Task StopAsync(CancellationToken cancellationToken)
+    {
+        _listener?.Close();
+        return base.StopAsync(cancellationToken);
+    }
+
+    private async Task HandleAsync(
+        HttpListenerContext context,
+        CancellationToken cancellationToken)
+    {
+        try
+        {
+            if (context.Request.HttpMethod != "POST")
+            {
+                await WriteJsonAsync(context.Response, 405, new { error = "method_not_allowed" });
+                return;
+            }
+
+            if (!IsAuthorized(context.Request.Headers[SharedSecretHeader]))
+            {
+                await WriteJsonAsync(context.Response, 401, new { error = "unauthorized" });
+                return;
+            }
+
+            if (context.Request.ContentLength64 == 0
+                || context.Request.ContentLength64 > MaxRequestBytes)
+            {
+                await WriteJsonAsync(context.Response, 400, new { error = "invalid_request_size" });
+                return;
+            }
+
+            using StreamReader reader = new(
+                context.Request.InputStream,
+                context.Request.ContentEncoding ?? Encoding.UTF8,
+                detectEncodingFromByteOrderMarks: false,
+                leaveOpen: true);
+            string json = await reader.ReadToEndAsync(cancellationToken);
+            if (string.IsNullOrWhiteSpace(json)
+                || Encoding.UTF8.GetByteCount(json) > MaxRequestBytes)
+            {
+                await WriteJsonAsync(context.Response, 400, new { error = "invalid_request_size" });
+                return;
+            }
+
+            LauncherTicketRequest? request = JsonSerializer.Deserialize<LauncherTicketRequest>(
+                json,
+                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
+            if (request is null || string.IsNullOrWhiteSpace(request.Username))
+            {
+                await WriteJsonAsync(context.Response, 400, new { error = "invalid_request" });
+                return;
+            }
+
+            if (request.Revoke)
+            {
+                int revoked =
+                    BnetSessionTicketStorage.RevokeTicketsForUsername(request.Username);
+                Log.Print(
+                    LogType.Network,
+                    $"Launcher tickets revoked for '{request.Username}' (count={revoked}).");
+                await WriteJsonAsync(context.Response, 200, new { revoked });
+                return;
+            }
+
+            if (string.IsNullOrWhiteSpace(request.Ticket)
+                || (!request.Ticket.StartsWith("HP-", StringComparison.Ordinal)
+                    && !request.Ticket.StartsWith("ATL-", StringComparison.Ordinal))
+                || request.Ticket.Length > 128)
+            {
+                await WriteJsonAsync(context.Response, 400, new { error = "invalid_ticket" });
+                return;
+            }
+
+            string ticket = request.Ticket;
+            Locale locale = Enum.TryParse(request.Locale, ignoreCase: false, out Locale parsed)
+                && LocaleChecker.IsValidLocale(parsed)
+                    ? parsed
+                    : Locale.frFR;
+            byte[] legacySessionKey = RandomNumberGenerator.GetBytes(40);
+            AccountBridgeInfo? account = await _bridge.PrepareLegacySessionAsync(
+                request.Username,
+                legacySessionKey,
+                locale);
+            if (account is null)
+            {
+                await WriteJsonAsync(context.Response, 404, new { error = "account_not_found" });
+                return;
+            }
+
+            GlobalSessionData globalSession = new(
+                _clientOptions.CurrentValue,
+                _legacyServerOptions.CurrentValue,
+                _networkOptions.CurrentValue,
+                _diagnosticsOptions.CurrentValue,
+                _throttlingOptions.CurrentValue);
+            globalSession.AuthClient = new AuthClient(globalSession);
+            globalSession.AuthClient.AdoptExternalSession(account.Username, legacySessionKey);
+            globalSession.RealmManager.UpdateRealms(await _bridge.LoadRealmsAsync());
+            globalSession.LoginTicket = ticket;
+            globalSession.Username = account.Username;
+            globalSession.AccountInfo = new AccountInfo(account.AccountId, account.Username);
+            uint expiry = checked((uint)(
+                Time.UnixTime + _bridgeOptions.CurrentValue.LoginTicketDurationSeconds));
+            globalSession.AccountInfo.LoginTicketExpiry = expiry;
+            globalSession.AccountMetaDataMgr = new AccountMetaDataManager(account.Username);
+
+            BnetSessionTicketStorage.AddNewSession(
+                account.Username,
+                ticket,
+                globalSession);
+            Log.Print(
+                LogType.Network,
+                $"Launcher ticket registered for '{account.Username}' "
+                + $"(format={ticket[..ticket.IndexOf('-')]}, "
+                + $"length={ticket.Length}, expires={expiry}).");
+
+            await WriteJsonAsync(
+                context.Response,
+                200,
+                new { expiresAt = DateTimeOffset.FromUnixTimeSeconds(expiry) });
+        }
+        catch (Exception exception)
+        {
+            Log.outException(exception);
+            await WriteJsonAsync(context.Response, 500, new { error = "internal_error" });
+        }
+    }
+
+    private bool IsAuthorized(string? providedSecret)
+    {
+        string expectedSecret = _bridgeOptions.CurrentValue.InternalTicketSharedSecret;
+        if (string.IsNullOrEmpty(providedSecret) || string.IsNullOrEmpty(expectedSecret))
+            return false;
+
+        byte[] provided = SHA256.HashData(Encoding.UTF8.GetBytes(providedSecret));
+        byte[] expected = SHA256.HashData(Encoding.UTF8.GetBytes(expectedSecret));
+        return CryptographicOperations.FixedTimeEquals(provided, expected);
+    }
+
+    private static async Task WriteJsonAsync(
+        HttpListenerResponse response,
+        int statusCode,
+        object body)
+    {
+        try
+        {
+            byte[] payload = JsonSerializer.SerializeToUtf8Bytes(body);
+            response.StatusCode = statusCode;
+            response.ContentType = "application/json; charset=utf-8";
+            response.ContentLength64 = payload.Length;
+            await response.OutputStream.WriteAsync(payload);
+            response.Close();
+        }
+        catch (ObjectDisposedException)
+        {
+        }
+        catch (HttpListenerException)
+        {
+        }
+    }
+
+    private sealed record LauncherTicketRequest(
+        string Username,
+        string? Ticket,
+        string? Locale,
+        bool Revoke = false);
+}
