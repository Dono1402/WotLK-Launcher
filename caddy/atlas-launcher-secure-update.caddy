# Import this file inside the animeclub.fr site block before /wotlk/*.
@atlas_launcher_update_manifest path /wotlk/launcher/launcher-update.json
handle @atlas_launcher_update_manifest {
	header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	header Pragma "no-cache"
	header X-Content-Type-Options "nosniff"
	root * /var/www/wotlk-launcher/launcher
	uri strip_prefix /wotlk/launcher
	file_server
}

@atlas_launcher_update_release path_regexp atlas_launcher_update_release ^/wotlk/launcher/releases/[0-9]{1,5}(\.[0-9]{1,5}){1,3}/WotLK-Launcher(-Installer)?\.exe$
handle @atlas_launcher_update_release {
	header Cache-Control "public, max-age=31536000, immutable"
	header X-Content-Type-Options "nosniff"
	root * /var/www/wotlk-launcher/launcher
	uri strip_prefix /wotlk/launcher
	file_server
}
