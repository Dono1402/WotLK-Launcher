<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <Style x:Key="AtlasV2.FocusVisual.Button">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="2"
                            BorderBrush="{StaticResource AtlasV2.Brush.Cyan}"
                            BorderThickness="2"
                            CornerRadius="5"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.FocusVisual.Field">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-12,-8"
                            BorderBrush="{StaticResource AtlasV2.Brush.Cyan}"
                            BorderThickness="2"
                            CornerRadius="6"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.Button.Base" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Manrope}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.64"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="Height" Value="52"/>
        <Setter Property="MinWidth" Value="170"/>
        <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.Gold}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Gold}"/>
        <Setter Property="Foreground" Value="#111318"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.GoldHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GoldHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.GoldPressed}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GoldPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#75643E"/>
                <Setter Property="BorderBrush" Value="#8A7547"/>
                <Setter Property="Foreground" Value="#D8D2C4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.Button.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="Height" Value="52"/>
        <Setter Property="Background" Value="#D9141A20"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfaceHover}"/>
                <Setter Property="BorderBrush" Value="#536170"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfacePressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.Button.Icon" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfaceHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Border}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfacePressed}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfaceRaised}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GoldBorder}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.Button.TopBarIcon" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Icon}">
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#181F28"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#222B35"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.Button.GhostCompact" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.BorderSoft}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfaceHover}"/>
                <Setter Property="BorderBrush" Value="#4A5867"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfacePressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.Button.Window" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Icon}">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Padding" Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>

    <Style x:Key="AtlasV2.Button.WindowClose" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Window}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#B93643"/>
                <Setter Property="BorderBrush" Value="#B93643"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#962B36"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.Button.Nav" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="Height" Value="64"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="NavSurface" Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <Border x:Name="Indicator"
                                Height="2"
                                Margin="12,0"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource AtlasV2.Brush.Gold}"
                                Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
                            <Setter TargetName="NavSurface" Property="Background" Value="#121820"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
                            <Setter TargetName="NavSurface" Property="Background" Value="#171E26"/>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.Button.Segment" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfaceHover}"/>
                <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfaceRaised}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Border}"/>
                <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.Toggle" TargetType="{x:Type primitives:ToggleButton}">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type primitives:ToggleButton}">
                    <Grid Width="44" Height="24">
                        <Border x:Name="Track"
                                Background="{StaticResource AtlasV2.Brush.Field}"
                                BorderBrush="{StaticResource AtlasV2.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12"/>
                        <Ellipse x:Name="Thumb"
                                 Width="18"
                                 Height="18"
                                 Margin="3"
                                 HorizontalAlignment="Left"
                                 Fill="{StaticResource AtlasV2.Brush.TextMuted}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbTranslate"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="#111318"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                         Storyboard.TargetProperty="X"
                                                         To="20"
                                                         Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Track"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.86"
                                                         Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Track"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.Toggle.ReadOnly"
           TargetType="{x:Type primitives:ToggleButton}"
           BasedOn="{StaticResource AtlasV2.Toggle}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="AtlasV2.Field.Container" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Gold}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AtlasV2.ComboBoxItem.Field" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
        <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfaceRaised}"/>
        <Setter Property="Padding" Value="13,10"/>
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Manrope}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemSurface" Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface"
                                    Property="Background"
                                    Value="{StaticResource AtlasV2.Brush.SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemSurface"
                                    Property="Background"
                                    Value="{StaticResource AtlasV2.Brush.Field}"/>
                            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Gold}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.ComboBox.Field" TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Manrope}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource AtlasV2.ComboBoxItem.Field}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Field}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="ComboSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"/>
                        <primitives:ToggleButton Background="Transparent"
                                                 BorderThickness="0"
                                                 ClickMode="Press"
                                                 Focusable="False"
                                                 IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <primitives:ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type primitives:ToggleButton}">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </primitives:ToggleButton.Template>
                        </primitives:ToggleButton>
                        <ContentPresenter Margin="13,0,40,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False"/>
                        <Path Width="14"
                              Height="14"
                              Margin="0,0,13,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Data="{StaticResource AtlasV2.Icon.ChevronDown}"
                              Stroke="{StaticResource AtlasV2.Brush.Gold}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"
                              IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,5,0,0"
                                    Background="{StaticResource AtlasV2.Brush.SurfaceRaised}"
                                    BorderBrush="{StaticResource AtlasV2.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <ScrollViewer CanContentScroll="True" MaxHeight="180">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboSurface"
                                    Property="BorderBrush"
                                    Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboSurface"
                                    Property="BorderBrush"
                                    Value="{StaticResource AtlasV2.Brush.Gold}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.TextBox.Field" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Manrope}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Field}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  VerticalAlignment="Center"
                                  Focusable="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.PasswordBox.Field" TargetType="{x:Type PasswordBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Manrope}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Field}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  VerticalAlignment="Center"
                                  Focusable="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.Banner.Warning" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="13,11"/>
        <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.GoldSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GoldBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style x:Key="AtlasV2.Banner.Error" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="13,11"/>
        <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.DangerSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.DangerBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style x:Key="AtlasV2.Progress.Compact" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
        <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.BorderSoft}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid Height="{TemplateBinding Height}"
                          ClipToBounds="True">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"/>
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3"/>
                        <Border x:Name="IndeterminateSegment"
                                Width="62"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3"
                                Opacity="0.9"
                                Visibility="Collapsed">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="White" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="IndeterminateTransform" X="-62"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IndeterminateSegment" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="IndeterminateTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="-62"
                                                         To="390"
                                                         Duration="0:0:1.35"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="IndeterminateStoryboard"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="22"/>
    </Style>

    <Style x:Key="AtlasV2.StatusChip" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#B312171D"/>
        <Setter Property="BorderBrush" Value="#44515E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style x:Key="AtlasV2.ScrollBar.Dark" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Width="6" Background="Transparent">
                        <primitives:Track x:Name="PART_Track"
                                          IsDirectionReversed="True"
                                          Focusable="False">
                            <primitives:Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False"
                                              Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </primitives:Track.DecreaseRepeatButton>
                            <primitives:Track.Thumb>
                                <Thumb MinHeight="30"
                                       Margin="0,2"
                                       Background="#3B4652">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbSurface"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbSurface" Property="Background" Value="#536170"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbSurface" Property="Background" Value="#637285"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </primitives:Track.Thumb>
                            <primitives:Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False"
                                              Opacity="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </primitives:Track.IncreaseRepeatButton>
                        </primitives:Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
