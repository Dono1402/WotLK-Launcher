<UserControl x:Class="WotLK.Launcher.UI.V2.Views.ArmoryViewV2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#101418">
    <Grid>
        <Grid x:Name="BrowserHost"/>
        <StackPanel x:Name="StatusPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24">
            <Grid x:Name="ProfileLoadingIndicator" Width="36" Height="36" HorizontalAlignment="Center"
                  Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.Name="Chargement du profil">
                <Ellipse Margin="3" Stroke="{StaticResource AtlasV2.Brush.Border}" StrokeThickness="2.5"/>
                <Path x:Name="ProfileLoadingArc" Data="M18,3 A15,15 0 1 1 3,18"
                      Stroke="{StaticResource AtlasV2.Brush.Gold}" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="ProfileLoadingAnimation">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:0.9"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="ProfileLoadingAnimation"/></Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
            <TextBlock x:Name="StatusText" Visibility="Collapsed" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource AtlasV2.Brush.TextSecondary}" FontSize="15"/>
            <Button x:Name="RetryButton" Visibility="Collapsed" Margin="0,18,0,0" HorizontalAlignment="Center"
                    Style="{StaticResource AtlasV2.Button.Secondary}" Content="Réessayer" Click="RetryButton_Click"/>
            <Button x:Name="CustomizeButton" Visibility="Collapsed" Margin="0,12,0,0" HorizontalAlignment="Center"
                    Style="{StaticResource AtlasV2.Button.Secondary}" Content="Personnaliser le profil" Click="CustomizeButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
