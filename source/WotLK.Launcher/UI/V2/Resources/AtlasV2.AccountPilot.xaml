<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="AtlasV2.Account.ModalSurface" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0A1927" Offset="0"/>
        <GradientStop Color="#FF142B3D" Offset="0.6"/>
        <GradientStop Color="#FF091723" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AtlasV2.Account.FieldSurface" Color="#C8061420"/>

    <Style x:Key="AtlasV2.Account.Text.Body" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TextSecondary}"/>
    </Style>
    <Style x:Key="AtlasV2.Account.Text.Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Account.Text.Body}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#B2C6D8"/>
    </Style>
    <Style x:Key="AtlasV2.Account.Text.Eyebrow" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Account.Text.Caption}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Cyan}"/>
    </Style>
    <Style x:Key="AtlasV2.Account.Text.Section" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AtlasV2.Account.Text.Body}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.TitlePearl}"/>
    </Style>
    <Style x:Key="AtlasV2.Account.Button.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Background" Value="#B20B2131"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GlassBorder}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#DB19374B"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#F20B1A29"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AtlasV2.Account.Button.Compact" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Account.Button.Secondary}">
        <Setter Property="Height" Value="38"/>
        <Setter Property="MinWidth" Value="92"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="AtlasV2.Account.Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Primary}">
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinWidth" Value="128"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="AtlasV2.Account.Tab" TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="MinWidth" Value="130"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#B8CCDD"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="7,7,0,0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="ActiveLine" Height="2" Background="{StaticResource AtlasV2.Brush.Cyan}" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabSurface" Property="Background" Value="#551A4058"/>
                            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="TabSurface" Property="Background" Value="#881D3B50"/>
                            <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AtlasV2.Account.Field" TargetType="{x:Type Border}" BasedOn="{StaticResource AtlasV2.Field.Container}">
        <Setter Property="Background" Value="{StaticResource AtlasV2.Account.FieldSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Brush.GlassBorder}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
</ResourceDictionary>
