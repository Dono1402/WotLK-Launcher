+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Framework.Constants;
+using HermesProxy.Enums;
+using HermesProxy.World.Enums;
+using HermesProxy.World.Server.Packets;
+
+namespace HermesProxy.World.Server;
+
+public partial class WorldSocket
+{
+    bool SupportsAtlasServices => ModernVersion.Build == ClientVersionBuild.V3_4_3_54261
+        && LegacyVersion.Build == ClientVersionBuild.V3_3_5a_12340;
+
+    void RequestAtlasAccountServices()
+    {
+        if (SupportsAtlasServices && GetSession().WorldClient?.IsConnected() == true
+            && GetSession().AtlasAccountServices.Subscribe(Environment.TickCount64) is { } request)
+            SendPacketToServer(request);
+    }
+
+    [PacketHandler(Opcode.CMSG_BATTLE_PAY_GET_PRODUCT_LIST)]
+    void HandleAtlasProducts(AtlasStoreEmptyRequest request)
+    {
+        if (!SupportsAtlasServices) return;
+        SendPacket(new AtlasEmptyProductList());
+        RequestAtlasAccountServices();
+    }
+    [PacketHandler(Opcode.CMSG_BATTLE_PAY_GET_PURCHASE_LIST)]
+    void HandleAtlasPurchases(AtlasStoreEmptyRequest request)
+    {
+        if (!SupportsAtlasServices) return;
+        SendPacket(new AtlasEmptyPurchaseList());
+        RequestAtlasAccountServices();
+    }
+    [PacketHandler(Opcode.CMSG_UPDATE_VAS_PURCHASE_STATES)]
+    void HandleAtlasVasStates(AtlasStoreEmptyRequest request)
+    {
+        if (!SupportsAtlasServices) return;
+        SendPacket(new AtlasEmptyVasStates());
+        RequestAtlasAccountServices();
+    }
+    [PacketHandler(Opcode.CMSG_GET_VAS_ACCOUNT_CHARACTER_LIST)]
+    void HandleAtlasVasCharacters(AtlasVasCharactersRequest request)
+    {
+        if (!SupportsAtlasServices) return;
+        var session = GetSession();
+        SendPacket(BuildAtlasVasCharacters(request.Token, request.WireServiceType, session.AtlasAccountServices.Ready,
+            session.GameState.OwnCharacters, WowGuid128.Create(HighGuidType703.WowAccount, session.GameAccountInfo.Id),
+            session.RealmId.GetAddress(), session.Realm?.Name));
+    }
+
+    internal static AtlasVasCharactersResult BuildAtlasVasCharacters(uint token, uint wireServiceType, bool ready,
+        IEnumerable<OwnCharacterInfo> characters, WowGuid128 accountId, uint realmAddress, string? realmName)
+    {
+        var response = new AtlasVasCharactersResult { Token = token };
+        if (wireServiceType != AtlasVasCharactersRequest.PaidNameChangeWireType || !ready || string.IsNullOrWhiteSpace(realmName)) response.Result = 1;
+        else foreach (var own in characters)
+            response.Characters.Add(new AccountCharacterListEntry {
+                AccountId = accountId, CharacterGuid = own.CharacterGuid, RealmVirtualAddress = realmAddress,
+                // The store selector groups characters by realm name; the normal character-list
+                // convention of an empty display realm must not be used for the VAS list.
+                RealmName = realmName, Name = own.Name ?? string.Empty, LastLoginUnixSec = own.LastLoginUnixSec,
+                Race = own.RaceId, Class = own.ClassId, Sex = own.SexId, Level = own.Level,
+            });
+        return response;
+    }
+    [PacketHandler(Opcode.CMSG_BATTLE_PAY_DISTRIBUTION_ASSIGN_VAS)]
+    void HandleAtlasAssignment(AtlasAssignNameChange request)
+    {
+        if (!SupportsAtlasServices) return;
+        var session = GetSession();
+        bool owns = session.GameState.OwnCharacters.Any(character => character.CharacterGuid == request.Character);
+        var packet = session.AtlasAccountServices.Assign(request, owns, session.RealmId.GetAddress(),
+            session.GameState.IsInWorld, Environment.TickCount64);
+        if (packet == null || session.WorldClient?.IsConnected() != true)
+            SendPacket(new AtlasAssignVasResponse { Token = request.Token, StoreError = 3 });
+        else SendPacketToServer(packet);
+    }
+}
