# Legacy mode requires schema 0012 and one character database worker.
# Native account services require schema 0013 and the verified core overlay;
# they support multiple character database workers.
# Both databases must use the same MySQL instance.
# Keep disabled until module/core integration has been verified on a test realm.
AtlasShop.Enable = 0
AtlasShop.AccountServices = 0
# Gold conversion additionally requires schema 0014. Rate: 100 gold = 1 Atlas euro.
AtlasShop.GoldConversion = 0
