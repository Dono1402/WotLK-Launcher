<UserControl x:Class="WotLK.Launcher.UI.V2.Views.AuthOverlayViewV2"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:presentation="clr-namespace:WotLK.Launcher.UI.V2.Presentation"
             mc:Ignorable="d"
             d:DesignWidth="1597.6"
             d:DesignHeight="996.8"
             Background="Transparent"
             Visibility="Collapsed"
             IsHitTestVisible="False"
             Focusable="False"
             PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/AtlasV2.OverlaysPilot.xaml"/>
                <ResourceDictionary Source="../Resources/AtlasV2.AccountPilot.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="AtlasV2.Auth.Field" TargetType="{x:Type Border}"
                   BasedOn="{StaticResource AtlasV2.Field.Container}">
                <Setter Property="Background" Value="#DB091723"/>
                <Setter Property="BorderBrush" Value="#354C5C"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Cursor" Value="IBeam"/>
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Field_PreviewMouseLeftButtonDown"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#7BDBF3"/>
                        <Setter Property="Background" Value="#102533"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AtlasV2.Auth.RegisterField" TargetType="{x:Type Border}"
                   BasedOn="{StaticResource AtlasV2.Auth.Field}">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Margin" Value="0,4,0,6"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CanClose, ElementName=Root}" Value="False">
                        <Setter Property="Height" Value="42"/>
                        <Setter Property="Margin" Value="0,6,0,8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AtlasV2.Auth.Button" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource AtlasV2.Button.Base}">
                <Setter Property="IsTabStop" Value="True"/>
                <Setter Property="Background" Value="#79D7ED"/>
                <Setter Property="BorderBrush" Value="#A7EEFF"/>
                <Setter Property="Foreground" Value="#071822"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#A4EAF8"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#55B9D3"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="White"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#183241"/>
                        <Setter Property="BorderBrush" Value="#344F60"/>
                        <Setter Property="Foreground" Value="#A4B9C6"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AtlasV2.Auth.Tab" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource AtlasV2.Auth.Button}">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="#C5D6E2"/>
                <Setter Property="FontSize" Value="13"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1B3546"/>
                        <Setter Property="Foreground" Value="#E8F6FF"/>
                    </Trigger>
                    <Trigger Property="Tag" Value="Active">
                        <Setter Property="Background" Value="#243E50"/>
                        <Setter Property="BorderBrush" Value="#3F5D70"/>
                        <Setter Property="Foreground" Value="#E8F6FF"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="#A7EEFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AtlasV2.Auth.Error" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFC6C6"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
                <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
                <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="AtlasV2.Auth.Eye" TargetType="Button" BasedOn="{StaticResource AtlasV2.Auth.Tab}">
                <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="8"/><Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="OverlayRoot">
        <!-- The artwork already includes the Atlas logo in its upper-left 40%. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="0.4*"/>
            <RowDefinition Height="0.6*"/>
        </Grid.RowDefinitions>
        <Border x:Name="Scrim"
                Grid.RowSpan="2"
                Opacity="0"
                IsHitTestVisible="False"
                MouseLeftButtonDown="Scrim_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{StaticResource AtlasV2.Brush.AuthScrim}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanClose, ElementName=Root}" Value="False">
                            <Setter Property="Background" Value="Transparent"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Border x:Name="AuthCard"
                Width="500"
                MaxWidth="500"
                Opacity="0"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Contained">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Grid.RowSpan" Value="2"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="28,28,28,30"/>
                    <Setter Property="Margin" Value="24,16"/>
                    <Setter Property="MaxHeight" Value="620"/>
                    <Setter Property="Background" Value="{StaticResource AtlasV2.Overlay.Panel}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Overlay.Edge}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="12"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanClose, ElementName=Root}" Value="False">
                            <Setter Property="Grid.Row" Value="1"/>
                            <Setter Property="Grid.RowSpan" Value="1"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="Margin" Value="64,0,24,20"/>
                            <Setter Property="Padding" Value="28,12,28,20"/>
                            <Setter Property="MaxHeight" Value="740"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="0.985" ScaleY="0.985"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="AuthBrandHeader" Grid.Row="0"
                      Visibility="{Binding CanClose, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,44,0">
                        <Image Width="40" Height="40" Margin="-4,0,14,0"
                               Source="/WotLK.Launcher;component/Assets/Branding/AtlasLauncherLogo.png"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ATLAS" Foreground="#EEF8FF" FontSize="27" FontWeight="ExtraBold"/>
                            <TextBlock Text="LAUNCHER" Foreground="#80B4C9" FontSize="10" FontWeight="Medium" Margin="1,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="CloseButton"
                            Width="38"
                            Height="38"
                            Padding="10"
                            HorizontalAlignment="Right"
                            Style="{StaticResource AtlasV2.Overlay.IconButton}"
                            ToolTip="Fermer"
                            KeyboardNavigation.TabIndex="20"
                            AutomationProperties.Name="Fermer l’authentification"
                            Visibility="{Binding CanClose, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                            Click="CloseButton_Click">
                        <Path Data="{StaticResource AtlasV2.Icon.Close}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                    </Button>
                </Grid>

                <ScrollViewer x:Name="AuthScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ScrollViewer.Style>
                        <Style TargetType="{x:Type ScrollViewer}">
                            <Setter Property="Margin" Value="0,8,0,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanClose, ElementName=Root}" Value="False">
                                    <Setter Property="Margin" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="{Binding State.Title, ElementName=Root}"
                                   Style="{StaticResource AtlasV2.Overlay.Title}"
                                   FontSize="30"
                                   TextWrapping="Wrap"
                                   FontWeight="ExtraBold"/>
                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding State.Description, ElementName=Root}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AtlasV2.Text.Body}"/>

                        <Border x:Name="ModeSelector" Margin="0,24,0,0"
                                Padding="4"
                                Background="#A5081723"
                                BorderBrush="#263D4C"
                                BorderThickness="1"
                                CornerRadius="9"
                                AutomationProperties.Name="Choix du formulaire d’authentification">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LoginModeButton"
                                        Grid.Column="0"
                                        Content="Connexion"
                                        Command="{Binding State.ShowLoginCommand, ElementName=Root}"
                                        KeyboardNavigation.TabIndex="0"
                                        AutomationProperties.Name="Afficher la connexion"
                                        Click="ModeButton_Click">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}"
                                               BasedOn="{StaticResource AtlasV2.Auth.Tab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State.Mode, ElementName=Root}"
                                                             Value="{x:Static presentation:AuthMode.Login}">
                                                    <Setter Property="Tag" Value="Active"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="RegisterModeButton"
                                        Grid.Column="1"
                                        Content="Inscription"
                                        Command="{Binding State.ShowRegisterCommand, ElementName=Root}"
                                        KeyboardNavigation.TabIndex="1"
                                        AutomationProperties.Name="Afficher l’inscription"
                                        Click="ModeButton_Click">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}"
                                               BasedOn="{StaticResource AtlasV2.Auth.Tab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State.Mode, ElementName=Root}"
                                                             Value="{x:Static presentation:AuthMode.Register}">
                                                    <Setter Property="Tag" Value="Active"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AtlasV2.Brush.Text}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <Border x:Name="EmailWarningBanner"
                                Margin="0,10,0,0"
                                Style="{StaticResource AtlasV2.Banner.Warning}"
                                Visibility="{Binding State.IsEmailWarningVisible, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                AutomationProperties.Name="Adresse e-mail non vérifiée"
                                AutomationProperties.HelpText="Tu peux continuer, mais pense à confirmer ton adresse e-mail.">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Width="17"
                                      Height="17"
                                      VerticalAlignment="Top"
                                      Data="{StaticResource AtlasV2.Icon.Info}"
                                      Stroke="{StaticResource AtlasV2.Brush.Gold}"
                                      Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Adresse e-mail non vérifiée"
                                               Style="{StaticResource AtlasV2.Text.Body}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AtlasV2.Brush.Gold}"/>
                                    <TextBlock Margin="0,2,0,0"
                                               Text="Tu peux continuer, mais pense à confirmer ton adresse e-mail."
                                               Style="{StaticResource AtlasV2.Text.Caption}" Foreground="#C5D6E2"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="ErrorBanner"
                                Margin="0,10,0,0"
                                Style="{StaticResource AtlasV2.Banner.Error}"
                                Visibility="{Binding State.IsErrorVisible, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                AutomationProperties.Name="Erreur d’authentification"
                                AutomationProperties.HelpText="{Binding State.ErrorMessage, ElementName=Root}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Width="17"
                                      Height="17"
                                      VerticalAlignment="Top"
                                      Data="{StaticResource AtlasV2.Icon.AlertCircle}"
                                      Stroke="{StaticResource AtlasV2.Brush.Danger}"
                                      Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Text="{Binding State.ErrorMessage, ElementName=Root}"
                                           Style="{StaticResource AtlasV2.Text.Caption}"
                                           Foreground="{StaticResource AtlasV2.Brush.Danger}"/>
                            </Grid>
                        </Border>

                        <Grid x:Name="LoginForm" Margin="0,24,0,0">
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State.Mode, ElementName=Root}"
                                                     Value="{x:Static presentation:AuthMode.Login}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel IsEnabled="{Binding State.IsFormEnabled, ElementName=Root}">
                                <TextBlock Text="NOM D’UTILISATEUR"
                                           Style="{StaticResource AtlasV2.Text.Caption}" Foreground="#C5D6E2"
                                           FontWeight="SemiBold"/>
                                <Border Height="48" Margin="0,8,0,18"
                                        Tag="{Binding ElementName=LoginUsernameBox}" LostKeyboardFocus="Field_LostKeyboardFocus"
                                        Style="{StaticResource AtlasV2.Auth.Field}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Width="17"
                                              Height="17"
                                              VerticalAlignment="Center"
                                              Data="{StaticResource AtlasV2.Icon.User}"
                                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                        <TextBox x:Name="LoginUsernameBox"
                                                 Grid.Column="1"
                                                 Margin="8,0,0,0"
                                                 Text="{Binding State.LoginUsername, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource AtlasV2.TextBox.Field}"
                                                 KeyboardNavigation.TabIndex="2"
                                                 AutomationProperties.Name="Nom d’utilisateur"
                                                 TextChanged="Input_Changed"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="LoginUsernameBoxError" Text="{Binding State.UsernameError, ElementName=Root}" Style="{StaticResource AtlasV2.Auth.Error}"/>

                                <TextBlock Text="MOT DE PASSE"
                                           Style="{StaticResource AtlasV2.Text.Caption}" Foreground="#C5D6E2"
                                           FontWeight="SemiBold"/>
                                <Border Height="48" Margin="0,8,0,0"
                                        Tag="{Binding ElementName=LoginPasswordBox}" LostKeyboardFocus="Field_LostKeyboardFocus"
                                        Style="{StaticResource AtlasV2.Auth.Field}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Width="17"
                                              Height="17"
                                              VerticalAlignment="Center"
                                              Data="{StaticResource AtlasV2.Icon.Lock}"
                                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                        <PasswordBox x:Name="LoginPasswordBox"
                                                     Grid.Column="1"
                                                     Margin="8,0,0,0"
                                                     Style="{StaticResource AtlasV2.PasswordBox.Field}"
                                                     KeyboardNavigation.TabIndex="3"
                                                     AutomationProperties.Name="Mot de passe"
                                                     PasswordChanged="Input_Changed"/>
                                    <TextBox x:Name="LoginPasswordBoxRevealed" Grid.Column="1" Margin="8,0,0,0" Visibility="Collapsed"
                        MaxLength="128" SpellCheck.IsEnabled="False" InputMethod.IsInputMethodEnabled="False"
                        Style="{StaticResource AtlasV2.TextBox.Field}" AutomationProperties.Name="Mot de passe visible"
                        TextChanged="RevealedPassword_Changed"/>
                    <Button x:Name="LoginPasswordBoxEye" Grid.Column="2" Tag="{Binding ElementName=LoginPasswordBox}"
                        Style="{StaticResource AtlasV2.Auth.Eye}" ToolTip="Afficher le mot de passe"
                        AutomationProperties.Name="Afficher le mot de passe" Click="PasswordEye_Click">
                        <Path Data="M 1,9 C 5,1 13,1 17,9 C 13,17 5,17 1,9 M 12,9 A 3,3 0 1 1 6,9 A 3,3 0 1 1 12,9"
                              Width="18" Height="18" StrokeThickness="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                    </Button>
                    </Grid>
                                </Border>
                                <TextBlock x:Name="LoginPasswordBoxError" Text="{Binding State.PasswordError, ElementName=Root}" Style="{StaticResource AtlasV2.Auth.Error}"/>
                                <Button x:Name="ForgotPasswordButton" Content="Mot de passe oublié ?" Margin="0,8,0,0"
                                    HorizontalAlignment="Right" Padding="8,0" Style="{StaticResource AtlasV2.Auth.Tab}"
                                    Click="ForgotPassword_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="RegisterForm">
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Margin" Value="0,10,0,0"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanClose, ElementName=Root}" Value="False">
                                            <Setter Property="Margin" Value="0,24,0,0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State.Mode, ElementName=Root}"
                                                     Value="{x:Static presentation:AuthMode.Register}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel IsEnabled="{Binding State.IsFormEnabled, ElementName=Root}">
                                <TextBlock Text="NOM D’UTILISATEUR"
                                           Style="{StaticResource AtlasV2.Text.Caption}" Foreground="#C5D6E2"
                                           FontWeight="SemiBold"/>
                                <Border Tag="{Binding ElementName=RegisterUsernameBox}" LostKeyboardFocus="Field_LostKeyboardFocus" Style="{StaticResource AtlasV2.Auth.RegisterField}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Width="17" Height="17" VerticalAlignment="Center"
                                              Data="{StaticResource AtlasV2.Icon.User}"
                                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                        <TextBox x:Name="RegisterUsernameBox"
                                                 Grid.Column="1"
                                                 Margin="8,0,0,0"
                                                 MaxLength="20"
                                                 Text="{Binding State.RegisterUsername, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource AtlasV2.TextBox.Field}"
                                                 KeyboardNavigation.TabIndex="2"
                                                 AutomationProperties.Name="Nom d’utilisateur pour l’inscription"
                                                 AutomationProperties.HelpText="3 à 20 lettres, chiffres ou underscores"
                                                 TextChanged="Input_Changed"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="RegisterUsernameBoxError" Text="{Binding State.UsernameError, ElementName=Root}" Style="{StaticResource AtlasV2.Auth.Error}"/>

                                <TextBlock Text="ADRESSE E-MAIL"
                                           Style="{StaticResource AtlasV2.Text.Caption}" Foreground="#C5D6E2"
                                           FontWeight="SemiBold"/>
                                <Border Tag="{Binding ElementName=RegisterEmailBox}" LostKeyboardFocus="Field_LostKeyboardFocus" Style="{StaticResource AtlasV2.Auth.RegisterField}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Width="17" Height="17" VerticalAlignment="Center"
                                              Data="{StaticResource AtlasV2.Icon.Mail}"
                                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                        <TextBox x:Name="RegisterEmailBox"
                                                 Grid.Column="1"
                                                 Margin="8,0,0,0"
                                                 MaxLength="254"
                                                 Text="{Binding State.RegisterEmail, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource AtlasV2.TextBox.Field}"
                                                 KeyboardNavigation.TabIndex="3"
                                                 AutomationProperties.Name="Adresse e-mail"
                                                 TextChanged="Input_Changed"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="RegisterEmailBoxError" Text="{Binding State.EmailError, ElementName=Root}" Style="{StaticResource AtlasV2.Auth.Error}"/>

                                <TextBlock Text="MOT DE PASSE · 10 À 128 CARACTÈRES"
                                           Style="{StaticResource AtlasV2.Text.Caption}" Foreground="#C5D6E2"
                                           FontWeight="SemiBold"/>
                                <Border Tag="{Binding ElementName=RegisterPasswordBox}" LostKeyboardFocus="Field_LostKeyboardFocus" Style="{StaticResource AtlasV2.Auth.RegisterField}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Width="17" Height="17" VerticalAlignment="Center"
                                              Data="{StaticResource AtlasV2.Icon.Lock}"
                                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                        <PasswordBox x:Name="RegisterPasswordBox"
                                                     Grid.Column="1"
                                                     Margin="8,0,0,0"
                                                     MaxLength="128"
                                                     Style="{StaticResource AtlasV2.PasswordBox.Field}"
                                                     KeyboardNavigation.TabIndex="4"
                                                     AutomationProperties.Name="Mot de passe pour l’inscription"
                                                     AutomationProperties.HelpText="10 à 128 caractères"
                                                     PasswordChanged="Input_Changed"/>
                                    <TextBox x:Name="RegisterPasswordBoxRevealed" Grid.Column="1" Margin="8,0,0,0" Visibility="Collapsed"
                        MaxLength="128" SpellCheck.IsEnabled="False" InputMethod.IsInputMethodEnabled="False"
                        Style="{StaticResource AtlasV2.TextBox.Field}" AutomationProperties.Name="Mot de passe visible"
                        TextChanged="RevealedPassword_Changed"/>
                    <Button x:Name="RegisterPasswordBoxEye" Grid.Column="2" Tag="{Binding ElementName=RegisterPasswordBox}"
                        Style="{StaticResource AtlasV2.Auth.Eye}" ToolTip="Afficher le mot de passe"
                        AutomationProperties.Name="Afficher le mot de passe" Click="PasswordEye_Click">
                        <Path Data="M 1,9 C 5,1 13,1 17,9 C 13,17 5,17 1,9 M 12,9 A 3,3 0 1 1 6,9 A 3,3 0 1 1 12,9"
                              Width="18" Height="18" StrokeThickness="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                    </Button>
                    </Grid>
                                </Border>
                                <TextBlock x:Name="RegisterPasswordBoxError" Text="{Binding State.PasswordError, ElementName=Root}" Style="{StaticResource AtlasV2.Auth.Error}"/>
                                <TextBlock Text="CONFIRMER LE MOT DE PASSE"
                                           Style="{StaticResource AtlasV2.Text.Caption}" Foreground="#C5D6E2"
                                           FontWeight="SemiBold"/>
                                <Border Tag="{Binding ElementName=RegisterPasswordConfirmBox}" LostKeyboardFocus="Field_LostKeyboardFocus" Margin="0,8,0,0" Style="{StaticResource AtlasV2.Auth.RegisterField}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Width="17" Height="17" VerticalAlignment="Center"
                                              Data="{StaticResource AtlasV2.Icon.Lock}"
                                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                                        <PasswordBox x:Name="RegisterPasswordConfirmBox"
                                                     Grid.Column="1"
                                                     Margin="8,0,0,0"
                                                     MaxLength="128"
                                                     Style="{StaticResource AtlasV2.PasswordBox.Field}"
                                                     KeyboardNavigation.TabIndex="5"
                                                     AutomationProperties.Name="Confirmation du mot de passe"
                                                     PasswordChanged="Input_Changed"/>
                                    <TextBox x:Name="RegisterPasswordConfirmBoxRevealed" Grid.Column="1" Margin="8,0,0,0" Visibility="Collapsed"
                        MaxLength="128" SpellCheck.IsEnabled="False" InputMethod.IsInputMethodEnabled="False"
                        Style="{StaticResource AtlasV2.TextBox.Field}" AutomationProperties.Name="Mot de passe visible"
                        TextChanged="RevealedPassword_Changed"/>
                    <Button x:Name="RegisterPasswordConfirmBoxEye" Grid.Column="2" Tag="{Binding ElementName=RegisterPasswordConfirmBox}"
                        Style="{StaticResource AtlasV2.Auth.Eye}" ToolTip="Afficher le mot de passe"
                        AutomationProperties.Name="Afficher le mot de passe" Click="PasswordEye_Click">
                        <Path Data="M 1,9 C 5,1 13,1 17,9 C 13,17 5,17 1,9 M 12,9 A 3,3 0 1 1 6,9 A 3,3 0 1 1 12,9"
                              Width="18" Height="18" StrokeThickness="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform"/>
                    </Button>
                    </Grid>
                                </Border>
                                <TextBlock x:Name="RegisterPasswordConfirmBoxError" Text="{Binding State.ConfirmationError, ElementName=Root}" Style="{StaticResource AtlasV2.Auth.Error}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="RecoveryForm" Visibility="Collapsed" Margin="0,20,0,0"
                                    IsEnabled="{Binding State.IsFormEnabled, ElementName=Root}">
                            <TextBlock Text="Indique l’adresse e-mail de ton compte Atlas pour recevoir un lien de réinitialisation."
                                       Foreground="#C5D6E2" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <TextBlock Text="ADRESSE E-MAIL" Foreground="#C5D6E2" FontSize="12" FontWeight="SemiBold"/>
                            <Border Height="48" Margin="0,8,0,0" Style="{StaticResource AtlasV2.Auth.Field}" Tag="{Binding ElementName=RecoveryEmailBox}" LostKeyboardFocus="Field_LostKeyboardFocus">
                                <TextBox x:Name="RecoveryEmailBox" MaxLength="254" Style="{StaticResource AtlasV2.TextBox.Field}"
                                         Text="{Binding State.RecoveryEmail, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Adresse e-mail du compte" TextChanged="Input_Changed"/>
                            </Border>
                            <TextBlock Text="{Binding State.EmailError, ElementName=Root}" Style="{StaticResource AtlasV2.Auth.Error}"/>
                        </StackPanel>
                        <Border x:Name="NoticeBanner" Margin="0,16,0,0" Padding="14" Background="#EB102D2F" BorderBrush="#4B968B" BorderThickness="1" CornerRadius="6"
                                Visibility="{Binding State.HasNotice, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                            <TextBlock Text="{Binding State.Notice, ElementName=Root}" Foreground="#D1F3EA" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        </Border>
                        <StackPanel x:Name="RegistrationSuccess" Visibility="Collapsed" Margin="0,22,0,0">
                            <TextBlock Text="Ton compte Atlas est créé. Tes jeux et tes services t’attendent."
                                       Foreground="#D1F3EA" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,16"/>
                            <TextBlock Text="Pense à vérifier ton adresse e-mail. Si tu n’as pas reçu le message, tu peux renvoyer le lien depuis ton profil."
                                       Foreground="#C5D6E2" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Margin="0,24,0,0">
                            <Button x:Name="PrimaryAuthButton"
                                    Height="48"
                                    Style="{StaticResource AtlasV2.Auth.Button}"
                                    IsEnabled="{Binding State.CanSubmit, ElementName=Root}"
                                    IsDefault="True"
                                    KeyboardNavigation.TabIndex="6"
                                    AutomationProperties.Name="{Binding State.PrimaryActionLabel, ElementName=Root}"
                                    Click="PrimaryAuthButton_Click">
                                <TextBlock Text="{Binding State.PrimaryActionLabel, ElementName=Root}"
                                           FontWeight="SemiBold"/>
                            </Button>
                            <Border Height="48"
                                    Background="#79D7ED"
                                    BorderBrush="#A7EEFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding State.IsBusy, ElementName=Root, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
                                    AutomationProperties.Name="Connexion en cours">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Path x:Name="BusySpinner"
                                          Width="17"
                                          Height="17"
                                          Margin="0,0,8,0"
                                          Data="{StaticResource AtlasV2.Icon.Refresh}"
                                          Stroke="{StaticResource AtlasV2.Brush.Window}"
                                          StrokeThickness="2"
                                          Stretch="Uniform"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform/>
                                        </Path.RenderTransform>
                                        <Path.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                         From="0" To="360" Duration="0:0:1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Path.Triggers>
                                    </Path>
                                    <TextBlock Text="{Binding State.PrimaryActionLabel, ElementName=Root}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AtlasV2.Brush.Window}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
