<UserControl x:Class="WotLK.Launcher.UI.V2.Views.FriendsDrawerV2"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="796"
             Background="Transparent"
             Visibility="Collapsed"
             IsHitTestVisible="False"
             Focusable="False">
    <Grid x:Name="OverlayRoot">
        <Border x:Name="Scrim"
                Background="{StaticResource AtlasV2.Brush.Scrim}"
                Opacity="0"
                IsHitTestVisible="False"
                MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>

        <Border x:Name="DrawerPanel"
                Width="360"
                Margin="0,10,10,10"
                Padding="22"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="#FC141A20"
                BorderBrush="{StaticResource AtlasV2.Brush.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Opacity="0"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Contained">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTranslate" X="376"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="AMIS ATLAS"
                                   Style="{StaticResource AtlasV2.Text.Eyebrow}"/>
                        <TextBlock Margin="0,5,0,0"
                                   Text="Mes amis"
                                   Style="{StaticResource AtlasV2.Text.SectionTitle}"
                                   FontSize="24"/>
                    </StackPanel>
                    <Button x:Name="CloseButton"
                            Width="38"
                            Height="38"
                            Padding="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource AtlasV2.Button.Icon}"
                            ToolTip="Fermer"
                            AutomationProperties.Name="Fermer le panneau Amis"
                            Click="CloseButton_Click">
                        <Path Data="{StaticResource AtlasV2.Icon.Close}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,22,0,14">
                    <TextBlock Style="{StaticResource AtlasV2.Text.Caption}">
                        <Run Text="{Binding State.OnlineCount, ElementName=Root, Mode=OneWay}"/>
                        <Run Text=" en jeu sur "/>
                        <Run Text="{Binding State.Friends.Count, ElementName=Root, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Width="34"
                            Height="34"
                            Padding="9"
                            HorizontalAlignment="Right"
                            Style="{StaticResource AtlasV2.Button.Icon}"
                            ToolTip="Actualiser"
                            AutomationProperties.Name="Actualiser les amis">
                        <Path Data="{StaticResource AtlasV2.Icon.Refresh}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding State.Friends, ElementName=Root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="13"
                                        Background="{StaticResource AtlasV2.Brush.SurfaceRaised}"
                                        BorderBrush="{StaticResource AtlasV2.Brush.BorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38"
                                                Height="38"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="#D6A94E"
                                                CornerRadius="19">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Initial}"
                                                       FontFamily="{StaticResource AtlasV2.Font.Manrope}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#111318"/>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Margin="10,0,10,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Username}"
                                                       Style="{StaticResource AtlasV2.Text.Body}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding CharacterName}"
                                                       Style="{StaticResource AtlasV2.Text.Caption}"
                                                       Foreground="{StaticResource AtlasV2.Brush.Cyan}"/>
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="{Binding CharacterDetails}"
                                                       Style="{StaticResource AtlasV2.Text.Caption}"/>
                                            <TextBlock Margin="0,5,0,0"
                                                       Text="{Binding PresenceText}"
                                                       Style="{StaticResource AtlasV2.Text.Caption}"/>
                                        </StackPanel>
                                        <Ellipse Grid.Column="2"
                                                 Width="8"
                                                 Height="8"
                                                 VerticalAlignment="Top"
                                                 Margin="0,5,0,0">
                                            <Ellipse.Style>
                                                <Style TargetType="{x:Type Ellipse}">
                                                    <Setter Property="Fill" Value="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource AtlasV2.Brush.Success}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="3"
                        Margin="0,12,0,0"
                        Style="{StaticResource AtlasV2.Button.Secondary}"
                        Content="GÉRER MES AMIS"
                        AutomationProperties.Name="Gérer mes amis"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
