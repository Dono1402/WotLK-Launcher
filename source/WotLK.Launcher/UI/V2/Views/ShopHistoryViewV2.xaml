<UserControl x:Class="WotLK.Launcher.UI.V2.Views.ShopHistoryViewV2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:WotLK.Launcher.UI.V2.Localization"
             localization:LauncherLocalizationOptions.IsUserText="True"
             Visibility="{Binding IsHistoryOpen, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
             FontFamily="{StaticResource AtlasV2.Font.Inter}" TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" Focusable="False">
    <UserControl.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/AtlasV2.Shop.xaml"/></ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="HistoryFilterChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
        <Style x:Key="HistoryEntry" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Surface" Background="{StaticResource AtlasV2.Brush.GlassSurface}" BorderBrush="{StaticResource AtlasV2.Brush.GlassBorder}" BorderThickness="1" CornerRadius="12" Padding="18,14">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#70B9DA"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ResourceDictionary></UserControl.Resources>
    <Grid x:Name="HistoryFrame" Margin="60,24" MaxWidth="1320">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Button x:Name="HistoryBackButton" Style="{StaticResource ShopAction}" Height="30" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left" Margin="0,0,0,18" Click="Back_Click" AutomationProperties.Name="{Binding HistoryBackLabel}">
            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource AtlasV2.Icon.ArrowRight}" Style="{StaticResource ShopIcon}" Width="17" Height="17"><Path.LayoutTransform><ScaleTransform ScaleX="-1"/></Path.LayoutTransform></Path><TextBlock Text="{Binding HistoryBackLabel}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button x:Name="HistoryRefreshButton" Style="{StaticResource ShopAction}" Height="30" Width="32" Padding="7" BorderThickness="0" Background="Transparent" HorizontalAlignment="Right" Margin="0,0,0,18" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" ToolTip="{Binding RefreshLabel}" AutomationProperties.Name="{Binding RefreshLabel}">
            <Path Data="{StaticResource AtlasV2.Icon.Refresh}" Style="{StaticResource ShopIcon}" Width="17" Height="17"/>
        </Button>
        <StackPanel Grid.Row="1" Margin="0,0,0,24">
            <TextBlock x:Name="HistoryTitle" Text="{Binding HistoryHeading}" Style="{StaticResource AtlasV2.Text.Hero}" FontSize="40" Foreground="{StaticResource AtlasV2.Brush.TitleIce}"/>
            <TextBlock Text="{Binding HistorySubtitle}" Style="{StaticResource ShopBody}" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding HistoryKindLabel}" Style="{StaticResource ShopCaption}" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox x:Name="HistoryKindPicker" ItemsSource="{Binding HistoryKindFilters}" SelectedItem="{Binding SelectedHistoryKind, Mode=TwoWay}" ItemTemplate="{StaticResource HistoryFilterChoice}" Style="{StaticResource ShopField}" Height="38" IsEnabled="{Binding HistoryAvailable}" AutomationProperties.Name="{Binding HistoryKindLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding HistoryWalletLabel}" Style="{StaticResource ShopCaption}" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox x:Name="HistoryWalletPicker" ItemsSource="{Binding HistoryWalletFilters}" SelectedItem="{Binding SelectedHistoryWallet, Mode=TwoWay}" ItemTemplate="{StaticResource HistoryFilterChoice}" Style="{StaticResource ShopField}" Height="38" IsEnabled="{Binding HistoryAvailable}" AutomationProperties.Name="{Binding HistoryWalletLabel}"/>
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding HistoryCountLabel}" Style="{StaticResource ShopCaption}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,0,10"/>
        </Grid>
        <Grid Grid.Row="3">
            <ListBox x:Name="HistoryList" ItemsSource="{Binding FilteredHistory}" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource HistoryEntry}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="{Binding HistoryHeading}">
                <ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/></ListBox.Resources>
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="9" Background="#233B7294" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <Path Data="{Binding Icon}" Style="{StaticResource ShopIcon}" Width="19" Height="19"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.TitlePearl}"/>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource ShopCaption}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource ShopCaption}" FontSize="11" Foreground="#91AFC6" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,18,0">
                            <TextBlock Text="{Binding Amount}" ToolTip="{Binding Amount}" TextTrimming="CharacterEllipsis" FontSize="20" FontWeight="SemiBold" Foreground="{Binding CurrencyColor}" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                                <Path Width="12" Height="13" Stroke="{Binding CurrencyColor}" StrokeThickness="1.2" Stretch="Uniform" Margin="0,0,5,0">
                                    <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{StaticResource ShopIcon.Wallet}"/><Style.Triggers><DataTrigger Binding="{Binding IsCredits}" Value="True"><Setter Property="Data" Value="{StaticResource ShopIcon.AtlasCredits}"/></DataTrigger></Style.Triggers></Style></Path.Style>
                                </Path>
                                <TextBlock Text="{Binding CurrencyLabel}" FontSize="12" Foreground="{Binding CurrencyColor}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BalanceAfter}" Style="{StaticResource ShopCaption}" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="3" Background="{Binding StatusBackground}" CornerRadius="10" Padding="9,5" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>
                        </Border>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border x:Name="HistoryEmptyState" Style="{StaticResource ShopPanel}" Padding="32" VerticalAlignment="Top" Visibility="{Binding ShowHistoryEmpty, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                <StackPanel><Path Data="{StaticResource ShopIcon.Clock}" Style="{StaticResource ShopIcon}" Width="28" Height="28" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                    <TextBlock x:Name="HistoryEmptyTitle" Text="{Binding HistoryEmptyHeading}" Style="{StaticResource ShopHeading}" FontSize="22"/>
                    <TextBlock Text="{Binding HistoryEmptyDescription}" Style="{StaticResource ShopBody}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <ProgressBar Height="3" IsIndeterminate="True" VerticalAlignment="Top" Style="{StaticResource AtlasV2.Progress.Compact}" Visibility="{Binding IsLoading, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
        </Grid>
        <TextBlock Grid.Row="4" Text="{Binding HistoryLimitLabel}" Style="{StaticResource ShopCaption}" FontSize="12" Margin="0,8,0,0" Visibility="{Binding ShowHistoryLimit, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
    </Grid>
</UserControl>
