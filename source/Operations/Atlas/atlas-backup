#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ENV_FILE=/etc/atlas-backup/arthas.env
BACKUP_ROOT=${ATLAS_BACKUP_ROOT:-/var/backups/atlas}
RETENTION_DAYS=${ATLAS_BACKUP_RETENTION_DAYS:-14}
MEDIA_ROOT=${ATLAS_MEDIA_ROOT:-/srv/wotlk/atlas-media}
STAMP=$(date +%Y%m%d-%H%M%S)
LOCK_FILE=/run/atlas-backup.lock

if [[ ! -r "$ENV_FILE" ]]; then
  echo "Missing or unreadable $ENV_FILE" >&2
  exit 1
fi
# shellcheck disable=SC1090
source "$ENV_FILE"

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "Another atlas-backup run is already active."
  exit 0
fi

install -d -m 0700 \
  "$BACKUP_ROOT" \
  "$BACKUP_ROOT/mysql" \
  "$BACKUP_ROOT/postgresql" \
  "$BACKUP_ROOT/files" \
  "$BACKUP_ROOT/media" \
  "$BACKUP_ROOT/manifests" \
  "$BACKUP_ROOT/logs"
TMP_DIR=$(mktemp -d "$BACKUP_ROOT/.tmp.${STAMP}.XXXXXX")
LOG_FILE="$BACKUP_ROOT/logs/atlas-backup-${STAMP}.log"
cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT
exec > >(tee -a "$LOG_FILE") 2>&1

echo "atlas-backup started at $(date -Is)"
echo "backup root: $BACKUP_ROOT"

echo "services:"
for unit in arthas-authserver.service arthas-worldserver.service animeclub-backend.service animeclub-discord-bot.service linguasage-discord-bot.service wotlk-launcher-api.service caddy.service postgresql@18-main.service docker.service; do
  printf '  %-38s %s\n' "$unit" "$(systemctl is-active "$unit" 2>/dev/null || true)"
done

echo "creating MySQL dump..."
MYSQL_DUMP="$TMP_DIR/arthas-mysql-${STAMP}.sql.gz"
docker exec -e MYSQL_PWD="${DB_ROOT_PASSWORD}" "${MYSQL_CONTAINER_NAME}" \
  mysqldump -u"${DB_ROOT_USER}" \
    --single-transaction --quick --routines --triggers --events \
    --default-character-set=utf8mb4 --set-gtid-purged=OFF \
    --databases "${DB_AUTH}" "${DB_CHARS}" "${DB_WORLD}" "${DB_PLAYERBOTS}" \
  | gzip -1 > "$MYSQL_DUMP"
gzip -t "$MYSQL_DUMP"

echo "creating PostgreSQL dump..."
PG_DUMP="$TMP_DIR/animeclub-postgresql-${STAMP}.dump"
sudo -u postgres pg_dump -Fc animeclub > "$PG_DUMP"
pg_restore -l "$PG_DUMP" >/dev/null

echo "creating Uptime Kuma sqlite backup..."
if [[ -x /opt/uptime-kuma/backup.sh ]]; then
  /opt/uptime-kuma/backup.sh
fi

echo "creating files/config archive..."
FILES_ARCHIVE="$TMP_DIR/atlas-files-${STAMP}.tgz"
tar --xattrs --acls --dereference --ignore-failed-read --warning=no-file-changed -czf "$FILES_ARCHIVE" \
  -C / \
  etc/animeclub \
  etc/linguasage-discord-bot \
  etc/caddy \
  var/lib/caddy \
  etc/systemd/system/arthas-authserver.service \
  etc/systemd/system/arthas-worldserver.service \
  etc/systemd/system/animeclub-backend.service \
  etc/systemd/system/animeclub-discord-bot.service \
  etc/systemd/system/linguasage-discord-bot.service \
  etc/systemd/system/linguasage-discord-bot-kuma-push.service \
  etc/systemd/system/linguasage-discord-bot-kuma-push.timer \
  etc/systemd/system/uptime-kuma-backup.service \
  etc/systemd/system/uptime-kuma-backup.timer \
  etc/systemd/system/wotlk-launcher-api.service \
  etc/systemd/system/wotlk-launcher-api.service.d \
  opt/arthas/server/etc \
  opt/animeclub/backend \
  opt/animeclub-discord-bot/current \
  opt/linguasage-discord-bot/current \
  opt/uptime-kuma/backup.sh \
  opt/uptime-kuma/backups \
  var/www/animeclub

echo "creating Atlas media archive..."
MEDIA_ARCHIVE="$TMP_DIR/atlas-media-${STAMP}.tgz"
create_media_archive() {
  local attempt
  for attempt in 1 2 3; do
    if tar --xattrs --acls --numeric-owner -czf "$MEDIA_ARCHIVE" \
      -C "$(dirname "$MEDIA_ROOT")" "$(basename "$MEDIA_ROOT")"; then
      return 0
    fi
    echo "media archive changed during read; retrying (${attempt}/3)..." >&2
    rm -f "$MEDIA_ARCHIVE"
    sleep 1
  done
  return 1
}
create_media_archive
tar -tzf "$MEDIA_ARCHIVE" >/dev/null

echo "moving artifacts..."
MYSQL_NAME="arthas-mysql-${STAMP}.sql.gz"
PG_NAME="animeclub-postgresql-${STAMP}.dump"
FILES_NAME="atlas-files-${STAMP}.tgz"
MEDIA_NAME="atlas-media-${STAMP}.tgz"
MANIFEST_NAME="atlas-backup-${STAMP}.sha256"

mv "$MYSQL_DUMP" "$BACKUP_ROOT/mysql/$MYSQL_NAME"
mv "$PG_DUMP" "$BACKUP_ROOT/postgresql/$PG_NAME"
mv "$FILES_ARCHIVE" "$BACKUP_ROOT/files/$FILES_NAME"
mv "$MEDIA_ARCHIVE" "$BACKUP_ROOT/media/$MEDIA_NAME"

echo "writing manifest..."
(
  cd "$BACKUP_ROOT"
  sha256sum \
    "mysql/$MYSQL_NAME" \
    "postgresql/$PG_NAME" \
    "files/$FILES_NAME" \
    "media/$MEDIA_NAME" \
    > "manifests/$MANIFEST_NAME"
)
chmod 0600 \
  "$BACKUP_ROOT/mysql/$MYSQL_NAME" \
  "$BACKUP_ROOT/postgresql/$PG_NAME" \
  "$BACKUP_ROOT/files/$FILES_NAME" \
  "$BACKUP_ROOT/media/$MEDIA_NAME" \
  "$BACKUP_ROOT/manifests/$MANIFEST_NAME" \
  "$LOG_FILE"

ln -sfn "mysql/$MYSQL_NAME" "$BACKUP_ROOT/latest-mysql.sql.gz"
ln -sfn "postgresql/$PG_NAME" "$BACKUP_ROOT/latest-postgresql.dump"
ln -sfn "files/$FILES_NAME" "$BACKUP_ROOT/latest-files.tgz"
ln -sfn "media/$MEDIA_NAME" "$BACKUP_ROOT/latest-media.tgz"
ln -sfn "manifests/$MANIFEST_NAME" "$BACKUP_ROOT/latest.sha256"

echo "applying retention: ${RETENTION_DAYS} days"
find "$BACKUP_ROOT/mysql" -type f -name 'arthas-mysql-*.sql.gz' -mtime +"$RETENTION_DAYS" -delete
find "$BACKUP_ROOT/postgresql" -type f -name 'animeclub-postgresql-*.dump' -mtime +"$RETENTION_DAYS" -delete
find "$BACKUP_ROOT/files" -type f -name 'atlas-files-*.tgz' -mtime +"$RETENTION_DAYS" -delete
find "$BACKUP_ROOT/media" -type f -name 'atlas-media-*.tgz' -mtime +"$RETENTION_DAYS" -delete
find "$BACKUP_ROOT/manifests" -type f -name 'atlas-backup-*.sha256' -mtime +"$RETENTION_DAYS" -delete
find "$BACKUP_ROOT/logs" -type f -name 'atlas-backup-*.log' -mtime +30 -delete

run_offsite_copy() {
  local offsite_env="/etc/atlas-backup/offsite.env"

  if [[ ! -r "$offsite_env" ]]; then
    echo "offsite backup: disabled (missing $offsite_env)"
    return 0
  fi

  # shellcheck disable=SC1090
  source "$offsite_env"

  if [[ "${ATLAS_OFFSITE_ENABLED:-0}" != "1" ]]; then
    echo "offsite backup: disabled"
    return 0
  fi

  if [[ -z "${ATLAS_OFFSITE_TARGET:-}" ]]; then
    echo "ATLAS_OFFSITE_TARGET is required when offsite backup is enabled." >&2
    return 1
  fi

  if ! command -v rclone >/dev/null 2>&1; then
    echo "rclone is required when offsite backup is enabled." >&2
    return 1
  fi

  local -a flags=(--fast-list --transfers 4 --checkers 8 --exclude ".tmp.*/**")
  if [[ -n "${ATLAS_OFFSITE_FLAGS:-}" ]]; then
    local -a extra_flags=()
    read -r -a extra_flags <<< "$ATLAS_OFFSITE_FLAGS"
    flags+=("${extra_flags[@]}")
  fi

  echo "copying backup to offsite target: $ATLAS_OFFSITE_TARGET"
  RCLONE_CONFIG="${RCLONE_CONFIG:-/root/.config/rclone/rclone.conf}" \
    rclone copy "$BACKUP_ROOT" "$ATLAS_OFFSITE_TARGET" "${flags[@]}"
}

run_offsite_copy

ls -lh \
  "$BACKUP_ROOT/mysql/$MYSQL_NAME" \
  "$BACKUP_ROOT/postgresql/$PG_NAME" \
  "$BACKUP_ROOT/files/$FILES_NAME" \
  "$BACKUP_ROOT/media/$MEDIA_NAME" \
  "$BACKUP_ROOT/manifests/$MANIFEST_NAME"
df -h "$BACKUP_ROOT"
echo "atlas-backup completed at $(date -Is)"
