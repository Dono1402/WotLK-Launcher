<UserControl x:Class="WotLK.Launcher.UI.V2.Views.ShopConversionViewV2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsConversionOpen, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
             FontFamily="{StaticResource AtlasV2.Font.Inter}" TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" Focusable="False" KeyboardNavigation.TabNavigation="Continue">
    <UserControl.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/AtlasV2.Shop.xaml"/></ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="ConversionCharacter"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
        <Style x:Key="Preset" TargetType="Button" BasedOn="{StaticResource ShopAction}"><Setter Property="Height" Value="31"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="13,0"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="Amount" TargetType="TextBlock" BasedOn="{StaticResource ShopBody}"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F3DC9C"/></Style>
        <Style x:Key="ConversionSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Background="Transparent">
                    <Border Height="4" Background="#314B5A" CornerRadius="2" VerticalAlignment="Center"/>
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#DDBD6A" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                        <Track.Thumb><Thumb Width="16" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="14" Height="14" Fill="#F6D47B" Stroke="#FFF0B4" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    </Track>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ResourceDictionary></UserControl.Resources>
    <Grid Background="Transparent">
        <Border x:Name="ConversionFrame" MaxWidth="1320" Margin="60,20" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/></ScrollViewer.Resources>
                <StackPanel>
                    <Button x:Name="CloseConversionButton" Style="{StaticResource ShopAction}" Height="30" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left" Margin="0,0,0,18" Click="Close_Click" AutomationProperties.Name="{Binding FundingBackLabel}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AtlasV2.Icon.ArrowRight}" Style="{StaticResource ShopIcon}" Width="17" Height="17"><Path.LayoutTransform><ScaleTransform ScaleX="-1"/></Path.LayoutTransform></Path><TextBlock Text="{Binding FundingBackLabel}" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                    <StackPanel><TextBlock x:Name="ConversionTitle" Text="{Binding ConversionHeading}" Style="{StaticResource ShopHeading}" FontSize="40" LineHeight="50" Foreground="{StaticResource AtlasV2.Brush.TitlePearl}"/><TextBlock Text="{Binding ConversionSubtitle}" Style="{StaticResource ShopBody}" FontSize="15" Margin="0,7,0,0"/></StackPanel>
                    <TextBlock x:Name="ConversionFundingContext" Text="{Binding FundingContextText}" Style="{StaticResource ShopCaption}" Foreground="{StaticResource ShopCreditsAmount}" FontSize="13" Margin="0,8,0,0" Visibility="{Binding HasFundingReturn, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                    <Grid x:Name="ConversionToolbar" Margin="0,19,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="{StaticResource AtlasV2.Brush.GlassSurface}" BorderBrush="#3B596C" BorderThickness="1" Padding="12,6" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource ShopGoldCoin}" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock x:Name="ConversionRateText" Text="{Binding ConversionRate}" Style="{StaticResource Amount}" FontSize="13"/><TextBlock Text="{Binding CreditsLabel}" Style="{StaticResource ShopCaption}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel></Border>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ConversionSourceLabel}" Style="{StaticResource ShopCaption}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ConversionCharacterPicker" Width="235" Style="{StaticResource ShopField}" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedConversionCharacter, Mode=TwoWay}" ItemTemplate="{StaticResource ConversionCharacter}" IsEnabled="{Binding CanChooseConversionCharacter}" AutomationProperties.Name="{Binding ConversionSourceLabel}"/>
                    </StackPanel></Grid>
                    <TextBlock x:Name="ConversionFundingHint" Text="{Binding FundingConversionHint}" Style="{StaticResource ShopCaption}" FontSize="13" Margin="0,0,0,12" Visibility="{Binding ShowFundingConversionHint, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                    <Grid x:Name="ConversionFlow"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="GoldSourceCard" Style="{StaticResource ShopPanel}" Padding="26"><StackPanel>
                            <TextBlock Text="{Binding AvailableGoldLabel}" Style="{StaticResource ShopEyebrow}" Foreground="#E9CB7E" Height="28" VerticalAlignment="Center"/>
                            <Grid x:Name="GoldAvailableRow" Height="66" Margin="0,13,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Source="{StaticResource ShopGoldCoin}" Width="28" Height="28" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" x:Name="MaximumGoldText" Text="{Binding ConversionMaximum}" Style="{StaticResource Amount}" FontSize="38" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Height="1" Background="#354A54" Margin="0,0,0,19"/>
                            <TextBlock Text="{Binding GoldRemainingLabel}" Style="{StaticResource ShopCaption}"/>
                            <TextBlock Text="{Binding ConversionGoldAfter}" Style="{StaticResource Amount}" FontSize="24" Margin="0,8,0,0"/>
                        </StackPanel></Border>
                        <Border x:Name="GoldAmountCard" Grid.Column="2" Style="{StaticResource ShopPanel}" Padding="26" IsEnabled="{Binding CanEditConversion}"><StackPanel>
                            <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding GoldAmountLabel}" Style="{StaticResource ShopEyebrow}" VerticalAlignment="Center"/>
                                <Button x:Name="MaximumButton" Grid.Column="1" Content="Max" Style="{StaticResource Preset}" Margin="8,0,0,0" Padding="9,0" Height="28" IsEnabled="{Binding HasConvertibleGold}" Tag="100" Click="Preset_Click"/>
                            </Grid>
                            <Border CornerRadius="8" Background="#FF041019" BorderBrush="#D0AB50" BorderThickness="1" Padding="12,7" Height="66" Margin="0,13,0,0">
                                <TextBox x:Name="ConversionAmount" Text="{Binding ConversionGold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AtlasV2.TextBox.Field}" FontSize="32" FontWeight="SemiBold" TextAlignment="Center" VerticalContentAlignment="Center" MaxLength="6" IsEnabled="{Binding CanPreviewConversion}" PreviewTextInput="Amount_PreviewTextInput" DataObject.Pasting="Amount_Pasting" InputMethod.IsInputMethodEnabled="False" AutomationProperties.Name="{Binding GoldAmountLabel}"/>
                            </Border>
                            <Slider x:Name="AmountSlider" Style="{StaticResource ConversionSlider}" Minimum="0" Maximum="100" Value="{Binding ConversionPercent, Mode=OneWay}" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding HasConvertibleGold}" Margin="0,13,0,10" ValueChanged="Slider_Changed" AutomationProperties.Name="{Binding GoldAmountLabel}"/>
                            <UniformGrid Columns="3"><Button Content="25 %" Tag="25" Style="{StaticResource Preset}" Click="Preset_Click" IsEnabled="{Binding HasConvertibleGold}"/><Button Content="50 %" Tag="50" Style="{StaticResource Preset}" Click="Preset_Click" IsEnabled="{Binding HasConvertibleGold}"/><Button Content="75 %" Tag="75" Style="{StaticResource Preset}" Margin="0" Click="Preset_Click" IsEnabled="{Binding HasConvertibleGold}"/></UniformGrid>
                        </StackPanel></Border>
                        <Path Grid.Column="3" Data="{StaticResource AtlasV2.Icon.ArrowRight}" Style="{StaticResource ShopIcon}" Width="26" Height="26" Stroke="#FFCC61" VerticalAlignment="Top" Margin="0,103,0,0"/>
                        <Border x:Name="CreditResultCard" Grid.Column="4" Style="{StaticResource ShopPanel}" BorderBrush="#8C7851" Padding="26"><StackPanel>
                            <TextBlock Text="{Binding CreditReceivedLabel}" Style="{StaticResource ShopEyebrow}" Foreground="#E9CB7E" Height="28" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConversionCreditText" Text="{Binding ConversionCredit}" FontSize="40" FontWeight="Bold" Foreground="#FFDA79" Margin="0,13,0,17" Height="66" VerticalAlignment="Center" Padding="0,5,0,0"/>
                            <Grid><TextBlock Text="{Binding CurrentBalanceLabel}" Style="{StaticResource ShopCaption}"/><TextBlock Text="{Binding ConversionBalanceBefore}" Style="{StaticResource Amount}" HorizontalAlignment="Right"/></Grid>
                            <Border Height="1" Background="#476073" Margin="0,12,0,12"/>
                            <Grid><TextBlock Text="{Binding NewBalanceLabel}" Style="{StaticResource ShopBody}" FontSize="13"/><TextBlock Text="{Binding ConversionBalanceAfter}" Style="{StaticResource Amount}" HorizontalAlignment="Right"/></Grid>
                            <Expander x:Name="ConversionWalletHelp" Style="{StaticResource ShopWalletHelp}" Margin="0,12,0,0"/>
                        </StackPanel></Border>
                        <Canvas x:Name="TransferLayer" Grid.ColumnSpan="5" Panel.ZIndex="10" IsHitTestVisible="False" ClipToBounds="True"/>
                    </Grid>
                    <TextBlock x:Name="ConversionStatusText" Text="{Binding ConversionHint}" Margin="0,16,0,5" MinHeight="32"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ShopCaption}"><Style.Triggers><DataTrigger Binding="{Binding HasConversionReceipt}" Value="True"><Setter Property="Foreground" Value="#ACD6C4"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
            </ScrollViewer>
                    <Grid Grid.Row="1" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock x:Name="ConversionReceiveText" Text="{Binding ConversionReceiveText}" Style="{StaticResource ShopCaption}" Foreground="{StaticResource ShopCreditsAmount}" FontSize="13"/>
                            <TextBlock Text="{Binding ConversionModeHint}" Style="{StaticResource ShopCaption}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="CancelConversionButton" Grid.Column="1" Content="{Binding CancelLabel}" Style="{StaticResource ShopAction}" Margin="15,0,10,0" Click="Close_Click"/>
                        <Button x:Name="ConvertButton" Grid.Column="2" Content="{Binding ConvertAction}" Style="{StaticResource ShopAction}" MinWidth="180" Padding="20,0" FontWeight="SemiBold" Background="#B78B6825" BorderBrush="#E2BF65" Foreground="#FFF0C8" IsEnabled="{Binding CanConvert}" Click="Convert_Click"/>
                    </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
