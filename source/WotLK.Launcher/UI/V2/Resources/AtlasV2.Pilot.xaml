<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <!-- Floating chrome shared by the native launcher pages. -->
    <LinearGradientBrush x:Key="AtlasV2.Pilot.Shell.TopBar" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#DF06111C"/>
        <GradientStop Offset="0.58" Color="#A9122335"/>
        <GradientStop Offset="1" Color="#C40B1B2B"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AtlasV2.Pilot.Shell.NavActive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#192D42" Offset="0"/>
        <GradientStop Color="#1E405C" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="AtlasV2.Pilot.Shell.Nav" TargetType="{x:Type Button}"
           BasedOn="{StaticResource AtlasV2.Button.Base}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Navigation}"/>
        <Setter Property="Height" Value="78"/>
        <Setter Property="Padding" Value="30,0"/>
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#B8CBE0"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Surface" Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <Border x:Name="Indicator" Height="2" VerticalAlignment="Bottom"
                                Background="#80DAFF" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Active">
                            <Setter Property="Foreground" Value="#F5FAFF"/>
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource AtlasV2.Pilot.Shell.NavActive}"/>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#7030445B"/>
                            <Setter Property="Foreground" Value="#F5FAFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#90415D74"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.Pilot.Shell.Icon" TargetType="{x:Type Button}"
           BasedOn="{StaticResource AtlasV2.Button.TopBarIcon}">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontFamily" Value="{StaticResource AtlasV2.Font.Inter}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#B8CBE0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Surface" CornerRadius="7"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#55334A61"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#8850697F"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="Surface" Property="Background" Value="#55314C62"/>
                            <Setter Property="Foreground" Value="#80DAFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AtlasV2.Pilot.Shell.Window" TargetType="{x:Type Button}"
           BasedOn="{StaticResource AtlasV2.Pilot.Shell.Icon}">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>
    <Style x:Key="AtlasV2.Pilot.Shell.Close" TargetType="{x:Type Button}"
           BasedOn="{StaticResource AtlasV2.Pilot.Shell.Window}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#B93643"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#962B36"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
