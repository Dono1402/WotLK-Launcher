+using System.Net;
+using System.Net.Sockets;
+using Xunit;
+
+namespace HermesProxy.Tests;
+
+public class RealmAddressTests
+{
+    [Fact]
+    public void GetAddressForClient_WithHostname_ResolvesIpv4Endpoint()
+    {
+        Realm realm = new();
+
+        IPEndPoint endpoint = realm.GetAddressForClient(
+            IPAddress.Parse("203.0.113.42"),
+            "localhost",
+            8084);
+
+        Assert.Equal(AddressFamily.InterNetwork, endpoint.AddressFamily);
+        Assert.Equal(IPAddress.Loopback, endpoint.Address);
+        Assert.Equal(8084, endpoint.Port);
+    }
+}
