<UserControl x:Class="WotLK.Launcher.UI.V2.Views.ChatViewV2"
             x:Name="ChatRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:WotLK.Launcher.UI.V2.Presentation"
             Background="Transparent" Focusable="False"
             FontFamily="{StaticResource AtlasV2.Font.Inter}"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WotLK.Launcher;component/UI/V2/Resources/AtlasV2.OverlaysPilot.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/>
            <DataTemplate DataType="{x:Type presentation:ChatConversationRow}">
                <Button Margin="0,0,0,6" Padding="11" HorizontalContentAlignment="Stretch"
                        Click="ConversationButton_Click" AutomationProperties.Name="{Binding AccessibleName}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AtlasV2.Overlay.Button}">
                            <Setter Property="Height" Value="Auto"/>
                            <Setter Property="MinHeight" Value="78"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AtlasV2.Overlay.CardHover}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AtlasV2.Overlay.Edge}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#21455E" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource AtlasV2.Brush.Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource AtlasV2.Brush.Text}" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1" Margin="6,0,0,0" Padding="5,1" MinWidth="22" CornerRadius="8"
                                    Background="{StaticResource AtlasV2.Brush.Cyan}"
                                    Visibility="{Binding HasUnread, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                <TextBlock Text="{Binding UnreadText}" FontSize="10" FontWeight="Bold" Foreground="#07151F" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Preview}" Margin="0,4,0,0"
                                       FontSize="12" Foreground="{StaticResource AtlasV2.Brush.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding DateText}" Margin="0,3,0,0"
                                       FontSize="10" Foreground="{StaticResource AtlasV2.Brush.TextMuted}"/>
                        </Grid>
                    </Grid>
                </Button>
            </DataTemplate>
            <DataTemplate DataType="{x:Type presentation:ChatMessageRow}">
                <Border x:Name="MessageBubble" MaxWidth="640" Margin="0,0,0,12" Padding="14,11"
                        CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource AtlasV2.Overlay.CardEdge}">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="Background" Value="{StaticResource AtlasV2.Overlay.Card}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Background" Value="#E3183B52"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource AtlasV2.Brush.Cyan}" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1" Margin="12,0,0,0" Padding="5,1" CornerRadius="4" Background="#26000000">
                                <TextBlock Text="{Binding OriginText}" FontSize="10" Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding DateText}" ToolTip="{Binding FullDateText}" Margin="10,1,0,0"
                                       FontSize="10" Foreground="{StaticResource AtlasV2.Brush.TextMuted}"/>
                        </Grid>
                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="14" LineHeight="21"
                                   Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
    <Grid x:Name="PageGrid" Margin="24,4,24,20" DataContext="{Binding UiState, ElementName=ChatRoot}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{Binding Strings.Title}" FontSize="30" FontWeight="ExtraBold" Foreground="{StaticResource AtlasV2.Brush.Text}"/>
            <TextBlock Text="{Binding Strings.Subtitle}" Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
        </StackPanel>
        <Border x:Name="UnavailableNotice" Grid.Row="1" Padding="14,10" Margin="0,0,0,12" CornerRadius="10"
                Background="#DE202F3C" BorderBrush="{StaticResource AtlasV2.Overlay.CardEdge}" BorderThickness="1"
                Visibility="{Binding ShowsUnavailable, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
            <TextBlock Text="{Binding Strings.Unavailable}" FontSize="13" Foreground="{StaticResource AtlasV2.Brush.TextSecondary}" TextWrapping="Wrap"/>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource AtlasV2.Overlay.Panel}"
                BorderBrush="{StaticResource AtlasV2.Overlay.Edge}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.3*" MinWidth="240" MaxWidth="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{StaticResource AtlasV2.Overlay.Divider}" BorderThickness="0,0,1,0" Padding="12,16,12,12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Strings.Conversations}" Margin="10,0,0,14" Style="{StaticResource AtlasV2.Overlay.Eyebrow}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                            <ItemsControl x:Name="ConversationsList" ItemsSource="{Binding Conversations}"/>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Margin="14,24" VerticalAlignment="Top"
                                    Visibility="{Binding ShowsNoConversations, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                            <TextBlock Text="{Binding Strings.NoConversations}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource AtlasV2.Brush.TextSecondary}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Strings.NoConversationsHint}" Margin="0,8,0,0" FontSize="12" LineHeight="19"
                                       Foreground="{StaticResource AtlasV2.Brush.TextMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Column="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30"
                                Visibility="{Binding ShowsNoSelection, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                        <Path Width="42" Height="42" Margin="0,0,0,20" Data="{StaticResource AtlasV2.Icon.Mail}"
                              Style="{StaticResource AtlasV2.Icon.Stroke}" Stroke="{StaticResource AtlasV2.Brush.Cyan}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Strings.ChooseConversation}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource AtlasV2.Brush.Text}" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Strings.ChooseConversationHint}" Margin="0,8,0,0" FontSize="13"
                                   Foreground="{StaticResource AtlasV2.Brush.TextMuted}" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid x:Name="ConversationPanel" Visibility="{Binding HasSelection, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Padding="22,16" BorderBrush="{StaticResource AtlasV2.Overlay.Divider}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="19" Background="#21455E">
                                    <TextBlock Text="{Binding SelectedInitial}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AtlasV2.Brush.Cyan}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedUsername}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                                    <TextBlock Text="{Binding Strings.AtlasAccount}" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource AtlasV2.Brush.TextMuted}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="ErrorNotice" Grid.Row="1" Padding="12,9" Margin="18,12,18,0" CornerRadius="8"
                                Background="{StaticResource AtlasV2.Brush.DangerSurface}" BorderBrush="{StaticResource AtlasV2.Brush.DangerBorder}" BorderThickness="1"
                                Visibility="{Binding HasError, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource AtlasV2.Brush.Text}"/>
                        </Border>
                        <StackPanel Grid.Row="2" Margin="18,8,18,0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Strings.Loading}" FontSize="12" Margin="0,6" HorizontalAlignment="Center"
                                       Foreground="{StaticResource AtlasV2.Brush.TextMuted}"
                                       Visibility="{Binding ShowsLoading, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                            <Button x:Name="LoadEarlierButton" Content="{Binding EarlierText}" Padding="14,5" Height="32"
                                    Style="{StaticResource AtlasV2.Overlay.CompactButton}" Click="LoadEarlierButton_Click"
                                    IsEnabled="{Binding CanLoadEarlier}" AutomationProperties.Name="{Binding EarlierText}"
                                    Visibility="{Binding HasEarlier, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                        </StackPanel>
                        <Grid Grid.Row="3">
                            <ScrollViewer x:Name="MessagesScrollViewer" Margin="18,12,12,0" Padding="0,0,6,0"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}"/>
                            </ScrollViewer>
                            <StackPanel Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ShowsNoMessages, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                <TextBlock Text="{Binding Strings.NoMessages}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"
                                           TextWrapping="Wrap" Foreground="{StaticResource AtlasV2.Brush.TextSecondary}"/>
                                <TextBlock Text="{Binding Strings.NoMessagesHint}" Margin="0,8,0,0" FontSize="12" TextAlignment="Center"
                                           TextWrapping="Wrap" Foreground="{StaticResource AtlasV2.Brush.TextMuted}"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="4" BorderBrush="{StaticResource AtlasV2.Overlay.Divider}" BorderThickness="0,1,0,0" Padding="18,14,18,12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource AtlasV2.Overlay.Field}" BorderBrush="{StaticResource AtlasV2.Overlay.CardEdge}"
                                        BorderThickness="1" CornerRadius="10" Padding="12,10">
                                    <Grid>
                                        <TextBox x:Name="ComposerBox" MinHeight="58" MaxHeight="122" MaxLength="1000"
                                                 Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                 IsEnabled="{Binding CanEditDraft}" VerticalContentAlignment="Top"
                                                 AutomationProperties.Name="{Binding Strings.ComposerName}"
                                                 PreviewKeyDown="ComposerBox_PreviewKeyDown" Style="{StaticResource AtlasV2.TextBox.Field}">
                                            <TextBox.Template>
                                                <ControlTemplate TargetType="{x:Type TextBox}">
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Stretch" Focusable="False"/>
                                                </ControlTemplate>
                                            </TextBox.Template>
                                        </TextBox>
                                        <TextBlock Text="{Binding Strings.ComposerPlaceholder}" FontSize="14" IsHitTestVisible="False"
                                                   Foreground="{StaticResource AtlasV2.Brush.TextMuted}">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding Draft}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Button x:Name="SendButton" Grid.Column="1" Content="{Binding SendText}" Margin="12,0,0,0" MinWidth="106"
                                        Padding="18,0" Height="42" VerticalAlignment="Bottom" Style="{StaticResource AtlasV2.Overlay.PrimaryButton}"
                                        IsEnabled="{Binding CanSend}" Click="SendButton_Click" AutomationProperties.Name="{Binding SendText}"/>
                                <TextBlock Grid.Row="1" Text="{Binding Strings.ComposerHint}" Margin="1,8,10,0" FontSize="10"
                                           Foreground="{StaticResource AtlasV2.Brush.TextMuted}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DraftLengthText}" Margin="0,8,0,0" FontSize="10"
                                           HorizontalAlignment="Right" Foreground="{StaticResource AtlasV2.Brush.TextMuted}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
        <Grid x:Name="RichHost" Visibility="Collapsed" ClipToBounds="True"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="RichStatus" Visibility="Collapsed" Margin="36,12" HorizontalAlignment="Center"
                   TextWrapping="Wrap" Foreground="{StaticResource AtlasV2.Brush.TextSecondary}" FontSize="14"/>
        <Button x:Name="RichRetryButton" Content="Réessayer" Visibility="Collapsed" HorizontalAlignment="Center"
                Style="{StaticResource AtlasV2.Button.Secondary}" Padding="20,10" Click="RichRetryButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
