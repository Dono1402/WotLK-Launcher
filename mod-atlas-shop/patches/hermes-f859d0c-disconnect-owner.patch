diff --git a/HermesProxy.Tests/Framework/SocketCloseLifecycleTests.cs b/HermesProxy.Tests/Framework/SocketCloseLifecycleTests.cs
new file mode 100644
index 0000000..b376a21
--- /dev/null
+++ b/HermesProxy.Tests/Framework/SocketCloseLifecycleTests.cs
@@ -0,0 +1,77 @@
+using System;
+using System.Net;
+using System.Net.Sockets;
+using System.Threading;
+using System.Threading.Tasks;
+using Framework.Networking;
+using Xunit;
+
+namespace HermesProxy.Tests.Framework;
+
+public class SocketCloseLifecycleTests
+{
+    private sealed class Probe(Socket socket) : SocketBase(socket)
+    {
+        public readonly TaskCompletionSource Closed = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public int CloseCount;
+        public override void Accept() => AsyncRead();
+        public override void ReadHandler(SocketAsyncEventArgs args) => AsyncRead();
+        public override void OnClose()
+        {
+            Interlocked.Increment(ref CloseCount);
+            base.OnClose();
+            Closed.TrySetResult();
+        }
+    }
+
+    [Fact]
+    public void DisconnectedSocket_StillRunsOwnershipCleanupExactlyOnce()
+    {
+        using var socket = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
+        var probe = new Probe(socket);
+        probe.CloseSocket();
+        probe.CloseSocket();
+        Assert.Equal(1, probe.CloseCount);
+    }
+
+    [Fact]
+    public async Task PeerReset_RunsCleanupAndStopsAcceptingFurtherCloses()
+    {
+        using var listener = new TcpListener(IPAddress.Loopback, 0);
+        listener.Start();
+        using var peer = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
+        await peer.ConnectAsync(listener.LocalEndpoint, TestContext.Current.CancellationToken);
+        using var accepted = await listener.AcceptSocketAsync(TestContext.Current.CancellationToken);
+        var probe = new Probe(accepted);
+        try
+        {
+            probe.Accept();
+            peer.LingerState = new LingerOption(true, 0);
+            peer.Close();
+            await probe.Closed.Task.WaitAsync(TimeSpan.FromSeconds(5), TestContext.Current.CancellationToken);
+            probe.CloseSocket();
+            Assert.Equal(1, probe.CloseCount);
+        }
+        finally { probe.CloseSocket(); }
+    }
+
+    [Fact]
+    public async Task ConcurrentCloseAndPeerEof_RunCleanupExactlyOnce()
+    {
+        using var listener = new TcpListener(IPAddress.Loopback, 0);
+        listener.Start();
+        using var peer = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
+        await peer.ConnectAsync(listener.LocalEndpoint, TestContext.Current.CancellationToken);
+        using var accepted = await listener.AcceptSocketAsync(TestContext.Current.CancellationToken);
+        var probe = new Probe(accepted);
+        try
+        {
+            probe.Accept();
+            peer.Close();
+            Parallel.For(0, 16, _ => probe.CloseSocket());
+            await probe.Closed.Task.WaitAsync(TimeSpan.FromSeconds(5), TestContext.Current.CancellationToken);
+            Assert.Equal(1, probe.CloseCount);
+        }
+        finally { probe.CloseSocket(); }
+    }
+}
