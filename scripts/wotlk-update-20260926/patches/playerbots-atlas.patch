+# Always reserve randombots that belong to a guild led by a real player when the active bot list is rebuilt.
+# Reserved guild bots are also connected before the rest of the random bot pool after a server restart.
+# Default: 0 (disabled)
+AiPlayerbot.RealGuildBotAutologin = 0
+
 # Randombot count
 AiPlayerbot.MinRandomBots = 500
 AiPlayerbot.MaxRandomBots = 500
