diff --git a/HermesProxy/BnetServer/Auth/AzerothCoreBridge.cs b/HermesProxy/BnetServer/Auth/AzerothCoreBridge.cs
new file mode 100644
index 0000000..3e5c9e3
--- /dev/null
+++ b/HermesProxy/BnetServer/Auth/AzerothCoreBridge.cs
@@ -0,0 +1,168 @@
+using System;
+using System.Collections.Generic;
+using System.Text.RegularExpressions;
+using System.Threading;
+using System.Threading.Tasks;
+using Framework.Constants;
+using Framework.Logging;
+using HermesProxy.Auth;
+using HermesProxy.Configuration.Options;
+using Microsoft.Extensions.Options;
+using MySqlConnector;
+
+namespace BNetServer.Auth;
+
+public sealed partial class AzerothCoreBridge
+{
+    private readonly IOptionsMonitor<AzerothCoreBridgeOptions> _options;
+    private int _initialized;
+
+    public AzerothCoreBridge(IOptionsMonitor<AzerothCoreBridgeOptions> options)
+    {
+        _options = options;
+    }
+
+    public bool Enabled => _options.CurrentValue.Enabled;
+
+    public async Task<ModernCredential?> GetModernCredentialAsync(string login)
+    {
+        if (!Enabled)
+            return null;
+
+        await EnsureInitializedAsync();
+        string table = QuoteIdentifier(_options.CurrentValue.ModernCredentialTable);
+
+        await using MySqlConnection connection = await OpenConnectionAsync();
+        await using MySqlCommand command = connection.CreateCommand();
+        command.CommandText = $"SELECT username, srp_version, salt, verifier FROM {table} WHERE BINARY username = BINARY @username";
+        command.Parameters.AddWithValue("@username", login.ToUpperInvariant());
+
+        await using MySqlDataReader reader = await command.ExecuteReaderAsync();
+        if (!await reader.ReadAsync())
+            return null;
+
+        return new ModernCredential(
+            reader.GetString(0),
+            reader.GetByte(1),
+            (byte[])reader["salt"],
+            (byte[])reader["verifier"]);
+    }
+
+    public async Task<AccountBridgeInfo?> PrepareLegacySessionAsync(string login, byte[] sessionKey, Locale locale)
+    {
+        if (!Enabled)
+            return null;
+
+        await EnsureInitializedAsync();
+        await using MySqlConnection connection = await OpenConnectionAsync();
+
+        uint id;
+        string username;
+        await using (MySqlCommand select = connection.CreateCommand())
+        {
+            select.CommandText = "SELECT id, username FROM account WHERE BINARY username = BINARY @login OR BINARY email = BINARY @login LIMIT 1";
+            select.Parameters.AddWithValue("@login", login.ToUpperInvariant());
+
+            await using MySqlDataReader reader = await select.ExecuteReaderAsync();
+            if (!await reader.ReadAsync())
+                return null;
+
+            id = reader.GetUInt32(0);
+            username = reader.GetString(1);
+        }
+
+        await using (MySqlCommand update = connection.CreateCommand())
+        {
+            update.CommandText = "UPDATE account SET session_key = @sessionKey, locale = @locale WHERE id = @id";
+            update.Parameters.Add("@sessionKey", MySqlDbType.Binary, 40).Value = sessionKey;
+            update.Parameters.AddWithValue("@locale", (byte)locale);
+            update.Parameters.AddWithValue("@id", id);
+            await update.ExecuteNonQueryAsync();
+        }
+
+        return new AccountBridgeInfo(id, username);
+    }
+
+    public async Task<List<RealmInfo>> LoadRealmsAsync()
+    {
+        List<RealmInfo> realms = [];
+        if (!Enabled)
+            return realms;
+
+        await EnsureInitializedAsync();
+        await using MySqlConnection connection = await OpenConnectionAsync();
+        await using MySqlCommand command = connection.CreateCommand();
+        command.CommandText = "SELECT id, name, address, port, icon, flag, timezone, population FROM realmlist ORDER BY id";
+
+        await using MySqlDataReader reader = await command.ExecuteReaderAsync();
+        while (await reader.ReadAsync())
+        {
+            realms.Add(new RealmInfo
+            {
+                ID = reader.GetUInt32(0),
+                Name = reader.GetString(1),
+                Address = reader.GetString(2),
+                Port = reader.GetUInt16(3),
+                Type = (RealmType)reader.GetByte(4),
+                Flags = (RealmFlags)reader.GetByte(5),
+                Timezone = reader.GetByte(6),
+                Population = reader.GetFloat(7),
+                CharacterCount = 0
+            });
+        }
+
+        return realms;
+    }
+
+    private async Task EnsureInitializedAsync()
+    {
+        if (Interlocked.CompareExchange(ref _initialized, 1, 0) != 0)
+            return;
+
+        try
+        {
+            string table = QuoteIdentifier(_options.CurrentValue.ModernCredentialTable);
+            await using MySqlConnection connection = await OpenConnectionAsync();
+            await using MySqlCommand command = connection.CreateCommand();
+            command.CommandText = $"""
+                CREATE TABLE IF NOT EXISTS {table} (
+                    username VARCHAR(64) NOT NULL PRIMARY KEY,
+                    srp_version TINYINT UNSIGNED NOT NULL DEFAULT 2,
+                    salt BINARY(32) NOT NULL,
+                    verifier VARBINARY(256) NOT NULL,
+                    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+                    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
+                )
+                """;
+            await command.ExecuteNonQueryAsync();
+        }
+        catch
+        {
+            Interlocked.Exchange(ref _initialized, 0);
+            throw;
+        }
+    }
+
+    private async Task<MySqlConnection> OpenConnectionAsync()
+    {
+        MySqlConnection connection = new(_options.CurrentValue.ConnectionString);
+        await connection.OpenAsync();
+        return connection;
+    }
+
+    private static string QuoteIdentifier(string identifier)
+    {
+        if (!SafeIdentifierRegex().IsMatch(identifier))
+            throw new InvalidOperationException($"Unsafe MySQL identifier '{identifier}'.");
+
+        return "`" + identifier.Replace("`", "``") + "`";
+    }
+
+    [GeneratedRegex("^[A-Za-z0-9_]+$")]
+    private static partial Regex SafeIdentifierRegex();
+}
+
+public sealed record ModernCredential(string Username, byte SrpVersion, byte[] Salt, byte[] Verifier);
+
+public sealed record AccountBridgeInfo(uint AccountId, string Username);
+
diff --git a/HermesProxy/BnetServer/Auth/BnetSrp6.cs b/HermesProxy/BnetServer/Auth/BnetSrp6.cs
new file mode 100644
index 0000000..a054900
--- /dev/null
+++ b/HermesProxy/BnetServer/Auth/BnetSrp6.cs
@@ -0,0 +1,150 @@
+using System;
+using System.Globalization;
+using System.Numerics;
+using System.Security.Cryptography;
+using System.Text;
+
+namespace BNetServer.Auth;
+
+internal sealed class BnetSrp6
+{
+    private const string NHex = "";
+    private static readonly BigInteger N = FromHex(NHex);
+    private static readonly BigInteger G = new(2);
+    private static readonly BigInteger K = FromSha256(ToBigEndian(N, 256), ToBigEndian(G, 256));
+
+    private readonly BigInteger _verifier;
+    private readonly BigInteger _privateB;
+    private readonly BigInteger _publicB;
+
+    public BnetSrp6(string usernameHashHex, byte[] salt, byte[] verifier)
+    {
+        UsernameHashHex = usernameHashHex;
+        Salt = salt;
+        _verifier = FromBigEndian(verifier);
+        _privateB = GeneratePrivateB();
+        _publicB = (BigInteger.ModPow(G, _privateB, N) + (_verifier * K)) % N;
+    }
+
+    public string UsernameHashHex { get; }
+
+    public byte[] Salt { get; }
+
+    public string PublicBHex => ToHex(_publicB);
+
+    public string ModulusHex => NHex;
+
+    public string GeneratorHex => "02";
+
+    public string? ServerEvidenceM2Hex { get; private set; }
+
+    public bool VerifyClientEvidence(string publicAHex, string clientEvidenceM1Hex)
+    {
+        BigInteger publicA = FromHex(publicAHex);
+        BigInteger clientM1 = FromHex(clientEvidenceM1Hex);
+
+        if (publicA % N == 0)
+            return false;
+
+        BigInteger u = FromSha256(ToBigEndian(publicA, 256), ToBigEndian(_publicB, 256));
+        if (u % N == 0)
+            return false;
+
+        BigInteger sessionSecret = BigInteger.ModPow(publicA * BigInteger.ModPow(_verifier, u, N), _privateB, N);
+        BigInteger expectedM1 = FromSha256(GetBrokenEvidenceVector(publicA), GetBrokenEvidenceVector(_publicB), GetBrokenEvidenceVector(sessionSecret));
+        if (expectedM1 != clientM1)
+            return false;
+
+        BigInteger serverM2 = FromSha256(GetBrokenEvidenceVector(publicA), GetBrokenEvidenceVector(clientM1), GetBrokenEvidenceVector(sessionSecret));
+        ServerEvidenceM2Hex = ToHex(serverM2);
+        return true;
+    }
+
+    public static string GetSrpUsernameHash(string login)
+        => Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(login.ToUpperInvariant())));
+
+    public static (byte[] Salt, byte[] Verifier) MakeRegistrationData(string login, string password)
+    {
+        byte[] salt = RandomNumberGenerator.GetBytes(32);
+        string srpUsername = GetSrpUsernameHash(login);
+        byte[] xBytes = Rfc2898DeriveBytes.Pbkdf2(
+            Encoding.UTF8.GetBytes(srpUsername + ":" + password),
+            salt,
+            15000,
+            HashAlgorithmName.SHA512,
+            64);
+
+        BigInteger x = CalculatePasswordX(xBytes);
+        BigInteger verifier = BigInteger.ModPow(G, x, N);
+        return (salt, ToBigEndian(verifier));
+    }
+
+    private static BigInteger CalculatePasswordX(byte[] xBytes)
+    {
+        BigInteger x = FromBigEndian(xBytes);
+        if ((xBytes[0] & 0x80) != 0)
+            x -= BigInteger.One << (xBytes.Length * 8);
+
+        x %= N - 1;
+        return x.Sign < 0 ? x + (N - 1) : x;
+    }
+
+    private static BigInteger GeneratePrivateB()
+    {
+        byte[] bytes = RandomNumberGenerator.GetBytes(256);
+        BigInteger value = FromBigEndian(bytes);
+        return value % (N - 1);
+    }
+
+    private static BigInteger FromSha256(params byte[][] parts)
+    {
+        using IncrementalHash hash = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
+        foreach (byte[] part in parts)
+            hash.AppendData(part);
+        return FromBigEndian(hash.GetHashAndReset());
+    }
+
+    private static BigInteger FromHex(string hex)
+    {
+        if (hex.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+            hex = hex[2..];
+        if (hex.Length % 2 != 0)
+            hex = "0" + hex;
+
+        byte[] bytes = Convert.FromHexString(hex);
+        return FromBigEndian(bytes);
+    }
+
+    private static BigInteger FromBigEndian(byte[] bytes)
+        => new(bytes, isUnsigned: true, isBigEndian: true);
+
+    private static string ToHex(BigInteger value)
+        => Convert.ToHexString(ToBigEndian(value)).TrimStart('0') switch
+        {
+            "" => "00",
+            string hex when hex.Length % 2 == 0 => hex,
+            string hex => "0" + hex
+        };
+
+    private static byte[] ToBigEndian(BigInteger value, int minBytes = 0)
+    {
+        if (value.Sign < 0)
+            throw new ArgumentOutOfRangeException(nameof(value), "Only non-negative values are supported.");
+
+        byte[] bytes = value.ToByteArray(isUnsigned: true, isBigEndian: true);
+        if (bytes.Length >= minBytes)
+            return bytes;
+
+        byte[] padded = new byte[minBytes];
+        bytes.CopyTo(padded.AsSpan(minBytes - bytes.Length));
+        return padded;
+    }
+
+    private static byte[] GetBrokenEvidenceVector(BigInteger value)
+    {
+        long bitLength = value.GetBitLength();
+        int byteLength = Math.Max(1, (int)((bitLength + 8) >> 3));
+        return ToBigEndian(value, byteLength);
+    }
+}
+
