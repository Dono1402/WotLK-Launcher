<UserControl x:Class="WotLK.Launcher.UI.V2.Views.ShopViewV2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WotLK.Launcher.UI.V2.Views"
             xmlns:localization="clr-namespace:WotLK.Launcher.UI.V2.Localization"
             localization:LauncherLocalizationOptions.IsUserText="True"
             FontFamily="{StaticResource AtlasV2.Font.Inter}" TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" Background="Transparent" Focusable="False">
    <!-- These bindings provide their own locale; preserve their values from the legacy text translation bridge. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/AtlasV2.Shop.xaml"/></ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ShopChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding IsConversionOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/></ScrollViewer.Resources>
        <Grid x:Name="ContentFrame" Margin="40,0,24,19" MaxWidth="1700">
            <Grid.RowDefinitions><RowDefinition Height="128"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel Margin="11,0,0,0">
                    <StackPanel Orientation="Horizontal"><Border Width="36" Height="1.5" Background="{StaticResource ShopIce}" Margin="0,0,20,0"/><TextBlock Text="ATLAS LAUNCHER" Style="{StaticResource ShopEyebrow}"/></StackPanel>
                    <TextBlock x:Name="PageTitle" Text="{Binding PageHeading}" FontSize="60" FontWeight="ExtraBold" Foreground="{StaticResource AtlasV2.Brush.TitlePearl}" Margin="0,0,0,0"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource ShopBody}" FontSize="20" LineHeight="25" Margin="5,0,0,0"/>

                </StackPanel>
                <StackPanel x:Name="MottoPanel" HorizontalAlignment="Right" Margin="0,10,42,0" Width="104" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Motto}" FontFamily="{StaticResource AtlasV2.Font.Inter}" FontSize="12" Foreground="#C5E1F6" TextAlignment="Center" LineHeight="24"/>
                    <Grid Margin="0,14,0,0"><Border Height="1" Background="#6795B2"/><TextBlock Text="❖" Foreground="#98CDEE" Background="#081B2B" HorizontalAlignment="Center" Padding="7,0" FontSize="15"/></Grid>
                </StackPanel>
            </Grid>
            <Grid x:Name="ShopColumns" Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="CategoryColumn" Width="196"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailGap" Width="20"/><ColumnDefinition x:Name="DetailColumn" Width="384"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="26,0,0,0" VerticalAlignment="Top" Grid.ColumnSpan="3">
                        <Path Style="{StaticResource ShopIcon}" Data="{StaticResource ShopIcon.Cart}"/><TextBlock Text="{Binding SecureLabel}" Style="{StaticResource ShopCaption}" VerticalAlignment="Center" Margin="15,0,40,0"/>
                        <Path Style="{StaticResource ShopIcon}" Data="{StaticResource ShopIcon.Shield}"/><TextBlock Text="{Binding OfficialLabel}" Style="{StaticResource ShopCaption}" VerticalAlignment="Center" Margin="15,0,45,0"/>
                        <Path Style="{StaticResource ShopIcon}" Data="{StaticResource AtlasV2.Icon.Users}"/><TextBlock Text="{Binding RealmSupportLabel}" Style="{StaticResource ShopCaption}" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </StackPanel>
                <StackPanel x:Name="CategoriesPanel" Margin="0,41,0,0">
                    <Border Height="1" Background="#456577" Margin="3,0,27,27"/>
                    <TextBlock Text="{Binding CatalogueHeading}" Style="{StaticResource ShopEyebrow}" Margin="11,0,0,10"/>
                    <Border Height="63" CornerRadius="6" BorderThickness="1" BorderBrush="#A98935" Background="#303E331C">
                        <Grid><Border Width="3" Background="#F7CE68" HorizontalAlignment="Left" CornerRadius="5"></Border>
                            <Grid Margin="18,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource AtlasV2.Icon.User}" Style="{StaticResource ShopIcon}" Width="28" Height="32" Stroke="{StaticResource ShopGold}"/><TextBlock Grid.Column="1" Text="{Binding CategoryLabel}" Foreground="#FFE4A0" Style="{StaticResource ShopBody}" FontWeight="SemiBold" FontSize="14" LineHeight="19" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
                        </Grid>
                    </Border>
                    <Grid Margin="11,12,0,0" Height="43"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border CornerRadius="6" BorderBrush="#293F50" BorderThickness="1"><Path Data="{StaticResource ShopIcon.Clock}" Style="{StaticResource ShopIcon}"/></Border><TextBlock Grid.Column="1" Text="{Binding Availability}" Style="{StaticResource ShopCaption}" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid>
                </StackPanel>
                <Border x:Name="CataloguePanel" Grid.Column="2" Style="{StaticResource ShopPanel}" Margin="0,46,0,46" Padding="28,12,24,20" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid><TextBlock Text="{Binding ServicesHeading}" Style="{StaticResource ShopHeading}" FontSize="28" LineHeight="34"/>
                            <Button x:Name="RefreshButton" Style="{StaticResource ShopAction}" Width="28" Height="28" Padding="6" BorderThickness="0" Background="Transparent" HorizontalAlignment="Right" IsEnabled="{Binding CanRefresh}" Click="Refresh_Click" ToolTip="{Binding RefreshLabel}" AutomationProperties.Name="{Binding RefreshLabel}"><Path Data="{StaticResource AtlasV2.Icon.Refresh}" Style="{StaticResource ShopIcon}" Width="14" Height="14" Opacity=".65"/></Button>
                        </Grid>
                        <TextBlock Text="{Binding ServicesSubtitle}" Style="{StaticResource ShopBody}" FontSize="14" Margin="0,0,0,18"/>
                        <ProgressBar Height="3" IsIndeterminate="True" Style="{StaticResource AtlasV2.Progress.Compact}" Visibility="{Binding IsLoading, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                        <Border Background="#DA071925" CornerRadius="6" Padding="14" Margin="0,0,0,12" Visibility="{Binding ShowStatus, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"><TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource ShopBody}"/></Border>
                        <Grid x:Name="ServiceCards"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.08*"/></Grid.ColumnDefinitions>
                            <Border BorderThickness="2.5" BorderBrush="#FFD56A" CornerRadius="12" IsHitTestVisible="False" Visibility="{Binding HasSelection, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"></Border>
                            <ListBox x:Name="ProductList" ItemsSource="{Binding Offers}" SelectedItem="{Binding SelectedOffer, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource ShopProduct}" AutomationProperties.Name="Produits de la boutique">
                                <ListBox.ItemTemplate><DataTemplate><Grid MinHeight="369"><Grid.RowDefinitions><RowDefinition Height="151"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
                                    <Border CornerRadius="10,10,0,0"><Border.Background><ImageBrush ImageSource="/WotLK.Launcher;component/Assets/Shop/Service_nom_sans_badge_recompose.png" Stretch="UniformToFill"/></Border.Background></Border>
                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" CornerRadius="6" Background="#F5C65D" BorderBrush="#FFDE83" BorderThickness="1" Padding="10,5" Margin="0,15,15,0"><TextBlock Text="{Binding DataContext.PopularLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11.5" FontWeight="Bold" Foreground="#191506"/></Border>
                                    <StackPanel Grid.Row="1" Margin="22,12,17,0"><TextBlock Text="{Binding Name}" Style="{StaticResource ShopHeading}" FontSize="22"/><TextBlock Text="{Binding Description}" Style="{StaticResource ShopBody}" Margin="0,10,0,0"/></StackPanel>
                                    <Border Grid.Row="2" CornerRadius="8" BorderBrush="#AD893C" BorderThickness="1" Margin="13,0,13,13" Background="#4B302710"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding DisplayPrice}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ShopGold}"/><TextBlock Text="{Binding DataContext.PriceWalletsLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ShopCaption}" FontSize="10.5"/></StackPanel><Path Grid.Column="1" Data="{StaticResource ShopIcon.Chevron}" Style="{StaticResource ShopIcon}" Width="12" Height="17" Stroke="{StaticResource ShopGold}"/></Grid></Border>
                                </Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <Border x:Name="CustomizationCard" Grid.Column="2" Style="{StaticResource ShopPanel}" Padding="0" MinHeight="373" AutomationProperties.Name="{Binding CustomizationHeading}"><Grid><Grid.RowDefinitions><RowDefinition Height="151"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
                                <Border CornerRadius="8,8,0,0"><Border.Background><ImageBrush ImageSource="/WotLK.Launcher;component/Assets/Shop/Service_personnalisation.png" Stretch="UniformToFill"/></Border.Background></Border>
                                <StackPanel Grid.Row="1" Margin="23,13,18,0"><TextBlock Text="{Binding CustomizationHeading}" Style="{StaticResource ShopHeading}" FontSize="22"/><TextBlock Text="{Binding CustomizationDescription}" Style="{StaticResource ShopBody}" Margin="0,10,0,0"/></StackPanel>
                                <Border Grid.Row="2" CornerRadius="8" Background="#6811283A" BorderBrush="#253F55" BorderThickness="1" Margin="13,0,13,13"><StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center"><Path Data="{StaticResource ShopIcon.Clock}" Style="{StaticResource ShopIcon}"/><TextBlock Text="{Binding SoonLabel}" Style="{StaticResource ShopBody}" FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel></Border>
                            </Grid></Border>
                            <Border x:Name="UpcomingCard" Grid.Column="4" Style="{StaticResource ShopPanel}" Padding="0" MinHeight="373" AutomationProperties.Name="{Binding FutureHeading}"><Grid><Grid.RowDefinitions><RowDefinition Height="151"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
                                <Border CornerRadius="8,8,0,0"><Border.Background><ImageBrush ImageSource="/WotLK.Launcher;component/Assets/Shop/Service_a_venir.png" Stretch="UniformToFill"/></Border.Background></Border>
                                <StackPanel Grid.Row="1" Margin="24,13,18,0"><TextBlock Text="{Binding FutureHeading}" Style="{StaticResource ShopHeading}" FontSize="22"/><TextBlock Text="{Binding FutureDescription}" Style="{StaticResource ShopBody}" Margin="0,10,0,0"/></StackPanel>
                                <Border Grid.Row="2" CornerRadius="8" Background="#6811283A" BorderBrush="#253F55" BorderThickness="1" Margin="13,0,13,13"><StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center"><Path Data="{StaticResource ShopIcon.Clock}" Style="{StaticResource ShopIcon}"/><TextBlock Text="{Binding UpcomingLabel}" Style="{StaticResource ShopBody}" FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel></Border>
                            </Grid></Border>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="DetailsPanel" Grid.Column="4" Style="{StaticResource ShopPanel}" Padding="22,17,22,15" MinHeight="575" VerticalAlignment="Top" Visibility="{Binding HasSelection, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                    <StackPanel>
                        <Grid Margin="-8,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Fill="#65134160" Width="48" Height="48"/><Path Data="{StaticResource AtlasV2.Icon.User}" Style="{StaticResource ShopIcon}" Width="28" Height="32" Stroke="#87D9FF"/>
                            <StackPanel Grid.Column="1" Margin="13,0,0,0"><TextBlock Text="{Binding SelectionHeading}" Style="{StaticResource ShopEyebrow}" LineHeight="18"/><TextBlock Text="{Binding OfferName}" Style="{StaticResource ShopHeading}" FontSize="21" LineHeight="26" Margin="0,4,0,0"/></StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding BeneficiaryLabel}" Style="{StaticResource ShopBody}" Foreground="#E9F3FF" FontSize="14" Margin="0,13,0,7"/>
                        <ComboBox x:Name="CharacterPicker" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}" ItemTemplate="{StaticResource ShopChoice}" Style="{StaticResource ShopField}" IsEnabled="{Binding HasCharacters}" AutomationProperties.Name="{Binding BeneficiaryLabel}"/>
                        <TextBlock Text="{Binding CharacterHint}" Style="{StaticResource ShopCaption}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding PaymentLabel}" Style="{StaticResource ShopBody}" Foreground="#E9F3FF" FontSize="14" Margin="0,14,0,6"/>
                        <ComboBox x:Name="CurrencyPicker" ItemsSource="{Binding Prices}" SelectedItem="{Binding SelectedPrice, Mode=TwoWay}" ItemTemplate="{StaticResource ShopChoice}" Style="{StaticResource ShopField}" AutomationProperties.Name="{Binding PaymentLabel}"/>
                        <TextBlock Text="{Binding PaymentHint}" Style="{StaticResource ShopCaption}" MinHeight="30" Margin="0,6,0,11"/>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#294C64" Background="#6501101B" Padding="17,12,17,10" ToolTip="{Binding OfferConditions}" ToolTipService.ShowDuration="30000">
                            <StackPanel><TextBlock Text="{Binding RecapHeading}" Style="{StaticResource ShopBody}" FontWeight="SemiBold" Margin="0,0,0,11"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding OfferName}" Style="{StaticResource ShopBody}" FontSize="14"/><TextBlock Grid.Column="1" Text="{Binding SelectedAmount}" Style="{StaticResource ShopBody}" FontSize="14" Margin="8,0,0,0"/></Grid>
                                <TextBlock x:Name="SummaryText" Text="{Binding SummaryCharacter}" Style="{StaticResource ShopBody}" FontSize="14" Margin="0,2,0,0"/>
                                <Border Height="1" Background="#284356" Margin="0,8,0,9"/>
                                <Grid><TextBlock Text="{Binding TotalLabel}" Style="{StaticResource ShopBody}" Foreground="#EFF5FF"/><TextBlock Text="{Binding SelectedAmount}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource ShopGold}" HorizontalAlignment="Right"/></Grid>
                            </StackPanel>
                        </Border>
                        <Button x:Name="PurchaseButton" Style="{StaticResource ShopAction}" IsEnabled="{Binding CanPurchase}" Margin="0,11,0,8" Background="#AA705E2D" BorderBrush="#B59A54" Foreground="#FFF0CE"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ShopIcon.Lock}" Style="{StaticResource ShopIcon}" Width="17" Height="19" Stroke="#EBD194"/><TextBlock Text="{Binding SoonLabel}" Margin="15,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <TextBlock Text="{Binding PurchaseHint}" Style="{StaticResource ShopCaption}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="ConversionBanner" Grid.Row="2" Style="{StaticResource ShopPanel}" Padding="16,12,25,12" Margin="0,14,12,0" MinHeight="112">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="CoinsColumn" Width="214"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image x:Name="ConversionCoins" Source="/WotLK.Launcher;component/Assets/Shop/Conversion_or_transparent.png" Width="190" Height="86" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{Binding ConversionHeading}" Style="{StaticResource ShopHeading}" FontSize="23"/><TextBlock Text="{Binding CreditsInformation}" Style="{StaticResource ShopBody}" FontSize="13.5" Margin="0,4,0,7"/>
                        <Border BorderBrush="#A38437" BorderThickness="1" CornerRadius="4" Padding="14,5" HorizontalAlignment="Left" Background="#A2091920"><TextBlock Text="{Binding ConversionRate}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource ShopGold}"/></Border>
                    </StackPanel>
                    <Button x:Name="MoreConversionButton" Grid.Column="2" Style="{StaticResource ShopAction}" Height="53" Padding="23,0" VerticalAlignment="Center" BorderBrush="#3F9BCB" Click="Credits_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AtlasV2.Icon.Refresh}" Style="{StaticResource ShopIcon}" Width="19" Height="19"/><TextBlock Text="{Binding ConvertAction}" Margin="13,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
    <views:ShopConversionViewV2 x:Name="ConversionView"/>
    </Grid>
</UserControl>
