<UserControl x:Class="WotLK.Launcher.UI.V2.Views.ShopAdminViewV2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:WotLK.Launcher.UI.V2.Localization" localization:LauncherLocalizationOptions.IsUserText="True"
             Visibility="{Binding IsShopAdminOpen, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"
             FontFamily="{StaticResource AtlasV2.Font.Inter}" TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal" Focusable="False">
    <UserControl.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/AtlasV2.Shop.xaml"/></ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="FundingChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
        <Style x:Key="FundingInput" TargetType="TextBox" BasedOn="{StaticResource AtlasV2.TextBox.Field}">
            <Setter Property="Height" Value="40"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="#B004131D"/>
            <Setter Property="BorderBrush" Value="#436278"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="11,7">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="#8CCCEC"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FundingLabel" TargetType="TextBlock" BasedOn="{StaticResource ShopCaption}">
            <Setter Property="Margin" Value="0,14,0,6"/><Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FundingEntry" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AtlasV2.FocusVisual.Button}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Reference}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Surface" Background="#7405121C" BorderBrush="#354D60" BorderThickness="1" CornerRadius="10" Padding="14">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#86C9E8"/><Setter TargetName="Surface" Property="Background" Value="#AB153449"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ResourceDictionary></UserControl.Resources>
    <Grid x:Name="AdminFrame" Margin="60,24" MaxWidth="1320">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Button x:Name="AdminBackButton" Style="{StaticResource ShopAction}" Height="30" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left" Margin="0,0,0,18" Click="Back_Click" Content="{Binding WalletLabel}"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="{Binding AdminFundingLabel}" Style="{StaticResource ShopHeading}" Foreground="{StaticResource AtlasV2.Brush.TitlePearl}" FontSize="34" LineHeight="44"/>
            <TextBlock Text="{Binding AdminSubtitle}" Style="{StaticResource ShopBody}" Margin="0,6,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="2" x:Name="AdminFundingNotice" Text="{Binding FundingNotice}" Style="{StaticResource ShopBody}" Foreground="#ECD096" Margin="0,0,0,14" Visibility="{Binding HasFundingNotice, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource ShopPanel}" Padding="18">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ComboBox x:Name="AdminStatusPicker" ItemsSource="{Binding AdminStatusFilters}" SelectedItem="{Binding AdminStatusFilter, Mode=TwoWay}"
                              Style="{StaticResource ShopField}" ItemTemplate="{StaticResource FundingChoice}" IsEnabled="{Binding CanRefreshAdmin}"/>
                    <Button Grid.Row="1" x:Name="AdminRefreshButton" Style="{StaticResource ShopAction}" Content="{Binding AdminLatestLabel}" Margin="0,10,0,16" Height="34" Click="Refresh_Click" IsEnabled="{Binding CanRefreshAdmin}"/>
                    <ListBox Grid.Row="2" x:Name="AdminRequestList" ItemsSource="{Binding AdminTopUps}" SelectedItem="{Binding AdminSelectedTopUp, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource FundingEntry}" Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             IsEnabled="{Binding CanEditAdminDetails}" AutomationProperties.Name="{Binding AdminFundingLabel}">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource ShopWalletAmount}"/>
                                <TextBlock Text="{Binding Account}" Style="{StaticResource ShopBody}" VerticalAlignment="Center"/></DockPanel>
                            <TextBlock Text="{Binding Status}" Foreground="#B7D8EB" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Reference}" FontFamily="Consolas" FontSize="10" Foreground="#A3BACA" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Created}" Style="{StaticResource ShopCaption}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="{Binding AdminEmpty}" Style="{StaticResource ShopBody}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Visibility="{Binding ShowAdminEmpty, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}"/>
                    <Button Grid.Row="3" Style="{StaticResource ShopAction}" Content="{Binding AdminNextLabel}" Margin="0,12,0,0" Height="34" Click="Next_Click" IsEnabled="{Binding HasAdminNextPage}"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource ShopPanel}" Padding="24">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="AdminSearchInput" Text="{Binding AdminSearchReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FundingInput}" MaxLength="38"
                                 AutomationProperties.Name="{Binding AdminSearchLabel}" IsEnabled="{Binding CanEditAdminDetails}"/>
                        <Button Grid.Column="1" Style="{StaticResource ShopAction}" Content="{Binding AdminSearchLabel}" Margin="10,0,0,0" Padding="12,0" Height="40" Click="Search_Click" IsEnabled="{Binding CanRefreshAdmin}"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding AdminNoSelection}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ShopBody}"><Style.Triggers><DataTrigger Binding="{Binding HasAdminSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer Grid.Row="1" x:Name="AdminDetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasAdminSelection, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AtlasV2.ScrollBar.Dark}"/></ScrollViewer.Resources>
                        <StackPanel Margin="0,0,14,0" IsEnabled="{Binding CanEditAdminDetails}">
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding AdminAmount}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource ShopWalletAmount}"/>
                                <TextBlock Text="{Binding AdminAccount}" Style="{StaticResource ShopHeading}" FontSize="21" VerticalAlignment="Center"/></DockPanel>
                            <TextBlock Text="{Binding AdminReference}" FontFamily="Consolas" FontSize="13" Foreground="#C0D8E7" TextWrapping="Wrap" Margin="0,10,0,18"/>
                            <TextBlock Text="{Binding AdminActionLabel}" Style="{StaticResource FundingLabel}"/>
                            <ComboBox x:Name="AdminActionPicker" ItemsSource="{Binding AdminActions}" SelectedItem="{Binding AdminAction, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource FundingChoice}" Style="{StaticResource ShopField}" AutomationProperties.Name="{Binding AdminActionLabel}"/>
                            <StackPanel Visibility="{Binding IsApprovalAction, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                <TextBlock Text="{Binding AdminTransactionLabel}" Style="{StaticResource FundingLabel}"/>
                                <TextBox x:Name="AdminTransactionInput" Text="{Binding AdminTransactionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FundingInput}" MaxLength="64" AutomationProperties.Name="{Binding AdminTransactionLabel}"/>
                                <TextBlock Text="{Binding AdminReceivedLabel}" Style="{StaticResource FundingLabel}"/>
                                <TextBox x:Name="AdminReceivedInput" Text="{Binding AdminReceivedAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FundingInput}" MaxLength="11" AutomationProperties.Name="{Binding AdminReceivedLabel}"/>
                                <CheckBox x:Name="AdminPaymentVerifiedCheck" IsChecked="{Binding AdminPaymentVerified, Mode=TwoWay}" Foreground="#D2E4EF" Margin="0,16,0,0">
                                    <TextBlock Text="{Binding AdminPaymentConfirmation}" TextWrapping="Wrap" FontSize="13" LineHeight="19"/>
                                </CheckBox>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsDisputeAction, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                <TextBlock Text="{Binding AdminCaseLabel}" Style="{StaticResource FundingLabel}"/>
                                <TextBox x:Name="AdminCaseInput" Text="{Binding AdminCaseId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FundingInput}" MaxLength="100" AutomationProperties.Name="{Binding AdminCaseLabel}"/>
                            </StackPanel>
                            <CheckBox x:Name="AdminRefundVerifiedCheck" IsChecked="{Binding AdminRefundVerified, Mode=TwoWay}" Foreground="#ECD096" Margin="0,16,0,0"
                                      Visibility="{Binding IsRefundAction, Converter={StaticResource AtlasV2.Converter.BooleanToVisibility}}">
                                <TextBlock Text="{Binding AdminRefundConfirmation}" TextWrapping="Wrap" FontSize="13" LineHeight="19"/>
                            </CheckBox>
                            <TextBlock Text="{Binding AdminNoteLabel}" Style="{StaticResource FundingLabel}"/>
                            <TextBox x:Name="AdminNoteInput" Text="{Binding AdminNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FundingInput}" Height="76"
                                     VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="1000" AutomationProperties.Name="{Binding AdminNoteLabel}"/>
                            <Border Background="#3C5870" Height="1" Margin="0,22,0,18"/>
                            <TextBlock Text="{Binding AdminAuditLabel}" Style="{StaticResource ShopHeading}" FontSize="20"/>
                            <TextBlock x:Name="AdminAuditText" Text="{Binding AdminAudit}" Style="{StaticResource ShopBody}" FontSize="12" LineHeight="19" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" x:Name="AdminSubmitButton" Style="{StaticResource ShopAction}" Content="{Binding AdminSubmitLabel}" IsEnabled="{Binding CanSubmitAdminDecision}"
                            Click="Submit_Click" Height="44" Margin="0,18,0,0" Background="#264C7294" BorderBrush="#5285A7"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
